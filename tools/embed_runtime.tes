// Generates stage1/runtime_text.tes from the files in runtime/, so the stage 1 compiler carries
// exactly the runtime that stage 0 includes, plus the parts only stage 1 uses. Each argument after
// the output file is `function_name=path`; a missing file becomes an empty function.
//
//   tessera run tools/embed_runtime.tes -- stage1/runtime_text.tes core_runtime=runtime/core.rs ui_runtime=runtime/ui.rs ...

fn escape(line: Text) -> Text {
var out: List[Text] = []
for code in code_points(line) {
let piece = match code {
34 => "\\\""
92 => "\\\\"
9 => "\\t"
_ => from_code_point(code)
}
set out = append(out, piece)
}
join(out, "")
}

fn text_function(name: Text, source: Text, origin: Text) -> Text {
var lines: List[Text] = []
var current: List[Int] = []
for code in code_points(source) {
if code == 10 {
set lines = append(lines, "\"" + escape(from_code_points(current)) + "\",")
set current = []
} else {
set current = append(current, code)
}
}
set lines = append(lines, "\"" + escape(from_code_points(current)) + "\",")
"note \"Generated from " + origin + "; do not edit by hand.\"\npub fn " + name + "() -> Text {\nlet lines = [\n" + join(lines, "\n") + "\n]\njoin(lines, \"\\n\")\n}\n"
}

fn before_equals(text: Text) -> Text {
var out: List[Int] = []
for code in code_points(text) {
if code == 61 {
return from_code_points(out)
}
set out = append(out, code)
}
from_code_points(out)
}

fn after_equals(text: Text) -> Text {
var out: List[Int] = []
var seen = false
for code in code_points(text) {
if seen {
set out = append(out, code)
} else if code == 61 {
set seen = true
}
}
from_code_points(out)
}

fn file_name(path: Text) -> Text {
var out: List[Int] = []
for code in code_points(path) {
if code == 47 {
set out = []
} else {
set out = append(out, code)
}
}
from_code_points(out)
}

fn directory_label(path: Text) -> Text {
let codes = code_points(path)
let count = length(codes)
if count > 4 and codes[count - 4] == 46 and codes[count - 3] == 116 and codes[count - 2] == 101 and codes[count - 1] == 115 {
return "std/"
}
"runtime/"
}

fn main() -> Unit uses io, fs, env {
let arguments = args()
if length(arguments) < 2 {
print_error("usage: embed_runtime <output.tes> <function_name=path>...")
exit(2)
}
var parts: List[Text] = ["// Generated by tools/embed_runtime.tes from the files in runtime/. Do not edit.\n"]
for index in range(1, length(arguments)) {
let name = before_equals(arguments[index])
let path = after_equals(arguments[index])
var content = ""
if file_exists(path) {
set content = read_file(path)
} else {
print_error("warning: " + path + " does not exist; embedding it as empty")
}
set parts = append(parts, text_function(name, content, directory_label(path) + file_name(path)))
}
write_file(arguments[0], join(parts, "\n"))
print("wrote " + arguments[0])
}
