// Generates stage1/runtime_text.tes from runtime/core.rs and runtime/ui.rs, so the
// stage 1 compiler carries exactly the runtime that stage 0 includes.
//
//   tessera run tools/embed_runtime.tes -- runtime/core.rs runtime/ui.rs stage1/runtime_text.tes

fn escape(line: Text) -> Text {
    var out: List[Text] = []
    for code in code_points(line) {
        let piece = match code {
            34 => "\\\""
            92 => "\\\\"
            9 => "\\t"
            _ => from_code_point(code)
        }
        set out = append(out, piece)
    }
    join(out, "")
}

fn text_function(name: Text, source: Text, origin: Text) -> Text {
    var lines: List[Text] = []
    var current: List[Int] = []
    for code in code_points(source) {
        if code == 10 {
            set lines = append(lines, "        \"" + escape(from_code_points(current)) + "\",")
            set current = []
        } else {
            set current = append(current, code)
        }
    }
    set lines = append(lines, "        \"" + escape(from_code_points(current)) + "\",")
    "note \"Generated from " + origin + "; do not edit by hand.\"\npub fn " + name + "() -> Text {\n    let lines = [\n" + join(lines, "\n") + "\n    ]\n    join(lines, \"\\n\")\n}\n"
}

fn main() -> Unit uses io, fs, env {
    let arguments = args()
    if length(arguments) != 3 {
        print_error("usage: embed_runtime <core.rs> <ui.rs> <output.tes>")
        exit(2)
    }
    let header = "// Generated by tools/embed_runtime.tes from the files in runtime/. Do not edit.\n\n"
    let core = text_function("core_runtime", read_file(arguments[0]), "runtime/core.rs")
    let ui = text_function("ui_runtime", read_file(arguments[1]), "runtime/ui.rs")
    write_file(arguments[2], header + core + "\n" + ui)
    print("wrote " + arguments[2])
}
