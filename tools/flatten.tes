// Turns the modular stage 1 compiler into module_name-free source that the stage 0
// compiler can build (the `bootstrap/` directory):
// - drops `import` lines and `pub` markers,
// - removes module_name qualifiers such as `ast.` in front of names that module_name declares.
// Text literals and comments are left untouched. Fails if two modules declare the same
// name, because the flattened files share one namespace.
//
//   tessera run tools/flatten.tes -- stage1 bootstrap source lexer ast parser checker codegen runtime_text main

fn is_name_code(code: Int) -> Bool = (code >= 97 and code <= 122) or (code >= 65 and code <= 90) or (code >= 48 and code <= 57) or code == 95

fn starts_with(text: Text, prefix: Text) -> Bool {
    let codes = code_points(text)
    let prefix_codes = code_points(prefix)
    length(codes) >= length(prefix_codes) and slice(codes, 0, length(prefix_codes)) == prefix_codes
}

fn split_lines(text: Text) -> List[Text] {
    var lines: List[Text] = []
    var current: List[Int] = []
    for code in code_points(text) {
        if code == 10 {
            set lines = append(lines, from_code_points(current))
            set current = []
        } else {
            set current = append(current, code)
        }
    }
    append(lines, from_code_points(current))
}

fn word_after(line: Text, prefix: Text) -> Text {
    let codes = code_points(line)
    var index = length(code_points(prefix))
    var word: List[Int] = []
    while index < length(codes) and is_name_code(codes[index]) {
        set word = append(word, codes[index])
        set index = index + 1
    }
    from_code_points(word)
}

note "Top-level names declared in a module: `fn`, `type` and `enum` at the start of a line."
fn declared_names(text: Text) -> List[Text] {
    var names: List[Text] = []
    for line in split_lines(text) {
        for prefix in ["fn ", "type ", "enum ", "pub fn ", "pub type ", "pub enum "] {
            if starts_with(line, prefix) {
                set names = append(names, word_after(line, prefix))
            }
        }
    }
    names
}

fn contains(items: List[Text], item: Text) -> Bool {
    for candidate in items {
        if candidate == item {
            return true
        }
    }
    false
}

type ModuleNames {
    module_name: Text
    names: List[Text]
}

fn declares(modules: List[ModuleNames], module_name: Text, name: Text) -> Bool {
    for m in modules {
        if m.module_name == module_name {
            return contains(m.names, name)
        }
    }
    false
}

fn read_word(codes: List[Int], start: Int) -> Text {
    var index = start
    while index < length(codes) and is_name_code(codes[index]) {
        set index = index + 1
    }
    from_code_points(slice(codes, start, index))
}

note "Removes `module.` in front of names that the module declares, outside text literals and comments."
fn strip_qualifiers(line: Text, modules: List[ModuleNames]) -> Text {
    let codes = code_points(line)
    var out: List[Int] = []
    var index = 0
    var in_text = false
    while index < length(codes) {
        let code = codes[index]
        if in_text {
            set out = append(out, code)
            if code == 92 and index + 1 < length(codes) {
                set out = append(out, codes[index + 1])
                set index = index + 2
                continue
            }
            if code == 34 {
                set in_text = false
            }
            set index = index + 1
            continue
        }
        if code == 34 {
            set in_text = true
            set out = append(out, code)
            set index = index + 1
            continue
        }
        if code == 47 and index + 1 < length(codes) and codes[index + 1] == 47 {
            return from_code_points(concat(out, slice(codes, index, length(codes))))
        }
        let previous = if index > 0 { codes[index - 1] } else { 32 }
        if is_name_code(code) and not is_name_code(previous) and previous != 46 {
            let word = read_word(codes, index)
            let after = index + length(code_points(word))
            if after < length(codes) and codes[after] == 46 {
                let member = read_word(codes, after + 1)
                if declares(modules, word, member) {
                    set index = after + 1
                    continue
                }
            }
            set out = concat(out, code_points(word))
            set index = after
            continue
        }
        set out = append(out, code)
        set index = index + 1
    }
    from_code_points(out)
}

fn flatten(text: Text, modules: List[ModuleNames]) -> Text {
    var out: List[Text] = []
    var previous_blank = false
    for line in split_lines(text) {
        if starts_with(line, "import ") {
            continue
        }
        let unmarked = if starts_with(line, "pub ") { from_code_points(slice(code_points(line), 4, length(code_points(line)))) } else { line }
        let blank = unmarked == ""
        if blank and previous_blank {
            continue
        }
        set previous_blank = blank
        set out = append(out, strip_qualifiers(unmarked, modules))
    }
    join(out, "\n")
}

fn main() -> Unit uses io, fs, env {
    let arguments = args()
    if length(arguments) < 3 {
        print_error("usage: flatten <source-dir> <target-dir> <module>...")
        exit(2)
    }
    let source_dir = arguments[0]
    let target_dir = arguments[1]
    let module_list = slice(arguments, 2, length(arguments))
    var modules: List[ModuleNames] = []
    var all_names: List[Text] = []
    for module_name in module_list {
        let names = declared_names(read_file(source_dir + "/" + module_name + ".tes"))
        for name in names {
            if contains(all_names, name) {
                print_error("error: `" + name + "` is declared in more than one module; flattening would merge them")
                exit(1)
            }
        }
        set all_names = concat(all_names, names)
        set modules = append(modules, ModuleNames { module_name: module_name, names: names })
    }
    for module_name in module_list {
        let text = read_file(source_dir + "/" + module_name + ".tes")
        write_file(target_dir + "/" + module_name + ".tes", flatten(text, modules))
    }
    print("flattened " + to_text(length(module_list)) + " modules into " + target_dir)
}
