// Source positions, diagnostics, and text helpers shared by all compiler phases.

pub type Span {
file: Int
line: Int
col: Int
end_line: Int
end_col: Int
}

pub type SourceFile {
path: Text
text: Text
}

note "A machine-applicable change: the text of `span` (end exclusive) becomes `replacement`; an empty span inserts. When `expect` is not empty the edit only applies if the span holds exactly that text, which guards the positions a fix assumes."
pub type TextEdit {
span: Span
replacement: Text
expect: Text
}

note "A repair for a diagnostic: applying all `edits` together removes the error (spec section 20.4)."
pub type Fix {
message: Text
edits: List[TextEdit]
}

note "Empty `label`, `help`, `expected` or `actual` means the diagnostic has none. `expected` and `actual` name what the compiler wanted and what it found (types, counts or names)."
pub type Diagnostic {
code: Text
message: Text
span: Span
label: Text
help: Text
expected: Text
actual: Text
fixes: List[Fix]
}

pub fn span_of(file: Int, line: Int, col: Int, end_col: Int) -> Span {
Span { file: file, line: line, col: col, end_line: line, end_col: end_col }
}

pub fn span_to(start: Span, finish: Span) -> Span {
Span { file: start.file, line: start.line, col: start.col, end_line: finish.end_line, end_col: finish.end_col }
}

pub fn error(code: Text, span: Span, message: Text) -> Diagnostic {
Diagnostic { code: code, message: message, span: span, label: "", help: "", expected: "", actual: "", fixes: [] }
}

pub fn error_help(code: Text, span: Span, message: Text, help: Text) -> Diagnostic {
Diagnostic { code: code, message: message, span: span, label: "", help: help, expected: "", actual: "", fixes: [] }
}

pub fn with_fix(d: Diagnostic, message: Text, edits: List[TextEdit]) -> Diagnostic = d with { fixes: append(d.fixes, Fix { message: message, edits: edits }) }

pub fn with_types(d: Diagnostic, expected: Text, actual: Text) -> Diagnostic = d with { expected: expected, actual: actual }

pub fn replace_span(span: Span, replacement: Text) -> TextEdit = TextEdit { span: span, replacement: replacement, expect: "" }

pub fn replace_expected(span: Span, old: Text, replacement: Text) -> TextEdit = TextEdit { span: span, replacement: replacement, expect: old }

pub fn insert_at(file: Int, line: Int, col: Int, text: Text) -> TextEdit = TextEdit { span: Span { file: file, line: line, col: col, end_line: line, end_col: col }, replacement: text, expect: "" }

note "Deletes whole lines `first` to `last`, with their line breaks."
pub fn delete_lines(file: Int, first: Int, last: Int) -> TextEdit = TextEdit { span: Span { file: file, line: first, col: 1, end_line: last + 1, end_col: 1 }, replacement: "", expect: "" }

pub fn start_of(span: Span) -> Span = Span { file: span.file, line: span.line, col: span.col, end_line: span.line, end_col: span.col }

pub fn end_of(span: Span) -> Span = Span { file: span.file, line: span.end_line, col: span.end_col, end_line: span.end_line, end_col: span.end_col }

// ---------- applying edits ----------

note "Code-point offset of each line start; one more entry for the end of the text."
fn line_starts(codes: List[Int]) -> List[Int] {
var starts = [0]
var index = 0
while index < length(codes) {
if codes[index] == 10 {
set starts = append(starts, index + 1)
}
set index += 1
}
append(starts, length(codes))
}

note "Offset of a line and column, or -1 when it lies outside the text. Line `count + 1` column 1 is the end of the text."
fn offset_of(starts: List[Int], total: Int, line: Int, col: Int) -> Int {
let lines = length(starts) - 1
if line < 1 or col < 1 or line > lines {
if line == lines + 1 and col == 1 {
return total
}
return -1
}
let begin = starts[line - 1]
let next = if line < lines { starts[line] } else { total }
let offset = begin + col - 1
if offset > next { -1 } else { offset }
}

type EditRange {
start: Int
finish: Int
replacement: Text
expect: Text
}

note "Applies the edits for `file` to `text`, or gives an error when an edit is outside the text, overlaps another, or does not find the text it expects."
pub fn apply_edits(text: Text, file: Int, edits: List[TextEdit]) -> Result[Text, Text] {
let codes = code_points(text)
let starts = line_starts(codes)
var ranges: List[EditRange] = []
for e in edits {
if e.span.file != file {
continue
}
let start = offset_of(starts, length(codes), e.span.line, e.span.col)
let finish = offset_of(starts, length(codes), e.span.end_line, e.span.end_col)
if start < 0 or finish < start {
return .Error("edit outside the text")
}
if e.expect != "" and from_code_points(slice(codes, start, finish)) != e.expect {
return .Error("the text is not `\(e.expect)`")
}
set ranges = append(ranges, EditRange { start: start, finish: finish, replacement: e.replacement, expect: e.expect })
}
let sorted = sort_ranges(ranges)
var out: List[Text] = []
var position = 0
var previous_start = -1
for r in sorted {
// Two edits at the same place would depend on their order, so they count as overlapping too.
if r.start < position or r.start == previous_start {
return .Error("overlapping edits")
}
set previous_start = r.start
set out = append(append(out, from_code_points(slice(codes, position, r.start))), r.replacement)
set position = r.finish
}
set out = append(out, from_code_points(slice(codes, position, length(codes))))
.Ok(join(out, ""))
}

fn sort_ranges(items: List[EditRange]) -> List[EditRange] {
if length(items) <= 1 {
return items
}
let middle = length(items) / 2
let left = sort_ranges(slice(items, 0, middle))
let right = sort_ranges(slice(items, middle, length(items)))
var merged: List[EditRange] = []
var i = 0
var j = 0
while i < length(left) and j < length(right) {
if left[i].start <= right[j].start {
set merged = append(merged, left[i])
set i += 1
} else {
set merged = append(merged, right[j])
set j += 1
}
}
concat(concat(merged, slice(left, i, length(left))), slice(right, j, length(right)))
}

note "Keeps only the fixes that apply cleanly to the source, so every fix a diagnostic carries can be applied as it is."
pub fn valid_fixes(diagnostics: List[Diagnostic], files: List[SourceFile]) -> List[Diagnostic] {
var out: List[Diagnostic] = []
for d in diagnostics {
var kept: List[Fix] = []
for f in d.fixes {
if fix_applies(f, files) {
set kept = append(kept, f)
}
}
set out = append(out, d with { fixes: kept })
}
out
}

fn fix_applies(f: Fix, files: List[SourceFile]) -> Bool {
if length(f.edits) == 0 {
return false
}
for e in f.edits {
if e.span.file < 0 or e.span.file >= length(files) or starts_with_text(files[e.span.file].path, "<") {
return false
}
match apply_edits(files[e.span.file].text, e.span.file, f.edits) {
.Ok(_) => {}
.Error(_) => return false
}
}
true
}

fn count_newlines(text: Text) -> Int {
var count = 0
for code in code_points(text) {
if code == 10 {
set count += 1
}
}
count
}

fn deletes_lines(e: TextEdit) -> Bool = e.replacement == "" and e.span.col == 1 and e.span.end_col == 1 and e.span.end_line > e.span.line

note "The lines a fix produces, numbered as in the fixed file (at most three); nothing when it only deletes lines."
fn fix_preview(f: Fix, files: List[SourceFile]) -> Text {
var only_deletes = true
for e in f.edits {
if not deletes_lines(e) {
set only_deletes = false
}
}
if only_deletes {
return ""
}
let file = f.edits[0].span.file
var first = f.edits[0].span.line
var last = f.edits[0].span.end_line
var delta = 0
for e in f.edits {
if e.span.file == file {
if e.span.line < first {
set first = e.span.line
}
if e.span.end_line > last {
set last = e.span.end_line
}
set delta = delta + count_newlines(e.replacement) - (e.span.end_line - e.span.line)
}
}
let fixed = match apply_edits(files[file].text, file, f.edits) {
.Ok(text) => text
.Error(_) => return ""
}
let lines = split_lines(fixed)
var finish = last + delta
if finish > first + 2 {
set finish = first + 2
}
var out = ""
var line = first
while line <= finish and line <= length(lines) {
set out = "\(out)  \(line) | \(lines[line - 1])\n"
set line += 1
}
out
}

// ---------- character classes (code points) ----------

pub fn is_digit(code: Int) -> Bool = code >= 48 and code <= 57

pub fn is_upper(code: Int) -> Bool = code >= 65 and code <= 90

pub fn is_lower(code: Int) -> Bool = code >= 97 and code <= 122

pub fn is_letter(code: Int) -> Bool = is_upper(code) or is_lower(code)

pub fn is_alphanumeric(code: Int) -> Bool = is_letter(code) or is_digit(code)

pub fn is_hex_digit(code: Int) -> Bool = is_digit(code) or (code >= 97 and code <= 102) or (code >= 65 and code <= 70)

pub fn is_control(code: Int) -> Bool = code < 32 or (code >= 127 and code < 160)

pub fn hex_value(code: Int) -> Int {
if is_digit(code) { code - 48 } else if code >= 97 { code - 87 } else { code - 55 }
}

// ---------- text helpers ----------

pub fn repeat_text(text: Text, count: Int) -> Text {
var out = ""
var index = 0
while index < count {
set out += text
set index += 1
}
out
}

pub fn starts_with_upper(text: Text) -> Bool {
let codes = code_points(text)
length(codes) > 0 and is_upper(codes[0])
}

pub fn contains_text(items: List[Text], item: Text) -> Bool {
for candidate in items {
if candidate == item {
return true
}
}
false
}

pub fn ends_with_text(text: Text, suffix: Text) -> Bool {
let codes = code_points(text)
let suffix_codes = code_points(suffix)
if length(suffix_codes) > length(codes) {
return false
}
slice(codes, length(codes) - length(suffix_codes), length(codes)) == suffix_codes
}

pub fn starts_with_text(text: Text, prefix: Text) -> Bool {
let codes = code_points(text)
let prefix_codes = code_points(prefix)
if length(prefix_codes) > length(codes) {
return false
}
slice(codes, 0, length(prefix_codes)) == prefix_codes
}

note "Same contract as Rust `str::lines` for LF-only text: no empty last line after a final newline."
fn split_lines(text: Text) -> List[Text] {
let codes = code_points(text)
var lines: List[Text] = []
var start = 0
var index = 0
while index < length(codes) {
if codes[index] == 10 {
set lines = append(lines, from_code_points(slice(codes, start, index)))
set start = index + 1
}
set index += 1
}
if start < length(codes) {
set lines = append(lines, from_code_points(slice(codes, start, length(codes))))
}
lines
}

pub fn split_on(text: Text, separator: Int) -> List[Text] {
let codes = code_points(text)
var parts: List[Text] = []
var start = 0
var index = 0
while index < length(codes) {
if codes[index] == separator {
set parts = append(parts, from_code_points(slice(codes, start, index)))
set start = index + 1
}
set index += 1
}
append(parts, from_code_points(slice(codes, start, length(codes))))
}

pub fn split_on_text(text: Text, separator: Text) -> List[Text] {
let codes = code_points(text)
let sep = code_points(separator)
let width = length(sep)
var parts: List[Text] = []
var start = 0
var index = 0
while index + width <= length(codes) {
if slice(codes, index, index + width) == sep {
set parts = append(parts, from_code_points(slice(codes, start, index)))
set index += width
set start = index
} else {
set index += 1
}
}
append(parts, from_code_points(slice(codes, start, length(codes))))
}

fn hex_text(value: Int) -> Text {
if value == 0 {
return "0"
}
let digits = code_points("0123456789abcdef")
var remaining = value
var reversed: List[Int] = []
while remaining > 0 {
set reversed = append(reversed, digits[remaining % 16])
set remaining = remaining / 16
}
var out: List[Int] = []
var index = length(reversed) - 1
while index >= 0 {
set out = append(out, reversed[index])
set index -= 1
}
from_code_points(out)
}

fn left_padded(text: Text, width: Int, fill: Text) -> Text {
let missing = width - length(text)
if missing > 0 { repeat_text(fill, missing) + text } else { text }
}

note "Must match `rust_string` in the stage 0 compiler exactly, or generated code differs."
pub fn rust_string(text: Text) -> Text {
var out: List[Text] = ["\""]
for code in code_points(text) {
let piece = match code {
34 => "\\\""
92 => "\\\\"
10 => "\\n"
13 => "\\r"
9 => "\\t"
_ => if code >= 32 and code <= 126 { from_code_point(code) } else { "\\u{\(hex_text(code))}" }
}
set out = append(out, piece)
}
join(append(out, "\""), "")
}

pub fn json_string(text: Text) -> Text {
var out: List[Text] = ["\""]
for code in code_points(text) {
let piece = match code {
34 => "\\\""
92 => "\\\\"
10 => "\\n"
13 => "\\r"
9 => "\\t"
_ => if code < 32 { "\\u\(left_padded(hex_text(code), 4, "0"))" } else { from_code_point(code) }
}
set out = append(out, piece)
}
join(append(out, "\""), "")
}

// ---------- rendering ----------

pub fn render(diagnostic: Diagnostic, files: List[SourceFile]) -> Text {
let file = files[diagnostic.span.file]
let span = diagnostic.span
var out = "error[\(diagnostic.code)]: \(diagnostic.message)\n"
set out = "\(out)  --> \(file.path):\(span.line):\(span.col)\n"
let lines = split_lines(file.text)
if span.line >= 1 and span.line <= length(lines) {
let line_text = lines[span.line - 1]
let number = to_text(span.line)
let pad = repeat_text(" ", length(number))
set out = "\(out)\(pad) |\n"
set out = "\(out)\(number) | \(line_text)\n"
let start = if span.col < 1 { 1 } else { span.col }
let finish = if span.end_line == span.line { span.end_col } else { length(line_text) + 1 }
let width = if finish - start < 1 { 1 } else { finish - start }
var marker = "\(pad) | \(repeat_text(" ", start - 1))\(repeat_text("^", width))"
if diagnostic.label != "" {
set marker = "\(marker) \(diagnostic.label)"
}
set out = "\(out)\(marker)\n"
set out = "\(out)\(pad) |\n"
}
if diagnostic.help != "" {
set out = "\(out)help: \(diagnostic.help)\n"
}
for f in diagnostic.fixes {
set out = "\(out)fix: \(f.message)\n\(fix_preview(f, files))"
}
out
}

fn json_or_null(text: Text) -> Text = if text == "" { "null" } else { json_string(text) }

fn source_line(text: Text, line: Int) -> Text {
let lines = split_lines(text)
if line >= 1 and line <= length(lines) { lines[line - 1] } else { "" }
}

fn fixes_json(fixes: List[Fix], files: List[SourceFile]) -> Text {
var parts: List[Text] = []
for f in fixes {
var edits: List[Text] = []
for e in f.edits {
let s = e.span
set edits = append(edits, "{\"file\":\(json_string(files[s.file].path)),\"line\":\(s.line),\"column\":\(s.col),\"end_line\":\(s.end_line),\"end_column\":\(s.end_col),\"replacement\":\(json_string(e.replacement))}")
}
set parts = append(parts, "{\"message\":\(json_string(f.message)),\"edits\":[\(join(edits, ","))]}")
}
"[\(join(parts, ","))]"
}

pub fn render_json(diagnostics: List[Diagnostic], files: List[SourceFile]) -> Text {
var parts: List[Text] = []
for d in diagnostics {
let s = d.span
set parts = append(parts, "{\"severity\":\"error\",\"code\":\(json_string(d.code)),\"message\":\(json_string(d.message)),\"file\":\(json_string(files[s.file].path)),\"line\":\(s.line),\"column\":\(s.col),\"end_line\":\(s.end_line),\"end_column\":\(s.end_col),\"label\":\(json_or_null(d.label)),\"help\":\(json_or_null(d.help)),\"expected\":\(json_or_null(d.expected)),\"actual\":\(json_or_null(d.actual)),\"source_line\":\(json_or_null(source_line(files[s.file].text, s.line))),\"fixes\":\(fixes_json(d.fixes, files))}")
}
"{\"diagnostics\":[\(join(parts, ","))]}"
}

// ---------- ordering ----------

fn comes_before(a: Diagnostic, b: Diagnostic) -> Bool {
if a.span.file != b.span.file {
return a.span.file < b.span.file
}
if a.span.line != b.span.line {
return a.span.line < b.span.line
}
a.span.col <= b.span.col
}

note "Stable merge sort by (file, line, column), matching the stage 0 order."
pub fn sort_diagnostics(items: List[Diagnostic]) -> List[Diagnostic] {
if length(items) <= 1 {
return items
}
let middle = length(items) / 2
let left = sort_diagnostics(slice(items, 0, middle))
let right = sort_diagnostics(slice(items, middle, length(items)))
var merged: List[Diagnostic] = []
var i = 0
var j = 0
while i < length(left) and j < length(right) {
if comes_before(left[i], right[j]) {
set merged = append(merged, left[i])
set i += 1
} else {
set merged = append(merged, right[j])
set j += 1
}
}
concat(concat(merged, slice(left, i, length(left))), slice(right, j, length(right)))
}

pub fn dedup_diagnostics(items: List[Diagnostic]) -> List[Diagnostic] {
var out: List[Diagnostic] = []
for d in items {
let count = length(out)
if count == 0 {
set out = append(out, d)
} else {
let previous = out[count - 1]
if not (previous.span == d.span and previous.code == d.code and previous.message == d.message) {
set out = append(out, d)
}
}
}
out
}
