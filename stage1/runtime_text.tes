note "Generated from runtime/ui.rs; do not edit by hand."
pub fn ui_runtime() -> Text {
let lines = [
"",
"// ---------------------------------------------------------------------------",
"// Tessera `ui` runtime: a minimal X11 client in safe Rust (Linux, local display).",
"// Speaks the X11 core protocol directly over the X server's Unix socket, so",
"// generated programs need no libraries. One window per program; drawing goes",
"// to an off-screen pixmap and becomes visible on `present()`.",
"// ---------------------------------------------------------------------------",
"",
"use std::cell::RefCell;",
"use std::collections::VecDeque;",
"use std::io::Read;",
"use std::os::unix::net::UnixStream;",
"",
"struct T_Ui {",
"    stream: UnixStream,",
"    out: Vec<u8>,",
"    seq: u16,",
"    id_base: u32,",
"    id_mask: u32,",
"    next_id: u32,",
"    window: u32,",
"    pixmap: u32,",
"    gc: u32,",
"    width: u16,",
"    height: u16,",
"    wm_delete: u32,",
"    events: VecDeque<Vec<u8>>,",
"    min_keycode: u8,",
"    keysyms_per_keycode: u8,",
"    keysyms: Vec<u32>,",
"    char_width: i64,",
"    font_ascent: i64,",
"    color: i64,",
"    line_width: i64,",
"}",
"",
"thread_local! {",
"    static T_UI: RefCell<Option<T_Ui>> = RefCell::new(None);",
"}",
"",
"fn t_ui_fail(message: String, loc: &str) -> ! {",
"    t_fail(\"R012\", message, loc)",
"}",
"",
"fn t_u16(b: &[u8], i: usize) -> u16 { u16::from_le_bytes([b[i], b[i + 1]]) }",
"fn t_i16(b: &[u8], i: usize) -> i16 { i16::from_le_bytes([b[i], b[i + 1]]) }",
"fn t_u32(b: &[u8], i: usize) -> u32 { u32::from_le_bytes([b[i], b[i + 1], b[i + 2], b[i + 3]]) }",
"fn t_put16(v: &mut Vec<u8>, x: u16) { v.extend_from_slice(&x.to_le_bytes()); }",
"fn t_put32(v: &mut Vec<u8>, x: u32) { v.extend_from_slice(&x.to_le_bytes()); }",
"fn t_pad4(v: &mut Vec<u8>) { while v.len() % 4 != 0 { v.push(0); } }",
"fn t_coord(v: i64) -> u16 { (v.clamp(-32768, 32767) as i16) as u16 }",
"fn t_size(v: i64) -> u16 { v.clamp(0, 65535) as u16 }",
"",
"fn t_read_exact(stream: &mut UnixStream, buf: &mut [u8], loc: &str) {",
"    if let Err(e) = stream.read_exact(buf) {",
"        t_ui_fail(format!(\"the connection to the X server was lost: {}\", e), loc)",
"    }",
"}",
"",
"fn t_x_authority(display_number: &str) -> (Vec<u8>, Vec<u8>) {",
"    let path = match std::env::var_os(\"XAUTHORITY\") {",
"        Some(p) => std::path::PathBuf::from(p),",
"        None => match std::env::var_os(\"HOME\") {",
"            Some(h) => std::path::Path::new(&h).join(\".Xauthority\"),",
"            None => return (Vec::new(), Vec::new()),",
"        },",
"    };",
"    let data = match std::fs::read(&path) { Ok(d) => d, Err(_) => return (Vec::new(), Vec::new()) };",
"    let hostname = std::fs::read_to_string(\"/proc/sys/kernel/hostname\").unwrap_or_default().trim().to_string();",
"    let mut pos = 0usize;",
"    let mut fallback: Option<(Vec<u8>, Vec<u8>)> = None;",
"    let read_field = |pos: &mut usize| -> Option<Vec<u8>> {",
"        if *pos + 2 > data.len() { return None; }",
"        let len = u16::from_be_bytes([data[*pos], data[*pos + 1]]) as usize;",
"        *pos += 2;",
"        if *pos + len > data.len() { return None; }",
"        let field = data[*pos..*pos + len].to_vec();",
"        *pos += len;",
"        Some(field)",
"    };",
"    while pos + 2 <= data.len() {",
"        let family = u16::from_be_bytes([data[pos], data[pos + 1]]);",
"        pos += 2;",
"        let (Some(address), Some(number), Some(name), Some(cookie)) =",
"            (read_field(&mut pos), read_field(&mut pos), read_field(&mut pos), read_field(&mut pos)) else { break };",
"        if name != b\"MIT-MAGIC-COOKIE-1\" { continue; }",
"        let number_matches = number.is_empty() || number == display_number.as_bytes();",
"        if !number_matches { continue; }",
"        if family == 65535 || (family == 256 && address == hostname.as_bytes()) {",
"            return (name, cookie);",
"        }",
"        if fallback.is_none() { fallback = Some((name, cookie)); }",
"    }",
"    fallback.unwrap_or((Vec::new(), Vec::new()))",
"}",
"",
"impl T_Ui {",
"    fn begin(&mut self, opcode: u8, data: u8) -> usize {",
"        let start = self.out.len();",
"        self.out.push(opcode);",
"        self.out.push(data);",
"        t_put16(&mut self.out, 0);",
"        start",
"    }",
"",
"    fn end(&mut self, start: usize) {",
"        t_pad4(&mut self.out);",
"        let words = ((self.out.len() - start) / 4) as u16;",
"        self.out[start + 2..start + 4].copy_from_slice(&words.to_le_bytes());",
"        self.seq = self.seq.wrapping_add(1);",
"    }",
"",
"    fn new_id(&mut self) -> u32 {",
"        let id = self.id_base | (self.next_id & self.id_mask);",
"        self.next_id += 1;",
"        id",
"    }",
"",
"    fn flush(&mut self, loc: &str) {",
"        if self.out.is_empty() { return; }",
"        use std::io::Write;",
"        if let Err(e) = self.stream.write_all(&self.out) {",
"            t_ui_fail(format!(\"the connection to the X server was lost: {}\", e), loc)",
"        }",
"        self.out.clear();",
"    }",
"",
"    fn read_packet(&mut self, loc: &str) -> Vec<u8> {",
"        let mut packet = vec![0u8; 32];",
"        t_read_exact(&mut self.stream, &mut packet, loc);",
"        if packet[0] == 1 {",
"            let extra = t_u32(&packet, 4) as usize * 4;",
"            let mut rest = vec![0u8; extra];",
"            t_read_exact(&mut self.stream, &mut rest, loc);",
"            packet.extend_from_slice(&rest);",
"        }",
"        packet",
"    }",
"",
"    /// Wait for the reply to the last request. Errors for requests sent at or",
"    /// after `first_seq` are returned as `Err(code)`; events are queued.",
"    fn reply_since(&mut self, first_seq: u16, loc: &str) -> Result<Vec<u8>, u8> {",
"        self.flush(loc);",
"        loop {",
"            let packet = self.read_packet(loc);",
"            match packet[0] {",
"                1 if t_u16(&packet, 2) == self.seq => return Ok(packet),",
"                1 => {}",
"                0 => {",
"                    let seq = t_u16(&packet, 2);",
"                    if seq.wrapping_sub(first_seq) <= self.seq.wrapping_sub(first_seq) {",
"                        return Err(packet[1]);",
"                    }",
"                    t_x_error(&packet, loc)",
"                }",
"                _ => self.events.push_back(packet),",
"            }",
"        }",
"    }",
"",
"    fn reply(&mut self, loc: &str) -> Vec<u8> {",
"        let first = self.seq;",
"        match self.reply_since(first, loc) {",
"            Ok(r) => r,",
"            Err(code) => t_ui_fail(format!(\"the X server reported error {}\", code), loc),",
"        }",
"    }",
"",
"    fn intern_atom(&mut self, name: &str, loc: &str) -> u32 {",
"        let start = self.begin(16, 0);",
"        t_put16(&mut self.out, name.len() as u16);",
"        t_put16(&mut self.out, 0);",
"        self.out.extend_from_slice(name.as_bytes());",
"        self.end(start);",
"        let r = self.reply(loc);",
"        t_u32(&r, 8)",
"    }",
"",
"    fn change_property(&mut self, property: u32, kind: u32, format: u8, data: &[u8]) {",
"        let start = self.begin(18, 0);",
"        t_put32(&mut self.out, self.window);",
"        t_put32(&mut self.out, property);",
"        t_put32(&mut self.out, kind);",
"        self.out.push(format);",
"        self.out.extend_from_slice(&[0, 0, 0]);",
"        t_put32(&mut self.out, (data.len() / (format as usize / 8)) as u32);",
"        self.out.extend_from_slice(data);",
"        self.end(start);",
"    }",
"",
"    fn set_gc(&mut self, color: i64, line_width: i64) {",
"        if color != self.color {",
"            let start = self.begin(56, 0);",
"            t_put32(&mut self.out, self.gc);",
"            t_put32(&mut self.out, 0x4);",
"            t_put32(&mut self.out, color as u32);",
"            self.end(start);",
"            self.color = color;",
"        }",
"        if line_width != self.line_width {",
"            let start = self.begin(56, 0);",
"            t_put32(&mut self.out, self.gc);",
"            t_put32(&mut self.out, 0x10);",
"            t_put32(&mut self.out, line_width.clamp(0, 65535) as u32);",
"            self.end(start);",
"            self.line_width = line_width;",
"        }",
"    }",
"",
"    /// Start a drawing request on the back buffer.",
"    fn draw_request(&mut self, opcode: u8) -> usize {",
"        let start = self.begin(opcode, 0);",
"        t_put32(&mut self.out, self.pixmap);",
"        t_put32(&mut self.out, self.gc);",
"        start",
"    }",
"",
"    fn present(&mut self, loc: &str) {",
"        let start = self.begin(62, 0);",
"        t_put32(&mut self.out, self.pixmap);",
"        t_put32(&mut self.out, self.window);",
"        t_put32(&mut self.out, self.gc);",
"        for _ in 0..4 { t_put16(&mut self.out, 0); }",
"        t_put16(&mut self.out, self.width);",
"        t_put16(&mut self.out, self.height);",
"        self.end(start);",
"        self.flush(loc);",
"    }",
"",
"    fn key_name(&self, keycode: u8, state: u16) -> Option<String> {",
"        if keycode < self.min_keycode || self.keysyms_per_keycode == 0 { return None; }",
"        let per = self.keysyms_per_keycode as usize;",
"        let base = (keycode - self.min_keycode) as usize * per;",
"        let shifted = state & 1 != 0 && per > 1 && self.keysyms.get(base + 1).map_or(false, |&k| k != 0);",
"        let keysym = *self.keysyms.get(if shifted { base + 1 } else { base })?;",
"        let name = match keysym {",
"            0x20..=0x7e => (keysym as u8 as char).to_string(),",
"            0xff1b => \"Escape\".into(),",
"            0xff0d | 0xff8d => \"Enter\".into(),",
"            0xff08 => \"Backspace\".into(),",
"            0xff09 => \"Tab\".into(),",
"            0xff51 => \"Left\".into(),",
"            0xff52 => \"Up\".into(),",
"            0xff53 => \"Right\".into(),",
"            0xff54 => \"Down\".into(),",
"            _ => return None,",
"        };",
"        Some(name)",
"    }",
"}",
"",
"fn t_x_error(packet: &[u8], loc: &str) -> ! {",
"    t_ui_fail(format!(\"the X server reported error {} for request {}\", packet[1], packet[10]), loc)",
"}",
"",
"fn t_with_ui<R>(loc: &str, f: impl FnOnce(&mut T_Ui) -> R) -> R {",
"    T_UI.with(|cell| {",
"        let mut slot = cell.borrow_mut();",
"        match slot.as_mut() {",
"            Some(ui) => f(ui),",
"            None => t_ui_fail(\"no window is open; call open_window first\".to_string(), loc),",
"        }",
"    })",
"}",
"",
"/// Connect and authenticate. Returns the connection, the root window, its depth and the keycode range.",
"fn t_ui_connect(width: i64, height: i64, loc: &str) -> (T_Ui, u32, u8, u8, u8) {",
"    let display = match std::env::var(\"DISPLAY\") {",
"        Ok(d) if !d.is_empty() => d,",
"        _ => t_ui_fail(\"cannot open a window: DISPLAY is not set (is a graphical X11 session running?)\".to_string(), loc),",
"    };",
"    let (host, rest) = match display.split_once(':') {",
"        Some(parts) => parts,",
"        None => t_ui_fail(format!(\"cannot parse DISPLAY `{}`\", display), loc),",
"    };",
"    if !host.is_empty() && host != \"unix\" {",
"        t_ui_fail(format!(\"only local X displays are supported (DISPLAY is `{}`)\", display), loc)",
"    }",
"    let number = rest.split('.').next().unwrap_or(\"0\").to_string();",
"    let mut stream = match UnixStream::connect(format!(\"/tmp/.X11-unix/X{}\", number)) {",
"        Ok(s) => s,",
"        Err(e) => t_ui_fail(format!(\"cannot connect to X display `{}`: {}\", display, e), loc),",
"    };",
"",
"    // Connection setup.",
"    let (auth_name, auth_data) = t_x_authority(&number);",
"    let mut setup = vec![b'l', 0];",
"    t_put16(&mut setup, 11);",
"    t_put16(&mut setup, 0);",
"    t_put16(&mut setup, auth_name.len() as u16);",
"    t_put16(&mut setup, auth_data.len() as u16);",
"    t_put16(&mut setup, 0);",
"    setup.extend_from_slice(&auth_name);",
"    t_pad4(&mut setup);",
"    setup.extend_from_slice(&auth_data);",
"    t_pad4(&mut setup);",
"    {",
"        use std::io::Write;",
"        if let Err(e) = stream.write_all(&setup) {",
"            t_ui_fail(format!(\"cannot talk to the X server: {}\", e), loc)",
"        }",
"    }",
"    let mut header = [0u8; 8];",
"    t_read_exact(&mut stream, &mut header, loc);",
"    let mut info = vec![0u8; t_u16(&header, 6) as usize * 4];",
"    t_read_exact(&mut stream, &mut info, loc);",
"    if header[0] != 1 {",
"        let reason_len = (header[1] as usize).min(info.len());",
"        let reason = String::from_utf8_lossy(&info[..reason_len]).trim().to_string();",
"        t_ui_fail(format!(\"the X server refused the connection: {}\", reason), loc)",
"    }",
"    let id_base = t_u32(&info, 4);",
"    let id_mask = t_u32(&info, 8);",
"    let vendor_len = t_u16(&info, 16) as usize;",
"    let formats = info[21] as usize;",
"    let min_keycode = info[26];",
"    let max_keycode = info[27];",
"    let screen = 32 + ((vendor_len + 3) / 4) * 4 + formats * 8;",
"    let root = t_u32(&info, screen);",
"    let root_depth = info[screen + 38];",
"    if root_depth != 24 && root_depth != 32 {",
"        t_ui_fail(format!(\"only 24-bit color displays are supported (this display has depth {})\", root_depth), loc)",
"    }",
"",
"    let ui = T_Ui {",
"        stream,",
"        out: Vec::new(),",
"        seq: 0,",
"        id_base,",
"        id_mask,",
"        next_id: 1,",
"        window: 0,",
"        pixmap: 0,",
"        gc: 0,",
"        width: width as u16,",
"        height: height as u16,",
"        wm_delete: 0,",
"        events: VecDeque::new(),",
"        min_keycode,",
"        keysyms_per_keycode: 0,",
"        keysyms: Vec::new(),",
"        char_width: 8,",
"        font_ascent: 12,",
"        color: 0,",
"        line_width: 1,",
"    };",
"    (ui, root, root_depth, min_keycode, max_keycode)",
"}",
"",
"fn t_open_window(title: Rc<String>, width: i64, height: i64, loc: &str) {",
"    if !(1..=4096).contains(&width) || !(1..=4096).contains(&height) {",
"        t_ui_fail(format!(\"window size {}x{} is outside 1..4096\", width, height), loc)",
"    }",
"    if T_UI.with(|cell| cell.borrow().is_some()) {",
"        t_ui_fail(\"a window is already open\".to_string(), loc)",
"    }",
"    let (mut ui, root, root_depth, min_keycode, max_keycode) = t_ui_connect(width, height, loc);",
"    let wm_protocols = ui.intern_atom(\"WM_PROTOCOLS\", loc);",
"    ui.wm_delete = ui.intern_atom(\"WM_DELETE_WINDOW\", loc);",
"    let net_wm_name = ui.intern_atom(\"_NET_WM_NAME\", loc);",
"    let utf8_string = ui.intern_atom(\"UTF8_STRING\", loc);",
"",
"    // Window: white background; key, button, exposure and structure events.",
"    ui.window = ui.new_id();",
"    let start = ui.begin(1, root_depth);",
"    t_put32(&mut ui.out, ui.window);",
"    t_put32(&mut ui.out, root);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, ui.width);",
"    t_put16(&mut ui.out, ui.height);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, 1);",
"    t_put32(&mut ui.out, 0);",
"    t_put32(&mut ui.out, 0x2 | 0x800);",
"    t_put32(&mut ui.out, 0xffffff);",
"    t_put32(&mut ui.out, 0x1 | 0x4 | 0x8000 | 0x20000);",
"    ui.end(start);",
"",
"    let latin1: Vec<u8> = title.chars().map(|c| if (c as u32) < 256 { c as u32 as u8 } else { b'?' }).collect();",
"    ui.change_property(39, 31, 8, &latin1);",
"    ui.change_property(net_wm_name, utf8_string, 8, title.as_bytes());",
"    ui.change_property(wm_protocols, 4, 32, &ui.wm_delete.to_le_bytes());",
"    let mut hints = vec![0u32; 18];",
"    hints[0] = 16 | 32;",
"    hints[5] = width as u32;",
"    hints[6] = height as u32;",
"    hints[7] = width as u32;",
"    hints[8] = height as u32;",
"    let hint_bytes: Vec<u8> = hints.iter().flat_map(|h| h.to_le_bytes()).collect();",
"    ui.change_property(40, 41, 32, &hint_bytes);",
"",
"    // Back buffer.",
"    ui.pixmap = ui.new_id();",
"    let start = ui.begin(53, root_depth);",
"    t_put32(&mut ui.out, ui.pixmap);",
"    t_put32(&mut ui.out, ui.window);",
"    t_put16(&mut ui.out, ui.width);",
"    t_put16(&mut ui.out, ui.height);",
"    ui.end(start);",
"",
"    // Font: the first one the server knows.",
"    let mut font = 0u32;",
"    for name in [\"-misc-fixed-bold-r-normal--18-120-100-100-c-90-iso8859-1\", \"-misc-fixed-bold-r-normal--15-140-75-75-c-90-iso8859-1\", \"9x15bold\", \"9x15\", \"fixed\"] {",
"        let candidate = ui.new_id();",
"        let first = ui.seq.wrapping_add(1);",
"        let start = ui.begin(45, 0);",
"        t_put32(&mut ui.out, candidate);",
"        t_put16(&mut ui.out, name.len() as u16);",
"        t_put16(&mut ui.out, 0);",
"        ui.out.extend_from_slice(name.as_bytes());",
"        ui.end(start);",
"        let start = ui.begin(47, 0);",
"        t_put32(&mut ui.out, candidate);",
"        ui.end(start);",
"        if let Ok(r) = ui.reply_since(first, loc) {",
"            font = candidate;",
"            ui.char_width = t_i16(&r, 28).max(1) as i64;",
"            ui.font_ascent = t_i16(&r, 52) as i64;",
"            break;",
"        }",
"    }",
"",
"    // Graphics context: foreground, line width, round caps and joins, font, no exposure events.",
"    ui.gc = ui.new_id();",
"    let start = ui.begin(55, 0);",
"    t_put32(&mut ui.out, ui.gc);",
"    t_put32(&mut ui.out, ui.pixmap);",
"    let mut mask = 0x4 | 0x10 | 0x40 | 0x80 | 0x10000;",
"    if font != 0 { mask |= 0x4000; }",
"    t_put32(&mut ui.out, mask);",
"    t_put32(&mut ui.out, 0);",
"    t_put32(&mut ui.out, 1);",
"    t_put32(&mut ui.out, 2);",
"    t_put32(&mut ui.out, 1);",
"    if font != 0 { t_put32(&mut ui.out, font); }",
"    t_put32(&mut ui.out, 0);",
"    ui.end(start);",
"",
"    // Clear the back buffer, show the window.",
"    ui.set_gc(0xffffff, 1);",
"    let start = ui.draw_request(70);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, ui.width);",
"    t_put16(&mut ui.out, ui.height);",
"    ui.end(start);",
"    let start = ui.begin(8, 0);",
"    t_put32(&mut ui.out, ui.window);",
"    ui.end(start);",
"",
"    // Keyboard mapping, for key names.",
"    let start = ui.begin(101, 0);",
"    ui.out.push(min_keycode);",
"    ui.out.push(max_keycode.wrapping_sub(min_keycode).wrapping_add(1));",
"    t_put16(&mut ui.out, 0);",
"    ui.end(start);",
"    let r = ui.reply(loc);",
"    ui.keysyms_per_keycode = r[1];",
"    ui.keysyms = r[32..].chunks_exact(4).map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]])).collect();",
"",
"    T_UI.with(|cell| *cell.borrow_mut() = Some(ui));",
"}",
"",
"fn t_fill_rectangle(x: i64, y: i64, width: i64, height: i64, color: i64, loc: &str) {",
"    if width <= 0 || height <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, ui.line_width);",
"        let start = ui.draw_request(70);",
"        t_put16(&mut ui.out, t_coord(x));",
"        t_put16(&mut ui.out, t_coord(y));",
"        t_put16(&mut ui.out, t_size(width));",
"        t_put16(&mut ui.out, t_size(height));",
"        ui.end(start);",
"    })",
"}",
"",
"fn t_draw_line(x1: i64, y1: i64, x2: i64, y2: i64, thickness: i64, color: i64, loc: &str) {",
"    if thickness <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, thickness);",
"        let start = ui.draw_request(66);",
"        for v in [x1, y1, x2, y2] { t_put16(&mut ui.out, t_coord(v)); }",
"        ui.end(start);",
"    })",
"}",
"",
"fn t_arc(opcode: u8, center_x: i64, center_y: i64, radius: i64, thickness: i64, color: i64, loc: &str) {",
"    if radius <= 0 || thickness <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, thickness);",
"        let start = ui.draw_request(opcode);",
"        t_put16(&mut ui.out, t_coord(center_x - radius));",
"        t_put16(&mut ui.out, t_coord(center_y - radius));",
"        t_put16(&mut ui.out, t_size(radius * 2));",
"        t_put16(&mut ui.out, t_size(radius * 2));",
"        t_put16(&mut ui.out, 0);",
"        t_put16(&mut ui.out, (360 * 64) as u16);",
"        ui.end(start);",
"    })",
"}",
"",
"fn t_draw_circle(center_x: i64, center_y: i64, radius: i64, thickness: i64, color: i64, loc: &str) {",
"    t_arc(68, center_x, center_y, radius, thickness, color, loc)",
"}",
"",
"fn t_fill_circle(center_x: i64, center_y: i64, radius: i64, color: i64, loc: &str) {",
"    t_arc(71, center_x, center_y, radius, 1, color, loc)",
"}",
"",
"fn t_draw_text(x: i64, y: i64, text: Rc<String>, color: i64, loc: &str) {",
"    let bytes: Vec<u8> = text.chars().map(|c| if (c as u32) >= 32 && (c as u32) < 256 { c as u32 as u8 } else { b'?' }).collect();",
"    if bytes.is_empty() { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, ui.line_width);",
"        let start = ui.draw_request(74);",
"        t_put16(&mut ui.out, t_coord(x));",
"        t_put16(&mut ui.out, t_coord(y + ui.font_ascent));",
"        for chunk in bytes.chunks(254) {",
"            ui.out.push(chunk.len() as u8);",
"            ui.out.push(0);",
"            ui.out.extend_from_slice(chunk);",
"        }",
"        ui.end(start);",
"    })",
"}",
"",
"fn t_text_width(text: Rc<String>, loc: &str) -> i64 {",
"    t_with_ui(loc, |ui| ui.char_width * text.chars().count() as i64)",
"}",
"",
"fn t_present(loc: &str) {",
"    t_with_ui(loc, |ui| ui.present(loc))",
"}",
"",
"fn t_next_event(loc: &str) -> Rc<T_WindowEvent> {",
"    t_with_ui(loc, |ui| {",
"        ui.flush(loc);",
"        loop {",
"            let packet = match ui.events.pop_front() {",
"                Some(p) => p,",
"                None => ui.read_packet(loc),",
"            };",
"            match packet[0] & 0x7f {",
"                0 => t_x_error(&packet, loc),",
"                12 => {",
"                    // Expose: the back buffer still holds the picture.",
"                    if t_u16(&packet, 16) == 0 { ui.present(loc); }",
"                }",
"                4 => {",
"                    let x = t_i16(&packet, 24) as i64;",
"                    let y = t_i16(&packet, 26) as i64;",
"                    return Rc::new(T_WindowEvent::V_Click(x, y, packet[1] as i64));",
"                }",
"                2 => {",
"                    if let Some(name) = ui.key_name(packet[1], t_u16(&packet, 28)) {",
"                        return Rc::new(T_WindowEvent::V_Key(Rc::new(name)));",
"                    }",
"                }",
"                33 => {",
"                    if t_u32(&packet, 12) == ui.wm_delete {",
"                        return Rc::new(T_WindowEvent::V_Close);",
"                    }",
"                }",
"                _ => {}",
"            }",
"        }",
"    })",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/extra.rs; do not edit by hand."
pub fn extra_runtime() -> Text {
let lines = [
"",
"// ---- Stage 1 runtime additions (draft 0.13). Not used by stage 0; may refer to types the stage 1",
"// code generator always emits (`T_FileError`). Safe Rust only, like the rest of the runtime.",
"",
"// Text",
"fn t_trim(t: &Rc<String>) -> Rc<String> { Rc::new(t.trim().to_string()) }",
"fn t_starts_with(t: &Rc<String>, part: &Rc<String>) -> bool { t.starts_with(part.as_str()) }",
"fn t_ends_with(t: &Rc<String>, part: &Rc<String>) -> bool { t.ends_with(part.as_str()) }",
"fn t_replace(t: &Rc<String>, old: &Rc<String>, new: &Rc<String>) -> Rc<String> {",
"    if old.is_empty() { return t.clone(); }",
"    let out = t.replace(old.as_str(), new.as_str());",
"    t_charge(out.len());",
"    Rc::new(out)",
"}",
"fn t_slice_text(t: Rc<String>, start: i64, end: i64, loc: &str) -> Rc<String> {",
"    let count = t.chars().count() as i64;",
"    if start < 0 || end < start || end > count {",
"        t_fail(\"R004\", format!(\"invalid slice_text {}..{} of a text of length {}\", start, end, count), loc)",
"    }",
"    Rc::new(t.chars().skip(start as usize).take((end - start) as usize).collect())",
"}",
"fn t_repeat(t: Rc<String>, times: i64, loc: &str) -> Rc<String> {",
"    if times < 0 { t_fail(\"R004\", format!(\"repeat count {} is negative\", times), loc) }",
"    t_charge(t.len().saturating_mul(times as usize));",
"    Rc::new(t.repeat(times as usize))",
"}",
"fn t_pad(t: &Rc<String>, width: i64, fill: &Rc<String>, left: bool, loc: &str) -> Rc<String> {",
"    let mut chars = fill.chars();",
"    let fill_char = match (chars.next(), chars.next()) {",
"        (Some(c), None) => c,",
"        _ => t_fail(\"R004\", format!(\"the fill text must be exactly one character, found {:?}\", fill.as_str()), loc),",
"    };",
"    let count = t.chars().count() as i64;",
"    if count >= width { return t.clone(); }",
"    let padding: String = std::iter::repeat(fill_char).take((width - count) as usize).collect();",
"    t_charge(padding.len());",
"    Rc::new(if left { padding + t.as_str() } else { t.to_string() + &padding })",
"}",
"fn t_pad_left(t: Rc<String>, width: i64, fill: Rc<String>, loc: &str) -> Rc<String> { t_pad(&t, width, &fill, true, loc) }",
"fn t_pad_right(t: Rc<String>, width: i64, fill: Rc<String>, loc: &str) -> Rc<String> { t_pad(&t, width, &fill, false, loc) }",
"fn t_lines(t: &Rc<String>) -> Rc<Vec<Rc<String>>> {",
"    Rc::new(t.lines().map(|line| Rc::new(line.to_string())).collect())",
"}",
"",
"// Standard input",
"fn t_read_line(loc: &str) -> Option<Rc<String>> {",
"    let _ = std::io::stdout().flush();",
"    let mut buffer = Vec::new();",
"    let mut input = std::io::stdin().lock();",
"    match std::io::BufRead::read_until(&mut input, b'\\n', &mut buffer) {",
"        Ok(0) => None,",
"        Ok(_) => {",
"            if buffer.last() == Some(&b'\\n') { buffer.pop(); }",
"            if buffer.last() == Some(&b'\\r') { buffer.pop(); }",
"            match String::from_utf8(buffer) {",
"                Ok(s) => Some(Rc::new(s)),",
"                Err(_) => t_fail(\"R008\", \"standard input is not valid UTF-8\".to_string(), loc),",
"            }",
"        }",
"        Err(e) => t_fail(\"R006\", format!(\"cannot read standard input: {}\", e), loc),",
"    }",
"}",
"fn t_read_input(loc: &str) -> Rc<String> {",
"    let _ = std::io::stdout().flush();",
"    let mut buffer = Vec::new();",
"    if let Err(e) = std::io::Read::read_to_end(&mut std::io::stdin().lock(), &mut buffer) {",
"        t_fail(\"R006\", format!(\"cannot read standard input: {}\", e), loc)",
"    }",
"    t_charge(buffer.len());",
"    match String::from_utf8(buffer) {",
"        Ok(s) => Rc::new(s),",
"        Err(_) => t_fail(\"R008\", \"standard input is not valid UTF-8\".to_string(), loc),",
"    }",
"}",
"",
"// Files, with failures as values",
"fn t_file_error(e: std::io::Error) -> Rc<T_FileError> {",
"    Rc::new(match e.kind() {",
"        std::io::ErrorKind::NotFound => T_FileError::V_NotFound,",
"        std::io::ErrorKind::PermissionDenied => T_FileError::V_PermissionDenied,",
"        _ => T_FileError::V_Other(Rc::new(e.to_string())),",
"    })",
"}",
"fn t_read_text(path: Rc<String>, loc: &str) -> Result<Rc<String>, Rc<T_FileError>> {",
"    match std::fs::read(t_check_path(&path, loc)) {",
"        Ok(bytes) => {",
"            t_charge(bytes.len());",
"            match String::from_utf8(bytes) {",
"                Ok(s) => Ok(Rc::new(s)),",
"                Err(_) => Err(Rc::new(T_FileError::V_Other(Rc::new(format!(\"`{}` is not valid UTF-8 text\", path))))),",
"            }",
"        }",
"        Err(e) => Err(t_file_error(e)),",
"    }",
"}",
"fn t_write_text(path: Rc<String>, content: Rc<String>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    std::fs::write(t_check_path(&path, loc), content.as_bytes()).map_err(t_file_error)",
"}",
"fn t_read_bytes(path: Rc<String>, loc: &str) -> Result<Rc<Vec<u8>>, Rc<T_FileError>> {",
"    match std::fs::read(t_check_path(&path, loc)) {",
"        Ok(bytes) => { t_charge(bytes.len()); Ok(Rc::new(bytes)) }",
"        Err(e) => Err(t_file_error(e)),",
"    }",
"}",
"fn t_write_bytes(path: Rc<String>, data: Rc<Vec<u8>>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    std::fs::write(t_check_path(&path, loc), data.as_slice()).map_err(t_file_error)",
"}",
"fn t_list_directory(path: Rc<String>, loc: &str) -> Result<Rc<Vec<Rc<String>>>, Rc<T_FileError>> {",
"    let entries = std::fs::read_dir(t_check_path(&path, loc)).map_err(t_file_error)?;",
"    let mut names = Vec::new();",
"    for entry in entries {",
"        let entry = entry.map_err(t_file_error)?;",
"        names.push(Rc::new(entry.file_name().to_string_lossy().to_string()));",
"    }",
"    names.sort();",
"    Ok(Rc::new(names))",
"}",
"fn t_create_directory(path: Rc<String>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    std::fs::create_dir_all(t_check_path(&path, loc)).map_err(t_file_error)",
"}",
"fn t_remove_file(path: Rc<String>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    std::fs::remove_file(t_check_path(&path, loc)).map_err(t_file_error)",
"}",
"",
"// Logging: standard error, which hosts route to their error log.",
"fn t_log(level: Rc<String>, message: Rc<String>) {",
"    let _ = std::io::stdout().flush();",
"    eprintln!(\"[{}] {}\", level, message);",
"}",
"",
"// Maps (sorted by key, so output does not depend on hashing)",
"type TMap<K, V> = Rc<std::collections::BTreeMap<K, V>>;",
"fn t_map_new<K: Ord, V>(pairs: Vec<(K, V)>) -> TMap<K, V> { Rc::new(pairs.into_iter().collect()) }",
"fn t_map_get<K: Ord, V: Clone>(m: &TMap<K, V>, key: &K) -> Option<V> { m.get(key).cloned() }",
"fn t_map_put<K: Ord + Clone, V: Clone>(mut m: TMap<K, V>, key: K, value: V) -> TMap<K, V> {",
"    t_charge(std::mem::size_of::<K>() + std::mem::size_of::<V>());",
"    Rc::make_mut(&mut m).insert(key, value);",
"    m",
"}",
"fn t_map_remove<K: Ord + Clone, V: Clone>(mut m: TMap<K, V>, key: &K) -> TMap<K, V> {",
"    if m.contains_key(key) { Rc::make_mut(&mut m).remove(key); }",
"    m",
"}",
"fn t_map_keys<K: Ord + Clone, V>(m: &TMap<K, V>) -> Rc<Vec<K>> { Rc::new(m.keys().cloned().collect()) }",
"fn t_map_values<K: Ord, V: Clone>(m: &TMap<K, V>) -> Rc<Vec<V>> { Rc::new(m.values().cloned().collect()) }",
"fn t_map_length<K, V>(m: &TMap<K, V>) -> i64 { m.len() as i64 }",
"fn t_map_contains<K: Ord, V>(m: &TMap<K, V>, key: &K) -> bool { m.contains_key(key) }",
"",
"// Bytes",
"fn t_to_bytes(t: &Rc<String>) -> Rc<Vec<u8>> { Rc::new(t.as_bytes().to_vec()) }",
"fn t_from_bytes(b: &Rc<Vec<u8>>) -> Option<Rc<String>> { String::from_utf8(b.to_vec()).ok().map(Rc::new) }",
"fn t_bytes(values: Rc<Vec<i64>>, loc: &str) -> Rc<Vec<u8>> {",
"    let mut out = Vec::with_capacity(values.len());",
"    for &v in values.iter() {",
"        if !(0..=255).contains(&v) { t_fail(\"R018\", format!(\"byte value {} is outside 0..255\", v), loc) }",
"        out.push(v as u8);",
"    }",
"    Rc::new(out)",
"}",
"fn t_byte_values(b: &Rc<Vec<u8>>) -> Rc<Vec<i64>> { Rc::new(b.iter().map(|&x| x as i64).collect()) }",
"fn t_bytes_index(b: &Rc<Vec<u8>>, i: i64, loc: &str) -> i64 {",
"    if i < 0 || (i as u64) >= (b.len() as u64) {",
"        t_fail(\"R001\", format!(\"index {} is out of bounds for bytes of length {}\", i, b.len()), loc)",
"    }",
"    b[i as usize] as i64",
"}",
"",
"// Changing part of a variable (draft 0.14): `set xs[i] = v`, `set r.field = v`. `Rc::make_mut` copies",
"// a list or record only when another value still shares it, so the change is never observable elsewhere.",
"fn t_slot<'a, T: Clone>(l: &'a mut Rc<Vec<T>>, i: i64, loc: &str) -> &'a mut T {",
"    if i < 0 || (i as u64) >= (l.len() as u64) {",
"        t_fail(\"R001\", format!(\"list index {} is out of bounds for a list of length {}\", i, l.len()), loc)",
"    }",
"    if Rc::strong_count(l) > 1 { t_charge(l.len() * std::mem::size_of::<T>()); }",
"    &mut Rc::make_mut(l)[i as usize]",
"}",
"fn t_set_byte(b: &mut Rc<Vec<u8>>, i: i64, v: i64, loc: &str) {",
"    if i < 0 || (i as u64) >= (b.len() as u64) {",
"        t_fail(\"R001\", format!(\"index {} is out of bounds for bytes of length {}\", i, b.len()), loc)",
"    }",
"    if !(0..=255).contains(&v) { t_fail(\"R018\", format!(\"byte value {} is outside 0..255\", v), loc) }",
"    if Rc::strong_count(b) > 1 { t_charge(b.len()); }",
"    Rc::make_mut(b)[i as usize] = v as u8;",
"}",
"fn t_repeat_list<T: Clone>(l: Rc<Vec<T>>, times: i64, loc: &str) -> Rc<Vec<T>> {",
"    if times < 0 { t_fail(\"R004\", format!(\"repeat count {} is negative\", times), loc) }",
"    let total = l.len().saturating_mul(times as usize);",
"    t_charge(total.saturating_mul(std::mem::size_of::<T>()));",
"    let mut out = Vec::with_capacity(total);",
"    for _ in 0..times { out.extend(l.iter().cloned()); }",
"    Rc::new(out)",
"}",
"",
"// Bit operations (draft 0.14). Shifts never lose bits silently: `shift_left` is R002 when the",
"// result does not fit, like `*`; `shift_right` is arithmetic (rounds toward negative infinity).",
"fn t_shift_amount(n: i64, loc: &str) -> u32 {",
"    if !(0..=63).contains(&n) { t_fail(\"R020\", format!(\"shift amount {} is outside 0..63\", n), loc) }",
"    n as u32",
"}",
"fn t_shift_left(a: i64, n: i64, loc: &str) -> i64 {",
"    let n = t_shift_amount(n, loc);",
"    let r = a << n;",
"    if (r >> n) != a { t_fail(\"R002\", format!(\"shift_left({}, {}) does not fit in Int\", a, n), loc) }",
"    r",
"}",
"fn t_shift_right(a: i64, n: i64, loc: &str) -> i64 { a >> t_shift_amount(n, loc) }",
"",
"// Functions as values",
"fn t_map_list<A: Clone, B>(l: Rc<Vec<A>>, f: fn(A) -> B) -> Rc<Vec<B>> {",
"    t_charge(l.len() * std::mem::size_of::<B>());",
"    Rc::new(l.iter().cloned().map(f).collect())",
"}",
"fn t_filter<A: Clone>(l: Rc<Vec<A>>, f: fn(A) -> bool) -> Rc<Vec<A>> {",
"    Rc::new(l.iter().cloned().filter(|x| f(x.clone())).collect())",
"}",
"fn t_sort_by<A: Clone, K: Ord>(mut l: Rc<Vec<A>>, f: fn(A) -> K) -> Rc<Vec<A>> {",
"    Rc::make_mut(&mut l).sort_by_key(|x| f(x.clone()));",
"    l",
"}",
"",
"// Tests",
"fn t_assert(condition: bool, loc: &str) {",
"    if !condition { t_fail(\"R019\", \"assertion failed\".to_string(), loc) }",
"}",
"fn t_run_tests(tests: &[(&str, fn())]) {",
"    t_install_panic_hook();",
"    let mut failed = 0;",
"    for (name, test) in tests.iter() {",
"        let test = *test;",
"        let outcome = std::thread::Builder::new().stack_size(64 * 1024 * 1024).spawn(move || {",
"            t_limits_begin(64 * 1024 * 1024, 10_000, 0);",
"            test();",
"        });",
"        let result = match outcome { Ok(handle) => handle.join(), Err(_) => { eprintln!(\"runtime error R000: could not start a test thread\"); std::process::exit(70) } };",
"        match result {",
"            Ok(()) => println!(\"ok      {}\", name),",
"            Err(payload) => {",
"                failed += 1;",
"                if let Some(f) = payload.downcast_ref::<TFailure>() {",
"                    println!(\"FAILED  {}\\n        runtime error {}: {}\\n        at {}\", name, f.code, f.message, f.location);",
"                } else if payload.downcast_ref::<TExit>().is_some() {",
"                    println!(\"FAILED  {}\\n        the test called exit\", name);",
"                } else {",
"                    println!(\"FAILED  {}\", name);",
"                }",
"            }",
"        }",
"    }",
"    println!(\"{} passed, {} failed\", tests.len() - failed, failed);",
"    let _ = std::io::stdout().flush();",
"    std::process::exit(if failed == 0 { 0 } else { 1 });",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/web.rs; do not edit by hand."
pub fn web_runtime() -> Text {
let lines = [
"",
"// ---------------------------------------------------------------------------",
"// Tessera `web` runtime: decimals, time, randomness, crypto and encodings,",
"// SQLite (through the sqlite3 command-line program), a plain-HTTP client and",
"// the web hosts (HTTP/1.1 server, FastCGI responder, CGI, a binary library",
"// protocol and a one-shot \"request\" test host).",
"// Pasted at top level after core.rs. Safe Rust and std only; every item is",
"// prefixed `tw_` / `TW_` (or is `TDecimal`, `TDatabase`, `RawRequest`,",
"// `RawResponse`) so it cannot clash with core.rs or generated code. No plain",
"// `use` of names: only `as _` trait imports, which can never clash.",
"// ---------------------------------------------------------------------------",
"",
"use std::io::Read as _;",
"use std::io::BufRead as _;",
"",
"// ===========================================================================",
"// 1. Decimal: fixed point with exactly 9 decimal places (value * 10^9 in i128)",
"// ===========================================================================",
"",
"#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]",
"pub struct TDecimal(pub i128);",
"",
"const TW_DEC_SCALE: i128 = 1_000_000_000;",
"const TW_LO64: u128 = 0xFFFF_FFFF_FFFF_FFFF;",
"",
"/// Full 128 x 128 -> 256 bit unsigned product, returned as (high, low).",
"fn tw_mul_wide(a: u128, b: u128) -> (u128, u128) {",
"    let (a1, a0) = (a >> 64, a & TW_LO64);",
"    let (b1, b0) = (b >> 64, b & TW_LO64);",
"    let p00 = a0 * b0;",
"    let p01 = a0 * b1;",
"    let p10 = a1 * b0;",
"    let p11 = a1 * b1;",
"    let mid = (p00 >> 64) + (p01 & TW_LO64) + (p10 & TW_LO64);",
"    let lo = (p00 & TW_LO64) | (mid << 64);",
"    let hi = p11 + (p01 >> 64) + (p10 >> 64) + (mid >> 64);",
"    (hi, lo)",
"}",
"",
"/// 256-bit (hi, lo) divided by d < 2^64: (quotient hi, quotient lo, remainder).",
"fn tw_div_wide_small(hi: u128, lo: u128, d: u128) -> (u128, u128, u128) {",
"    let limbs = [hi >> 64, hi & TW_LO64, lo >> 64, lo & TW_LO64];",
"    let mut q = [0u128; 4];",
"    let mut r = 0u128;",
"    for i in 0..4 {",
"        let cur = (r << 64) | limbs[i];",
"        q[i] = cur / d;",
"        r = cur % d;",
"    }",
"    ((q[0] << 64) | q[1], (q[2] << 64) | q[3], r)",
"}",
"",
"/// 256-bit (hi, lo) divided by 0 < d <= 2^127: (quotient hi, quotient lo, remainder).",
"fn tw_div_wide(hi: u128, lo: u128, d: u128) -> (u128, u128, u128) {",
"    if hi == 0 { return (0, lo / d, lo % d); }",
"    let (mut qh, mut ql, mut r) = (0u128, 0u128, 0u128);",
"    for i in (0..256u32).rev() {",
"        let bit = if i >= 128 { (hi >> (i - 128)) & 1 } else { (lo >> i) & 1 };",
"        r = (r << 1) | bit; // r < d <= 2^127, so this cannot overflow",
"        qh = (qh << 1) | (ql >> 127);",
"        ql <<= 1;",
"        if r >= d { r -= d; ql |= 1; }",
"    }",
"    (qh, ql, r)",
"}",
"",
"fn tw_wide_inc(hi: u128, lo: u128) -> (u128, u128) {",
"    let (l, carry) = lo.overflowing_add(1);",
"    (hi.wrapping_add(carry as u128), l)",
"}",
"",
"fn tw_dec_pack(neg: bool, hi: u128, lo: u128) -> Option<TDecimal> {",
"    if hi != 0 { return None; }",
"    if neg {",
"        if lo > (1u128 << 127) { return None; }",
"        Some(TDecimal((lo as i128).wrapping_neg()))",
"    } else {",
"        if lo > i128::MAX as u128 { return None; }",
"        Some(TDecimal(lo as i128))",
"    }",
"}",
"",
"fn tw_dec_overflow(op: &str, a: TDecimal, b: TDecimal, loc: &str) -> ! {",
"    t_fail(\"R002\", format!(\"decimal overflow: {} {} {}\", tw_dec_to_text(a), op, tw_dec_to_text(b)), loc)",
"}",
"",
"fn tw_dec_add(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    match a.0.checked_add(b.0) { Some(v) => TDecimal(v), None => tw_dec_overflow(\"+\", a, b, loc) }",
"}",
"fn tw_dec_sub(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    match a.0.checked_sub(b.0) { Some(v) => TDecimal(v), None => tw_dec_overflow(\"-\", a, b, loc) }",
"}",
"fn tw_dec_mul(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    let neg = (a.0 < 0) != (b.0 < 0);",
"    let (hi, lo) = tw_mul_wide(a.0.unsigned_abs(), b.0.unsigned_abs());",
"    let (mut qh, mut ql, r) = tw_div_wide_small(hi, lo, TW_DEC_SCALE as u128);",
"    if r * 2 >= TW_DEC_SCALE as u128 { (qh, ql) = tw_wide_inc(qh, ql); }",
"    match tw_dec_pack(neg, qh, ql) { Some(d) => d, None => tw_dec_overflow(\"*\", a, b, loc) }",
"}",
"fn tw_dec_div(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    if b.0 == 0 { t_fail(\"R003\", format!(\"division by zero: {} / 0\", tw_dec_to_text(a)), loc) }",
"    let neg = (a.0 < 0) != (b.0 < 0);",
"    let d = b.0.unsigned_abs();",
"    let (hi, lo) = tw_mul_wide(a.0.unsigned_abs(), TW_DEC_SCALE as u128);",
"    let (mut qh, mut ql, r) = tw_div_wide(hi, lo, d);",
"    if r >= d - r { (qh, ql) = tw_wide_inc(qh, ql); } // 2r >= d: round half away from zero",
"    match tw_dec_pack(neg, qh, ql) { Some(v) => v, None => tw_dec_overflow(\"/\", a, b, loc) }",
"}",
"fn tw_dec_neg(a: TDecimal, loc: &str) -> TDecimal {",
"    match a.0.checked_neg() {",
"        Some(v) => TDecimal(v),",
"        None => t_fail(\"R002\", format!(\"decimal overflow: -({})\", tw_dec_to_text(a)), loc),",
"    }",
"}",
"fn tw_dec_from_int(n: i64) -> TDecimal { TDecimal(n as i128 * TW_DEC_SCALE) }",
"fn tw_dec_to_int(d: TDecimal, loc: &str) -> i64 {",
"    match i64::try_from(d.0 / TW_DEC_SCALE) {",
"        Ok(v) => v,",
"        Err(_) => t_fail(\"R002\", format!(\"decimal {} does not fit in an Int\", tw_dec_to_text(d)), loc),",
"    }",
"}",
"fn tw_dec_round(d: TDecimal, places: i64, loc: &str) -> TDecimal {",
"    if !(0..=9).contains(&places) { t_fail(\"R004\", format!(\"round: places {} is outside 0..9\", places), loc) }",
"    if places == 9 { return d; }",
"    let f = 10i128.pow((9 - places) as u32);",
"    let mut q = d.0 / f;",
"    let r = d.0 % f;",
"    if r.unsigned_abs() * 2 >= f as u128 { q += d.0.signum(); }",
"    match q.checked_mul(f) {",
"        Some(v) => TDecimal(v),",
"        None => t_fail(\"R002\", format!(\"decimal overflow: round({}, {})\", tw_dec_to_text(d), places), loc),",
"    }",
"}",
"fn tw_dec_to_text(d: TDecimal) -> Rc<String> {",
"    let m = d.0.unsigned_abs();",
"    let ip = m / TW_DEC_SCALE as u128;",
"    let fp = m % TW_DEC_SCALE as u128;",
"    let mut s = String::new();",
"    if d.0 < 0 { s.push('-'); }",
"    s.push_str(&ip.to_string());",
"    if fp != 0 {",
"        let f = format!(\"{:09}\", fp);",
"        s.push('.');",
"        s.push_str(f.trim_end_matches('0'));",
"    }",
"    Rc::new(s)",
"}",
"fn tw_dec_parse(text: Rc<String>) -> Option<TDecimal> {",
"    let b = text.as_bytes();",
"    let mut i = 0;",
"    let neg = b.first() == Some(&b'-');",
"    if neg { i = 1; }",
"    let start = i;",
"    let mut ip: u128 = 0;",
"    while i < b.len() && b[i].is_ascii_digit() {",
"        ip = ip.checked_mul(10)?.checked_add((b[i] - b'0') as u128)?;",
"        i += 1;",
"    }",
"    if i == start { return None; }",
"    let mut fp: u128 = 0;",
"    if i < b.len() {",
"        if b[i] != b'.' { return None; }",
"        i += 1;",
"        let fs = i;",
"        while i < b.len() && b[i].is_ascii_digit() {",
"            fp = fp * 10 + (b[i] - b'0') as u128;",
"            i += 1;",
"        }",
"        let n = i - fs;",
"        if n == 0 || n > 9 || i != b.len() { return None; }",
"        fp *= 10u128.pow((9 - n) as u32);",
"    }",
"    let mag = ip.checked_mul(TW_DEC_SCALE as u128)?.checked_add(fp)?;",
"    tw_dec_pack(neg, 0, mag)",
"}",
"",
"// ===========================================================================",
"// 2. Time: Unix time in milliseconds (i64), proleptic Gregorian calendar, UTC",
"// ===========================================================================",
"",
"fn tw_now_ms() -> i64 {",
"    match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {",
"        Ok(d) => i64::try_from(d.as_millis()).unwrap_or(i64::MAX),",
"        Err(e) => {",
"            let d = e.duration();",
"            let ms = i64::try_from(d.as_millis()).unwrap_or(i64::MAX - 1);",
"            if d.subsec_nanos() % 1_000_000 != 0 { -ms - 1 } else { -ms }",
"        }",
"    }",
"}",
"static TW_MONO_START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();",
"fn tw_monotonic_ms() -> i64 {",
"    let start = TW_MONO_START.get_or_init(std::time::Instant::now);",
"    i64::try_from(start.elapsed().as_millis()).unwrap_or(i64::MAX)",
"}",
"fn tw_sleep_ms(ms: i64, loc: &str) {",
"    if ms < 0 { t_fail(\"R004\", format!(\"sleep: {} milliseconds is negative\", ms), loc) }",
"    std::thread::sleep(std::time::Duration::from_millis(ms as u64));",
"}",
"",
"/// Howard Hinnant's civil_from_days: days since 1970-01-01 -> (year, month, day).",
"fn tw_civil_from_days(days: i64) -> (i64, i64, i64) {",
"    let z = days + 719_468;",
"    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;",
"    let doe = z - era * 146_097;",
"    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;",
"    let y = yoe + era * 400;",
"    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);",
"    let mp = (5 * doy + 2) / 153;",
"    let d = doy - (153 * mp + 2) / 5 + 1;",
"    let m = if mp < 10 { mp + 3 } else { mp - 9 };",
"    (if m <= 2 { y + 1 } else { y }, m, d)",
"}",
"/// Howard Hinnant's days_from_civil.",
"fn tw_days_from_civil(y: i64, m: i64, d: i64) -> i64 {",
"    let y = if m <= 2 { y - 1 } else { y };",
"    let era = if y >= 0 { y } else { y - 399 } / 400;",
"    let yoe = y - era * 400;",
"    let doy = (153 * (if m > 2 { m - 3 } else { m + 9 }) + 2) / 5 + d - 1;",
"    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;",
"    era * 146_097 + doe - 719_468",
"}",
"fn tw_is_leap(y: i64) -> bool { (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }",
"fn tw_days_in_month(y: i64, m: i64) -> i64 {",
"    match m { 1 | 3 | 5 | 7 | 8 | 10 | 12 => 31, 4 | 6 | 9 | 11 => 30, _ => if tw_is_leap(y) { 29 } else { 28 } }",
"}",
"fn tw_year_text(y: i64) -> String {",
"    // RFC 3339 only covers years 0000..9999; outside that range an explicit sign is used.",
"    if (0..=9999).contains(&y) { format!(\"{:04}\", y) } else { format!(\"{:+05}\", y) }",
"}",
"fn tw_format_time(ms: i64) -> Rc<String> {",
"    let days = ms.div_euclid(86_400_000);",
"    let rem = ms.rem_euclid(86_400_000);",
"    let (y, m, d) = tw_civil_from_days(days);",
"    Rc::new(format!(\"{}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", tw_year_text(y), m, d,",
"        rem / 3_600_000, rem / 60_000 % 60, rem / 1000 % 60, rem % 1000))",
"}",
"fn tw_digits(b: &[u8], start: usize, n: usize) -> Option<i64> {",
"    if start + n > b.len() { return None; }",
"    let mut v = 0i64;",
"    for &c in &b[start..start + n] {",
"        if !c.is_ascii_digit() { return None; }",
"        v = v * 10 + (c - b'0') as i64;",
"    }",
"    Some(v)",
"}",
"fn tw_parse_time(text: Rc<String>) -> Option<i64> {",
"    let b = text.as_bytes();",
"    if b.len() < 20 { return None; }",
"    let y = tw_digits(b, 0, 4)?;",
"    let mo = tw_digits(b, 5, 2)?;",
"    let d = tw_digits(b, 8, 2)?;",
"    let h = tw_digits(b, 11, 2)?;",
"    let mi = tw_digits(b, 14, 2)?;",
"    let s = tw_digits(b, 17, 2)?;",
"    if b[4] != b'-' || b[7] != b'-' || !(b[10] == b'T' || b[10] == b't') || b[13] != b':' || b[16] != b':' { return None; }",
"    if !(1..=12).contains(&mo) || d < 1 || d > tw_days_in_month(y, mo) || h > 23 || mi > 59 || s > 59 { return None; }",
"    let mut i = 19;",
"    let mut millis = 0i64;",
"    if b[i] == b'.' {",
"        i += 1;",
"        let fs = i;",
"        while i < b.len() && b[i].is_ascii_digit() {",
"            if i - fs < 3 { millis = millis * 10 + (b[i] - b'0') as i64; }",
"            i += 1;",
"        }",
"        let n = i - fs;",
"        if n == 0 { return None; }",
"        for _ in n..3 { millis *= 10; }",
"    }",
"    if i >= b.len() { return None; }",
"    let offset_min = match b[i] {",
"        b'Z' | b'z' => { if i + 1 != b.len() { return None; } 0 }",
"        b'+' | b'-' => {",
"            if i + 6 != b.len() || b[i + 3] != b':' { return None; }",
"            let oh = tw_digits(b, i + 1, 2)?;",
"            let om = tw_digits(b, i + 4, 2)?;",
"            if oh > 23 || om > 59 { return None; }",
"            let v = oh * 60 + om;",
"            if b[i] == b'-' { -v } else { v }",
"        }",
"        _ => return None,",
"    };",
"    let days = tw_days_from_civil(y, mo, d);",
"    let local = days * 86_400_000 + h * 3_600_000 + mi * 60_000 + s * 1000 + millis;",
"    Some(local - offset_min * 60_000)",
"}",
"fn tw_http_date(ms: i64) -> Rc<String> {",
"    const DAYS: [&str; 7] = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"];",
"    const MONTHS: [&str; 12] = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];",
"    let days = ms.div_euclid(86_400_000);",
"    let rem = ms.rem_euclid(86_400_000);",
"    let (y, m, d) = tw_civil_from_days(days);",
"    let wd = (days + 4).rem_euclid(7) as usize; // 1970-01-01 was a Thursday",
"    Rc::new(format!(\"{}, {:02} {} {} {:02}:{:02}:{:02} GMT\", DAYS[wd], d, MONTHS[(m - 1) as usize], tw_year_text(y),",
"        rem / 3_600_000, rem / 60_000 % 60, rem / 1000 % 60))",
"}",
"",
"// ===========================================================================",
"// 3. Random numbers",
"// ===========================================================================",
"//",
"// Source: /dev/urandom on unix. Elsewhere (Windows: BCryptGenRandom needs FFI,",
"// which `#![forbid(unsafe_code)]` rules out), and on unix as a fallback when",
"// /dev/urandom cannot be read, a ChaCha20 generator (RFC 8439 block function)",
"// is used. Its key is SHA-256 over several `RandomState` hasher outputs (std",
"// seeds RandomState from the operating system's RNG, giving ~128 bits of OS",
"// entropy per thread), the time, the process id, a stack address (ASLR) and a",
"// global counter. After every request for bytes the key is replaced by unused",
"// generator output (\"fast key erasure\"), so earlier output cannot be",
"// reconstructed from the current state. The state lives in a thread_local.",
"",
"struct TwChaCha { key: [u32; 8], nonce: [u32; 3] }",
"",
"thread_local! {",
"    static TW_RNG: std::cell::RefCell<Option<TwChaCha>> = std::cell::RefCell::new(None);",
"}",
"static TW_RNG_COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);",
"",
"fn tw_chacha_qr(w: &mut [u32; 16], a: usize, b: usize, c: usize, d: usize) {",
"    w[a] = w[a].wrapping_add(w[b]); w[d] ^= w[a]; w[d] = w[d].rotate_left(16);",
"    w[c] = w[c].wrapping_add(w[d]); w[b] ^= w[c]; w[b] = w[b].rotate_left(12);",
"    w[a] = w[a].wrapping_add(w[b]); w[d] ^= w[a]; w[d] = w[d].rotate_left(8);",
"    w[c] = w[c].wrapping_add(w[d]); w[b] ^= w[c]; w[b] = w[b].rotate_left(7);",
"}",
"/// RFC 8439 section 2.3 ChaCha20 block function.",
"fn tw_chacha20_block(key: &[u32; 8], counter: u32, nonce: &[u32; 3]) -> [u8; 64] {",
"    let mut s = [0u32; 16];",
"    s[0] = 0x6170_7865; s[1] = 0x3320_646e; s[2] = 0x7962_2d32; s[3] = 0x6b20_6574;",
"    s[4..12].copy_from_slice(key);",
"    s[12] = counter;",
"    s[13..16].copy_from_slice(nonce);",
"    let mut w = s;",
"    for _ in 0..10 {",
"        tw_chacha_qr(&mut w, 0, 4, 8, 12); tw_chacha_qr(&mut w, 1, 5, 9, 13);",
"        tw_chacha_qr(&mut w, 2, 6, 10, 14); tw_chacha_qr(&mut w, 3, 7, 11, 15);",
"        tw_chacha_qr(&mut w, 0, 5, 10, 15); tw_chacha_qr(&mut w, 1, 6, 11, 12);",
"        tw_chacha_qr(&mut w, 2, 7, 8, 13); tw_chacha_qr(&mut w, 3, 4, 9, 14);",
"    }",
"    let mut out = [0u8; 64];",
"    for i in 0..16 { out[i * 4..i * 4 + 4].copy_from_slice(&w[i].wrapping_add(s[i]).to_le_bytes()); }",
"    out",
"}",
"fn tw_words_le(b: &[u8]) -> Vec<u32> {",
"    b.chunks(4).map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]])).collect()",
"}",
"fn tw_chacha_seed() -> TwChaCha {",
"    use std::hash::{BuildHasher, Hasher};",
"    let mut material = TwSha256::new();",
"    let stack_marker = 0u8;",
"    let addr = &stack_marker as *const u8 as usize; // pointer-to-int cast is safe; adds ASLR entropy",
"    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);",
"    let thread = format!(\"{:?}\", std::thread::current().id());",
"    for i in 0..8u64 {",
"        let state = std::collections::hash_map::RandomState::new();",
"        let mut h = state.build_hasher();",
"        h.write_u64(TW_RNG_COUNTER.fetch_add(1, std::sync::atomic::Ordering::Relaxed));",
"        h.write_u64(i);",
"        h.write_u128(now);",
"        h.write_usize(addr);",
"        h.write_u32(std::process::id());",
"        h.write(thread.as_bytes());",
"        material.update(&h.finish().to_le_bytes());",
"    }",
"    material.update(&now.to_le_bytes());",
"    material.update(&(addr as u64).to_le_bytes());",
"    let mut nonce_material = material.clone();",
"    material.update(b\"key\");",
"    nonce_material.update(b\"nonce\");",
"    let k = material.finish();",
"    let n = nonce_material.finish();",
"    let kw = tw_words_le(&k);",
"    let nw = tw_words_le(&n[..12]);",
"    TwChaCha { key: [kw[0], kw[1], kw[2], kw[3], kw[4], kw[5], kw[6], kw[7]], nonce: [nw[0], nw[1], nw[2]] }",
"}",
"fn tw_chacha_fill(out: &mut [u8]) {",
"    TW_RNG.with(|cell| {",
"        let mut slot = cell.borrow_mut();",
"        if slot.is_none() { *slot = Some(tw_chacha_seed()); }",
"        if let Some(g) = slot.as_mut() {",
"            let mut counter = 0u32;",
"            for chunk in out.chunks_mut(64) {",
"                let block = tw_chacha20_block(&g.key, counter, &g.nonce);",
"                chunk.copy_from_slice(&block[..chunk.len()]);",
"                counter = counter.wrapping_add(1);",
"            }",
"            let next = tw_chacha20_block(&g.key, counter, &g.nonce);",
"            let kw = tw_words_le(&next[..32]);",
"            g.key.copy_from_slice(&kw);",
"        }",
"    });",
"}",
"#[cfg(unix)]",
"fn tw_os_random(buf: &mut [u8]) -> bool {",
"    match std::fs::File::open(\"/dev/urandom\") { Ok(mut f) => f.read_exact(buf).is_ok(), Err(_) => false }",
"}",
"#[cfg(not(unix))]",
"fn tw_os_random(_buf: &mut [u8]) -> bool { false }",
"fn tw_fill_random(buf: &mut [u8]) {",
"    if buf.is_empty() { return; }",
"    if !tw_os_random(buf) { tw_chacha_fill(buf); }",
"}",
"fn tw_random_u64() -> u64 {",
"    let mut b = [0u8; 8];",
"    tw_fill_random(&mut b);",
"    u64::from_le_bytes(b)",
"}",
"fn tw_random_int(low: i64, high: i64, loc: &str) -> i64 {",
"    if low >= high { t_fail(\"R004\", format!(\"random_int: low ({}) must be less than high ({})\", low, high), loc) }",
"    let span = (high as i128 - low as i128) as u64; // 1 ..= 2^64 - 1",
"    // 2^64 mod span: values below this are rejected so that the rest is an exact multiple of span.",
"    let threshold = span.wrapping_neg() % span;",
"    loop {",
"        let x = tw_random_u64();",
"        if x >= threshold { return (low as i128 + (x % span) as i128) as i64; }",
"    }",
"}",
"fn tw_random_bytes(n: i64, loc: &str) -> Rc<Vec<u8>> {",
"    if !(0..=1_048_576).contains(&n) { t_fail(\"R004\", format!(\"random_bytes: count {} is outside 0..1048576\", n), loc) }",
"    let mut v = vec![0u8; n as usize];",
"    tw_fill_random(&mut v);",
"    Rc::new(v)",
"}",
"",
"// ===========================================================================",
"// 4. Crypto and encodings",
"// ===========================================================================",
"",
"const TW_SHA_K: [u32; 64] = [",
"    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,",
"    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,",
"    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,",
"    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,",
"    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,",
"    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,",
"    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,",
"    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,",
"];",
"",
"#[derive(Clone)]",
"struct TwSha256 { h: [u32; 8], buf: [u8; 64], len: usize, total: u64 }",
"",
"impl TwSha256 {",
"    fn new() -> TwSha256 {",
"        TwSha256 {",
"            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],",
"            buf: [0u8; 64], len: 0, total: 0,",
"        }",
"    }",
"    fn compress(h: &mut [u32; 8], block: &[u8]) {",
"        let mut w = [0u32; 64];",
"        for t in 0..16 { w[t] = u32::from_be_bytes([block[t * 4], block[t * 4 + 1], block[t * 4 + 2], block[t * 4 + 3]]); }",
"        for t in 16..64 {",
"            let s0 = w[t - 15].rotate_right(7) ^ w[t - 15].rotate_right(18) ^ (w[t - 15] >> 3);",
"            let s1 = w[t - 2].rotate_right(17) ^ w[t - 2].rotate_right(19) ^ (w[t - 2] >> 10);",
"            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);",
"        }",
"        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) = (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);",
"        for t in 0..64 {",
"            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);",
"            let ch = (e & f) ^ (!e & g);",
"            let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(TW_SHA_K[t]).wrapping_add(w[t]);",
"            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);",
"            let maj = (a & b) ^ (a & c) ^ (b & c);",
"            let t2 = s0.wrapping_add(maj);",
"            hh = g; g = f; f = e; e = d.wrapping_add(t1); d = c; c = b; b = a; a = t1.wrapping_add(t2);",
"        }",
"        h[0] = h[0].wrapping_add(a); h[1] = h[1].wrapping_add(b); h[2] = h[2].wrapping_add(c); h[3] = h[3].wrapping_add(d);",
"        h[4] = h[4].wrapping_add(e); h[5] = h[5].wrapping_add(f); h[6] = h[6].wrapping_add(g); h[7] = h[7].wrapping_add(hh);",
"    }",
"    fn update(&mut self, mut data: &[u8]) {",
"        self.total = self.total.wrapping_add(data.len() as u64);",
"        if self.len > 0 {",
"            let take = (64 - self.len).min(data.len());",
"            self.buf[self.len..self.len + take].copy_from_slice(&data[..take]);",
"            self.len += take;",
"            data = &data[take..];",
"            if self.len == 64 {",
"                TwSha256::compress(&mut self.h, &self.buf);",
"                self.len = 0;",
"            }",
"        }",
"        while data.len() >= 64 {",
"            TwSha256::compress(&mut self.h, &data[..64]);",
"            data = &data[64..];",
"        }",
"        if !data.is_empty() {",
"            self.buf[..data.len()].copy_from_slice(data);",
"            self.len = data.len();",
"        }",
"    }",
"    fn finish(mut self) -> [u8; 32] {",
"        let bits = self.total.wrapping_mul(8);",
"        self.update(&[0x80]);",
"        while self.len != 56 { self.update(&[0]); }",
"        self.update(&bits.to_be_bytes());",
"        let mut out = [0u8; 32];",
"        for i in 0..8 { out[i * 4..i * 4 + 4].copy_from_slice(&self.h[i].to_be_bytes()); }",
"        out",
"    }",
"}",
"fn tw_sha256_raw(data: &[u8]) -> [u8; 32] {",
"    let mut s = TwSha256::new();",
"    s.update(data);",
"    s.finish()",
"}",
"",
"#[derive(Clone)]",
"struct TwHmac { inner: TwSha256, outer: TwSha256 }",
"fn tw_hmac_new(key: &[u8]) -> TwHmac {",
"    let mut k = [0u8; 64];",
"    if key.len() > 64 { k[..32].copy_from_slice(&tw_sha256_raw(key)); } else { k[..key.len()].copy_from_slice(key); }",
"    let mut ipad = [0u8; 64];",
"    let mut opad = [0u8; 64];",
"    for i in 0..64 { ipad[i] = k[i] ^ 0x36; opad[i] = k[i] ^ 0x5c; }",
"    let mut inner = TwSha256::new();",
"    inner.update(&ipad);",
"    let mut outer = TwSha256::new();",
"    outer.update(&opad);",
"    TwHmac { inner, outer }",
"}",
"fn tw_hmac_once(mac: &TwHmac, message: &[u8]) -> [u8; 32] {",
"    let mut i = mac.inner.clone();",
"    i.update(message);",
"    let digest = i.finish();",
"    let mut o = mac.outer.clone();",
"    o.update(&digest);",
"    o.finish()",
"}",
"fn tw_pbkdf2_sha256(password: &[u8], salt: &[u8], iterations: u32, dk_len: usize) -> Vec<u8> {",
"    let mac = tw_hmac_new(password);",
"    let mut out = Vec::with_capacity(dk_len);",
"    let mut block = 1u32;",
"    while out.len() < dk_len {",
"        let mut m = salt.to_vec();",
"        m.extend_from_slice(&block.to_be_bytes());",
"        let mut u = tw_hmac_once(&mac, &m);",
"        let mut t = u;",
"        for _ in 1..iterations {",
"            u = tw_hmac_once(&mac, &u);",
"            for j in 0..32 { t[j] ^= u[j]; }",
"        }",
"        let take = 32.min(dk_len - out.len());",
"        out.extend_from_slice(&t[..take]);",
"        block = block.wrapping_add(1);",
"    }",
"    out",
"}",
"",
"fn tw_sha256(data: Rc<Vec<u8>>) -> Rc<Vec<u8>> { Rc::new(tw_sha256_raw(&data).to_vec()) }",
"fn tw_hmac_sha256(key: Rc<Vec<u8>>, message: Rc<Vec<u8>>) -> Rc<Vec<u8>> {",
"    Rc::new(tw_hmac_once(&tw_hmac_new(&key), &message).to_vec())",
"}",
"",
"const TW_B64: &[u8; 64] = b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";",
"fn tw_b64_encode_raw(data: &[u8], pad: bool) -> String {",
"    let mut s = String::with_capacity((data.len() + 2) / 3 * 4);",
"    for c in data.chunks(3) {",
"        let n = (c[0] as u32) << 16 | (*c.get(1).unwrap_or(&0) as u32) << 8 | *c.get(2).unwrap_or(&0) as u32;",
"        let chars = c.len() + 1;",
"        for i in 0..4 {",
"            if i < chars { s.push(TW_B64[((n >> (18 - 6 * i)) & 63) as usize] as char); } else if pad { s.push('='); }",
"        }",
"    }",
"    s",
"}",
"fn tw_b64_value(c: u8) -> Option<u32> {",
"    match c {",
"        b'A'..=b'Z' => Some((c - b'A') as u32),",
"        b'a'..=b'z' => Some((c - b'a') as u32 + 26),",
"        b'0'..=b'9' => Some((c - b'0') as u32 + 52),",
"        b'+' | b'-' => Some(62),",
"        b'/' | b'_' => Some(63),",
"        _ => None,",
"    }",
"}",
"fn tw_b64_decode_raw(s: &[u8]) -> Option<Vec<u8>> {",
"    let mut end = s.len();",
"    let mut pads = 0;",
"    while end > 0 && s[end - 1] == b'=' { end -= 1; pads += 1; }",
"    let body = &s[..end];",
"    if body.len() % 4 == 1 || pads > 2 { return None; }",
"    if pads > 0 && (s.len() % 4 != 0 || (4 - body.len() % 4) % 4 != pads) { return None; }",
"    let mut out = Vec::with_capacity(body.len() / 4 * 3 + 2);",
"    for c in body.chunks(4) {",
"        let mut n = 0u32;",
"        for (i, &ch) in c.iter().enumerate() { n |= tw_b64_value(ch)? << (18 - 6 * i); }",
"        match c.len() {",
"            4 => { out.push((n >> 16) as u8); out.push((n >> 8) as u8); out.push(n as u8); }",
"            3 => { if n & 0xFF != 0 { return None; } out.push((n >> 16) as u8); out.push((n >> 8) as u8); }",
"            2 => { if n & 0xFFFF != 0 { return None; } out.push((n >> 16) as u8); }",
"            _ => return None,",
"        }",
"    }",
"    Some(out)",
"}",
"fn tw_base64_encode(data: Rc<Vec<u8>>) -> Rc<String> { Rc::new(tw_b64_encode_raw(&data, true)) }",
"fn tw_base64_decode(text: Rc<String>) -> Option<Rc<Vec<u8>>> { tw_b64_decode_raw(text.as_bytes()).map(Rc::new) }",
"",
"fn tw_hex_raw(data: &[u8]) -> String {",
"    const HEX: &[u8; 16] = b\"0123456789abcdef\";",
"    let mut s = String::with_capacity(data.len() * 2);",
"    for &b in data { s.push(HEX[(b >> 4) as usize] as char); s.push(HEX[(b & 15) as usize] as char); }",
"    s",
"}",
"fn tw_hex_encode(data: Rc<Vec<u8>>) -> Rc<String> { Rc::new(tw_hex_raw(&data)) }",
"fn tw_hex_decode(text: Rc<String>) -> Option<Rc<Vec<u8>>> {",
"    let b = text.as_bytes();",
"    if b.len() % 2 != 0 { return None; }",
"    let nib = |c: u8| -> Option<u8> {",
"        match c { b'0'..=b'9' => Some(c - b'0'), b'a'..=b'f' => Some(c - b'a' + 10), b'A'..=b'F' => Some(c - b'A' + 10), _ => None }",
"    };",
"    let mut out = Vec::with_capacity(b.len() / 2);",
"    for p in b.chunks(2) { out.push(nib(p[0])? << 4 | nib(p[1])?); }",
"    Some(Rc::new(out))",
"}",
"fn tw_ct_eq(a: &[u8], b: &[u8]) -> bool {",
"    if a.len() != b.len() { return false; } // the length is not treated as secret",
"    let mut acc = 0u8;",
"    for i in 0..a.len() { acc = std::hint::black_box(acc | (a[i] ^ b[i])); }",
"    acc == 0",
"}",
"fn tw_equal_constant_time(a: Rc<Vec<u8>>, b: Rc<Vec<u8>>) -> bool { tw_ct_eq(&a, &b) }",
"",
"const TW_PBKDF2_ITERATIONS: u32 = 600_000;",
"fn tw_password_hash(password: Rc<String>, loc: &str) -> Rc<String> {",
"    let salt = tw_random_bytes(16, loc);",
"    let key = tw_pbkdf2_sha256(password.as_bytes(), &salt, TW_PBKDF2_ITERATIONS, 32);",
"    Rc::new(format!(\"$pbkdf2-sha256$i={}${}${}\", TW_PBKDF2_ITERATIONS, tw_b64_encode_raw(&salt, false), tw_b64_encode_raw(&key, false)))",
"}",
"fn tw_password_verify(password: Rc<String>, hash: Rc<String>) -> bool {",
"    let parts: Vec<&str> = hash.split('$').collect();",
"    if parts.len() != 5 || !parts[0].is_empty() || parts[1] != \"pbkdf2-sha256\" { return false; }",
"    let digits = match parts[2].strip_prefix(\"i=\") { Some(d) => d, None => return false };",
"    if digits.is_empty() || digits.len() > 8 || !digits.bytes().all(|c| c.is_ascii_digit()) { return false; }",
"    let iterations: u32 = match digits.parse() { Ok(v) => v, Err(_) => return false };",
"    if !(1..=10_000_000).contains(&iterations) { return false; }",
"    let salt = match tw_b64_decode_raw(parts[3].as_bytes()) { Some(s) => s, None => return false };",
"    let key = match tw_b64_decode_raw(parts[4].as_bytes()) { Some(k) => k, None => return false };",
"    if salt.len() > 1024 || key.is_empty() || key.len() > 1024 { return false; }",
"    let computed = tw_pbkdf2_sha256(password.as_bytes(), &salt, iterations, key.len());",
"    tw_ct_eq(&computed, &key)",
"}",
"",
"// ===========================================================================",
"// 5. SQLite through the sqlite3 command-line program",
"// ===========================================================================",
"//",
"// One persistent `sqlite3 -batch <file>` child per open database (so",
"// transactions can span calls). Per call the runtime writes:",
"//   DELETE FROM temp.sqlite_parameters;",
"//   REPLACE INTO temp.sqlite_parameters(key,value) VALUES('?N',CAST(X'<hex>' AS TEXT));  (per parameter)",
"//   DELETE FROM temp.sqlite_parameters WHERE 0;      -- resets changes() to 0",
"//   <the statement, unchanged>",
"//   ;",
"//   SELECT changes() AS tessera_changes;              -- execute only",
"//   .print TESSERA_END_<random>                       -- stdout sync marker",
"//   .tessera_sync_<random>                            -- unknown command: stderr sync marker",
"// Parameter values are hex encoded, so they can never end a literal, start a",
"// new statement or a dot-command. The statement is checked to be exactly one",
"// complete statement (balanced quotes/comments, no second statement, does",
"// not start with '.' or '#', no \"GO\" or \"/\" terminator lines), so it cannot",
"// swallow the markers or run dot-commands either.",
"",
"struct TwDb {",
"    child: std::process::Child,",
"    stdin: Option<std::process::ChildStdin>,",
"    stdout: std::io::BufReader<std::process::ChildStdout>,",
"    errors: std::sync::mpsc::Receiver<String>,",
"    broken: bool,",
"}",
"impl Drop for TwDb {",
"    fn drop(&mut self) {",
"        self.stdin.take(); // EOF makes sqlite3 exit cleanly",
"        for _ in 0..100 {",
"            match self.child.try_wait() {",
"                Ok(Some(_)) => return,",
"                Ok(None) => std::thread::sleep(std::time::Duration::from_millis(10)),",
"                Err(_) => break,",
"            }",
"        }",
"        let _ = self.child.kill();",
"        let _ = self.child.wait();",
"    }",
"}",
"",
"#[derive(Clone)]",
"pub struct TDatabase(Rc<std::cell::RefCell<TwDb>>);",
"impl PartialEq for TDatabase {",
"    fn eq(&self, other: &TDatabase) -> bool { Rc::ptr_eq(&self.0, &other.0) }",
"}",
"impl Eq for TDatabase {}",
"impl std::fmt::Debug for TDatabase {",
"    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { write!(f, \"<database>\") }",
"}",
"",
"fn tw_db_open(path: Rc<String>, loc: &str) -> Result<TDatabase, Rc<String>> {",
"    if path.is_empty() { return Err(t_text(\"empty database path\")); }",
"    let target: std::ffi::OsString = if path.as_str() == \":memory:\" {",
"        std::ffi::OsString::from(\":memory:\")",
"    } else {",
"        let p = t_check_path(path.as_str(), loc).into_os_string();",
"        let lossy = p.to_string_lossy().to_string();",
"        // Never let the path be read as an option or a URI filename.",
"        if lossy.starts_with('-') || lossy.to_ascii_lowercase().starts_with(\"file:\") {",
"            let mut o = std::ffi::OsString::from(\"./\");",
"            o.push(&p);",
"            o",
"        } else { p }",
"    };",
"    let program = match std::env::var(\"TESSERA_SQLITE3\") { Ok(p) if !p.is_empty() => p, _ => \"sqlite3\".to_string() };",
"    let spawned = std::process::Command::new(&program)",
"        .arg(\"-batch\")",
"        .arg(&target)",
"        .stdin(std::process::Stdio::piped())",
"        .stdout(std::process::Stdio::piped())",
"        .stderr(std::process::Stdio::piped())",
"        .spawn();",
"    let mut child = match spawned {",
"        Ok(c) => c,",
"        Err(e) => return Err(Rc::new(format!(\"cannot start `{}`: {}\", program, e))),",
"    };",
"    let (stdin, stdout, stderr) = match (child.stdin.take(), child.stdout.take(), child.stderr.take()) {",
"        (Some(a), Some(b), Some(c)) => (a, b, c),",
"        _ => { let _ = child.kill(); let _ = child.wait(); return Err(t_text(\"cannot connect to sqlite3\")); }",
"    };",
"    let (tx, rx) = std::sync::mpsc::channel::<String>();",
"    let reader = std::thread::Builder::new().name(\"tessera-sqlite3-stderr\".to_string()).spawn(move || {",
"        let mut r = std::io::BufReader::new(stderr);",
"        let mut line = Vec::new();",
"        loop {",
"            line.clear();",
"            match r.read_until(b'\\n', &mut line) {",
"                Ok(0) | Err(_) => break,",
"                Ok(_) => {",
"                    let s = String::from_utf8_lossy(&line).trim_end_matches(&['\\r', '\\n'][..]).to_string();",
"                    if tx.send(s).is_err() { break; }",
"                }",
"            }",
"        }",
"    });",
"    if reader.is_err() { let _ = child.kill(); let _ = child.wait(); return Err(t_text(\"cannot start a thread for sqlite3\")); }",
"    let mut db = TwDb { child, stdin: Some(stdin), stdout: std::io::BufReader::new(stdout), errors: rx, broken: false };",
"    let setup = \".bail off\\n.echo off\\n.changes off\\n.timer off\\n.eqp off\\n.stats off\\n.output\\n.mode json\\n.timeout 5000\\n.parameter init\\n\";",
"    match tw_db_roundtrip(&mut db, setup) {",
"        Ok(_) => Ok(TDatabase(Rc::new(std::cell::RefCell::new(db)))),",
"        Err(e) => Err(Rc::new(e)),",
"    }",
"}",
"",
"fn tw_sqlite_error_text(lines: &[String]) -> String {",
"    let mut out = Vec::new();",
"    for (i, l) in lines.iter().enumerate() {",
"        let mut s = l.as_str();",
"        if i == 0 {",
"            for prefix in [\"Parse error near line \", \"Runtime error near line \", \"Error: near line \", \"Error: in prepare, \"] {",
"                if let Some(rest) = s.strip_prefix(prefix) {",
"                    s = match rest.find(\": \") { Some(p) if prefix.ends_with(\"line \") => &rest[p + 2..], _ => rest };",
"                    break;",
"                }",
"            }",
"            if let Some(rest) = s.strip_prefix(\"Error: \") { s = rest; }",
"        }",
"        out.push(s.trim_end().to_string());",
"    }",
"    let joined = out.join(\"\\n\");",
"    joined.trim().to_string()",
"}",
"",
"fn tw_db_roundtrip(db: &mut TwDb, script: &str) -> Result<Vec<String>, String> {",
"    if db.broken { return Err(\"the database connection is closed (sqlite3 is no longer running)\".to_string()); }",
"    let mut tag = [0u8; 16];",
"    tw_fill_random(&mut tag);",
"    let tag = tw_hex_raw(&tag);",
"    let marker = format!(\"TESSERA_END_{}\", tag);",
"    let sync = format!(\"tessera_sync_{}\", tag);",
"    let full = format!(\"{}.print {}\\n.{}\\n\", script, marker, sync);",
"    let written = match db.stdin.as_mut() {",
"        Some(w) => w.write_all(full.as_bytes()).and_then(|_| w.flush()).is_ok(),",
"        None => false,",
"    };",
"    if !written {",
"        db.broken = true;",
"        return Err(tw_db_dead_message(db));",
"    }",
"    let mut lines = Vec::new();",
"    loop {",
"        let mut buf = Vec::new();",
"        match db.stdout.read_until(b'\\n', &mut buf) {",
"            Ok(0) | Err(_) => { db.broken = true; return Err(tw_db_dead_message(db)); }",
"            Ok(_) => {}",
"        }",
"        let line = String::from_utf8_lossy(&buf).trim_end_matches(&['\\r', '\\n'][..]).to_string();",
"        if line == marker { break; }",
"        lines.push(line);",
"    }",
"    let mut errors = Vec::new();",
"    loop {",
"        match db.errors.recv_timeout(std::time::Duration::from_secs(30)) {",
"            Ok(l) => { if l.contains(&sync) { break; } errors.push(l); }",
"            Err(_) => { db.broken = true; return Err(\"sqlite3 stopped responding\".to_string()); }",
"        }",
"    }",
"    if !errors.is_empty() { return Err(tw_sqlite_error_text(&errors)); }",
"    Ok(lines)",
"}",
"fn tw_db_dead_message(db: &mut TwDb) -> String {",
"    let mut errors = Vec::new();",
"    while let Ok(l) = db.errors.recv_timeout(std::time::Duration::from_millis(500)) { errors.push(l); }",
"    if errors.is_empty() { \"sqlite3 exited unexpectedly\".to_string() } else { format!(\"sqlite3 exited: {}\", tw_sqlite_error_text(&errors)) }",
"}",
"",
"/// Validates that `sql` is exactly one complete statement and returns it (leading",
"/// whitespace/comments removed, trailing ';' removed).",
"fn tw_sql_prepare(sql: &str) -> Result<String, String> {",
"    let b = sql.as_bytes();",
"    let n = b.len();",
"    let mut i = 0;",
"    // Skips whitespace and comments starting at i; Err on an unterminated block comment.",
"    fn skip_space(b: &[u8], mut i: usize) -> Result<usize, String> {",
"        let n = b.len();",
"        loop {",
"            while i < n && b[i].is_ascii_whitespace() { i += 1; }",
"            if i + 1 < n && b[i] == b'-' && b[i + 1] == b'-' {",
"                while i < n && b[i] != b'\\n' { i += 1; }",
"            } else if i + 1 < n && b[i] == b'/' && b[i + 1] == b'*' {",
"                match sql_find(b, i + 2, b\"*/\") { Some(p) => i = p + 2, None => return Err(\"unterminated comment in SQL\".to_string()) }",
"            } else {",
"                return Ok(i);",
"            }",
"        }",
"    }",
"    fn sql_find(b: &[u8], from: usize, pat: &[u8]) -> Option<usize> {",
"        if from > b.len() { return None; }",
"        b[from..].windows(pat.len()).position(|w| w == pat).map(|p| p + from)",
"    }",
"    i = skip_space(b, i)?;",
"    let start = i;",
"    if start == n { return Err(\"empty SQL statement\".to_string()); }",
"    if b[start] == b'.' || b[start] == b'#' { return Err(\"an SQL statement cannot start with '.' or '#'\".to_string()); }",
"    let mut end = n;",
"    while i < n {",
"        match b[i] {",
"            q @ (b'\\'' | b'\"' | b'`') => {",
"                match b[i + 1..].iter().position(|&c| c == q) { Some(p) => i = i + 1 + p + 1, None => return Err(\"unterminated quoted text in SQL\".to_string()) }",
"            }",
"            b'[' => {",
"                match b[i + 1..].iter().position(|&c| c == b']') { Some(p) => i = i + 1 + p + 1, None => return Err(\"unterminated [identifier] in SQL\".to_string()) }",
"            }",
"            b'-' if i + 1 < n && b[i + 1] == b'-' => { while i < n && b[i] != b'\\n' { i += 1; } }",
"            b'/' if i + 1 < n && b[i + 1] == b'*' => {",
"                match sql_find(b, i + 2, b\"*/\") { Some(p) => i = p + 2, None => return Err(\"unterminated comment in SQL\".to_string()) }",
"            }",
"            b';' => {",
"                end = i;",
"                if skip_space(b, i + 1)? != n { return Err(\"only one SQL statement is allowed per call\".to_string()); }",
"                break;",
"            }",
"            _ => i += 1,",
"        }",
"    }",
"    let body = sql[start..end].trim_end().to_string();",
"    for line in body.lines() {",
"        let t = line.trim();",
"        if t.eq_ignore_ascii_case(\"go\") || t == \"/\" { return Err(\"an SQL statement cannot contain a line with only `GO` or `/`\".to_string()); }",
"    }",
"    Ok(body)",
"}",
"",
"fn tw_db_run(db: &TDatabase, sql: &str, params: &[Rc<String>], want_changes: bool) -> Result<Vec<TwJson>, String> {",
"    let body = tw_sql_prepare(sql)?;",
"    let mut script = String::from(\"DELETE FROM temp.sqlite_parameters;\\n\");",
"    for (i, p) in params.iter().enumerate() {",
"        script.push_str(&format!(\"REPLACE INTO temp.sqlite_parameters(key,value) VALUES('?{}',CAST(X'{}' AS TEXT));\\n\", i + 1, tw_hex_raw(p.as_bytes())));",
"    }",
"    script.push_str(\"DELETE FROM temp.sqlite_parameters WHERE 0;\\n\");",
"    script.push_str(&body);",
"    script.push_str(\"\\n;\\n\");",
"    if want_changes { script.push_str(\"SELECT changes() AS tessera_changes;\\n\"); }",
"    let mut inner = db.0.borrow_mut();",
"    let lines = tw_db_roundtrip(&mut inner, &script)?;",
"    tw_json_parse_all(&lines.join(\"\\n\")).ok_or_else(|| \"cannot parse the output of sqlite3\".to_string())",
"}",
"",
"fn tw_db_query(db: TDatabase, sql: Rc<String>, params: Rc<Vec<Rc<String>>>, loc: &str)",
"    -> Result<Rc<Vec<Rc<std::collections::BTreeMap<Rc<String>, Rc<String>>>>>, Rc<String>> {",
"    let values = tw_db_run(&db, &sql, &params, false).map_err(Rc::new)?;",
"    let mut rows = Vec::new();",
"    for v in values {",
"        if let TwJson::Arr(items) = v {",
"            for item in items {",
"                if let TwJson::Obj(fields) = item {",
"                    let mut row = std::collections::BTreeMap::new();",
"                    for (k, val) in fields {",
"                        let text = match val {",
"                            TwJson::Null => continue,",
"                            TwJson::Str(s) => s,",
"                            TwJson::Num(n) => tw_sql_number_text(&n),",
"                            TwJson::Bool(b) => b.to_string(),",
"                            TwJson::Arr(_) | TwJson::Obj(_) => continue,",
"                        };",
"                        row.insert(Rc::new(k), Rc::new(text));",
"                    }",
"                    rows.push(Rc::new(row));",
"                }",
"            }",
"        }",
"    }",
"    Ok(Rc::new(rows))",
"}",
"fn tw_db_execute(db: TDatabase, sql: Rc<String>, params: Rc<Vec<Rc<String>>>, loc: &str) -> Result<i64, Rc<String>> {",
"    let values = tw_db_run(&db, &sql, &params, true).map_err(Rc::new)?;",
"    if let Some(TwJson::Arr(items)) = values.last() {",
"        if let Some(TwJson::Obj(fields)) = items.first() {",
"            for (k, v) in fields {",
"                if k == \"tessera_changes\" {",
"                    if let TwJson::Num(n) = v { if let Ok(c) = n.parse::<i64>() { return Ok(c); } }",
"                }",
"            }",
"        }",
"    }",
"    Err(t_text(\"cannot read the number of changed rows from sqlite3\"))",
"}",
"fn tw_sql_number_text(raw: &str) -> String {",
"    let digits = raw.strip_prefix('-').unwrap_or(raw);",
"    if !digits.is_empty() && digits.bytes().all(|c| c.is_ascii_digit()) { return raw.to_string(); }",
"    match raw.parse::<f64>() {",
"        Ok(f) if f.is_finite() => format!(\"{:?}\", f), // shortest text that round-trips",
"        _ => raw.to_string(),",
"    }",
"}",
"",
"enum TwJson { Null, Bool(bool), Num(String), Str(String), Arr(Vec<TwJson>), Obj(Vec<(String, TwJson)>) }",
"",
"struct TwJsonParser<'a> { b: &'a [u8], i: usize, depth: usize }",
"impl<'a> TwJsonParser<'a> {",
"    fn ws(&mut self) { while self.i < self.b.len() && self.b[self.i].is_ascii_whitespace() { self.i += 1; } }",
"    fn value(&mut self) -> Option<TwJson> {",
"        self.ws();",
"        let c = *self.b.get(self.i)?;",
"        match c {",
"            b'[' => {",
"                self.depth += 1;",
"                if self.depth > 64 { return None; }",
"                self.i += 1;",
"                let mut items = Vec::new();",
"                self.ws();",
"                if self.b.get(self.i) == Some(&b']') { self.i += 1; self.depth -= 1; return Some(TwJson::Arr(items)); }",
"                loop {",
"                    items.push(self.value()?);",
"                    self.ws();",
"                    match self.b.get(self.i)? { b',' => self.i += 1, b']' => { self.i += 1; break; } _ => return None }",
"                }",
"                self.depth -= 1;",
"                Some(TwJson::Arr(items))",
"            }",
"            b'{' => {",
"                self.depth += 1;",
"                if self.depth > 64 { return None; }",
"                self.i += 1;",
"                let mut fields = Vec::new();",
"                self.ws();",
"                if self.b.get(self.i) == Some(&b'}') { self.i += 1; self.depth -= 1; return Some(TwJson::Obj(fields)); }",
"                loop {",
"                    self.ws();",
"                    let k = match self.value()? { TwJson::Str(s) => s, _ => return None };",
"                    self.ws();",
"                    if self.b.get(self.i)? != &b':' { return None; }",
"                    self.i += 1;",
"                    let v = self.value()?;",
"                    fields.push((k, v));",
"                    self.ws();",
"                    match self.b.get(self.i)? { b',' => self.i += 1, b'}' => { self.i += 1; break; } _ => return None }",
"                }",
"                self.depth -= 1;",
"                Some(TwJson::Obj(fields))",
"            }",
"            b'\"' => {",
"                self.i += 1;",
"                let mut out: Vec<u8> = Vec::new();",
"                loop {",
"                    let c = *self.b.get(self.i)?;",
"                    self.i += 1;",
"                    match c {",
"                        b'\"' => break,",
"                        b'\\\\' => {",
"                            let e = *self.b.get(self.i)?;",
"                            self.i += 1;",
"                            match e {",
"                                b'\"' => out.push(b'\"'), b'\\\\' => out.push(b'\\\\'), b'/' => out.push(b'/'),",
"                                b'b' => out.push(8), b'f' => out.push(12), b'n' => out.push(b'\\n'), b'r' => out.push(b'\\r'), b't' => out.push(b'\\t'),",
"                                b'u' => {",
"                                    let mut cp = self.hex4()?;",
"                                    if (0xD800..0xDC00).contains(&cp) && self.b.get(self.i) == Some(&b'\\\\') && self.b.get(self.i + 1) == Some(&b'u') {",
"                                        let save = self.i;",
"                                        self.i += 2;",
"                                        let lo = self.hex4()?;",
"                                        if (0xDC00..0xE000).contains(&lo) { cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00); } else { self.i = save; }",
"                                    }",
"                                    let ch = char::from_u32(cp).unwrap_or('\\u{FFFD}');",
"                                    let mut tmp = [0u8; 4];",
"                                    out.extend_from_slice(ch.encode_utf8(&mut tmp).as_bytes());",
"                                }",
"                                _ => return None,",
"                            }",
"                        }",
"                        _ => out.push(c),",
"                    }",
"                }",
"                Some(TwJson::Str(String::from_utf8_lossy(&out).to_string()))",
"            }",
"            _ => {",
"                let s = self.i;",
"                while self.i < self.b.len() && (self.b[self.i].is_ascii_alphanumeric() || b\"+-.\".contains(&self.b[self.i])) { self.i += 1; }",
"                if s == self.i { return None; }",
"                let tok = String::from_utf8_lossy(&self.b[s..self.i]).to_string();",
"                Some(match tok.as_str() { \"null\" => TwJson::Null, \"true\" => TwJson::Bool(true), \"false\" => TwJson::Bool(false), _ => TwJson::Num(tok) })",
"            }",
"        }",
"    }",
"    fn hex4(&mut self) -> Option<u32> {",
"        let h = self.b.get(self.i..self.i + 4)?;",
"        let s = std::str::from_utf8(h).ok()?;",
"        let v = u32::from_str_radix(s, 16).ok()?;",
"        self.i += 4;",
"        Some(v)",
"    }",
"}",
"fn tw_json_parse_all(text: &str) -> Option<Vec<TwJson>> {",
"    let mut p = TwJsonParser { b: text.as_bytes(), i: 0, depth: 0 };",
"    let mut out = Vec::new();",
"    loop {",
"        p.ws();",
"        if p.i >= p.b.len() { return Some(out); }",
"        out.push(p.value()?);",
"    }",
"}",
"",
"// ===========================================================================",
"// Shared HTTP helpers",
"// ===========================================================================",
"",
"fn tw_reason(status: u16) -> &'static str {",
"    match status {",
"        100 => \"Continue\", 101 => \"Switching Protocols\",",
"        200 => \"OK\", 201 => \"Created\", 202 => \"Accepted\", 203 => \"Non-Authoritative Information\", 204 => \"No Content\",",
"        205 => \"Reset Content\", 206 => \"Partial Content\",",
"        300 => \"Multiple Choices\", 301 => \"Moved Permanently\", 302 => \"Found\", 303 => \"See Other\", 304 => \"Not Modified\",",
"        307 => \"Temporary Redirect\", 308 => \"Permanent Redirect\",",
"        400 => \"Bad Request\", 401 => \"Unauthorized\", 402 => \"Payment Required\", 403 => \"Forbidden\", 404 => \"Not Found\",",
"        405 => \"Method Not Allowed\", 406 => \"Not Acceptable\", 407 => \"Proxy Authentication Required\", 408 => \"Request Timeout\",",
"        409 => \"Conflict\", 410 => \"Gone\", 411 => \"Length Required\", 412 => \"Precondition Failed\", 413 => \"Content Too Large\",",
"        414 => \"URI Too Long\", 415 => \"Unsupported Media Type\", 416 => \"Range Not Satisfiable\", 417 => \"Expectation Failed\",",
"        421 => \"Misdirected Request\", 422 => \"Unprocessable Content\", 425 => \"Too Early\", 426 => \"Upgrade Required\",",
"        428 => \"Precondition Required\", 429 => \"Too Many Requests\", 431 => \"Request Header Fields Too Large\",",
"        451 => \"Unavailable For Legal Reasons\",",
"        500 => \"Internal Server Error\", 501 => \"Not Implemented\", 502 => \"Bad Gateway\", 503 => \"Service Unavailable\",",
"        504 => \"Gateway Timeout\", 505 => \"HTTP Version Not Supported\",",
"        _ => \"Unknown\",",
"    }",
"}",
"",
"fn tw_is_token(s: &str) -> bool {",
"    !s.is_empty() && s.bytes().all(|c| c.is_ascii_alphanumeric() || b\"!#$%&'*+-.^_`|~\".contains(&c))",
"}",
"",
"/// Buffered reader with line-length limits, used by the HTTP client and server.",
"struct TwReader<R: std::io::Read> { inner: R, buf: Vec<u8>, start: usize }",
"#[derive(Debug, PartialEq)]",
"enum TwRd { Eof, TooLong, Io }",
"impl<R: std::io::Read> TwReader<R> {",
"    fn new(inner: R) -> TwReader<R> { TwReader { inner, buf: Vec::new(), start: 0 } }",
"    fn avail(&self) -> &[u8] { &self.buf[self.start..] }",
"    fn fill(&mut self) -> Result<usize, TwRd> {",
"        if self.start > 0 { self.buf.drain(..self.start); self.start = 0; }",
"        let mut tmp = [0u8; 16384];",
"        loop {",
"            match self.inner.read(&mut tmp) {",
"                Ok(n) => { self.buf.extend_from_slice(&tmp[..n]); return Ok(n); }",
"                Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,",
"                Err(_) => return Err(TwRd::Io),",
"            }",
"        }",
"    }",
"    /// One line without its LF (and CR); `max` limits the content length.",
"    fn read_line(&mut self, max: usize) -> Result<Vec<u8>, TwRd> {",
"        let mut scanned = 0;",
"        loop {",
"            let avail = &self.buf[self.start..];",
"            if let Some(p) = avail[scanned..].iter().position(|&c| c == b'\\n') {",
"                let p = scanned + p;",
"                let content = if p > 0 && avail[p - 1] == b'\\r' { p - 1 } else { p };",
"                if content > max { return Err(TwRd::TooLong); }",
"                let line = avail[..content].to_vec();",
"                self.start += p + 1;",
"                return Ok(line);",
"            }",
"            scanned = avail.len();",
"            if avail.len() > max + 1 { return Err(TwRd::TooLong); }",
"            if self.fill()? == 0 { return Err(TwRd::Eof); }",
"        }",
"    }",
"    fn read_exact_vec(&mut self, n: usize) -> Result<Vec<u8>, TwRd> {",
"        while self.avail().len() < n {",
"            if self.fill()? == 0 { return Err(TwRd::Eof); }",
"        }",
"        let v = self.buf[self.start..self.start + n].to_vec();",
"        self.start += n;",
"        Ok(v)",
"    }",
"    fn read_to_end_limit(&mut self, limit: usize) -> Result<Vec<u8>, TwRd> {",
"        loop {",
"            if self.avail().len() > limit { return Err(TwRd::TooLong); }",
"            if self.fill()? == 0 { break; }",
"        }",
"        let v = self.avail().to_vec();",
"        self.start = self.buf.len();",
"        Ok(v)",
"    }",
"}",
"",
"#[derive(Debug, PartialEq)]",
"enum TwBodyErr { TooLarge, Bad, Closed }",
"fn tw_read_chunked<R: std::io::Read>(r: &mut TwReader<R>, limit: usize) -> Result<Vec<u8>, TwBodyErr> {",
"    let map = |e: TwRd| match e { TwRd::TooLong => TwBodyErr::Bad, _ => TwBodyErr::Closed };",
"    let mut out = Vec::new();",
"    loop {",
"        let line = r.read_line(4096).map_err(map)?;",
"        let line = String::from_utf8_lossy(&line).to_string();",
"        let size_text = line.split(';').next().unwrap_or(\"\").trim();",
"        if size_text.is_empty() || size_text.len() > 15 || !size_text.bytes().all(|c| c.is_ascii_hexdigit()) { return Err(TwBodyErr::Bad); }",
"        let size = usize::from_str_radix(size_text, 16).map_err(|_| TwBodyErr::Bad)?;",
"        if size == 0 {",
"            // trailers: ignored, but bounded",
"            for _ in 0..101 {",
"                let t = r.read_line(8192).map_err(map)?;",
"                if t.is_empty() { return Ok(out); }",
"            }",
"            return Err(TwBodyErr::Bad);",
"        }",
"        if out.len() + size > limit { return Err(TwBodyErr::TooLarge); }",
"        let data = r.read_exact_vec(size).map_err(map)?;",
"        out.extend_from_slice(&data);",
"        let end = r.read_line(0).map_err(map)?;",
"        if !end.is_empty() { return Err(TwBodyErr::Bad); }",
"    }",
"}",
"",
"// ===========================================================================",
"// 6. HTTP client (plain http:// only)",
"// ===========================================================================",
"",
"const TW_CLIENT_MAX_RESPONSE: usize = 256 * 1024 * 1024;",
"",
"fn tw_net_request(method: Rc<String>, url: Rc<String>, header_lines: Rc<Vec<Rc<String>>>, body: Rc<Vec<u8>>, loc: &str) -> Result<Rc<Vec<u8>>, Rc<String>> {",
"    tw_http_client(&method, &url, &header_lines, &body).map(Rc::new).map_err(Rc::new)",
"}",
"",
"fn tw_http_client(method: &str, url: &str, header_lines: &[Rc<String>], body: &[u8]) -> Result<Vec<u8>, String> {",
"    if !tw_is_token(method) { return Err(format!(\"invalid HTTP method `{}`\", method)); }",
"    let lower = url.to_ascii_lowercase();",
"    if lower.starts_with(\"https://\") { return Err(\"https is not supported; use a reverse proxy\".to_string()); }",
"    if !lower.starts_with(\"http://\") { return Err(format!(\"unsupported URL `{}`: only http:// URLs are supported\", url)); }",
"    let rest = &url[7..];",
"    let auth_end = rest.find(|c| c == '/' || c == '?' || c == '#').unwrap_or(rest.len());",
"    let authority = &rest[..auth_end];",
"    let mut target = &rest[auth_end..];",
"    if let Some(p) = target.find('#') { target = &target[..p]; }",
"    let target = if target.starts_with('/') { target.to_string() } else { format!(\"/{}\", target) };",
"    if target.bytes().any(|c| c <= 0x20 || c == 0x7f) { return Err(format!(\"invalid character in URL `{}`\", url)); }",
"    if authority.contains('@') { return Err(\"user names or passwords in URLs are not supported\".to_string()); }",
"    let (host, port_text) = if let Some(after) = authority.strip_prefix('[') {",
"        match after.find(']') {",
"            Some(p) => {",
"                let tail = &after[p + 1..];",
"                let port = if tail.is_empty() { None } else if let Some(pt) = tail.strip_prefix(':') { Some(pt) } else { return Err(format!(\"invalid URL `{}`\", url)) };",
"                (&after[..p], port)",
"            }",
"            None => return Err(format!(\"invalid URL `{}`\", url)),",
"        }",
"    } else {",
"        match authority.rfind(':') { Some(p) => (&authority[..p], Some(&authority[p + 1..])), None => (authority, None) }",
"    };",
"    if host.is_empty() || host.bytes().any(|c| c <= 0x20 || c == 0x7f || c == b'/' ) { return Err(format!(\"invalid host in URL `{}`\", url)); }",
"    let port: u16 = match port_text {",
"        None => 80,",
"        Some(p) => match p.parse::<u16>() { Ok(v) if !p.starts_with('+') && v > 0 => v, _ => return Err(format!(\"invalid port in URL `{}`\", url)) },",
"    };",
"    let host_lower = host.to_ascii_lowercase();",
"    let host_shown = if host_lower.contains(':') { format!(\"[{}]\", host_lower) } else { host_lower.clone() };",
"    let host_port = format!(\"{}:{}\", host_shown, port);",
"    if let Ok(allow) = std::env::var(\"TESSERA_NET_ALLOW\") {",
"        let ok = allow.split(',').map(|e| e.trim().to_ascii_lowercase()).any(|e| !e.is_empty() && (e == host_lower || e == host_shown || e == host_port));",
"        if !ok { return Err(format!(\"network access to {} is not allowed\", host_port)); }",
"    }",
"    let mut user_headers = String::new();",
"    let mut has_host = false;",
"    for line in header_lines {",
"        if line.contains('\\r') || line.contains('\\n') || line.contains('\\0') { return Err(format!(\"invalid header line `{}`\", line.escape_debug())); }",
"        let (name, value) = match line.find(':') { Some(p) => (line[..p].trim(), line[p + 1..].trim()), None => return Err(format!(\"invalid header line `{}`\", line)) };",
"        if !tw_is_token(name) { return Err(format!(\"invalid header name `{}`\", name)); }",
"        let ln = name.to_ascii_lowercase();",
"        if ln == \"connection\" || ln == \"content-length\" || ln == \"transfer-encoding\" { continue; } // managed by the runtime",
"        if ln == \"host\" { has_host = true; }",
"        user_headers.push_str(&format!(\"{}: {}\\r\\n\", name, value));",
"    }",
"    let mut request = format!(\"{} {} HTTP/1.1\\r\\n\", method, target);",
"    if !has_host { request.push_str(&format!(\"Host: {}\\r\\n\", authority)); }",
"    request.push_str(\"Connection: close\\r\\n\");",
"    let upper = method.to_ascii_uppercase();",
"    if !body.is_empty() || upper == \"POST\" || upper == \"PUT\" || upper == \"PATCH\" { request.push_str(&format!(\"Content-Length: {}\\r\\n\", body.len())); }",
"    request.push_str(&user_headers);",
"    request.push_str(\"\\r\\n\");",
"    let mut out_bytes = request.into_bytes();",
"    out_bytes.extend_from_slice(body);",
"",
"    let addrs: Vec<std::net::SocketAddr> = match std::net::ToSocketAddrs::to_socket_addrs(&(host, port)) {",
"        Ok(a) => a.collect(),",
"        Err(e) => return Err(format!(\"cannot resolve {}: {}\", host_port, e)),",
"    };",
"    let timeout = std::time::Duration::from_secs(30);",
"    let mut last_err = format!(\"cannot resolve {}\", host_port);",
"    let mut stream = None;",
"    for a in addrs {",
"        match std::net::TcpStream::connect_timeout(&a, timeout) {",
"            Ok(s) => { stream = Some(s); break; }",
"            Err(e) => last_err = format!(\"cannot connect to {}: {}\", host_port, e),",
"        }",
"    }",
"    let mut stream = match stream { Some(s) => s, None => return Err(last_err) };",
"    let _ = stream.set_read_timeout(Some(timeout));",
"    let _ = stream.set_write_timeout(Some(timeout));",
"    if let Err(e) = stream.write_all(&out_bytes) { return Err(format!(\"cannot send the request to {}: {}\", host_port, e)); }",
"    let mut r = TwReader::new(stream);",
"    let rd_err = |e: TwRd| match e {",
"        TwRd::Eof => \"the connection was closed before the response was complete\".to_string(),",
"        TwRd::Io => \"error while reading the response (timeout or connection reset)\".to_string(),",
"        TwRd::TooLong => \"the response is too large\".to_string(),",
"    };",
"    let (status, reason, headers) = loop {",
"        let line = r.read_line(65536).map_err(rd_err)?;",
"        let line = String::from_utf8_lossy(&line).to_string();",
"        let mut parts = line.splitn(3, ' ');",
"        let version = parts.next().unwrap_or(\"\");",
"        let code = parts.next().unwrap_or(\"\");",
"        let reason = parts.next().unwrap_or(\"\").to_string();",
"        if !version.starts_with(\"HTTP/1.\") || code.len() != 3 { return Err(format!(\"invalid response status line `{}`\", line)); }",
"        let status: u16 = code.parse().map_err(|_| format!(\"invalid response status line `{}`\", line))?;",
"        let mut headers: Vec<(String, String)> = Vec::new();",
"        let mut total = 0;",
"        loop {",
"            let h = r.read_line(65536).map_err(rd_err)?;",
"            if h.is_empty() { break; }",
"            total += h.len();",
"            if total > 1024 * 1024 || headers.len() > 1000 { return Err(\"the response headers are too large\".to_string()); }",
"            let h = String::from_utf8_lossy(&h).to_string();",
"            match h.find(':') {",
"                Some(p) => headers.push((h[..p].trim().to_string(), h[p + 1..].trim().to_string())),",
"                None => return Err(format!(\"invalid response header `{}`\", h)),",
"            }",
"        }",
"        if (100..200).contains(&status) && status != 101 { continue; }",
"        break (status, reason, headers);",
"    };",
"    let header = |name: &str| -> Vec<&str> { headers.iter().filter(|(n, _)| n.eq_ignore_ascii_case(name)).map(|(_, v)| v.as_str()).collect() };",
"    let chunked = header(\"transfer-encoding\").iter().any(|v| v.to_ascii_lowercase().contains(\"chunked\"));",
"    let no_body = upper == \"HEAD\" || status == 204 || status == 304 || status < 200;",
"    let resp_body = if no_body {",
"        Vec::new()",
"    } else if chunked {",
"        match tw_read_chunked(&mut r, TW_CLIENT_MAX_RESPONSE) {",
"            Ok(b) => b,",
"            Err(TwBodyErr::TooLarge) => return Err(\"the response is too large\".to_string()),",
"            Err(TwBodyErr::Bad) => return Err(\"invalid chunked response body\".to_string()),",
"            Err(TwBodyErr::Closed) => return Err(\"the connection was closed before the response was complete\".to_string()),",
"        }",
"    } else if let Some(cl) = header(\"content-length\").first() {",
"        let n: usize = cl.parse().map_err(|_| format!(\"invalid Content-Length `{}`\", cl))?;",
"        if n > TW_CLIENT_MAX_RESPONSE { return Err(\"the response is too large\".to_string()); }",
"        r.read_exact_vec(n).map_err(rd_err)?",
"    } else {",
"        r.read_to_end_limit(TW_CLIENT_MAX_RESPONSE).map_err(rd_err)?",
"    };",
"    let mut out = format!(\"HTTP/1.1 {} {}\\r\\n\", status, reason).into_bytes();",
"    for (n, v) in &headers {",
"        if n.eq_ignore_ascii_case(\"transfer-encoding\") { continue; }",
"        out.extend_from_slice(format!(\"{}: {}\\r\\n\", n, v).as_bytes());",
"    }",
"    out.extend_from_slice(b\"\\r\\n\");",
"    out.extend_from_slice(&resp_body);",
"    Ok(out)",
"}",
"",
"// ===========================================================================",
"// 7. Web hosts",
"// ===========================================================================",
"",
"#[derive(Clone, Debug, PartialEq)]",
"pub struct RawRequest {",
"    pub method: String,",
"    pub path: String,",
"    pub query: String,",
"    pub remote_addr: String,",
"    pub headers: Vec<(String, String)>,",
"    pub body: Vec<u8>,",
"}",
"#[derive(Clone, Debug, PartialEq)]",
"pub struct RawResponse {",
"    pub status: u16,",
"    pub headers: Vec<(String, String)>,",
"    pub body: Vec<u8>,",
"}",
"",
"// ---- binary wire format (little-endian u32 lengths) -----------------------",
"",
"fn tw_put_u32(out: &mut Vec<u8>, v: u32) { out.extend_from_slice(&v.to_le_bytes()); }",
"fn tw_put_bytes(out: &mut Vec<u8>, b: &[u8]) { tw_put_u32(out, b.len() as u32); out.extend_from_slice(b); }",
"struct TwWire<'a> { b: &'a [u8], i: usize }",
"impl<'a> TwWire<'a> {",
"    fn remaining(&self) -> usize { self.b.len() - self.i }",
"    fn u32(&mut self) -> Option<u32> {",
"        if self.remaining() < 4 { return None; }",
"        let v = u32::from_le_bytes([self.b[self.i], self.b[self.i + 1], self.b[self.i + 2], self.b[self.i + 3]]);",
"        self.i += 4;",
"        Some(v)",
"    }",
"    fn bytes(&mut self) -> Option<&'a [u8]> {",
"        let n = self.u32()? as usize;",
"        if n > self.remaining() { return None; }",
"        let s = &self.b[self.i..self.i + n];",
"        self.i += n;",
"        Some(s)",
"    }",
"    fn text(&mut self) -> Option<String> { self.bytes().map(|b| String::from_utf8_lossy(b).to_string()) }",
"    fn headers(&mut self) -> Option<Vec<(String, String)>> {",
"        let count = self.u32()? as usize;",
"        if count > self.remaining() / 8 { return None; }",
"        let mut h = Vec::with_capacity(count);",
"        for _ in 0..count { let n = self.text()?; let v = self.text()?; h.push((n, v)); }",
"        Some(h)",
"    }",
"}",
"pub fn tw_encode_request(r: &RawRequest) -> Vec<u8> {",
"    let mut out = Vec::new();",
"    tw_put_u32(&mut out, 1);",
"    tw_put_bytes(&mut out, r.method.as_bytes());",
"    tw_put_bytes(&mut out, r.path.as_bytes());",
"    tw_put_bytes(&mut out, r.query.as_bytes());",
"    tw_put_bytes(&mut out, r.remote_addr.as_bytes());",
"    tw_put_u32(&mut out, r.headers.len() as u32);",
"    for (n, v) in &r.headers { tw_put_bytes(&mut out, n.as_bytes()); tw_put_bytes(&mut out, v.as_bytes()); }",
"    tw_put_bytes(&mut out, &r.body);",
"    out",
"}",
"pub fn tw_decode_request(b: &[u8]) -> Option<RawRequest> {",
"    let mut w = TwWire { b, i: 0 };",
"    if w.u32()? != 1 { return None; }",
"    let method = w.text()?;",
"    let path = w.text()?;",
"    let query = w.text()?;",
"    let remote_addr = w.text()?;",
"    let headers = w.headers()?;",
"    let body = w.bytes()?.to_vec();",
"    if w.remaining() != 0 { return None; }",
"    Some(RawRequest { method, path, query, remote_addr, headers, body })",
"}",
"pub fn tw_encode_response(r: &RawResponse) -> Vec<u8> {",
"    let mut out = Vec::new();",
"    tw_put_u32(&mut out, 1);",
"    tw_put_u32(&mut out, r.status as u32);",
"    tw_put_u32(&mut out, r.headers.len() as u32);",
"    for (n, v) in &r.headers { tw_put_bytes(&mut out, n.as_bytes()); tw_put_bytes(&mut out, v.as_bytes()); }",
"    tw_put_bytes(&mut out, &r.body);",
"    out",
"}",
"pub fn tw_decode_response(b: &[u8]) -> Option<RawResponse> {",
"    let mut w = TwWire { b, i: 0 };",
"    if w.u32()? != 1 { return None; }",
"    let status = u16::try_from(w.u32()?).ok()?;",
"    let headers = w.headers()?;",
"    let body = w.bytes()?.to_vec();",
"    if w.remaining() != 0 { return None; }",
"    Some(RawResponse { status, headers, body })",
"}",
"",
"// ---- running one request ----------------------------------------------------",
"",
"fn tw_env_u64(name: &str, default: u64) -> u64 {",
"    match std::env::var(name) { Ok(v) => v.trim().parse::<u64>().unwrap_or(default), Err(_) => default }",
"}",
"fn tw_max_body() -> usize {",
"    (tw_env_u64(\"TESSERA_MAX_BODY_MB\", 10) as usize).saturating_mul(1024 * 1024)",
"}",
"fn tw_text_response(status: u16, text: &str) -> RawResponse {",
"    RawResponse { status, headers: vec![(\"content-type\".to_string(), \"text/plain; charset=utf-8\".to_string())], body: text.as_bytes().to_vec() }",
"}",
"fn tw_status_response(status: u16) -> RawResponse { tw_text_response(status, &format!(\"{}\\n\", tw_reason(status))) }",
"fn tw_log(message: &str) {",
"    let err = std::io::stderr();",
"    let mut lock = err.lock();",
"    let _ = lock.write_all(message.as_bytes());",
"    let _ = lock.flush();",
"}",
"",
"static TW_PANIC_HOOK: std::sync::Once = std::sync::Once::new();",
"",
"pub fn tw_run_request(app: fn(RawRequest) -> RawResponse, req: RawRequest) -> RawResponse {",
"    TW_PANIC_HOOK.call_once(|| t_install_panic_hook());",
"    let stack_mb = match tw_env_u64(\"TESSERA_STACK_MB\", 64) { 0 => 64, v => v };",
"    let stack_bytes = (stack_mb as usize).saturating_mul(1024 * 1024);",
"    let time_ms = tw_env_u64(\"TESSERA_TIME_LIMIT_MS\", 30_000);",
"    let memory_bytes = tw_env_u64(\"TESSERA_MEMORY_LIMIT_MB\", 512).saturating_mul(1024 * 1024);",
"    let spawned = std::thread::Builder::new()",
"        .name(\"tessera-request\".to_string())",
"        .stack_size(stack_bytes)",
"        .spawn(move || {",
"            t_limits_begin(stack_bytes, time_ms, memory_bytes);",
"            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| app(req)))",
"        });",
"    let handle = match spawned {",
"        Ok(h) => h,",
"        Err(e) => {",
"            tw_log(&format!(\"runtime error R000: cannot start a thread for the request: {}\\n\", e));",
"            return tw_status_response(503);",
"        }",
"    };",
"    let payload = match handle.join() {",
"        Ok(Ok(resp)) => return resp,",
"        Ok(Err(p)) => p,",
"        Err(p) => p,",
"    };",
"    if let Some(f) = payload.downcast_ref::<TFailure>() {",
"        tw_log(&format!(\"runtime error {}: {}\\n  at {}\\n\", f.code, f.message, f.location));",
"    } else if payload.downcast_ref::<TExit>().is_some() {",
"        tw_log(\"runtime error R017: exit called while handling a request\\n\");",
"    } else if let Some(s) = payload.downcast_ref::<&str>() {",
"        tw_log(&format!(\"runtime error R000: panic while handling a request: {}\\n\", s));",
"    } else if let Some(s) = payload.downcast_ref::<String>() {",
"        tw_log(&format!(\"runtime error R000: panic while handling a request: {}\\n\", s));",
"    } else {",
"        tw_log(\"runtime error R000: panic while handling a request\\n\");",
"    }",
"    tw_text_response(500, \"Internal Server Error\\n\")",
"}",
"",
"pub fn tw_library_handle(app: fn(RawRequest) -> RawResponse, input: &[u8]) -> Vec<u8> {",
"    match tw_decode_request(input) {",
"        Some(req) => tw_encode_response(&tw_run_request(app, req)),",
"        None => tw_encode_response(&tw_text_response(400, \"Bad Request\\n\")),",
"    }",
"}",
"",
"/// Whether an application-provided response header may be sent.",
"fn tw_header_allowed(name: &str, value: &str, cgi: bool) -> bool {",
"    if !tw_is_token(name) || value.bytes().any(|c| c == b'\\r' || c == b'\\n' || c == 0) { return false; }",
"    let n = name.to_ascii_lowercase();",
"    !(n == \"content-length\" || n == \"transfer-encoding\" || n == \"connection\" || (cgi && n == \"status\"))",
"}",
"fn tw_valid_status(status: u16) -> u16 { if (200..=599).contains(&status) { status } else { 500 } }",
"",
"// ---- CGI -----------------------------------------------------------------------",
"",
"/// Builds a request from CGI-style variables (also used for FastCGI PARAMS).",
"/// Without CONTENT_LENGTH the body is empty, unless `read_all_without_length`.",
"/// Err(status) for a malformed (400) or too large (413) request.",
"pub fn tw_cgi_request(vars: &[(String, String)], body: &mut dyn std::io::Read, max_body: usize, read_all_without_length: bool) -> Result<RawRequest, u16> {",
"    let get = |name: &str| -> Option<&str> { vars.iter().find(|(n, _)| n == name).map(|(_, v)| v.as_str()).filter(|v| !v.is_empty()) };",
"    let method = get(\"REQUEST_METHOD\").unwrap_or(\"GET\").to_string();",
"    if !tw_is_token(&method) { return Err(400); }",
"    let path = match get(\"REQUEST_URI\").map(|u| u.split('?').next().unwrap_or(\"\")).filter(|p| !p.is_empty()) {",
"        Some(p) => p.to_string(),",
"        None => get(\"PATH_INFO\").unwrap_or(\"/\").to_string(),",
"    };",
"    let query = get(\"QUERY_STRING\").unwrap_or(\"\").to_string();",
"    let remote_addr = get(\"REMOTE_ADDR\").unwrap_or(\"\").to_string();",
"    let mut headers = Vec::new();",
"    for (n, v) in vars {",
"        if let Some(rest) = n.strip_prefix(\"HTTP_\") {",
"            if rest.is_empty() { continue; }",
"            headers.push((rest.to_ascii_lowercase().replace('_', \"-\"), v.clone()));",
"        } else if n == \"CONTENT_TYPE\" && !v.is_empty() {",
"            headers.push((\"content-type\".to_string(), v.clone()));",
"        } else if n == \"CONTENT_LENGTH\" && !v.is_empty() {",
"            headers.push((\"content-length\".to_string(), v.clone()));",
"        }",
"    }",
"    let mut data = Vec::new();",
"    match get(\"CONTENT_LENGTH\") {",
"        Some(cl) => {",
"            let cl = cl.trim();",
"            if cl.is_empty() || cl.len() > 19 || !cl.bytes().all(|c| c.is_ascii_digit()) { return Err(400); }",
"            let n: u64 = cl.parse().map_err(|_| 400u16)?;",
"            if n > max_body as u64 { return Err(413); }",
"            if body.take(n).read_to_end(&mut data).is_err() || data.len() as u64 != n { return Err(400); }",
"        }",
"        None => {",
"            if read_all_without_length {",
"                if body.take(max_body as u64 + 1).read_to_end(&mut data).is_err() { return Err(400); }",
"                if data.len() > max_body { return Err(413); }",
"            }",
"        }",
"    }",
"    Ok(RawRequest { method, path, query, remote_addr, headers, body: data })",
"}",
"",
"/// A response in CGI format: `Status:` line, headers, blank line, body.",
"pub fn tw_cgi_response_bytes(resp: &RawResponse, head: bool) -> Vec<u8> {",
"    let status = tw_valid_status(resp.status);",
"    let mut out = format!(\"Status: {} {}\\r\\n\", status, tw_reason(status));",
"    for (n, v) in &resp.headers {",
"        if tw_header_allowed(n, v, true) { out.push_str(&format!(\"{}: {}\\r\\n\", n, v)); }",
"    }",
"    if status != 204 && status != 304 { out.push_str(&format!(\"Content-Length: {}\\r\\n\", resp.body.len())); }",
"    out.push_str(\"\\r\\n\");",
"    let mut bytes = out.into_bytes();",
"    if !head && status != 204 && status != 304 { bytes.extend_from_slice(&resp.body); }",
"    bytes",
"}",
"",
"fn tw_cgi_main(app: fn(RawRequest) -> RawResponse) {",
"    let vars: Vec<(String, String)> = std::env::vars_os()",
"        .map(|(k, v)| (k.to_string_lossy().to_string(), v.to_string_lossy().to_string()))",
"        .collect();",
"    let stdin = std::io::stdin();",
"    let mut lock = stdin.lock();",
"    let bytes = match tw_cgi_request(&vars, &mut lock, tw_max_body(), false) {",
"        Ok(req) => {",
"            let head = req.method == \"HEAD\";",
"            tw_cgi_response_bytes(&tw_run_request(app, req), head)",
"        }",
"        Err(code) => tw_cgi_response_bytes(&tw_status_response(code), false),",
"    };",
"    let out = std::io::stdout();",
"    let mut o = out.lock();",
"    let _ = o.write_all(&bytes);",
"    let _ = o.flush();",
"}",
"",
"// ---- HTTP/1.1 server ----------------------------------------------------------",
"",
"const TW_MAX_CONNECTIONS: usize = 256;",
"const TW_HEAD_LIMIT: usize = 64 * 1024;",
"const TW_MAX_HEADERS: usize = 100;",
"",
"struct TwConnGuard(std::sync::Arc<std::sync::atomic::AtomicUsize>);",
"impl Drop for TwConnGuard {",
"    fn drop(&mut self) { self.0.fetch_sub(1, std::sync::atomic::Ordering::SeqCst); }",
"}",
"",
"/// HTTP/1.1 response bytes with Content-Length, Date and Connection headers.",
"fn tw_http_response_bytes(resp: &RawResponse, head: bool, keep_alive: bool) -> Vec<u8> {",
"    let status = tw_valid_status(resp.status);",
"    let mut out = format!(\"HTTP/1.1 {} {}\\r\\n\", status, tw_reason(status));",
"    let mut has_date = false;",
"    for (n, v) in &resp.headers {",
"        if !tw_header_allowed(n, v, false) { continue; }",
"        if n.eq_ignore_ascii_case(\"date\") { has_date = true; }",
"        out.push_str(&format!(\"{}: {}\\r\\n\", n, v));",
"    }",
"    if !has_date { out.push_str(&format!(\"Date: {}\\r\\n\", tw_http_date(tw_now_ms()))); }",
"    let bodyless = status == 204 || status == 304;",
"    if !bodyless { out.push_str(&format!(\"Content-Length: {}\\r\\n\", resp.body.len())); }",
"    out.push_str(if keep_alive { \"Connection: keep-alive\\r\\n\" } else { \"Connection: close\\r\\n\" });",
"    out.push_str(\"\\r\\n\");",
"    let mut bytes = out.into_bytes();",
"    if !head && !bodyless { bytes.extend_from_slice(&resp.body); }",
"    bytes",
"}",
"",
"enum TwReqErr { Closed, Status(u16) }",
"",
"/// Reads one request. Ok((request, keep_alive)).",
"fn tw_http_read_request<R: std::io::Read>(r: &mut TwReader<R>, w: &mut dyn std::io::Write, remote: &str, max_body: usize) -> Result<(RawRequest, bool), TwReqErr> {",
"    let mut used = 0usize;",
"    let line = loop {",
"        match r.read_line(TW_HEAD_LIMIT.saturating_sub(used)) {",
"            Ok(l) => {",
"                used += l.len() + 2;",
"                if used > TW_HEAD_LIMIT { return Err(TwReqErr::Status(431)); }",
"                if l.is_empty() { continue; } // tolerate empty lines before a request",
"                break l;",
"            }",
"            Err(TwRd::TooLong) => return Err(TwReqErr::Status(431)),",
"            Err(_) => return Err(TwReqErr::Closed),",
"        }",
"    };",
"    let line = String::from_utf8(line).map_err(|_| TwReqErr::Status(400))?;",
"    let parts: Vec<&str> = line.split(' ').collect();",
"    if parts.len() != 3 { return Err(TwReqErr::Status(400)); }",
"    let (method, target, version) = (parts[0], parts[1], parts[2]);",
"    if !tw_is_token(method) { return Err(TwReqErr::Status(400)); }",
"    let v11 = match version {",
"        \"HTTP/1.1\" => true,",
"        \"HTTP/1.0\" => false,",
"        v if v.starts_with(\"HTTP/\") => return Err(TwReqErr::Status(505)),",
"        _ => return Err(TwReqErr::Status(400)),",
"    };",
"    if target.is_empty() || target.bytes().any(|c| c <= 0x20 || c == 0x7f) { return Err(TwReqErr::Status(400)); }",
"    let origin = if target.starts_with('/') || target == \"*\" {",
"        target.to_string()",
"    } else {",
"        let lower = target.to_ascii_lowercase();",
"        let rest = if lower.starts_with(\"http://\") { &target[7..] } else if lower.starts_with(\"https://\") { &target[8..] } else { return Err(TwReqErr::Status(400)) };",
"        match rest.find(|c| c == '/' || c == '?') { Some(p) if rest.as_bytes()[p] == b'/' => rest[p..].to_string(), Some(p) => format!(\"/{}\", &rest[p..]), None => \"/\".to_string() }",
"    };",
"    let (path, query) = match origin.find('?') { Some(p) => (origin[..p].to_string(), origin[p + 1..].to_string()), None => (origin, String::new()) };",
"",
"    let mut headers: Vec<(String, String)> = Vec::new();",
"    loop {",
"        let h = match r.read_line(TW_HEAD_LIMIT.saturating_sub(used)) {",
"            Ok(h) => h,",
"            Err(TwRd::TooLong) => return Err(TwReqErr::Status(431)),",
"            Err(_) => return Err(TwReqErr::Closed),",
"        };",
"        used += h.len() + 2;",
"        if used > TW_HEAD_LIMIT { return Err(TwReqErr::Status(431)); }",
"        if h.is_empty() { break; }",
"        if headers.len() >= TW_MAX_HEADERS { return Err(TwReqErr::Status(431)); }",
"        if h[0] == b' ' || h[0] == b'\\t' { return Err(TwReqErr::Status(400)); } // obsolete line folding",
"        let colon = match h.iter().position(|&c| c == b':') { Some(p) => p, None => return Err(TwReqErr::Status(400)) };",
"        let name = String::from_utf8_lossy(&h[..colon]).to_string();",
"        if !tw_is_token(&name) { return Err(TwReqErr::Status(400)); }",
"        let value = &h[colon + 1..];",
"        if value.iter().any(|&c| c == b'\\r' || c == 0) { return Err(TwReqErr::Status(400)); }",
"        let value = String::from_utf8_lossy(value).trim_matches(|c| c == ' ' || c == '\\t').to_string();",
"        headers.push((name.to_ascii_lowercase(), value));",
"    }",
"    let values = |name: &str| -> Vec<String> { headers.iter().filter(|(n, _)| n == name).map(|(_, v)| v.clone()).collect() };",
"    if v11 && values(\"host\").is_empty() { return Err(TwReqErr::Status(400)); }",
"    let connection: Vec<String> = values(\"connection\").iter().flat_map(|v| v.split(',').map(|t| t.trim().to_ascii_lowercase()).collect::<Vec<_>>()).collect();",
"    let keep_alive = if v11 { !connection.iter().any(|t| t == \"close\") } else { connection.iter().any(|t| t == \"keep-alive\") };",
"    let te: Vec<String> = values(\"transfer-encoding\").iter().flat_map(|v| v.split(',').map(|t| t.trim().to_ascii_lowercase()).collect::<Vec<_>>()).filter(|t| !t.is_empty()).collect();",
"    let cl_values = values(\"content-length\");",
"    let chunked = !te.is_empty();",
"    if chunked {",
"        if !cl_values.is_empty() || !v11 { return Err(TwReqErr::Status(400)); }",
"        if te != [\"chunked\"] { return Err(TwReqErr::Status(501)); }",
"    }",
"    let mut content_length: Option<u64> = None;",
"    for v in &cl_values {",
"        for part in v.split(',') {",
"            let p = part.trim();",
"            if p.is_empty() || p.len() > 19 || !p.bytes().all(|c| c.is_ascii_digit()) { return Err(TwReqErr::Status(400)); }",
"            let n: u64 = p.parse().map_err(|_| TwReqErr::Status(400))?;",
"            if content_length.map_or(false, |c| c != n) { return Err(TwReqErr::Status(400)); }",
"            content_length = Some(n);",
"        }",
"    }",
"    if let Some(n) = content_length { if n > max_body as u64 { return Err(TwReqErr::Status(413)); } }",
"    let expects = values(\"expect\");",
"    if let Some(e) = expects.first() {",
"        if !e.eq_ignore_ascii_case(\"100-continue\") { return Err(TwReqErr::Status(417)); }",
"        if v11 && (chunked || content_length.unwrap_or(0) > 0) {",
"            if w.write_all(b\"HTTP/1.1 100 Continue\\r\\n\\r\\n\").and_then(|_| w.flush()).is_err() { return Err(TwReqErr::Closed); }",
"        }",
"    }",
"    let body = if chunked {",
"        match tw_read_chunked(r, max_body) {",
"            Ok(b) => b,",
"            Err(TwBodyErr::TooLarge) => return Err(TwReqErr::Status(413)),",
"            Err(TwBodyErr::Bad) => return Err(TwReqErr::Status(400)),",
"            Err(TwBodyErr::Closed) => return Err(TwReqErr::Closed),",
"        }",
"    } else if let Some(n) = content_length {",
"        r.read_exact_vec(n as usize).map_err(|_| TwReqErr::Closed)?",
"    } else {",
"        Vec::new()",
"    };",
"    Ok((RawRequest { method: method.to_string(), path, query, remote_addr: remote.to_string(), headers, body }, keep_alive))",
"}",
"",
"fn tw_http_connection(app: fn(RawRequest) -> RawResponse, stream: std::net::TcpStream, max_body: usize) {",
"    let timeout = Some(std::time::Duration::from_secs(30));",
"    let _ = stream.set_read_timeout(timeout);",
"    let _ = stream.set_write_timeout(timeout);",
"    let _ = stream.set_nodelay(true);",
"    let remote = stream.peer_addr().map(|a| a.ip().to_string()).unwrap_or_default();",
"    let mut writer = match stream.try_clone() { Ok(s) => s, Err(_) => return };",
"    let mut reader = TwReader::new(stream);",
"    loop {",
"        match tw_http_read_request(&mut reader, &mut writer, &remote, max_body) {",
"            Err(TwReqErr::Closed) => return,",
"            Err(TwReqErr::Status(code)) => {",
"                let _ = writer.write_all(&tw_http_response_bytes(&tw_status_response(code), false, false));",
"                let _ = writer.flush();",
"                let _ = writer.shutdown(std::net::Shutdown::Write);",
"                return;",
"            }",
"            Ok((req, keep_alive)) => {",
"                let head = req.method == \"HEAD\";",
"                let resp = tw_run_request(app, req);",
"                if writer.write_all(&tw_http_response_bytes(&resp, head, keep_alive)).and_then(|_| writer.flush()).is_err() { return; }",
"                if !keep_alive { let _ = writer.shutdown(std::net::Shutdown::Write); return; }",
"            }",
"        }",
"    }",
"}",
"",
"fn tw_accept_loop(app: fn(RawRequest) -> RawResponse, listener: std::net::TcpListener, fastcgi: bool) -> ! {",
"    let active = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));",
"    let max_body = tw_max_body();",
"    loop {",
"        match listener.accept() {",
"            Ok((mut stream, _)) => {",
"                if active.load(std::sync::atomic::Ordering::SeqCst) >= TW_MAX_CONNECTIONS {",
"                    if !fastcgi {",
"                        let _ = stream.set_write_timeout(Some(std::time::Duration::from_secs(1)));",
"                        let _ = stream.write_all(&tw_http_response_bytes(&tw_status_response(503), false, false));",
"                    }",
"                    continue;",
"                }",
"                active.fetch_add(1, std::sync::atomic::Ordering::SeqCst);",
"                let guard = TwConnGuard(active.clone());",
"                let _ = std::thread::Builder::new().name(\"tessera-connection\".to_string()).spawn(move || {",
"                    let _guard = guard;",
"                    if fastcgi { tw_fcgi_connection(app, stream, max_body) } else { tw_http_connection(app, stream, max_body) }",
"                });",
"            }",
"            Err(_) => std::thread::sleep(std::time::Duration::from_millis(10)),",
"        }",
"    }",
"}",
"",
"/// HTTP/1.1 server on an already bound listener. Never returns.",
"pub fn tw_serve_listener(app: fn(RawRequest) -> RawResponse, listener: std::net::TcpListener) -> ! {",
"    tw_accept_loop(app, listener, false)",
"}",
"fn tw_host_port_text(host: &str, port: u16) -> String {",
"    if host.contains(':') { format!(\"[{}]:{}\", host, port) } else { format!(\"{}:{}\", host, port) }",
"}",
"/// Binds host:port and runs the HTTP/1.1 server; returns only if binding fails.",
"pub fn tw_serve(app: fn(RawRequest) -> RawResponse, host: &str, port: u16) -> std::io::Result<()> {",
"    let listener = std::net::TcpListener::bind((host, port))?;",
"    tw_log(&format!(\"listening on http://{}\\n\", tw_host_port_text(host, port)));",
"    tw_serve_listener(app, listener)",
"}",
"",
"// ---- FastCGI responder ----------------------------------------------------------",
"",
"const TW_FCGI_BEGIN_REQUEST: u8 = 1;",
"const TW_FCGI_ABORT_REQUEST: u8 = 2;",
"const TW_FCGI_END_REQUEST: u8 = 3;",
"const TW_FCGI_PARAMS: u8 = 4;",
"const TW_FCGI_STDIN: u8 = 5;",
"const TW_FCGI_STDOUT: u8 = 6;",
"const TW_FCGI_DATA: u8 = 8;",
"const TW_FCGI_GET_VALUES: u8 = 9;",
"const TW_FCGI_GET_VALUES_RESULT: u8 = 10;",
"const TW_FCGI_UNKNOWN_TYPE: u8 = 11;",
"",
"fn tw_fcgi_record(ty: u8, id: u16, content: &[u8]) -> Vec<u8> {",
"    let len = content.len().min(65535);",
"    let pad = (8 - len % 8) % 8;",
"    let mut out = Vec::with_capacity(8 + len + pad);",
"    out.extend_from_slice(&[1, ty, (id >> 8) as u8, id as u8, (len >> 8) as u8, len as u8, pad as u8, 0]);",
"    out.extend_from_slice(&content[..len]);",
"    out.extend(std::iter::repeat(0u8).take(pad));",
"    out",
"}",
"fn tw_fcgi_end_request(id: u16, app_status: u32, protocol_status: u8) -> Vec<u8> {",
"    let s = app_status.to_be_bytes();",
"    tw_fcgi_record(TW_FCGI_END_REQUEST, id, &[s[0], s[1], s[2], s[3], protocol_status, 0, 0, 0])",
"}",
"fn tw_fcgi_read_record<R: std::io::Read>(r: &mut R) -> Option<(u8, u16, Vec<u8>)> {",
"    let mut h = [0u8; 8];",
"    r.read_exact(&mut h).ok()?;",
"    if h[0] != 1 { return None; }",
"    let id = u16::from_be_bytes([h[2], h[3]]);",
"    let len = u16::from_be_bytes([h[4], h[5]]) as usize;",
"    let mut content = vec![0u8; len];",
"    r.read_exact(&mut content).ok()?;",
"    let mut pad = vec![0u8; h[6] as usize];",
"    r.read_exact(&mut pad).ok()?;",
"    Some((h[1], id, content))",
"}",
"pub fn tw_fcgi_encode_pair(out: &mut Vec<u8>, name: &[u8], value: &[u8]) {",
"    for len in [name.len(), value.len()] {",
"        if len < 128 { out.push(len as u8); } else { out.extend_from_slice(&((len as u32) | 0x8000_0000).to_be_bytes()); }",
"    }",
"    out.extend_from_slice(name);",
"    out.extend_from_slice(value);",
"}",
"pub fn tw_fcgi_decode_pairs(b: &[u8]) -> Option<Vec<(Vec<u8>, Vec<u8>)>> {",
"    let mut i = 0;",
"    let mut out = Vec::new();",
"    let read_len = |i: &mut usize| -> Option<usize> {",
"        let first = *b.get(*i)?;",
"        if first < 128 { *i += 1; return Some(first as usize); }",
"        let s = b.get(*i..*i + 4)?;",
"        *i += 4;",
"        Some((u32::from_be_bytes([s[0], s[1], s[2], s[3]]) & 0x7FFF_FFFF) as usize)",
"    };",
"    while i < b.len() {",
"        let nl = read_len(&mut i)?;",
"        let vl = read_len(&mut i)?;",
"        if nl > b.len() - i { return None; }",
"        let name = b[i..i + nl].to_vec();",
"        i += nl;",
"        if vl > b.len() - i { return None; }",
"        let value = b[i..i + vl].to_vec();",
"        i += vl;",
"        out.push((name, value));",
"    }",
"    Some(out)",
"}",
"",
"struct TwFcgiRequest { id: u16, keep: bool, params: Vec<u8>, params_too_large: bool, stdin: Vec<u8>, too_large: bool }",
"",
"fn tw_fcgi_handle(app: fn(RawRequest) -> RawResponse, req: &TwFcgiRequest, max_body: usize) -> Vec<u8> {",
"    if req.params_too_large { return tw_cgi_response_bytes(&tw_status_response(431), false); }",
"    if req.too_large { return tw_cgi_response_bytes(&tw_status_response(413), false); }",
"    let pairs = match tw_fcgi_decode_pairs(&req.params) { Some(p) => p, None => return tw_cgi_response_bytes(&tw_status_response(400), false) };",
"    let vars: Vec<(String, String)> = pairs.iter().map(|(n, v)| (String::from_utf8_lossy(n).to_string(), String::from_utf8_lossy(v).to_string())).collect();",
"    let mut stdin: &[u8] = &req.stdin;",
"    match tw_cgi_request(&vars, &mut stdin, max_body, true) {",
"        Ok(r) => {",
"            let head = r.method == \"HEAD\";",
"            tw_cgi_response_bytes(&tw_run_request(app, r), head)",
"        }",
"        Err(code) => tw_cgi_response_bytes(&tw_status_response(code), false),",
"    }",
"}",
"",
"fn tw_fcgi_connection(app: fn(RawRequest) -> RawResponse, stream: std::net::TcpStream, max_body: usize) {",
"    let timeout = Some(std::time::Duration::from_secs(30));",
"    let _ = stream.set_read_timeout(timeout);",
"    let _ = stream.set_write_timeout(timeout);",
"    let mut w = match stream.try_clone() { Ok(s) => s, Err(_) => return };",
"    let mut r = std::io::BufReader::new(stream);",
"    let mut cur: Option<TwFcgiRequest> = None;",
"    loop {",
"        let (ty, id, content) = match tw_fcgi_read_record(&mut r) { Some(x) => x, None => return };",
"        let mut out: Vec<u8> = Vec::new();",
"        let mut close = false;",
"        match ty {",
"            TW_FCGI_GET_VALUES if id == 0 => {",
"                let mut result = Vec::new();",
"                for (name, _) in tw_fcgi_decode_pairs(&content).unwrap_or_default() {",
"                    let value: &[u8] = match name.as_slice() {",
"                        b\"FCGI_MAX_CONNS\" => b\"256\",",
"                        b\"FCGI_MAX_REQS\" => b\"256\",",
"                        b\"FCGI_MPXS_CONNS\" => b\"0\",",
"                        _ => continue,",
"                    };",
"                    tw_fcgi_encode_pair(&mut result, &name, value);",
"                }",
"                out = tw_fcgi_record(TW_FCGI_GET_VALUES_RESULT, 0, &result);",
"            }",
"            TW_FCGI_BEGIN_REQUEST if id != 0 => {",
"                if content.len() < 8 { continue; }",
"                let role = u16::from_be_bytes([content[0], content[1]]);",
"                let keep = content[2] & 1 != 0;",
"                if let Some(c) = &cur {",
"                    if c.id != id { out = tw_fcgi_end_request(id, 0, 1); } // FCGI_CANT_MPX_CONN",
"                } else if role != 1 {",
"                    out = tw_fcgi_end_request(id, 0, 3); // FCGI_UNKNOWN_ROLE",
"                    close = !keep;",
"                } else {",
"                    cur = Some(TwFcgiRequest { id, keep, params: Vec::new(), params_too_large: false, stdin: Vec::new(), too_large: false });",
"                }",
"            }",
"            TW_FCGI_ABORT_REQUEST => {",
"                if cur.as_ref().map_or(false, |c| c.id == id) {",
"                    let c = cur.take();",
"                    out = tw_fcgi_end_request(id, 0, 0);",
"                    close = !c.map_or(false, |c| c.keep);",
"                }",
"            }",
"            TW_FCGI_PARAMS => {",
"                if let Some(c) = cur.as_mut().filter(|c| c.id == id) {",
"                    if c.params.len() + content.len() > 1024 * 1024 { c.params_too_large = true; } else { c.params.extend_from_slice(&content); }",
"                }",
"            }",
"            TW_FCGI_STDIN => {",
"                if cur.as_ref().map_or(false, |c| c.id == id) {",
"                    if content.is_empty() {",
"                        if let Some(c) = cur.take() {",
"                            let resp = tw_fcgi_handle(app, &c, max_body);",
"                            for chunk in resp.chunks(32768) { out.extend_from_slice(&tw_fcgi_record(TW_FCGI_STDOUT, id, chunk)); }",
"                            out.extend_from_slice(&tw_fcgi_record(TW_FCGI_STDOUT, id, &[]));",
"                            out.extend_from_slice(&tw_fcgi_end_request(id, 0, 0));",
"                            close = !c.keep;",
"                        }",
"                    } else if let Some(c) = cur.as_mut() {",
"                        if c.too_large || c.stdin.len() + content.len() > max_body {",
"                            c.too_large = true;",
"                            c.stdin = Vec::new();",
"                        } else {",
"                            c.stdin.extend_from_slice(&content);",
"                        }",
"                    }",
"                }",
"            }",
"            TW_FCGI_DATA => {}",
"            _ => {",
"                if id == 0 { out = tw_fcgi_record(TW_FCGI_UNKNOWN_TYPE, 0, &[ty, 0, 0, 0, 0, 0, 0, 0]); }",
"            }",
"        }",
"        if !out.is_empty() && w.write_all(&out).and_then(|_| w.flush()).is_err() { return; }",
"        if close { let _ = w.shutdown(std::net::Shutdown::Both); return; }",
"    }",
"}",
"",
"/// FastCGI responder on an already bound listener. Never returns.",
"pub fn tw_fastcgi_serve_listener(app: fn(RawRequest) -> RawResponse, listener: std::net::TcpListener) -> ! {",
"    tw_accept_loop(app, listener, true)",
"}",
"/// Binds host:port and runs the FastCGI responder; returns only if binding fails.",
"pub fn tw_fastcgi_serve(app: fn(RawRequest) -> RawResponse, host: &str, port: u16) -> std::io::Result<()> {",
"    let listener = std::net::TcpListener::bind((host, port))?;",
"    tw_log(&format!(\"listening for FastCGI on {}\\n\", tw_host_port_text(host, port)));",
"    tw_fastcgi_serve_listener(app, listener)",
"}",
"",
"// ---- one-shot request host and main ---------------------------------------------",
"",
"fn tw_usage() -> ! {",
"    let program = std::env::args().next().unwrap_or_else(|| \"app\".to_string());",
"    tw_log(&format!(",
"        \"usage:\\n  {0} serve [--host HOST] [--port PORT]      HTTP/1.1 server (default 127.0.0.1:8080)\\n  {0} fastcgi [--host HOST] [--port PORT]    FastCGI responder (default 127.0.0.1:9000)\\n  {0} request METHOD PATH[?QUERY] [-H \\\"Name: value\\\"]... [--body TEXT]\\n  run as a CGI program when GATEWAY_INTERFACE is set\\n\",",
"        program));",
"    std::process::exit(2)",
"}",
"fn tw_parse_host_port(args: &[String], default_port: u16) -> (String, u16) {",
"    let mut host = \"127.0.0.1\".to_string();",
"    let mut port = default_port;",
"    let mut i = 0;",
"    while i < args.len() {",
"        match (args[i].as_str(), args.get(i + 1)) {",
"            (\"--host\", Some(h)) if !h.is_empty() => host = h.clone(),",
"            (\"--port\", Some(p)) => match p.parse::<u16>() { Ok(v) => port = v, Err(_) => tw_usage() },",
"            _ => tw_usage(),",
"        }",
"        i += 2;",
"    }",
"    (host, port)",
"}",
"fn tw_default_http_port() -> u16 {",
"    for name in [\"HTTP_PLATFORM_PORT\", \"ASPNETCORE_PORT\", \"PORT\"] {",
"        if let Ok(v) = std::env::var(name) { if let Ok(p) = v.trim().parse::<u16>() { return p; } }",
"    }",
"    8080",
"}",
"",
"/// `request` host: runs one request and returns the printed output.",
"pub fn tw_request_command(app: fn(RawRequest) -> RawResponse, args: &[String]) -> Option<Vec<u8>> {",
"    if args.len() < 2 { return None; }",
"    let method = args[0].clone();",
"    if !tw_is_token(&method) { return None; }",
"    let (path, query) = match args[1].find('?') { Some(p) => (args[1][..p].to_string(), args[1][p + 1..].to_string()), None => (args[1].clone(), String::new()) };",
"    let mut headers: Vec<(String, String)> = Vec::new();",
"    let mut body = Vec::new();",
"    let mut i = 2;",
"    while i < args.len() {",
"        match (args[i].as_str(), args.get(i + 1)) {",
"            (\"-H\", Some(h)) => {",
"                let p = h.find(':')?;",
"                let name = h[..p].trim();",
"                if !tw_is_token(name) { return None; }",
"                headers.push((name.to_ascii_lowercase(), h[p + 1..].trim().to_string()));",
"            }",
"            (\"--body\", Some(b)) => body = b.as_bytes().to_vec(),",
"            _ => return None,",
"        }",
"        i += 2;",
"    }",
"    if !body.is_empty() && !headers.iter().any(|(n, _)| n == \"content-length\") {",
"        headers.push((\"content-length\".to_string(), body.len().to_string()));",
"    }",
"    let head = method == \"HEAD\";",
"    let resp = tw_run_request(app, RawRequest { method, path, query, remote_addr: \"127.0.0.1\".to_string(), headers, body });",
"    let mut out = format!(\"HTTP/1.1 {} {}\\n\", resp.status, tw_reason(resp.status));",
"    for (n, v) in &resp.headers {",
"        out.push_str(&format!(\"{}: {}\\n\", n.replace(['\\r', '\\n'], \" \"), v.replace(['\\r', '\\n'], \" \")));",
"    }",
"    out.push('\\n');",
"    let mut bytes = out.into_bytes();",
"    if !head { bytes.extend_from_slice(&resp.body); }",
"    Some(bytes)",
"}",
"",
"/// `main` of a compiled web application.",
"pub fn tw_web_main(app: fn(RawRequest) -> RawResponse) {",
"    if std::env::var(\"GATEWAY_INTERFACE\").map_or(false, |g| g.starts_with(\"CGI/\")) {",
"        tw_cgi_main(app);",
"        return;",
"    }",
"    let args: Vec<String> = std::env::args_os().skip(1).map(|a| a.to_string_lossy().to_string()).collect();",
"    let iis = std::env::var(\"HTTP_PLATFORM_PORT\").is_ok() || std::env::var(\"ASPNETCORE_PORT\").is_ok();",
"    match args.first().map(|s| s.as_str()) {",
"        None if iis => {",
"            let port = tw_default_http_port();",
"            if let Err(e) = tw_serve(app, \"127.0.0.1\", port) { tw_log(&format!(\"cannot listen on 127.0.0.1:{}: {}\\n\", port, e)); std::process::exit(1) }",
"        }",
"        Some(\"serve\") => {",
"            let (host, port) = tw_parse_host_port(&args[1..], tw_default_http_port());",
"            if let Err(e) = tw_serve(app, &host, port) { tw_log(&format!(\"cannot listen on {}: {}\\n\", tw_host_port_text(&host, port), e)); std::process::exit(1) }",
"        }",
"        Some(\"fastcgi\") => {",
"            let (host, port) = tw_parse_host_port(&args[1..], 9000);",
"            if let Err(e) = tw_fastcgi_serve(app, &host, port) { tw_log(&format!(\"cannot listen on {}: {}\\n\", tw_host_port_text(&host, port), e)); std::process::exit(1) }",
"        }",
"        Some(\"request\") => match tw_request_command(app, &args[1..]) {",
"            Some(bytes) => {",
"                let out = std::io::stdout();",
"                let mut o = out.lock();",
"                let _ = o.write_all(&bytes);",
"                let _ = o.flush();",
"            }",
"            None => tw_usage(),",
"        },",
"        _ => tw_usage(),",
"    }",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/adapter.rs; do not edit by hand."
pub fn adapter_runtime() -> Text {
let lines = [
"// Tessera shared-library adapter (C ABI) for in-process web server modules.",
"//",
"// This file is the crate root of a `--crate-type cdylib` build:",
"//",
"//   rustc --edition 2021 --crate-type cdylib -C opt-level=2 -C panic=unwind \\",
"//         -o libapp.so adapter.rs",
"//",
"// next to the generated `app.rs`. It is the ONLY part of the Tessera runtime",
"// that contains `unsafe` code. The unsafe surface is limited to:",
"//   1. turning the caller's (pointer, length) request into a `&[u8]`,",
"//   2. writing the response pointer/length into the caller's out-parameters,",
"//   3. reconstructing the `Box<[u8]>` in `tessera_free`.",
"// Everything else (decoding, running the application, limits, error -> 500,",
"// encoding) happens in safe code in `app.rs` (`tw_library_handle`).",
"//",
"// The wire format and C declarations are documented in hosts/include/tessera.h.",
"",
"#![deny(unsafe_op_in_unsafe_fn)]",
"",
"#[path = \"app.rs\"]",
"mod app;",
"",
"use std::panic::{catch_unwind, AssertUnwindSafe};",
"",
"/// ABI version implemented by this library. Hosts refuse to use a library",
"/// that reports a different version.",
"pub const TESSERA_ABI_VERSION: i32 = 1;",
"",
"/// Result codes of `tessera_handle`.",
"const OK: i32 = 0;",
"const ERR_NULL_ARGUMENT: i32 = 1;",
"const ERR_INTERNAL: i32 = 2;",
"",
"#[no_mangle]",
"pub extern \"C\" fn tessera_abi_version() -> i32 {",
"    TESSERA_ABI_VERSION",
"}",
"",
"/// Handle one wire-format request.",
"///",
"/// On success returns 0 and stores a Rust-allocated buffer in `*response` /",
"/// `*response_len`; the caller must release it with `tessera_free` using the",
"/// same pointer and length. Application errors are reported as HTTP 500 in",
"/// the response, not as a nonzero return value. A nonzero return value means",
"/// invalid arguments (1) or an internal failure that should never happen (2);",
"/// in that case `*response` is set to NULL and `*response_len` to 0 (when",
"/// those pointers are non-null).",
"///",
"/// # Safety",
"/// `request` must point to `request_len` readable bytes (it may be NULL only",
"/// when `request_len` is 0). `response` and `response_len` must be valid,",
"/// writable, non-NULL pointers. The request buffer is only read during the call.",
"#[no_mangle]",
"pub unsafe extern \"C\" fn tessera_handle(",
"    request: *const u8,",
"    request_len: usize,",
"    response: *mut *mut u8,",
"    response_len: *mut usize,",
") -> i32 {",
"    if response.is_null() || response_len.is_null() {",
"        return ERR_NULL_ARGUMENT;",
"    }",
"    // SAFETY: both out-pointers were checked for NULL above; the caller",
"    // guarantees they are valid and writable.",
"    unsafe {",
"        *response = std::ptr::null_mut();",
"        *response_len = 0;",
"    }",
"    if request.is_null() && request_len != 0 {",
"        return ERR_NULL_ARGUMENT;",
"    }",
"    let input: &[u8] = if request_len == 0 {",
"        &[]",
"    } else {",
"        // SAFETY: non-NULL (checked above) and the caller guarantees",
"        // `request_len` readable bytes that stay valid for this call.",
"        unsafe { std::slice::from_raw_parts(request, request_len) }",
"    };",
"",
"    // Unwinding across `extern \"C\"` is undefined behaviour / an abort, so",
"    // catch everything here. tw_library_handle is designed never to panic;",
"    // this is a last line of defence.",
"    let result = catch_unwind(AssertUnwindSafe(|| app::tw_library_handle(app::tessera_app, input)));",
"    let bytes: Vec<u8> = match result {",
"        Ok(bytes) => bytes,",
"        Err(_) => return ERR_INTERNAL,",
"    };",
"",
"    let boxed: Box<[u8]> = bytes.into_boxed_slice();",
"    let len = boxed.len();",
"    let ptr = Box::into_raw(boxed) as *mut u8;",
"    // SAFETY: out-pointers checked for NULL above. Ownership of the buffer",
"    // passes to the caller until tessera_free(ptr, len).",
"    unsafe {",
"        *response = ptr;",
"        *response_len = len;",
"    }",
"    OK",
"}",
"",
"/// Release a response buffer returned by `tessera_handle`.",
"///",
"/// # Safety",
"/// `response` and `response_len` must be exactly the values produced by one",
"/// successful `tessera_handle` call, and each buffer must be freed only once.",
"/// Passing NULL is allowed and does nothing.",
"#[no_mangle]",
"pub unsafe extern \"C\" fn tessera_free(response: *mut u8, response_len: usize) {",
"    if response.is_null() {",
"        return;",
"    }",
"    let _ = catch_unwind(AssertUnwindSafe(|| {",
"        // SAFETY: (response, response_len) came from Box::<[u8]>::into_raw in",
"        // tessera_handle (a zero-length box yields a dangling non-NULL pointer,",
"        // which is also reconstructed correctly here).",
"        let slice = std::ptr::slice_from_raw_parts_mut(response, response_len);",
"        drop(unsafe { Box::from_raw(slice) });",
"    }));",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/http.tes; do not edit by hand."
pub fn std_http() -> Text {
let lines = [
"// std/http: requests, responses and helpers for web applications (draft 0.13).",
"//",
"// A web application is a program whose entry file has, instead of `main`:",
"//     fn handle(request: http.Request) -> http.Response uses ...",
"// The same program runs as CGI, as an HTTP server, as a FastCGI server, or inside nginx,",
"// Apache and IIS; see hosts/README.md.",
"",
"import std/url",
"",
"pub type Header {",
"name: Text",
"value: Text",
"}",
"",
"pub type Request {",
"method: Text",
"path: Text",
"raw_path: Text",
"query: Map[Text, Text]",
"raw_query: Text",
"headers: Map[Text, Text]",
"body: Bytes",
"remote_address: Text",
"}",
"",
"pub type Response {",
"status: Int",
"headers: List[Header]",
"body: Bytes",
"}",
"",
"// ---------- reading requests ----------",
"",
"note \"A request header by name (case-insensitive).\"",
"pub fn header(request: Request, name: Text) -> Option[Text] = get(request.headers, to_lower(name))",
"",
"note \"The body as text; empty when it is not valid UTF-8.\"",
"pub fn text_body(request: Request) -> Text = value_or(from_bytes(request.body), \"\")",
"",
"note \"Fields of an `application/x-www-form-urlencoded` body (an HTML form).\"",
"pub fn form(request: Request) -> Map[Text, Text] = url.parse_query(text_body(request))",
"",
"pub fn cookies(request: Request) -> Map[Text, Text] {",
"var result: Map[Text, Text] = [:]",
"let line = header(request, \"cookie\") else return result",
"for part in split(line, \";\") {",
"let pair = trim(part)",
"let position = index_of(pair, \"=\") else continue",
"let name = slice_text(pair, 0, position)",
"if not contains(result, name) {",
"set result = put(result, name, slice_text(pair, position + 1, length(pair)))",
"}",
"}",
"result",
"}",
"",
"pub fn cookie(request: Request, name: Text) -> Option[Text] = get(cookies(request), name)",
"",
"note \"Matches a path against a pattern such as `/items/:id`; the result maps parameter names to decoded segments.\"",
"pub fn match_path(pattern: Text, path: Text) -> Option[Map[Text, Text]] {",
"let wanted = split(pattern, \"/\")",
"let actual = split(path, \"/\")",
"if length(wanted) != length(actual) {",
"return .None",
"}",
"var parameters: Map[Text, Text] = [:]",
"for index in range(0, length(wanted)) {",
"if starts_with(wanted[index], \":\") {",
"let value = url.percent_decode(actual[index]) else return .None",
"set parameters = put(parameters, slice_text(wanted[index], 1, length(wanted[index])), value)",
"} else if wanted[index] != actual[index] {",
"return .None",
"}",
"}",
".Some(parameters)",
"}",
"",
"// ---------- building responses ----------",
"",
"fn security_headers() -> List[Header] = [Header { name: \"x-content-type-options\", value: \"nosniff\" }, Header { name: \"referrer-policy\", value: \"same-origin\" }]",
"",
"pub fn response(status: Int, content_type: Text, body: Text) -> Response {",
"Response { status: status, headers: security_headers() + [Header { name: \"content-type\", value: content_type }], body: to_bytes(body) }",
"}",
"",
"pub fn text(status: Int, body: Text) -> Response = response(status, \"text/plain; charset=utf-8\", body)",
"",
"note \"HTML with a restrictive Content-Security-Policy and framing forbidden; escape user input with `html.escape`.\"",
"pub fn html(status: Int, body: Text) -> Response {",
"let base = response(status, \"text/html; charset=utf-8\", body)",
"base with { headers: base.headers + [Header { name: \"content-security-policy\", value: \"default-src 'self'; frame-ancestors 'none'\" }, Header { name: \"x-frame-options\", value: \"DENY\" }] }",
"}",
"",
"pub fn json(status: Int, body: Text) -> Response = response(status, \"application/json\", body)",
"",
"pub fn bytes_response(status: Int, content_type: Text, body: Bytes) -> Response {",
"Response { status: status, headers: security_headers() + [Header { name: \"content-type\", value: content_type }], body: body }",
"}",
"",
"note \"303 See Other: after a form post, the browser follows with a GET.\"",
"pub fn redirect(location: Text) -> Response = text(303, \"\") with { headers: security_headers() + [Header { name: \"location\", value: location }] }",
"",
"pub fn not_found() -> Response = text(404, \"not found\\n\")",
"",
"pub fn with_header(r: Response, name: Text, value: Text) -> Response {",
"let lower = to_lower(name)",
"var kept: List[Header] = []",
"for h in r.headers {",
"if h.name != lower {",
"set kept += [h]",
"}",
"}",
"r with { headers: kept + [Header { name: lower, value: value }] }",
"}",
"",
"note \"Adds a cookie with safe defaults: HttpOnly, Secure, SameSite=Lax, path `/`. `max_age` in seconds; 0 deletes the cookie.\"",
"pub fn with_cookie(r: Response, name: Text, value: Text, max_age: Int) -> Response {",
"r with { headers: r.headers + [Header { name: \"set-cookie\", value: \"\\(name)=\\(value); Max-Age=\\(max_age); Path=/; HttpOnly; Secure; SameSite=Lax\" }] }",
"}",
"",
"// ---------- signed values, sessions and CSRF tokens ----------",
"",
"fn signature(secret: Text, value: Text) -> Text {",
"replace(replace(replace(base64_encode(hmac_sha256(to_bytes(secret), to_bytes(value))), \"+\", \"-\"), \"/\", \"_\"), \"=\", \"\")",
"}",
"",
"note \"`value.signature`: tamper-proof (not secret) text for cookies, with an HMAC-SHA-256 under `secret`.\"",
"pub fn sign(secret: Text, value: Text) -> Text = \"\\(value).\\(signature(secret, value))\"",
"",
"pub fn verify(secret: Text, signed: Text) -> Option[Text] {",
"let parts = split(signed, \".\")",
"if length(parts) < 2 {",
"return .None",
"}",
"let value = join(slice(parts, 0, length(parts) - 1), \".\")",
"let given = parts[length(parts) - 1]",
"if equal_constant_time(to_bytes(signature(secret, value)), to_bytes(given)) { .Some(value) } else { .None }",
"}",
"",
"note \"A CSRF token bound to the session; put it in forms and check it with `check_csrf` on every state-changing request.\"",
"pub fn csrf_token(secret: Text, session_id: Text) -> Text = signature(secret, \"csrf:\\(session_id)\")",
"",
"pub fn check_csrf(secret: Text, session_id: Text, token: Text) -> Bool = equal_constant_time(to_bytes(csrf_token(secret, session_id)), to_bytes(token))",
"",
"// ---------- HTTP client (plain HTTP; effect `net`) ----------",
"",
"pub type ClientResponse {",
"status: Int",
"headers: Map[Text, Text]",
"body: Bytes",
"}",
"",
"fn find_header_end(data: Bytes) -> Option[Int] {",
"if length(data) < 4 {",
"return .None",
"}",
"for index in range(0, length(data) - 3) {",
"if data[index] == 13 and data[index + 1] == 10 and data[index + 2] == 13 and data[index + 3] == 10 {",
"return .Some(index)",
"}",
"}",
".None",
"}",
"",
"pub fn fetch(method: Text, address: Text, headers: List[Header], body: Bytes) -> Result[ClientResponse, Text] uses net {",
"var lines: List[Text] = []",
"for h in headers {",
"set lines += [\"\\(h.name): \\(h.value)\"]",
"}",
"let raw = try net_request(method, address, lines, body)",
"let end = find_header_end(raw) else return .Error(\"malformed response\")",
"let head = value_or(from_bytes(slice(raw, 0, end)), \"\")",
"let head_lines = split(head, \"\\u{D}\\n\")",
"let status_parts = split(head_lines[0], \" \")",
"let status = if length(status_parts) > 1 { value_or(parse_int(status_parts[1]), 0) } else { 0 }",
"var found: Map[Text, Text] = [:]",
"for line in slice(head_lines, 1, length(head_lines)) {",
"let position = index_of(line, \":\") else continue",
"set found = put(found, to_lower(trim(slice_text(line, 0, position))), trim(slice_text(line, position + 1, length(line))))",
"}",
".Ok(ClientResponse { status: status, headers: found, body: slice(raw, end + 4, length(raw)) })",
"}",
"",
"pub fn get_text(address: Text) -> Result[Text, Text] uses net {",
"let r = try fetch(\"GET\", address, [], to_bytes(\"\"))",
".Ok(value_or(from_bytes(r.body), \"\"))",
"}",
"",
"// ---------- used by the compiler's host glue; not needed in applications ----------",
"",
"pub fn from_raw(method: Text, raw_path: Text, raw_query: Text, remote: Text, names: List[Text], values: List[Text], body: Bytes) -> Request {",
"var headers: Map[Text, Text] = [:]",
"for index in range(0, length(names)) {",
"let name = to_lower(names[index])",
"let joined = match get(headers, name) {",
".Some(earlier) => if name == \"cookie\" { \"\\(earlier); \\(values[index])\" } else { \"\\(earlier), \\(values[index])\" }",
".None => values[index]",
"}",
"set headers = put(headers, name, joined)",
"}",
"Request { method: to_upper(method), path: value_or(url.percent_decode(raw_path), raw_path), raw_path: raw_path, query: url.parse_query(raw_query), raw_query: raw_query, headers: headers, body: body, remote_address: remote }",
"}",
"",
"pub fn status_of(r: Response) -> Int = r.status",
"",
"pub fn header_names_of(r: Response) -> List[Text] {",
"var out: List[Text] = []",
"for h in r.headers {",
"set out += [h.name]",
"}",
"out",
"}",
"",
"pub fn header_values_of(r: Response) -> List[Text] {",
"var out: List[Text] = []",
"for h in r.headers {",
"set out += [h.value]",
"}",
"out",
"}",
"",
"pub fn body_of(r: Response) -> Bytes = r.body",
"",
"note \"Builds a request for tests of `handle`: `http.request(\\\"GET\\\", \\\"/items?id=4\\\", \\\"\\\")`.\"",
"pub fn request(method: Text, target: Text, body: Text) -> Request {",
"let position = index_of(target, \"?\")",
"let raw_path = match position {",
".Some(p) => slice_text(target, 0, p)",
".None => target",
"}",
"let raw_query = match position {",
".Some(p) => slice_text(target, p + 1, length(target))",
".None => \"\"",
"}",
"from_raw(method, raw_path, raw_query, \"127.0.0.1\", [], [], to_bytes(body))",
"}",
"",
"pub fn response_text(r: Response) -> Text = value_or(from_bytes(r.body), \"\")",
"",
]
join(lines, "\n")
}

note "Generated from std/json.tes; do not edit by hand."
pub fn std_json() -> Text {
let lines = [
"// std/json: JSON values, parsing and encoding (RFC 8259).",
"// Numbers are `Decimal` (9 decimal places); more precise numbers are rounded half away from zero.",
"",
"pub enum Json {",
"Null",
"Bool(value: Bool)",
"Number(value: Decimal)",
"String(value: Text)",
"Array(items: List[Json])",
"Object(fields: Map[Text, Json])",
"}",
"",
"// ---------- reading values ----------",
"",
"pub fn field(json: Json, name: Text) -> Option[Json] {",
"match json {",
".Object(fields) => get(fields, name)",
"_ => .None",
"}",
"}",
"",
"pub fn as_text(json: Json) -> Option[Text] {",
"match json {",
".String(value) => .Some(value)",
"_ => .None",
"}",
"}",
"",
"pub fn as_bool(json: Json) -> Option[Bool] {",
"match json {",
".Bool(value) => .Some(value)",
"_ => .None",
"}",
"}",
"",
"pub fn as_decimal(json: Json) -> Option[Decimal] {",
"match json {",
".Number(value) => .Some(value)",
"_ => .None",
"}",
"}",
"",
"note \"Only whole numbers; `1.5` gives `.None`.\"",
"pub fn as_int(json: Json) -> Option[Int] {",
"match json {",
".Number(value) => if decimal(to_int(value)) == value { .Some(to_int(value)) } else { .None }",
"_ => .None",
"}",
"}",
"",
"note \"The items of an array; an empty list for anything else.\"",
"pub fn as_list(json: Json) -> List[Json] {",
"match json {",
".Array(items) => items",
"_ => []",
"}",
"}",
"",
"pub fn text_field(json: Json, name: Text) -> Option[Text] {",
"let value = field(json, name) else return .None",
"as_text(value)",
"}",
"",
"pub fn int_field(json: Json, name: Text) -> Option[Int] {",
"let value = field(json, name) else return .None",
"as_int(value)",
"}",
"",
"pub fn from_int(value: Int) -> Json = .Number(decimal(value))",
"",
"// ---------- encoding ----------",
"",
"fn hex4(code: Int) -> Text {",
"let digits = split(\"0123456789abcdef\", \"\")",
"\"\\(digits[code / 4096 % 16])\\(digits[code / 256 % 16])\\(digits[code / 16 % 16])\\(digits[code % 16])\"",
"}",
"",
"pub fn quote(text: Text) -> Text {",
"var out = \"\\\"\"",
"for code in code_points(text) {",
"set out += if code == 34 {",
"\"\\\\\\\"\"",
"} else if code == 92 {",
"\"\\\\\\\\\"",
"} else if code == 10 {",
"\"\\\\n\"",
"} else if code == 13 {",
"\"\\\\r\"",
"} else if code == 9 {",
"\"\\\\t\"",
"} else if code < 32 {",
"\"\\\\u\\(hex4(code))\"",
"} else {",
"from_code_point(code)",
"}",
"}",
"out + \"\\\"\"",
"}",
"",
"note \"Compact JSON; object keys in sorted order, so the output is deterministic.\"",
"pub fn encode(json: Json) -> Text {",
"match json {",
".Null => \"null\"",
".Bool(value) => if value { \"true\" } else { \"false\" }",
".Number(value) => to_text(value)",
".String(value) => quote(value)",
".Array(items) => {",
"var parts: List[Text] = []",
"for item in items {",
"set parts += [encode(item)]",
"}",
"\"[\\(join(parts, \",\"))]\"",
"}",
".Object(fields) => {",
"var parts: List[Text] = []",
"for key in keys(fields) {",
"let value = get(fields, key) else continue",
"set parts += [\"\\(quote(key)):\\(encode(value))\"]",
"}",
"\"{\\(join(parts, \",\"))}\"",
"}",
"}",
"}",
"",
"// ---------- parsing ----------",
"",
"type Parsed {",
"value: Json",
"next: Int",
"}",
"",
"type Reader {",
"codes: List[Int]",
"}",
"",
"fn skip_space(r: Reader, start: Int) -> Int {",
"var index = start",
"while index < length(r.codes) and (r.codes[index] == 32 or r.codes[index] == 9 or r.codes[index] == 10 or r.codes[index] == 13) {",
"set index += 1",
"}",
"index",
"}",
"",
"fn at(r: Reader, index: Int) -> Int = if index < length(r.codes) { r.codes[index] } else { -1 }",
"",
"fn expect_word(r: Reader, index: Int, word: Text, value: Json) -> Result[Parsed, Text] {",
"let wanted = code_points(word)",
"for offset in range(0, length(wanted)) {",
"if at(r, index + offset) != wanted[offset] {",
"return .Error(\"invalid value at position \\(index)\")",
"}",
"}",
".Ok(Parsed { value: value, next: index + length(wanted) })",
"}",
"",
"fn hex_digit(code: Int) -> Int {",
"if code >= 48 and code <= 57 {",
"return code - 48",
"}",
"if code >= 65 and code <= 70 {",
"return code - 55",
"}",
"if code >= 97 and code <= 102 {",
"return code - 87",
"}",
"-1",
"}",
"",
"fn read_hex4(r: Reader, index: Int) -> Int {",
"var value = 0",
"for offset in range(0, 4) {",
"let digit = hex_digit(at(r, index + offset))",
"if digit < 0 {",
"return -1",
"}",
"set value = value * 16 + digit",
"}",
"value",
"}",
"",
"type ParsedText {",
"text: Text",
"next: Int",
"}",
"",
"fn parse_string(r: Reader, start: Int) -> Result[ParsedText, Text] {",
"var index = start + 1",
"var out: List[Int] = []",
"while true {",
"let code = at(r, index)",
"if code == -1 {",
"return .Error(\"unterminated string starting at position \\(start)\")",
"}",
"if code == 34 {",
"return .Ok(ParsedText { text: from_code_points(out), next: index + 1 })",
"}",
"if code < 32 {",
"return .Error(\"control character in string at position \\(index)\")",
"}",
"if code != 92 {",
"set out += [code]",
"set index += 1",
"continue",
"}",
"let escaped = at(r, index + 1)",
"if escaped == 117 {",
"var value = read_hex4(r, index + 2)",
"if value < 0 {",
"return .Error(\"invalid \\\\u escape at position \\(index)\")",
"}",
"set index += 6",
"if value >= 55296 and value <= 56319 {",
"let low = if at(r, index) == 92 and at(r, index + 1) == 117 { read_hex4(r, index + 2) } else { -1 }",
"if low < 56320 or low > 57343 {",
"return .Error(\"unpaired surrogate at position \\(index)\")",
"}",
"set value = 65536 + (value - 55296) * 1024 + (low - 56320)",
"set index += 6",
"} else if value >= 56320 and value <= 57343 {",
"return .Error(\"unpaired surrogate at position \\(index)\")",
"}",
"set out += [value]",
"continue",
"}",
"let replacement = match escaped {",
"34 => 34",
"92 => 92",
"47 => 47",
"98 => 8",
"102 => 12",
"110 => 10",
"114 => 13",
"116 => 9",
"_ => -1",
"}",
"if replacement < 0 {",
"return .Error(\"invalid escape at position \\(index)\")",
"}",
"set out += [replacement]",
"set index += 2",
"}",
".Error(\"unreachable\")",
"}",
"",
"fn is_digit(code: Int) -> Bool = code >= 48 and code <= 57",
"",
"note \"Builds the `Decimal` from the digits and exponent, rounding beyond 9 decimal places.\"",
"fn number_value(negative: Bool, digits: List[Int], point: Int, exponent: Int) -> Option[Decimal] {",
"// `digits` with the decimal point after `point` digits, times 10^exponent.",
"let shift = point + exponent",
"var whole: List[Int] = []",
"var fraction: List[Int] = []",
"for index in range(0, length(digits)) {",
"if index < shift {",
"set whole += [digits[index]]",
"} else {",
"set fraction += [digits[index]]",
"}",
"}",
"if shift < 0 {",
"set fraction = concat(split_zeros(0 - shift), fraction)",
"}",
"var whole_text = from_code_points(whole)",
"if whole_text == \"\" {",
"set whole_text = \"0\"",
"}",
"var missing = shift - length(digits)",
"while missing > 0 {",
"set whole_text += \"0\"",
"set missing -= 1",
"}",
"let kept = if length(fraction) > 9 { slice(fraction, 0, 9) } else { fraction }",
"let text = if length(kept) == 0 { whole_text } else { \"\\(whole_text).\\(from_code_points(kept))\" }",
"var value = parse_decimal(text) else return .None",
"if length(fraction) > 9 and fraction[9] >= 53 {",
"let smallest = parse_decimal(\"0.000000001\") else return .None",
"set value += smallest",
"}",
".Some(if negative { -value } else { value })",
"}",
"",
"fn split_zeros(count: Int) -> List[Int] {",
"var out: List[Int] = []",
"for _ in range(0, count) {",
"set out += [48]",
"}",
"out",
"}",
"",
"fn parse_number(r: Reader, start: Int) -> Result[Parsed, Text] {",
"var index = start",
"let negative = at(r, index) == 45",
"if negative {",
"set index += 1",
"}",
"var digits: List[Int] = []",
"if not is_digit(at(r, index)) {",
"return .Error(\"invalid number at position \\(start)\")",
"}",
"if at(r, index) == 48 and is_digit(at(r, index + 1)) {",
"return .Error(\"leading zero in number at position \\(start)\")",
"}",
"while is_digit(at(r, index)) {",
"set digits += [at(r, index)]",
"set index += 1",
"}",
"let point = length(digits)",
"if at(r, index) == 46 {",
"set index += 1",
"if not is_digit(at(r, index)) {",
"return .Error(\"invalid number at position \\(start)\")",
"}",
"while is_digit(at(r, index)) {",
"set digits += [at(r, index)]",
"set index += 1",
"}",
"}",
"var exponent = 0",
"if at(r, index) == 101 or at(r, index) == 69 {",
"set index += 1",
"var exponent_negative = false",
"if at(r, index) == 43 or at(r, index) == 45 {",
"set exponent_negative = at(r, index) == 45",
"set index += 1",
"}",
"if not is_digit(at(r, index)) {",
"return .Error(\"invalid exponent at position \\(start)\")",
"}",
"while is_digit(at(r, index)) {",
"if exponent > 1000 {",
"return .Error(\"number out of range at position \\(start)\")",
"}",
"set exponent = exponent * 10 + (at(r, index) - 48)",
"set index += 1",
"}",
"if exponent_negative {",
"set exponent = 0 - exponent",
"}",
"}",
"let value = number_value(negative, digits, point, exponent) else return .Error(\"number out of range at position \\(start)\")",
".Ok(Parsed { value: .Number(value), next: index })",
"}",
"",
"fn parse_value(r: Reader, start: Int, depth: Int) -> Result[Parsed, Text] {",
"if depth > 500 {",
"return .Error(\"nesting too deep at position \\(start)\")",
"}",
"let index = skip_space(r, start)",
"let code = at(r, index)",
"if code == 123 {",
"return parse_object(r, index, depth)",
"}",
"if code == 91 {",
"return parse_array(r, index, depth)",
"}",
"if code == 34 {",
"let s = try parse_string(r, index)",
"return .Ok(Parsed { value: .String(s.text), next: s.next })",
"}",
"if code == 116 {",
"return expect_word(r, index, \"true\", .Bool(true))",
"}",
"if code == 102 {",
"return expect_word(r, index, \"false\", .Bool(false))",
"}",
"if code == 110 {",
"return expect_word(r, index, \"null\", .Null)",
"}",
"if code == 45 or is_digit(code) {",
"return parse_number(r, index)",
"}",
"if code == -1 {",
"return .Error(\"unexpected end of input\")",
"}",
".Error(\"unexpected character at position \\(index)\")",
"}",
"",
"fn parse_array(r: Reader, start: Int, depth: Int) -> Result[Parsed, Text] {",
"var items: List[Json] = []",
"var index = skip_space(r, start + 1)",
"if at(r, index) == 93 {",
"return .Ok(Parsed { value: .Array(items), next: index + 1 })",
"}",
"while true {",
"let item = try parse_value(r, index, depth + 1)",
"set items += [item.value]",
"set index = skip_space(r, item.next)",
"if at(r, index) == 44 {",
"set index += 1",
"} else if at(r, index) == 93 {",
"return .Ok(Parsed { value: .Array(items), next: index + 1 })",
"} else {",
"return .Error(\"expected `,` or `]` at position \\(index)\")",
"}",
"}",
".Error(\"unreachable\")",
"}",
"",
"fn parse_object(r: Reader, start: Int, depth: Int) -> Result[Parsed, Text] {",
"var fields: Map[Text, Json] = [:]",
"var index = skip_space(r, start + 1)",
"if at(r, index) == 125 {",
"return .Ok(Parsed { value: .Object(fields), next: index + 1 })",
"}",
"while true {",
"if at(r, index) != 34 {",
"return .Error(\"expected a string key at position \\(index)\")",
"}",
"let key = try parse_string(r, index)",
"set index = skip_space(r, key.next)",
"if at(r, index) != 58 {",
"return .Error(\"expected `:` at position \\(index)\")",
"}",
"let value = try parse_value(r, index + 1, depth + 1)",
"set fields = put(fields, key.text, value.value)",
"set index = skip_space(r, value.next)",
"if at(r, index) == 44 {",
"set index = skip_space(r, index + 1)",
"} else if at(r, index) == 125 {",
"return .Ok(Parsed { value: .Object(fields), next: index + 1 })",
"} else {",
"return .Error(\"expected `,` or `}` at position \\(index)\")",
"}",
"}",
".Error(\"unreachable\")",
"}",
"",
"note \"Parses one JSON value; positions in error messages count characters from 0.\"",
"pub fn parse(text: Text) -> Result[Json, Text] {",
"let r = Reader { codes: code_points(text) }",
"let parsed = try parse_value(r, 0, 0)",
"let rest = skip_space(r, parsed.next)",
"if rest != length(r.codes) {",
"return .Error(\"unexpected text after the value at position \\(rest)\")",
"}",
".Ok(parsed.value)",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/url.tes; do not edit by hand."
pub fn std_url() -> Text {
let lines = [
"// std/url: percent-encoding and query strings (RFC 3986, application/x-www-form-urlencoded).",
"",
"note \"Characters that never need encoding (RFC 3986 unreserved).\"",
"fn is_unreserved(code: Int) -> Bool {",
"(code >= 65 and code <= 90) or (code >= 97 and code <= 122) or (code >= 48 and code <= 57) or code == 45 or code == 46 or code == 95 or code == 126",
"}",
"",
"fn hex_value(code: Int) -> Int {",
"if code >= 48 and code <= 57 {",
"return code - 48",
"}",
"if code >= 65 and code <= 70 {",
"return code - 55",
"}",
"if code >= 97 and code <= 102 {",
"return code - 87",
"}",
"-1",
"}",
"",
"note \"Encodes everything except unreserved characters, so the result is safe in a path segment, a query key or a query value.\"",
"pub fn percent_encode(text: Text) -> Text {",
"let digits = split(\"0123456789ABCDEF\", \"\")",
"var out = \"\"",
"for byte in byte_values(to_bytes(text)) {",
"if is_unreserved(byte) {",
"set out += from_code_point(byte)",
"} else {",
"set out += \"%\\(digits[byte / 16])\\(digits[byte % 16])\"",
"}",
"}",
"out",
"}",
"",
"note \"Decodes `%XX` escapes; `.None` for a broken escape or bytes that are not UTF-8. With `plus_is_space`, `+` means a space (form encoding).\"",
"fn decode(text: Text, plus_is_space: Bool) -> Option[Text] {",
"let input = byte_values(to_bytes(text))",
"var out: List[Int] = []",
"var index = 0",
"while index < length(input) {",
"let byte = input[index]",
"if byte == 37 {",
"if index + 2 >= length(input) {",
"return .None",
"}",
"let high = hex_value(input[index + 1])",
"let low = hex_value(input[index + 2])",
"if high < 0 or low < 0 {",
"return .None",
"}",
"set out += [high * 16 + low]",
"set index += 3",
"} else {",
"set out += [if plus_is_space and byte == 43 { 32 } else { byte }]",
"set index += 1",
"}",
"}",
"from_bytes(bytes(out))",
"}",
"",
"pub fn percent_decode(text: Text) -> Option[Text] = decode(text, false)",
"",
"note \"Every value of every key, in order. Broken escapes keep the raw text.\"",
"pub fn parse_query_all(query: Text) -> Map[Text, List[Text]] {",
"var result: Map[Text, List[Text]] = [:]",
"if query == \"\" {",
"return result",
"}",
"for pair in split(query, \"&\") {",
"if pair == \"\" {",
"continue",
"}",
"let position = index_of(pair, \"=\")",
"let raw_key = match position {",
".Some(p) => slice_text(pair, 0, p)",
".None => pair",
"}",
"let raw_value = match position {",
".Some(p) => slice_text(pair, p + 1, length(pair))",
".None => \"\"",
"}",
"let key = value_or(decode(raw_key, true), raw_key)",
"let value = value_or(decode(raw_value, true), raw_value)",
"set result = put(result, key, value_or(get(result, key), []) + [value])",
"}",
"result",
"}",
"",
"note \"The first value of each key: `a=1&b=2&a=3` gives `a` = `1`, `b` = `2`.\"",
"pub fn parse_query(query: Text) -> Map[Text, Text] {",
"var result: Map[Text, Text] = [:]",
"let all = parse_query_all(query)",
"for key in keys(all) {",
"let found = value_or(get(all, key), [])",
"if length(found) > 0 {",
"set result = put(result, key, found[0])",
"}",
"}",
"result",
"}",
"",
"pub fn encode_query(values: Map[Text, Text]) -> Text {",
"var parts: List[Text] = []",
"for key in keys(values) {",
"set parts += [\"\\(percent_encode(key))=\\(percent_encode(value_or(get(values, key), \"\")))\"]",
"}",
"join(parts, \"&\")",
"}",
"",
"note \"The decoded segments of a path: `/a/b%20c/` gives `a` and `b c`.\"",
"pub fn path_segments(path: Text) -> List[Text] {",
"var out: List[Text] = []",
"for part in split(path, \"/\") {",
"if part != \"\" {",
"set out += [value_or(percent_decode(part), part)]",
"}",
"}",
"out",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/html.tes; do not edit by hand."
pub fn std_html() -> Text {
let lines = [
"// std/html: escaping text for HTML, so user input cannot become markup (cross-site scripting).",
"",
"note \"Escapes `&`, `<`, `>`, `\\\"` and `'`; safe in element content and in quoted attribute values.\"",
"pub fn escape(text: Text) -> Text {",
"var out = \"\"",
"for piece in split(text, \"\") {",
"set out += match piece {",
"\"&\" => \"&amp;\"",
"\"<\" => \"&lt;\"",
"\">\" => \"&gt;\"",
"\"\\\"\" => \"&quot;\"",
"\"'\" => \"&#39;\"",
"_ => piece",
"}",
"}",
"out",
"}",
"",
]
join(lines, "\n")
}
