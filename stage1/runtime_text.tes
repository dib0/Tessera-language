"                    t_report_failure(failure);",
"                    std::process::exit(70)",
"                }",
"                if let Some(exit) = payload.downcast_ref::<TExit>() { std::process::exit(exit.code) }",
"                std::process::exit(70)",
"            }",
"        }",
"        Err(_) => { eprintln!(\"runtime error R000: could not start the main thread\"); std::process::exit(70) }",
"    }",
