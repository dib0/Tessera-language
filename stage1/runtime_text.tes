note "Generated from runtime/ui.rs; do not edit by hand."
pub fn ui_runtime() -> Text {
let lines = [
"",
"// ---------------------------------------------------------------------------",
"// Tessera `ui` runtime for unix: a minimal X11 client in safe Rust (local display).",
"// Speaks the X11 core protocol directly over the X server's Unix socket, so",
"// generated programs need no libraries. One window per program; drawing goes",
"// to an off-screen pixmap and becomes visible on `present()`.",
"// ---------------------------------------------------------------------------",
"",
"use std::cell::RefCell;",
"use std::collections::VecDeque;",
"use std::io::Read;",
"use std::os::unix::net::UnixStream;",
"",
"struct T_Ui {",
"    stream: UnixStream,",
"    out: Vec<u8>,",
"    seq: u16,",
"    id_base: u32,",
"    id_mask: u32,",
"    next_id: u32,",
"    window: u32,",
"    pixmap: u32,",
"    gc: u32,",
"    width: u16,",
"    height: u16,",
"    wm_delete: u32,",
"    events: VecDeque<Vec<u8>>,",
"    input: Vec<u8>,",
"    min_keycode: u8,",
"    keysyms_per_keycode: u8,",
"    keysyms: Vec<u32>,",
"    char_width: i64,",
"    font_ascent: i64,",
"    color: i64,",
"    line_width: i64,",
"}",
"",
"thread_local! {",
"    static T_UI: RefCell<Option<T_Ui>> = RefCell::new(None);",
"}",
"",
"fn t_ui_fail(message: String, loc: &str) -> ! {",
"    t_fail(\"R012\", message, loc)",
"}",
"",
"fn t_u16(b: &[u8], i: usize) -> u16 { u16::from_le_bytes([b[i], b[i + 1]]) }",
"fn t_i16(b: &[u8], i: usize) -> i16 { i16::from_le_bytes([b[i], b[i + 1]]) }",
"fn t_u32(b: &[u8], i: usize) -> u32 { u32::from_le_bytes([b[i], b[i + 1], b[i + 2], b[i + 3]]) }",
"fn t_put16(v: &mut Vec<u8>, x: u16) { v.extend_from_slice(&x.to_le_bytes()); }",
"fn t_put32(v: &mut Vec<u8>, x: u32) { v.extend_from_slice(&x.to_le_bytes()); }",
"fn t_pad4(v: &mut Vec<u8>) { while v.len() % 4 != 0 { v.push(0); } }",
"fn t_coord(v: i64) -> u16 { (v.clamp(-32768, 32767) as i16) as u16 }",
"fn t_size(v: i64) -> u16 { v.clamp(0, 65535) as u16 }",
"",
"fn t_read_exact(stream: &mut UnixStream, buf: &mut [u8], loc: &str) {",
"    if let Err(e) = stream.read_exact(buf) {",
"        t_ui_fail(format!(\"the connection to the X server was lost: {}\", e), loc)",
"    }",
"}",
"",
"fn t_x_authority(display_number: &str) -> (Vec<u8>, Vec<u8>) {",
"    let path = match std::env::var_os(\"XAUTHORITY\") {",
"        Some(p) => std::path::PathBuf::from(p),",
"        None => match std::env::var_os(\"HOME\") {",
"            Some(h) => std::path::Path::new(&h).join(\".Xauthority\"),",
"            None => return (Vec::new(), Vec::new()),",
"        },",
"    };",
"    let data = match std::fs::read(&path) { Ok(d) => d, Err(_) => return (Vec::new(), Vec::new()) };",
"    let hostname = std::fs::read_to_string(\"/proc/sys/kernel/hostname\").unwrap_or_default().trim().to_string();",
"    let mut pos = 0usize;",
"    let mut fallback: Option<(Vec<u8>, Vec<u8>)> = None;",
"    let read_field = |pos: &mut usize| -> Option<Vec<u8>> {",
"        if *pos + 2 > data.len() { return None; }",
"        let len = u16::from_be_bytes([data[*pos], data[*pos + 1]]) as usize;",
"        *pos += 2;",
"        if *pos + len > data.len() { return None; }",
"        let field = data[*pos..*pos + len].to_vec();",
"        *pos += len;",
"        Some(field)",
"    };",
"    while pos + 2 <= data.len() {",
"        let family = u16::from_be_bytes([data[pos], data[pos + 1]]);",
"        pos += 2;",
"        let (Some(address), Some(number), Some(name), Some(cookie)) =",
"            (read_field(&mut pos), read_field(&mut pos), read_field(&mut pos), read_field(&mut pos)) else { break };",
"        if name != b\"MIT-MAGIC-COOKIE-1\" { continue; }",
"        let number_matches = number.is_empty() || number == display_number.as_bytes();",
"        if !number_matches { continue; }",
"        if family == 65535 || (family == 256 && address == hostname.as_bytes()) {",
"            return (name, cookie);",
"        }",
"        if fallback.is_none() { fallback = Some((name, cookie)); }",
"    }",
"    fallback.unwrap_or((Vec::new(), Vec::new()))",
"}",
"",
"impl T_Ui {",
"    fn begin(&mut self, opcode: u8, data: u8) -> usize {",
"        let start = self.out.len();",
"        self.out.push(opcode);",
"        self.out.push(data);",
"        t_put16(&mut self.out, 0);",
"        start",
"    }",
"",
"    fn end(&mut self, start: usize) {",
"        t_pad4(&mut self.out);",
"        let words = ((self.out.len() - start) / 4) as u16;",
"        self.out[start + 2..start + 4].copy_from_slice(&words.to_le_bytes());",
"        self.seq = self.seq.wrapping_add(1);",
"    }",
"",
"    fn new_id(&mut self) -> u32 {",
"        let id = self.id_base | (self.next_id & self.id_mask);",
"        self.next_id += 1;",
"        id",
"    }",
"",
"    fn flush(&mut self, loc: &str) {",
"        if self.out.is_empty() { return; }",
"        use std::io::Write;",
"        if let Err(e) = self.stream.write_all(&self.out) {",
"            t_ui_fail(format!(\"the connection to the X server was lost: {}\", e), loc)",
"        }",
"        self.out.clear();",
"    }",
"",
"    /// The next packet from the server: taken from `input` (bytes already received) when complete,",
"    /// otherwise read. Without `wait`, returns None instead of blocking when no full packet is there.",
"    fn next_packet(&mut self, wait: bool, loc: &str) -> Option<Vec<u8>> {",
"        loop {",
"            if self.input.len() >= 32 {",
"                let size = if self.input[0] == 1 { 32 + t_u32(&self.input, 4) as usize * 4 } else { 32 };",
"                if self.input.len() >= size {",
"                    return Some(self.input.drain(..size).collect());",
"                }",
"            }",
"            let mut buffer = [0u8; 65536];",
"            if !wait {",
"                if let Err(e) = self.stream.set_nonblocking(true) {",
"                    t_ui_fail(format!(\"the connection to the X server failed: {}\", e), loc)",
"                }",
"            }",
"            let result = self.stream.read(&mut buffer);",
"            if !wait {",
"                let _ = self.stream.set_nonblocking(false);",
"            }",
"            match result {",
"                Ok(0) => t_ui_fail(\"the X server closed the connection\".to_string(), loc),",
"                Ok(n) => self.input.extend_from_slice(&buffer[..n]),",
"                Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => return None,",
"                Err(e) if e.kind() == std::io::ErrorKind::Interrupted => {}",
"                Err(e) => t_ui_fail(format!(\"the connection to the X server was lost: {}\", e), loc),",
"            }",
"        }",
"    }",
"",
"    fn read_packet(&mut self, loc: &str) -> Vec<u8> {",
"        match self.next_packet(true, loc) {",
"            Some(packet) => packet,",
"            None => t_ui_fail(\"the X server stopped answering\".to_string(), loc),",
"        }",
"    }",
"",
"    /// Turns a packet into an event, or None for packets a program does not see. A key release",
"    /// directly followed by a press of the same key at the same time is the keyboard's automatic",
"    /// repeat, not a real release; it is dropped.",
"    fn event_of(&mut self, packet: Vec<u8>, loc: &str) -> Option<Rc<T_WindowEvent>> {",
"        match packet[0] & 0x7f {",
"            0 => t_x_error(&packet, loc),",
"            12 => {",
"                // Expose: the back buffer still holds the picture.",
"                if t_u16(&packet, 16) == 0 { self.present(loc); }",
"                None",
"            }",
"            4 => {",
"                let x = t_i16(&packet, 24) as i64;",
"                let y = t_i16(&packet, 26) as i64;",
"                Some(Rc::new(T_WindowEvent::V_Click(x, y, packet[1] as i64)))",
"            }",
"            2 => self.key_name(packet[1], t_u16(&packet, 28)).map(|name| Rc::new(T_WindowEvent::V_Key(Rc::new(name)))),",
"            3 => {",
"                if self.events.is_empty() {",
"                    if let Some(next) = self.next_packet(false, loc) { self.events.push_back(next); }",
"                }",
"                if let Some(next) = self.events.front() {",
"                    if next[0] & 0x7f == 2 && next[1] == packet[1] && t_u32(next, 4) == t_u32(&packet, 4) {",
"                        return None;",
"                    }",
"                }",
"                self.key_name(packet[1], 0).map(|name| Rc::new(T_WindowEvent::V_KeyUp(Rc::new(name))))",
"            }",
"            33 => {",
"                if t_u32(&packet, 12) == self.wm_delete { Some(Rc::new(T_WindowEvent::V_Close)) } else { None }",
"            }",
"            _ => None,",
"        }",
"    }",
"",
"    /// Wait for the reply to the last request. Errors for requests sent at or",
"    /// after `first_seq` are returned as `Err(code)`; events are queued.",
"    fn reply_since(&mut self, first_seq: u16, loc: &str) -> Result<Vec<u8>, u8> {",
"        self.flush(loc);",
"        loop {",
"            let packet = self.read_packet(loc);",
"            match packet[0] {",
"                1 if t_u16(&packet, 2) == self.seq => return Ok(packet),",
"                1 => {}",
"                0 => {",
"                    let seq = t_u16(&packet, 2);",
"                    if seq.wrapping_sub(first_seq) <= self.seq.wrapping_sub(first_seq) {",
"                        return Err(packet[1]);",
"                    }",
"                    t_x_error(&packet, loc)",
"                }",
"                _ => self.events.push_back(packet),",
"            }",
"        }",
"    }",
"",
"    fn reply(&mut self, loc: &str) -> Vec<u8> {",
"        let first = self.seq;",
"        match self.reply_since(first, loc) {",
"            Ok(r) => r,",
"            Err(code) => t_ui_fail(format!(\"the X server reported error {}\", code), loc),",
"        }",
"    }",
"",
"    fn intern_atom(&mut self, name: &str, loc: &str) -> u32 {",
"        let start = self.begin(16, 0);",
"        t_put16(&mut self.out, name.len() as u16);",
"        t_put16(&mut self.out, 0);",
"        self.out.extend_from_slice(name.as_bytes());",
"        self.end(start);",
"        let r = self.reply(loc);",
"        t_u32(&r, 8)",
"    }",
"",
"    fn change_property(&mut self, property: u32, kind: u32, format: u8, data: &[u8]) {",
"        let start = self.begin(18, 0);",
"        t_put32(&mut self.out, self.window);",
"        t_put32(&mut self.out, property);",
"        t_put32(&mut self.out, kind);",
"        self.out.push(format);",
"        self.out.extend_from_slice(&[0, 0, 0]);",
"        t_put32(&mut self.out, (data.len() / (format as usize / 8)) as u32);",
"        self.out.extend_from_slice(data);",
"        self.end(start);",
"    }",
"",
"    fn set_gc(&mut self, color: i64, line_width: i64) {",
"        if color != self.color {",
"            let start = self.begin(56, 0);",
"            t_put32(&mut self.out, self.gc);",
"            t_put32(&mut self.out, 0x4);",
"            t_put32(&mut self.out, color as u32);",
"            self.end(start);",
"            self.color = color;",
"        }",
"        if line_width != self.line_width {",
"            let start = self.begin(56, 0);",
"            t_put32(&mut self.out, self.gc);",
"            t_put32(&mut self.out, 0x10);",
"            t_put32(&mut self.out, line_width.clamp(0, 65535) as u32);",
"            self.end(start);",
"            self.line_width = line_width;",
"        }",
"    }",
"",
"    /// Start a drawing request on the back buffer.",
"    fn draw_request(&mut self, opcode: u8) -> usize {",
"        let start = self.begin(opcode, 0);",
"        t_put32(&mut self.out, self.pixmap);",
"        t_put32(&mut self.out, self.gc);",
"        start",
"    }",
"",
"    fn present(&mut self, loc: &str) {",
"        let start = self.begin(62, 0);",
"        t_put32(&mut self.out, self.pixmap);",
"        t_put32(&mut self.out, self.window);",
"        t_put32(&mut self.out, self.gc);",
"        for _ in 0..4 { t_put16(&mut self.out, 0); }",
"        t_put16(&mut self.out, self.width);",
"        t_put16(&mut self.out, self.height);",
"        self.end(start);",
"        self.flush(loc);",
"    }",
"",
"    fn key_name(&self, keycode: u8, state: u16) -> Option<String> {",
"        if keycode < self.min_keycode || self.keysyms_per_keycode == 0 { return None; }",
"        let per = self.keysyms_per_keycode as usize;",
"        let base = (keycode - self.min_keycode) as usize * per;",
"        let shifted = state & 1 != 0 && per > 1 && self.keysyms.get(base + 1).map_or(false, |&k| k != 0);",
"        let keysym = *self.keysyms.get(if shifted { base + 1 } else { base })?;",
"        let name = match keysym {",
"            0x20..=0x7e => (keysym as u8 as char).to_string(),",
"            0xff1b => \"Escape\".into(),",
"            0xff0d | 0xff8d => \"Enter\".into(),",
"            0xff08 => \"Backspace\".into(),",
"            0xff09 => \"Tab\".into(),",
"            0xff51 => \"Left\".into(),",
"            0xff52 => \"Up\".into(),",
"            0xff53 => \"Right\".into(),",
"            0xff54 => \"Down\".into(),",
"            0xffe1 | 0xffe2 => \"Shift\".into(),",
"            0xffe3 | 0xffe4 => \"Control\".into(),",
"            0xffe9 | 0xffea => \"Alt\".into(),",
"            0xffbe..=0xffc9 => format!(\"F{}\", keysym - 0xffbe + 1),",
"            0xffff => \"Delete\".into(),",
"            0xff50 => \"Home\".into(),",
"            0xff57 => \"End\".into(),",
"            0xff55 => \"PageUp\".into(),",
"            0xff56 => \"PageDown\".into(),",
"            _ => return None,",
"        };",
"        Some(name)",
"    }",
"}",
"",
"fn t_x_error(packet: &[u8], loc: &str) -> ! {",
"    t_ui_fail(format!(\"the X server reported error {} for request {}\", packet[1], packet[10]), loc)",
"}",
"",
"fn t_with_ui<R>(loc: &str, f: impl FnOnce(&mut T_Ui) -> R) -> R {",
"    T_UI.with(|cell| {",
"        let mut slot = cell.borrow_mut();",
"        match slot.as_mut() {",
"            Some(ui) => f(ui),",
"            None => t_ui_fail(\"no window is open; call open_window first\".to_string(), loc),",
"        }",
"    })",
"}",
"",
"/// Connect and authenticate. Returns the connection, the root window, its depth and the keycode range.",
"fn t_ui_connect(width: i64, height: i64, loc: &str) -> (T_Ui, u32, u8, u8, u8) {",
"    let display = match std::env::var(\"DISPLAY\") {",
"        Ok(d) if !d.is_empty() => d,",
"        _ => t_ui_fail(\"cannot open a window: DISPLAY is not set (is a graphical X11 session running?)\".to_string(), loc),",
"    };",
"    let (host, rest) = match display.split_once(':') {",
"        Some(parts) => parts,",
"        None => t_ui_fail(format!(\"cannot parse DISPLAY `{}`\", display), loc),",
"    };",
"    if !host.is_empty() && host != \"unix\" {",
"        t_ui_fail(format!(\"only local X displays are supported (DISPLAY is `{}`)\", display), loc)",
"    }",
"    let number = rest.split('.').next().unwrap_or(\"0\").to_string();",
"    let mut stream = match UnixStream::connect(format!(\"/tmp/.X11-unix/X{}\", number)) {",
"        Ok(s) => s,",
"        Err(e) => t_ui_fail(format!(\"cannot connect to X display `{}`: {}\", display, e), loc),",
"    };",
"",
"    // Connection setup.",
"    let (auth_name, auth_data) = t_x_authority(&number);",
"    let mut setup = vec![b'l', 0];",
"    t_put16(&mut setup, 11);",
"    t_put16(&mut setup, 0);",
"    t_put16(&mut setup, auth_name.len() as u16);",
"    t_put16(&mut setup, auth_data.len() as u16);",
"    t_put16(&mut setup, 0);",
"    setup.extend_from_slice(&auth_name);",
"    t_pad4(&mut setup);",
"    setup.extend_from_slice(&auth_data);",
"    t_pad4(&mut setup);",
"    {",
"        use std::io::Write;",
"        if let Err(e) = stream.write_all(&setup) {",
"            t_ui_fail(format!(\"cannot talk to the X server: {}\", e), loc)",
"        }",
"    }",
"    let mut header = [0u8; 8];",
"    t_read_exact(&mut stream, &mut header, loc);",
"    let mut info = vec![0u8; t_u16(&header, 6) as usize * 4];",
"    t_read_exact(&mut stream, &mut info, loc);",
"    if header[0] != 1 {",
"        let reason_len = (header[1] as usize).min(info.len());",
"        let reason = String::from_utf8_lossy(&info[..reason_len]).trim().to_string();",
"        t_ui_fail(format!(\"the X server refused the connection: {}\", reason), loc)",
"    }",
"    let id_base = t_u32(&info, 4);",
"    let id_mask = t_u32(&info, 8);",
"    let vendor_len = t_u16(&info, 16) as usize;",
"    let formats = info[21] as usize;",
"    let min_keycode = info[26];",
"    let max_keycode = info[27];",
"    let screen = 32 + ((vendor_len + 3) / 4) * 4 + formats * 8;",
"    let root = t_u32(&info, screen);",
"    let root_depth = info[screen + 38];",
"    if root_depth != 24 && root_depth != 32 {",
"        t_ui_fail(format!(\"only 24-bit color displays are supported (this display has depth {})\", root_depth), loc)",
"    }",
"",
"    let ui = T_Ui {",
"        stream,",
"        out: Vec::new(),",
"        seq: 0,",
"        id_base,",
"        id_mask,",
"        next_id: 1,",
"        window: 0,",
"        pixmap: 0,",
"        gc: 0,",
"        width: width as u16,",
"        height: height as u16,",
"        wm_delete: 0,",
"        events: VecDeque::new(),",
"        input: Vec::new(),",
"        min_keycode,",
"        keysyms_per_keycode: 0,",
"        keysyms: Vec::new(),",
"        char_width: 8,",
"        font_ascent: 12,",
"        color: 0,",
"        line_width: 1,",
"    };",
"    (ui, root, root_depth, min_keycode, max_keycode)",
"}",
"",
"pub fn t_open_window(title: Rc<String>, width: i64, height: i64, loc: &str) {",
"    if !(1..=4096).contains(&width) || !(1..=4096).contains(&height) {",
"        t_ui_fail(format!(\"window size {}x{} is outside 1..4096\", width, height), loc)",
"    }",
"    if T_UI.with(|cell| cell.borrow().is_some()) {",
"        t_ui_fail(\"a window is already open\".to_string(), loc)",
"    }",
"    let (mut ui, root, root_depth, min_keycode, max_keycode) = t_ui_connect(width, height, loc);",
"    let wm_protocols = ui.intern_atom(\"WM_PROTOCOLS\", loc);",
"    ui.wm_delete = ui.intern_atom(\"WM_DELETE_WINDOW\", loc);",
"    let net_wm_name = ui.intern_atom(\"_NET_WM_NAME\", loc);",
"    let utf8_string = ui.intern_atom(\"UTF8_STRING\", loc);",
"",
"    // Window: white background; key, button, exposure and structure events.",
"    ui.window = ui.new_id();",
"    let start = ui.begin(1, root_depth);",
"    t_put32(&mut ui.out, ui.window);",
"    t_put32(&mut ui.out, root);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, ui.width);",
"    t_put16(&mut ui.out, ui.height);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, 1);",
"    t_put32(&mut ui.out, 0);",
"    t_put32(&mut ui.out, 0x2 | 0x800);",
"    t_put32(&mut ui.out, 0xffffff);",
"    t_put32(&mut ui.out, 0x1 | 0x2 | 0x4 | 0x8000 | 0x20000);",
"    ui.end(start);",
"",
"    let latin1: Vec<u8> = title.chars().map(|c| if (c as u32) < 256 { c as u32 as u8 } else { b'?' }).collect();",
"    ui.change_property(39, 31, 8, &latin1);",
"    ui.change_property(net_wm_name, utf8_string, 8, title.as_bytes());",
"    ui.change_property(wm_protocols, 4, 32, &ui.wm_delete.to_le_bytes());",
"    let mut hints = vec![0u32; 18];",
"    hints[0] = 16 | 32;",
"    hints[5] = width as u32;",
"    hints[6] = height as u32;",
"    hints[7] = width as u32;",
"    hints[8] = height as u32;",
"    let hint_bytes: Vec<u8> = hints.iter().flat_map(|h| h.to_le_bytes()).collect();",
"    ui.change_property(40, 41, 32, &hint_bytes);",
"",
"    // Back buffer.",
"    ui.pixmap = ui.new_id();",
"    let start = ui.begin(53, root_depth);",
"    t_put32(&mut ui.out, ui.pixmap);",
"    t_put32(&mut ui.out, ui.window);",
"    t_put16(&mut ui.out, ui.width);",
"    t_put16(&mut ui.out, ui.height);",
"    ui.end(start);",
"",
"    // Font: the first one the server knows.",
"    let mut font = 0u32;",
"    for name in [\"-misc-fixed-bold-r-normal--18-120-100-100-c-90-iso8859-1\", \"-misc-fixed-bold-r-normal--15-140-75-75-c-90-iso8859-1\", \"9x15bold\", \"9x15\", \"fixed\"] {",
"        let candidate = ui.new_id();",
"        let first = ui.seq.wrapping_add(1);",
"        let start = ui.begin(45, 0);",
"        t_put32(&mut ui.out, candidate);",
"        t_put16(&mut ui.out, name.len() as u16);",
"        t_put16(&mut ui.out, 0);",
"        ui.out.extend_from_slice(name.as_bytes());",
"        ui.end(start);",
"        let start = ui.begin(47, 0);",
"        t_put32(&mut ui.out, candidate);",
"        ui.end(start);",
"        if let Ok(r) = ui.reply_since(first, loc) {",
"            font = candidate;",
"            ui.char_width = t_i16(&r, 28).max(1) as i64;",
"            ui.font_ascent = t_i16(&r, 52) as i64;",
"            break;",
"        }",
"    }",
"",
"    // Graphics context: foreground, line width, round caps and joins, font, no exposure events.",
"    ui.gc = ui.new_id();",
"    let start = ui.begin(55, 0);",
"    t_put32(&mut ui.out, ui.gc);",
"    t_put32(&mut ui.out, ui.pixmap);",
"    let mut mask = 0x4 | 0x10 | 0x40 | 0x80 | 0x10000;",
"    if font != 0 { mask |= 0x4000; }",
"    t_put32(&mut ui.out, mask);",
"    t_put32(&mut ui.out, 0);",
"    t_put32(&mut ui.out, 1);",
"    t_put32(&mut ui.out, 2);",
"    t_put32(&mut ui.out, 1);",
"    if font != 0 { t_put32(&mut ui.out, font); }",
"    t_put32(&mut ui.out, 0);",
"    ui.end(start);",
"",
"    // Clear the back buffer, show the window.",
"    ui.set_gc(0xffffff, 1);",
"    let start = ui.draw_request(70);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, 0);",
"    t_put16(&mut ui.out, ui.width);",
"    t_put16(&mut ui.out, ui.height);",
"    ui.end(start);",
"    let start = ui.begin(8, 0);",
"    t_put32(&mut ui.out, ui.window);",
"    ui.end(start);",
"",
"    // Keyboard mapping, for key names.",
"    let start = ui.begin(101, 0);",
"    ui.out.push(min_keycode);",
"    ui.out.push(max_keycode.wrapping_sub(min_keycode).wrapping_add(1));",
"    t_put16(&mut ui.out, 0);",
"    ui.end(start);",
"    let r = ui.reply(loc);",
"    ui.keysyms_per_keycode = r[1];",
"    ui.keysyms = r[32..].chunks_exact(4).map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]])).collect();",
"",
"    T_UI.with(|cell| *cell.borrow_mut() = Some(ui));",
"}",
"",
"pub fn t_fill_rectangle(x: i64, y: i64, width: i64, height: i64, color: i64, loc: &str) {",
"    if width <= 0 || height <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, ui.line_width);",
"        let start = ui.draw_request(70);",
"        t_put16(&mut ui.out, t_coord(x));",
"        t_put16(&mut ui.out, t_coord(y));",
"        t_put16(&mut ui.out, t_size(width));",
"        t_put16(&mut ui.out, t_size(height));",
"        ui.end(start);",
"    })",
"}",
"",
"pub fn t_draw_line(x1: i64, y1: i64, x2: i64, y2: i64, thickness: i64, color: i64, loc: &str) {",
"    if thickness <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, thickness);",
"        let start = ui.draw_request(66);",
"        for v in [x1, y1, x2, y2] { t_put16(&mut ui.out, t_coord(v)); }",
"        ui.end(start);",
"    })",
"}",
"",
"fn t_arc(opcode: u8, center_x: i64, center_y: i64, radius: i64, thickness: i64, color: i64, loc: &str) {",
"    if radius <= 0 || thickness <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, thickness);",
"        let start = ui.draw_request(opcode);",
"        t_put16(&mut ui.out, t_coord(center_x - radius));",
"        t_put16(&mut ui.out, t_coord(center_y - radius));",
"        t_put16(&mut ui.out, t_size(radius * 2));",
"        t_put16(&mut ui.out, t_size(radius * 2));",
"        t_put16(&mut ui.out, 0);",
"        t_put16(&mut ui.out, (360 * 64) as u16);",
"        ui.end(start);",
"    })",
"}",
"",
"pub fn t_draw_circle(center_x: i64, center_y: i64, radius: i64, thickness: i64, color: i64, loc: &str) {",
"    t_arc(68, center_x, center_y, radius, thickness, color, loc)",
"}",
"",
"pub fn t_fill_circle(center_x: i64, center_y: i64, radius: i64, color: i64, loc: &str) {",
"    t_arc(71, center_x, center_y, radius, 1, color, loc)",
"}",
"",
"pub fn t_draw_text(x: i64, y: i64, text: Rc<String>, color: i64, loc: &str) {",
"    let bytes: Vec<u8> = text.chars().map(|c| if (c as u32) >= 32 && (c as u32) < 256 { c as u32 as u8 } else { b'?' }).collect();",
"    if bytes.is_empty() { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_gc(color, ui.line_width);",
"        let start = ui.draw_request(74);",
"        t_put16(&mut ui.out, t_coord(x));",
"        t_put16(&mut ui.out, t_coord(y + ui.font_ascent));",
"        for chunk in bytes.chunks(254) {",
"            ui.out.push(chunk.len() as u8);",
"            ui.out.push(0);",
"            ui.out.extend_from_slice(chunk);",
"        }",
"        ui.end(start);",
"    })",
"}",
"",
"pub fn t_text_width(text: Rc<String>, loc: &str) -> i64 {",
"    t_with_ui(loc, |ui| ui.char_width * text.chars().count() as i64)",
"}",
"",
"pub fn t_present(loc: &str) {",
"    t_with_ui(loc, |ui| ui.present(loc))",
"}",
"",
"pub fn t_next_event(loc: &str) -> Rc<T_WindowEvent> {",
"    t_with_ui(loc, |ui| {",
"        ui.flush(loc);",
"        loop {",
"            let packet = match ui.events.pop_front() {",
"                Some(p) => p,",
"                None => ui.read_packet(loc),",
"            };",
"            if let Some(event) = ui.event_of(packet, loc) { return event; }",
"        }",
"    })",
"}",
"",
"pub fn t_poll_event(loc: &str) -> Option<Rc<T_WindowEvent>> {",
"    t_with_ui(loc, |ui| {",
"        ui.flush(loc);",
"        loop {",
"            let packet = match ui.events.pop_front() {",
"                Some(p) => p,",
"                None => ui.next_packet(false, loc)?,",
"            };",
"            if let Some(event) = ui.event_of(packet, loc) { return Some(event); }",
"        }",
"    })",
"}",
"",
"/// Draws rows of `width` colors at (x, y), each pixel as a scale x scale square, with PutImage",
"/// (ZPixmap, 32 bits per pixel). The image is sent in bands of rows, as one request may carry at",
"/// most 262,140 bytes without the BIG-REQUESTS extension.",
"pub fn t_draw_pixels(x: i64, y: i64, width: i64, colors: &Rc<Vec<i64>>, scale: i64, loc: &str) {",
"    if width < 1 || width > 4096 || !(1..=16).contains(&scale) || colors.len() as i64 % width != 0 {",
"        t_fail(\"R004\", format!(\"draw_pixels: width {} and scale {} do not fit {} colors (scale 1..16, width 1..4096, colors a multiple of width)\", width, scale, colors.len()), loc)",
"    }",
"    if let Some(bad) = colors.iter().find(|c| !(0..=0xffffff).contains(*c)) {",
"        t_fail(\"R011\", format!(\"draw_pixels: {} is not a color (0..16777215)\", bad), loc)",
"    }",
"    let rows = colors.len() as i64 / width;",
"    let out_width = (width * scale) as usize;",
"    let rows_per_band = ((262140 - 24) / (out_width * 4)).max(1);",
"    t_with_ui(loc, |ui| {",
"        let mut out_row = 0usize;",
"        let total_rows = (rows * scale) as usize;",
"        while out_row < total_rows {",
"            let band = rows_per_band.min(total_rows - out_row);",
"            let start = ui.begin(72, 2);",
"            t_put32(&mut ui.out, ui.pixmap);",
"            t_put32(&mut ui.out, ui.gc);",
"            t_put16(&mut ui.out, out_width as u16);",
"            t_put16(&mut ui.out, band as u16);",
"            t_put16(&mut ui.out, t_coord(x));",
"            t_put16(&mut ui.out, t_coord(y + out_row as i64));",
"            ui.out.push(0);",
"            ui.out.push(24);",
"            t_put16(&mut ui.out, 0);",
"            ui.out.reserve(out_width * band * 4);",
"            for r in out_row..out_row + band {",
"                let source = (r / scale as usize) * width as usize;",
"                for c in &colors[source..source + width as usize] {",
"                    let pixel = (*c as u32).to_le_bytes();",
"                    for _ in 0..scale { ui.out.extend_from_slice(&pixel); }",
"                }",
"            }",
"            ui.end(start);",
"            out_row += band;",
"            if ui.out.len() > 1 << 20 { ui.flush(loc); }",
"        }",
"    })",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/win32.rs; do not edit by hand."
pub fn win32_runtime() -> Text {
let lines = [
"// ---------------------------------------------------------------------------",
"// Tessera `ui` runtime for Windows: one native window, drawn with GDI.",
"//",
"// The counterpart of runtime/ui.rs (the X11 client used on unix). It offers the",
"// same functions with the same meaning, so a Tessera program that uses the `ui`",
"// effect compiles and behaves the same on both systems: one window per program,",
"// drawing goes to an off-screen bitmap and becomes visible on `present()`.",
"//",
"// This is the only part of the runtime besides runtime/adapter.rs that contains",
"// `unsafe` code; the window system has no other interface than its C functions.",
"// The unsafe surface is the `extern \"system\"` declarations below and their call",
"// sites. Everything above them -- colours, coordinates, key names, the event",
"// queue -- is ordinary safe Rust. Generated programs that use `ui` therefore say",
"// `#![cfg_attr(windows, deny(unsafe_code))]` instead of `forbid`, and only this",
"// module is `#[allow(unsafe_code)]`; on unix the blanket `forbid` still holds.",
"//",
"// Mapping from the X11 backend, so both stay comparable:",
"//   pixmap          -> a memory DC with a compatible bitmap (the back buffer)",
"//   PolyFillRectangle -> FillRect with the DC brush",
"//   PolyLine        -> a geometric pen with round caps, MoveToEx + LineTo",
"//   PolyArc/PolyFillArc -> Ellipse with a null brush / with the DC brush",
"//   PolyText8       -> TextOutW with a transparent background",
"//   PutImage        -> StretchDIBits from a top-down 32-bit BI_RGB bitmap",
"//   CopyArea        -> BitBlt from the memory DC to the window DC",
"//   Expose          -> WM_PAINT, which queues a repaint the event loop answers",
"// ---------------------------------------------------------------------------",
"",
"use std::cell::RefCell;",
"use std::collections::VecDeque;",
"",
"// --- the C interface ------------------------------------------------------",
"",
"type T_Handle = *mut std::ffi::c_void;",
"",
"#[repr(C)]",
"struct T_Point { x: i32, y: i32 }",
"",
"#[repr(C)]",
"struct T_Rect { left: i32, top: i32, right: i32, bottom: i32 }",
"",
"#[repr(C)]",
"struct T_Msg { hwnd: T_Handle, message: u32, w: usize, l: isize, time: u32, pt: T_Point }",
"",
"#[repr(C)]",
"struct T_PaintStruct { hdc: T_Handle, erase: i32, paint: T_Rect, restore: i32, inc_update: i32, reserved: [u8; 32] }",
"",
"#[repr(C)]",
"struct T_WndClass {",
"    style: u32,",
"    proc_: Option<unsafe extern \"system\" fn(T_Handle, u32, usize, isize) -> isize>,",
"    class_extra: i32,",
"    window_extra: i32,",
"    instance: T_Handle,",
"    icon: T_Handle,",
"    cursor: T_Handle,",
"    background: T_Handle,",
"    menu_name: *const u16,",
"    class_name: *const u16,",
"}",
"",
"#[repr(C)]",
"struct T_LogBrush { style: u32, color: u32, hatch: usize }",
"",
"#[repr(C)]",
"struct T_BitmapInfoHeader {",
"    size: u32,",
"    width: i32,",
"    height: i32,",
"    planes: u16,",
"    bit_count: u16,",
"    compression: u32,",
"    size_image: u32,",
"    x_pixels_per_meter: i32,",
"    y_pixels_per_meter: i32,",
"    colors_used: u32,",
"    colors_important: u32,",
"}",
"",
"#[repr(C)]",
"struct T_TextMetric {",
"    height: i32,",
"    ascent: i32,",
"    descent: i32,",
"    internal_leading: i32,",
"    external_leading: i32,",
"    average_char_width: i32,",
"    max_char_width: i32,",
"    weight: i32,",
"    overhang: i32,",
"    digitized_aspect_x: i32,",
"    digitized_aspect_y: i32,",
"    first_char: u16,",
"    last_char: u16,",
"    default_char: u16,",
"    break_char: u16,",
"    italic: u8,",
"    underlined: u8,",
"    struck_out: u8,",
"    pitch_and_family: u8,",
"    char_set: u8,",
"}",
"",
"#[link(name = \"kernel32\")]",
"extern \"system\" {",
"    fn GetModuleHandleW(name: *const u16) -> T_Handle;",
"    fn GetLastError() -> u32;",
"}",
"",
"#[link(name = \"user32\")]",
"extern \"system\" {",
"    fn RegisterClassW(class: *const T_WndClass) -> u16;",
"    fn CreateWindowExW(ex_style: u32, class: *const u16, title: *const u16, style: u32,",
"                       x: i32, y: i32, width: i32, height: i32,",
"                       parent: T_Handle, menu: T_Handle, instance: T_Handle, param: T_Handle) -> T_Handle;",
"    fn DefWindowProcW(window: T_Handle, message: u32, w: usize, l: isize) -> isize;",
"    fn AdjustWindowRect(rect: *mut T_Rect, style: u32, menu: i32) -> i32;",
"    fn ShowWindow(window: T_Handle, how: i32) -> i32;",
"    fn UpdateWindow(window: T_Handle) -> i32;",
"    fn SetForegroundWindow(window: T_Handle) -> i32;",
"    fn GetDC(window: T_Handle) -> T_Handle;",
"    fn LoadCursorW(instance: T_Handle, name: *const u16) -> T_Handle;",
"    fn PeekMessageW(message: *mut T_Msg, window: T_Handle, first: u32, last: u32, remove: u32) -> i32;",
"    fn GetMessageW(message: *mut T_Msg, window: T_Handle, first: u32, last: u32) -> i32;",
"    fn TranslateMessage(message: *const T_Msg) -> i32;",
"    fn DispatchMessageW(message: *const T_Msg) -> isize;",
"    fn BeginPaint(window: T_Handle, paint: *mut T_PaintStruct) -> T_Handle;",
"    fn EndPaint(window: T_Handle, paint: *const T_PaintStruct) -> i32;",
"    fn ToUnicode(key: u32, scan_code: u32, state: *const u8, buffer: *mut u16, size: i32, flags: u32) -> i32;",
"    fn ScreenToClient(window: T_Handle, point: *mut T_Point) -> i32;",
"    fn FillRect(dc: T_Handle, rect: *const T_Rect, brush: T_Handle) -> i32;",
"    fn SetProcessDPIAware() -> i32;",
"    fn PostQuitMessage(code: i32);",
"}",
"",
"#[link(name = \"gdi32\")]",
"extern \"system\" {",
"    fn CreateCompatibleDC(dc: T_Handle) -> T_Handle;",
"    fn CreateCompatibleBitmap(dc: T_Handle, width: i32, height: i32) -> T_Handle;",
"    fn SelectObject(dc: T_Handle, object: T_Handle) -> T_Handle;",
"    fn DeleteObject(object: T_Handle) -> i32;",
"    fn GetStockObject(index: i32) -> T_Handle;",
"    fn BitBlt(dst: T_Handle, x: i32, y: i32, width: i32, height: i32,",
"              src: T_Handle, src_x: i32, src_y: i32, rop: u32) -> i32;",
"    fn SetDCBrushColor(dc: T_Handle, color: u32) -> u32;",
"    fn ExtCreatePen(style: u32, width: u32, brush: *const T_LogBrush, style_count: u32, style_data: *const u32) -> T_Handle;",
"    fn MoveToEx(dc: T_Handle, x: i32, y: i32, previous: *mut T_Point) -> i32;",
"    fn LineTo(dc: T_Handle, x: i32, y: i32) -> i32;",
"    fn Ellipse(dc: T_Handle, left: i32, top: i32, right: i32, bottom: i32) -> i32;",
"    fn SetTextColor(dc: T_Handle, color: u32) -> u32;",
"    fn SetBkMode(dc: T_Handle, mode: i32) -> i32;",
"    fn TextOutW(dc: T_Handle, x: i32, y: i32, text: *const u16, count: i32) -> i32;",
"    fn GetTextMetricsW(dc: T_Handle, metrics: *mut T_TextMetric) -> i32;",
"    fn CreateFontW(height: i32, width: i32, escapement: i32, orientation: i32, weight: i32,",
"                   italic: u32, underline: u32, strike_out: u32, char_set: u32,",
"                   out_precision: u32, clip_precision: u32, quality: u32, pitch_and_family: u32,",
"                   face: *const u16) -> T_Handle;",
"    fn SetStretchBltMode(dc: T_Handle, mode: i32) -> i32;",
"    fn StretchDIBits(dc: T_Handle, x: i32, y: i32, width: i32, height: i32,",
"                     src_x: i32, src_y: i32, src_width: i32, src_height: i32,",
"                     bits: *const u8, info: *const T_BitmapInfoHeader, usage: u32, rop: u32) -> i32;",
"}",
"",
"const WS_CAPTION: u32 = 0x00c0_0000;",
"const WS_SYSMENU: u32 = 0x0008_0000;",
"const WS_MINIMIZEBOX: u32 = 0x0002_0000;",
"const CS_OWNDC: u32 = 0x0020;",
"const CW_USEDEFAULT: i32 = 0x8000_0000u32 as i32;",
"const SW_SHOW: i32 = 5;",
"const SRCCOPY: u32 = 0x00cc_0020;",
"const PM_REMOVE: u32 = 1;",
"const IDC_ARROW: usize = 32512;",
"",
"const WM_CLOSE: u32 = 0x0010;",
"const WM_KILLFOCUS: u32 = 0x0008;",
"const WM_DESTROY: u32 = 0x0002;",
"const WM_PAINT: u32 = 0x000f;",
"const WM_ERASEBKGND: u32 = 0x0014;",
"const WM_KEYDOWN: u32 = 0x0100;",
"const WM_KEYUP: u32 = 0x0101;",
"const WM_SYSKEYDOWN: u32 = 0x0104;",
"const WM_SYSKEYUP: u32 = 0x0105;",
"const WM_LBUTTONDOWN: u32 = 0x0201;",
"const WM_RBUTTONDOWN: u32 = 0x0204;",
"const WM_MBUTTONDOWN: u32 = 0x0207;",
"const WM_MOUSEWHEEL: u32 = 0x020a;",
"const WM_QUIT: u32 = 0x0012;",
"",
"const NULL_BRUSH: i32 = 5;",
"const DC_BRUSH: i32 = 18;",
"const SYSTEM_FIXED_FONT: i32 = 16;",
"const TRANSPARENT: i32 = 1;",
"const COLORONCOLOR: i32 = 3;",
"const DIB_RGB_COLORS: u32 = 0;",
"const PS_GEOMETRIC_SOLID_ROUND: u32 = 0x0001_0000; // PS_GEOMETRIC | PS_SOLID | PS_ENDCAP_ROUND | PS_JOIN_ROUND",
"const FW_BOLD: i32 = 700;",
"const NONANTIALIASED_QUALITY: u32 = 3;",
"const FIXED_PITCH_MODERN: u32 = 1 | 48;",
"",
"// --- state ----------------------------------------------------------------",
"",
"struct T_Ui {",
"    window: T_Handle,",
"    window_dc: T_Handle,",
"    memory_dc: T_Handle,",
"    bitmap: T_Handle,",
"    pen: T_Handle,",
"    font: T_Handle,",
"    width: i32,",
"    height: i32,",
"    char_width: i64,",
"    color: i64,",
"    line_width: i64,",
"    text_color: i64,",
"}",
"",
"/// What the window procedure saw. `Repaint` is not a Tessera event: like X11's",
"/// Expose it only means the window must be shown again from the back buffer.",
"enum T_Seen { Click(i64, i64, i64), Key(String), KeyUp(String), Close, Repaint }",
"",
"thread_local! {",
"    static T_UI: RefCell<Option<T_Ui>> = RefCell::new(None);",
"    static T_SEEN: RefCell<VecDeque<T_Seen>> = RefCell::new(VecDeque::new());",
"    // Whether Shift is down, counted from the messages themselves rather than",
"    // read from the keyboard: that way a program also sees the right key names",
"    // for events a test helper posts to the window.",
"    static T_SHIFT: std::cell::Cell<bool> = std::cell::Cell::new(false);",
"}",
"",
"fn t_ui_fail(message: String, loc: &str) -> ! {",
"    t_fail(\"R012\", message, loc)",
"}",
"",
"fn t_with_ui<R>(loc: &str, f: impl FnOnce(&mut T_Ui) -> R) -> R {",
"    T_UI.with(|cell| {",
"        let mut slot = cell.borrow_mut();",
"        match slot.as_mut() {",
"            Some(ui) => f(ui),",
"            None => t_ui_fail(\"no window is open; call open_window first\".to_string(), loc),",
"        }",
"    })",
"}",
"",
"/// A Tessera colour (0xRRGGBB) as a Windows COLORREF (0x00BBGGRR).",
"fn t_colorref(color: i64) -> u32 {",
"    let c = color as u32;",
"    ((c & 0xff) << 16) | (c & 0xff00) | ((c >> 16) & 0xff)",
"}",
"",
"fn t_coord(v: i64) -> i32 { v.clamp(-32768, 32767) as i32 }",
"fn t_size(v: i64) -> i32 { v.clamp(0, 65535) as i32 }",
"",
"fn t_wide(text: &str) -> Vec<u16> {",
"    let mut v: Vec<u16> = text.encode_utf16().collect();",
"    v.push(0);",
"    v",
"}",
"",
"// --- the window procedure -------------------------------------------------",
"",
"fn t_push(event: T_Seen) {",
"    T_SEEN.with(|q| q.borrow_mut().push_back(event));",
"}",
"",
"/// The name of a key, in the same spelling as the X11 backend: the character it",
"/// produces for printable keys, a word for the others, nothing for the rest.",
"/// `with_shift` is false for a release, which is what the X11 backend reports.",
"fn t_key_name(key: u32, scan_code: u32, with_shift: bool) -> Option<String> {",
"    let named = match key {",
"        0x1b => \"Escape\",",
"        0x0d => \"Enter\",",
"        0x08 => \"Backspace\",",
"        0x09 => \"Tab\",",
"        0x25 => \"Left\",",
"        0x26 => \"Up\",",
"        0x27 => \"Right\",",
"        0x28 => \"Down\",",
"        0x10 | 0xa0 | 0xa1 => \"Shift\",",
"        0x11 | 0xa2 | 0xa3 => \"Control\",",
"        0x12 | 0xa4 | 0xa5 => \"Alt\",",
"        0x2e => \"Delete\",",
"        0x24 => \"Home\",",
"        0x23 => \"End\",",
"        0x21 => \"PageUp\",",
"        0x22 => \"PageDown\",",
"        0x70..=0x7b => return Some(format!(\"F{}\", key - 0x70 + 1)),",
"        _ => \"\",",
"    };",
"    if !named.is_empty() {",
"        return Some(named.to_string());",
"    }",
"    // A printable key: let the keyboard layout say which character it makes.",
"    // Only Shift is part of the state, so that Ctrl+C and Caps Lock report the",
"    // same name as the plain key, exactly as the X11 backend does.",
"    let mut state = [0u8; 256];",
"    if with_shift && T_SHIFT.with(|s| s.get()) {",
"        state[0x10] = 0x80;",
"        state[0xa0] = 0x80;",
"    }",
"    let mut buffer = [0u16; 8];",
"    // Flag 4: do not disturb the keyboard state (dead keys stay pending).",
"    #[allow(unsafe_code)]",
"    let count = unsafe { ToUnicode(key, scan_code, state.as_ptr(), buffer.as_mut_ptr(), buffer.len() as i32, 4) };",
"    if count != 1 { return None; }",
"    let c = char::from_u32(buffer[0] as u32)?;",
"    if (c as u32) >= 0x20 && (c as u32) <= 0x7e { Some(c.to_string()) } else { None }",
"}",
"",
"unsafe extern \"system\" fn t_window_proc(window: T_Handle, message: u32, w: usize, l: isize) -> isize {",
"    match message {",
"        WM_CLOSE => {",
"            // Like the X11 WM_DELETE_WINDOW protocol: tell the program, and let",
"            // it decide. The window stays open until the program stops.",
"            t_push(T_Seen::Close);",
"            0",
"        }",
"        WM_DESTROY => {",
"            // Not the close button (that is WM_CLOSE, which this window keeps):",
"            // something outside the program took the window away. Tell the",
"            // program, and end the message loop so it cannot wait forever.",
"            t_push(T_Seen::Close);",
"            unsafe { PostQuitMessage(0) };",
"            0",
"        }",
"        WM_ERASEBKGND => 1, // the back buffer covers every pixel; erasing only flickers",
"        WM_PAINT => {",
"            let mut paint = T_PaintStruct { hdc: std::ptr::null_mut(), erase: 0,",
"                paint: T_Rect { left: 0, top: 0, right: 0, bottom: 0 }, restore: 0, inc_update: 0, reserved: [0; 32] };",
"            unsafe {",
"                BeginPaint(window, &mut paint);",
"                EndPaint(window, &paint);",
"            }",
"            t_push(T_Seen::Repaint);",
"            0",
"        }",
"        WM_KILLFOCUS => {",
"            // Keys released while another window had the focus are never seen,",
"            // so Shift must not stay down across a switch.",
"            T_SHIFT.with(|s| s.set(false));",
"            0",
"        }",
"        WM_KEYDOWN | WM_SYSKEYDOWN => {",
"            if matches!(w as u32, 0x10 | 0xa0 | 0xa1) { T_SHIFT.with(|s| s.set(true)); }",
"            if let Some(name) = t_key_name(w as u32, ((l >> 16) & 0xff) as u32, true) {",
"                t_push(T_Seen::Key(name));",
"            }",
"            if message == WM_SYSKEYDOWN { unsafe { DefWindowProcW(window, message, w, l) } } else { 0 }",
"        }",
"        WM_KEYUP | WM_SYSKEYUP => {",
"            if matches!(w as u32, 0x10 | 0xa0 | 0xa1) { T_SHIFT.with(|s| s.set(false)); }",
"            if let Some(name) = t_key_name(w as u32, ((l >> 16) & 0xff) as u32, false) {",
"                t_push(T_Seen::KeyUp(name));",
"            }",
"            if message == WM_SYSKEYUP { unsafe { DefWindowProcW(window, message, w, l) } } else { 0 }",
"        }",
"        WM_LBUTTONDOWN | WM_MBUTTONDOWN | WM_RBUTTONDOWN => {",
"            let button = match message { WM_LBUTTONDOWN => 1, WM_MBUTTONDOWN => 2, _ => 3 };",
"            let x = (l & 0xffff) as u16 as i16 as i64;",
"            let y = ((l >> 16) & 0xffff) as u16 as i16 as i64;",
"            t_push(T_Seen::Click(x, y, button));",
"            0",
"        }",
"        WM_MOUSEWHEEL => {",
"            // The wheel reports screen coordinates, and X11 reports it as",
"            // button 4 (away from the user) or 5 (towards the user).",
"            let mut point = T_Point { x: (l & 0xffff) as u16 as i16 as i32, y: ((l >> 16) & 0xffff) as u16 as i16 as i32 };",
"            unsafe { ScreenToClient(window, &mut point); }",
"            let delta = ((w >> 16) & 0xffff) as u16 as i16;",
"            t_push(T_Seen::Click(point.x as i64, point.y as i64, if delta > 0 { 4 } else { 5 }));",
"            0",
"        }",
"        _ => unsafe { DefWindowProcW(window, message, w, l) },",
"    }",
"}",
"",
"// --- opening the window ---------------------------------------------------",
"",
"pub fn t_open_window(title: Rc<String>, width: i64, height: i64, loc: &str) {",
"    if !(1..=4096).contains(&width) || !(1..=4096).contains(&height) {",
"        t_ui_fail(format!(\"window size {}x{} is outside 1..4096\", width, height), loc)",
"    }",
"    if T_UI.with(|cell| cell.borrow().is_some()) {",
"        t_ui_fail(\"a window is already open\".to_string(), loc)",
"    }",
"",
"    let class_name = t_wide(\"TesseraWindow\");",
"    let window_title = t_wide(title.as_str());",
"    let style = WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX; // a fixed size, like the X11 size hints",
"",
"    #[allow(unsafe_code)]",
"    let (window, window_dc) = unsafe {",
"        // Ask for real pixels: without this a scaled display would stretch the",
"        // window afterwards and every drawing would be blurred.",
"        SetProcessDPIAware();",
"        let instance = GetModuleHandleW(std::ptr::null());",
"        let class = T_WndClass {",
"            style: CS_OWNDC,",
"            proc_: Some(t_window_proc),",
"            class_extra: 0,",
"            window_extra: 0,",
"            instance,",
"            icon: std::ptr::null_mut(),",
"            cursor: LoadCursorW(std::ptr::null_mut(), IDC_ARROW as *const u16),",
"            background: std::ptr::null_mut(),",
"            menu_name: std::ptr::null(),",
"            class_name: class_name.as_ptr(),",
"        };",
"        // A second window in the same program is refused above, and registering",
"        // the same class twice is the only other way this fails.",
"        RegisterClassW(&class);",
"        let mut rect = T_Rect { left: 0, top: 0, right: width as i32, bottom: height as i32 };",
"        AdjustWindowRect(&mut rect, style, 0);",
"        let window = CreateWindowExW(0, class_name.as_ptr(), window_title.as_ptr(), style,",
"            CW_USEDEFAULT, CW_USEDEFAULT, rect.right - rect.left, rect.bottom - rect.top,",
"            std::ptr::null_mut(), std::ptr::null_mut(), instance, std::ptr::null_mut());",
"        if window.is_null() {",
"            t_ui_fail(format!(\"cannot open a window (Windows error {})\", GetLastError()), loc)",
"        }",
"        (window, GetDC(window))",
"    };",
"    if window_dc.is_null() {",
"        t_ui_fail(\"cannot open a window: the display context is not available\".to_string(), loc)",
"    }",
"",
"    #[allow(unsafe_code)]",
"    let (memory_dc, bitmap, font, char_width) = unsafe {",
"        let memory_dc = CreateCompatibleDC(window_dc);",
"        let bitmap = CreateCompatibleBitmap(window_dc, width as i32, height as i32);",
"        if memory_dc.is_null() || bitmap.is_null() {",
"            t_ui_fail(\"cannot open a window: the back buffer could not be created\".to_string(), loc)",
"        }",
"        SelectObject(memory_dc, bitmap);",
"",
"        // A fixed-pitch font without smoothing, as close as Windows gets to the",
"        // bitmap font the X11 backend asks for. `text_width` counts characters,",
"        // so the font must be fixed-pitch for the measurement to be right.",
"        let face = t_wide(\"Consolas\");",
"        let mut font = CreateFontW(18, 0, 0, 0, FW_BOLD, 0, 0, 0, 0, 0, 0,",
"            NONANTIALIASED_QUALITY, FIXED_PITCH_MODERN, face.as_ptr());",
"        if font.is_null() { font = GetStockObject(SYSTEM_FIXED_FONT); }",
"        SelectObject(memory_dc, font);",
"        let mut metrics: T_TextMetric = std::mem::zeroed();",
"        GetTextMetricsW(memory_dc, &mut metrics);",
"        SetBkMode(memory_dc, TRANSPARENT);",
"        SetStretchBltMode(memory_dc, COLORONCOLOR);",
"",
"        // A white back buffer, like the X11 backend clears it to.",
"        SetDCBrushColor(memory_dc, 0x00ff_ffff);",
"        let all = T_Rect { left: 0, top: 0, right: width as i32, bottom: height as i32 };",
"        FillRect(memory_dc, &all, GetStockObject(DC_BRUSH));",
"",
"        ShowWindow(window, SW_SHOW);",
"        UpdateWindow(window);",
"        SetForegroundWindow(window);",
"        (memory_dc, bitmap, font, metrics.average_char_width.max(1) as i64)",
"    };",
"",
"    T_UI.with(|cell| *cell.borrow_mut() = Some(T_Ui {",
"        window,",
"        window_dc,",
"        memory_dc,",
"        bitmap,",
"        pen: std::ptr::null_mut(),",
"        font,",
"        width: width as i32,",
"        height: height as i32,",
"        char_width,",
"        color: -1,",
"        line_width: -1,",
"        text_color: -1,",
"    }));",
"}",
"",
"impl T_Ui {",
"    /// The pen used for lines and outlines. A geometric pen with round caps and",
"    /// joins, which is what the X11 graphics context asks for.",
"    fn set_pen(&mut self, color: i64, line_width: i64) {",
"        if color == self.color && line_width == self.line_width { return; }",
"        let brush = T_LogBrush { style: 0, color: t_colorref(color), hatch: 0 };",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            let pen = ExtCreatePen(PS_GEOMETRIC_SOLID_ROUND, line_width.clamp(1, 65535) as u32,",
"                &brush, 0, std::ptr::null());",
"            if pen.is_null() { return; }",
"            SelectObject(self.memory_dc, pen);",
"            if !self.pen.is_null() { DeleteObject(self.pen); }",
"            self.pen = pen;",
"        }",
"        self.color = color;",
"        self.line_width = line_width;",
"    }",
"",
"    fn set_brush(&self, color: i64) {",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            SetDCBrushColor(self.memory_dc, t_colorref(color));",
"            SelectObject(self.memory_dc, GetStockObject(DC_BRUSH));",
"        }",
"    }",
"",
"    fn present(&mut self) {",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            BitBlt(self.window_dc, 0, 0, self.width, self.height, self.memory_dc, 0, 0, SRCCOPY);",
"        }",
"        // Keep the window answering the system even in a program that only",
"        // draws: on Windows a window that never reads its messages freezes.",
"        t_pump(false);",
"    }",
"}",
"",
"/// Handles the messages Windows has for this program. With `wait`, blocks until",
"/// at least one arrives. Returns false when the window system asked the program",
"/// to stop (WM_QUIT), which cannot happen before a WM_CLOSE the program ignored.",
"fn t_pump(wait: bool) -> bool {",
"    let mut message: T_Msg = T_Msg { hwnd: std::ptr::null_mut(), message: 0, w: 0, l: 0, time: 0, pt: T_Point { x: 0, y: 0 } };",
"    #[allow(unsafe_code)]",
"    unsafe {",
"        if wait {",
"            let got = GetMessageW(&mut message, std::ptr::null_mut(), 0, 0);",
"            if got <= 0 { return false; }",
"            TranslateMessage(&message);",
"            DispatchMessageW(&message);",
"        }",
"        while PeekMessageW(&mut message, std::ptr::null_mut(), 0, 0, PM_REMOVE) != 0 {",
"            if message.message == WM_QUIT { return false; }",
"            TranslateMessage(&message);",
"            DispatchMessageW(&message);",
"        }",
"    }",
"    true",
"}",
"",
"// --- drawing --------------------------------------------------------------",
"",
"pub fn t_fill_rectangle(x: i64, y: i64, width: i64, height: i64, color: i64, loc: &str) {",
"    if width <= 0 || height <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_brush(color);",
"        let rect = T_Rect {",
"            left: t_coord(x),",
"            top: t_coord(y),",
"            right: t_coord(x).saturating_add(t_size(width)),",
"            bottom: t_coord(y).saturating_add(t_size(height)),",
"        };",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            FillRect(ui.memory_dc, &rect, GetStockObject(DC_BRUSH));",
"        }",
"    })",
"}",
"",
"pub fn t_draw_line(x1: i64, y1: i64, x2: i64, y2: i64, thickness: i64, color: i64, loc: &str) {",
"    if thickness <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_pen(color, thickness);",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            MoveToEx(ui.memory_dc, t_coord(x1), t_coord(y1), std::ptr::null_mut());",
"            LineTo(ui.memory_dc, t_coord(x2), t_coord(y2));",
"        }",
"    })",
"}",
"",
"/// The bounding box GDI wants: X11 gives a width and a height that both ends",
"/// belong to, GDI an exclusive right and bottom edge.",
"fn t_circle_box(center_x: i64, center_y: i64, radius: i64) -> (i32, i32, i32, i32) {",
"    (t_coord(center_x - radius), t_coord(center_y - radius),",
"     t_coord(center_x + radius) + 1, t_coord(center_y + radius) + 1)",
"}",
"",
"pub fn t_draw_circle(center_x: i64, center_y: i64, radius: i64, thickness: i64, color: i64, loc: &str) {",
"    if radius <= 0 || thickness <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        ui.set_pen(color, thickness);",
"        let (left, top, right, bottom) = t_circle_box(center_x, center_y, radius);",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            SelectObject(ui.memory_dc, GetStockObject(NULL_BRUSH));",
"            Ellipse(ui.memory_dc, left, top, right, bottom);",
"        }",
"    })",
"}",
"",
"pub fn t_fill_circle(center_x: i64, center_y: i64, radius: i64, color: i64, loc: &str) {",
"    if radius <= 0 { return; }",
"    t_with_ui(loc, |ui| {",
"        // The outline is drawn in the same colour, so the filled disc covers the",
"        // same pixels as the X11 PolyFillArc.",
"        ui.set_pen(color, 1);",
"        ui.set_brush(color);",
"        let (left, top, right, bottom) = t_circle_box(center_x, center_y, radius);",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            Ellipse(ui.memory_dc, left, top, right, bottom);",
"        }",
"    })",
"}",
"",
"pub fn t_draw_text(x: i64, y: i64, text: Rc<String>, color: i64, loc: &str) {",
"    // The same replacement the X11 backend makes, so a program draws the same",
"    // text on both systems.",
"    let shown: String = text.chars().map(|c| if (c as u32) >= 32 && (c as u32) < 256 { c } else { '?' }).collect();",
"    if shown.is_empty() { return; }",
"    t_with_ui(loc, |ui| {",
"        if color != ui.text_color {",
"            #[allow(unsafe_code)]",
"            unsafe { SetTextColor(ui.memory_dc, t_colorref(color)); }",
"            ui.text_color = color;",
"        }",
"        let wide: Vec<u16> = shown.encode_utf16().collect();",
"        // `y` is the top of the line: TextOut places the cell top there, so the",
"        // baseline lands on y + ascent, where the X11 backend draws it.",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            TextOutW(ui.memory_dc, t_coord(x), t_coord(y), wide.as_ptr(), wide.len() as i32);",
"        }",
"    })",
"}",
"",
"pub fn t_text_width(text: Rc<String>, loc: &str) -> i64 {",
"    t_with_ui(loc, |ui| ui.char_width * text.chars().count() as i64)",
"}",
"",
"pub fn t_present(loc: &str) {",
"    t_with_ui(loc, |ui| ui.present())",
"}",
"",
"/// Draws rows of `width` colors at (x, y), each pixel as a scale x scale square.",
"/// The colors are already in the byte order a 32-bit BI_RGB bitmap wants",
"/// (0x00RRGGBB), so the rows go to the back buffer unchanged and Windows does",
"/// the scaling with COLORONCOLOR, which repeats pixels without blending.",
"pub fn t_draw_pixels(x: i64, y: i64, width: i64, colors: &Rc<Vec<i64>>, scale: i64, loc: &str) {",
"    if width < 1 || width > 4096 || !(1..=16).contains(&scale) || colors.len() as i64 % width != 0 {",
"        t_fail(\"R004\", format!(\"draw_pixels: width {} and scale {} do not fit {} colors (scale 1..16, width 1..4096, colors a multiple of width)\", width, scale, colors.len()), loc)",
"    }",
"    if let Some(bad) = colors.iter().find(|c| !(0..=0xffffff).contains(*c)) {",
"        t_fail(\"R011\", format!(\"draw_pixels: {} is not a color (0..16777215)\", bad), loc)",
"    }",
"    if colors.is_empty() { return; }",
"    let rows = colors.len() as i64 / width;",
"    let pixels: Vec<u32> = colors.iter().map(|c| *c as u32).collect();",
"    let info = T_BitmapInfoHeader {",
"        size: std::mem::size_of::<T_BitmapInfoHeader>() as u32,",
"        width: width as i32,",
"        height: -(rows as i32), // negative: the first row in memory is the top one",
"        planes: 1,",
"        bit_count: 32,",
"        compression: 0,",
"        size_image: 0,",
"        x_pixels_per_meter: 0,",
"        y_pixels_per_meter: 0,",
"        colors_used: 0,",
"        colors_important: 0,",
"    };",
"    t_with_ui(loc, |ui| {",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            StretchDIBits(ui.memory_dc, t_coord(x), t_coord(y),",
"                t_size(width * scale), t_size(rows * scale),",
"                0, 0, width as i32, rows as i32,",
"                pixels.as_ptr() as *const u8, &info, DIB_RGB_COLORS, SRCCOPY);",
"        }",
"    })",
"}",
"",
"// --- events ---------------------------------------------------------------",
"",
"fn t_take_event(ui: &mut T_Ui) -> Option<Rc<T_WindowEvent>> {",
"    loop {",
"        let seen = T_SEEN.with(|q| q.borrow_mut().pop_front())?;",
"        match seen {",
"            T_Seen::Repaint => ui.present(),",
"            T_Seen::Click(x, y, button) => return Some(Rc::new(T_WindowEvent::V_Click(x, y, button))),",
"            T_Seen::Key(name) => return Some(Rc::new(T_WindowEvent::V_Key(Rc::new(name)))),",
"            T_Seen::KeyUp(name) => return Some(Rc::new(T_WindowEvent::V_KeyUp(Rc::new(name)))),",
"            T_Seen::Close => return Some(Rc::new(T_WindowEvent::V_Close)),",
"        }",
"    }",
"}",
"",
"pub fn t_next_event(loc: &str) -> Rc<T_WindowEvent> {",
"    t_with_ui(loc, |ui| {",
"        loop {",
"            if let Some(event) = t_take_event(ui) { return event; }",
"            if !t_pump(true) {",
"                // The window is gone. Anything the message loop saw on the way",
"                // out, such as the Close that WM_DESTROY queues, is reported",
"                // first; only then is there nothing left to wait for.",
"                if let Some(event) = t_take_event(ui) { return event; }",
"                t_ui_fail(\"the window was closed by the system\".to_string(), loc)",
"            }",
"        }",
"    })",
"}",
"",
"pub fn t_poll_event(loc: &str) -> Option<Rc<T_WindowEvent>> {",
"    t_with_ui(loc, |ui| {",
"        t_pump(false);",
"        t_take_event(ui)",
"    })",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/audio.rs; do not edit by hand."
pub fn audio_runtime() -> Text {
let lines = [
"// ---------------------------------------------------------------------------",
"// Tessera `audio` runtime (draft 0.19), included in a program that plays sound.",
"//",
"// One mixer thread adds up to 16 voices and sends 16-bit stereo frames at",
"// 22,050 per second to the sound device. Where that device is differs per",
"// system, and `TSink` is the only part that knows:",
"//",
"//   unix     a player that reads raw samples from standard input (`aplay`,",
"//            `pw-cat`, or the program named in TESSERA_AUDIO_PLAYER). Safe",
"//            Rust: a child process and a pipe.",
"//   Windows  the sound card itself through waveOut (runtime/winmm.rs), because",
"//            Windows ships no such player. TESSERA_AUDIO_PLAYER still works and",
"//            is tried first.",
"//",
"// Without any device, sounds are dropped silently.",
"// ---------------------------------------------------------------------------",
"",
"struct TVoice { samples: Vec<u8>, position: u64, step: u64, left: i32, right: i32 }",
"struct TMixer { voices: Vec<TVoice>, running: bool }",
"static T_MIXER: std::sync::OnceLock<Option<std::sync::Arc<std::sync::Mutex<TMixer>>>> = std::sync::OnceLock::new();",
"",
"/// Where mixed frames go. `write` blocks while the device is full, which is",
"/// what paces the mixer thread, and returns false when the device is gone.",
"enum TSink {",
"    Player(std::process::ChildStdin),",
"    #[cfg(windows)]",
"    Device(t_sound_backend::TWaveOut),",
"}",
"",
"impl TSink {",
"    fn write(&mut self, frames: &[u8]) -> bool {",
"        match self {",
"            TSink::Player(input) => {",
"                use std::io::Write;",
"                input.write_all(frames).is_ok()",
"            }",
"            #[cfg(windows)]",
"            TSink::Device(device) => device.write(frames),",
"        }",
"    }",
"}",
"",
"/// The player named in TESSERA_AUDIO_PLAYER, or one of the usual ones.",
"fn t_audio_player() -> Option<TSink> {",
"    use std::process::{Command, Stdio};",
"    let mut candidates: Vec<Vec<String>> = Vec::new();",
"    if let Ok(custom) = std::env::var(\"TESSERA_AUDIO_PLAYER\") {",
"        if !custom.trim().is_empty() { candidates.push(custom.split_whitespace().map(|s| s.to_string()).collect()); }",
"    }",
"    if !cfg!(windows) {",
"        candidates.push([\"aplay\", \"-q\", \"-t\", \"raw\", \"-f\", \"S16_LE\", \"-r\", \"22050\", \"-c\", \"2\", \"--buffer-time=60000\", \"-\"].iter().map(|s| s.to_string()).collect());",
"        candidates.push([\"pw-cat\", \"--playback\", \"--format=s16\", \"--rate=22050\", \"--channels=2\", \"--latency=40ms\", \"-\"].iter().map(|s| s.to_string()).collect());",
"    }",
"    for argv in candidates {",
"        let child = Command::new(&argv[0]).args(&argv[1..]).stdin(Stdio::piped()).stdout(Stdio::null()).stderr(Stdio::null()).spawn();",
"        if let Ok(mut child) = child {",
"            if let Some(input) = child.stdin.take() { return Some(TSink::Player(input)); }",
"        }",
"    }",
"    None",
"}",
"",
"#[cfg(windows)]",
"fn t_audio_device() -> Option<TSink> {",
"    if let Some(player) = t_audio_player() { return Some(player); }",
"    t_sound_backend::TWaveOut::open().map(TSink::Device)",
"}",
"",
"#[cfg(not(windows))]",
"fn t_audio_device() -> Option<TSink> {",
"    t_audio_player()",
"}",
"",
"fn t_start_audio() -> Option<std::sync::Arc<std::sync::Mutex<TMixer>>> {",
"    let mut sink = t_audio_device()?;",
"    let mixer = std::sync::Arc::new(std::sync::Mutex::new(TMixer { voices: Vec::new(), running: true }));",
"    let shared = mixer.clone();",
"    std::thread::spawn(move || {",
"        let mut buffer = vec![0u8; 256 * 4];",
"        // Pace by the clock: stay about 60 ms ahead of real time. Writing as fast as the",
"        // device accepts would queue its whole buffer (about 0.75 s for a pipe) in front of",
"        // every new sound. When far behind (the program was paused), skip ahead instead of",
"        // catching up, which would build the same queue.",
"        let started = std::time::Instant::now();",
"        let lead: u64 = 22050 * 60 / 1000;",
"        let mut written: u64 = 0;",
"        loop {",
"            let due = started.elapsed().as_micros() as u64 * 22050 / 1_000_000 + lead;",
"            if written + 256 > due {",
"                std::thread::sleep(std::time::Duration::from_micros((written + 256 - due) * 1_000_000 / 22050));",
"                continue;",
"            }",
"            if due > written + 2 * lead {",
"                written = due - lead;",
"            }",
"            written += 256;",
"            {",
"                let mut m = match shared.lock() { Ok(m) => m, Err(_) => return };",
"                if !m.running { return; }",
"                for frame in 0..256 {",
"                    let (mut l, mut r) = (0i32, 0i32);",
"                    for v in m.voices.iter_mut() {",
"                        let index = (v.position >> 16) as usize;",
"                        if index < v.samples.len() {",
"                            let s = (v.samples[index] as i32 - 128) * 256;",
"                            l += s * v.left / 100;",
"                            r += s * v.right / 100;",
"                            v.position += v.step;",
"                        }",
"                    }",
"                    m.voices.retain(|v| ((v.position >> 16) as usize) < v.samples.len());",
"                    let l = l.clamp(-32768, 32767) as i16;",
"                    let r = r.clamp(-32768, 32767) as i16;",
"                    buffer[frame * 4..frame * 4 + 2].copy_from_slice(&l.to_le_bytes());",
"                    buffer[frame * 4 + 2..frame * 4 + 4].copy_from_slice(&r.to_le_bytes());",
"                }",
"            }",
"            if !sink.write(&buffer) {",
"                if let Ok(mut m) = shared.lock() { m.running = false; }",
"                return;",
"            }",
"        }",
"    });",
"    Some(mixer)",
"}",
"",
"fn t_play_sound(samples: &Rc<Vec<u8>>, rate: i64, volume: i64, pan: i64, loc: &str) {",
"    if !(1000..=96000).contains(&rate) || !(0..=100).contains(&volume) || !(-100..=100).contains(&pan) {",
"        t_fail(\"R004\", format!(\"play_sound: rate {} (1000..96000), volume {} (0..100) or pan {} (-100..100) out of range\", rate, volume, pan), loc)",
"    }",
"    let mixer = match T_MIXER.get_or_init(t_start_audio) { Some(m) => m, None => return };",
"    if let Ok(mut m) = mixer.lock() {",
"        if !m.running || samples.is_empty() || volume == 0 { return; }",
"        if m.voices.len() >= 16 { m.voices.remove(0); }",
"        // Equal-power-ish panning: the far side fades to a third at full pan.",
"        let left = (volume * (300 - (pan.max(0) * 2)) / 300) as i32;",
"        let right = (volume * (300 + (pan.min(0) * 2)) / 300) as i32;",
"        let step = ((rate as u64) << 16) / 22050;",
"        m.voices.push(TVoice { samples: samples.to_vec(), position: 0, step, left, right });",
"    }",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/winmm.rs; do not edit by hand."
pub fn winmm_runtime() -> Text {
let lines = [
"// ---------------------------------------------------------------------------",
"// Tessera `audio` runtime for Windows: the sound card through waveOut (winmm).",
"//",
"// The counterpart of the player process the unix backend pipes samples into.",
"// Windows ships no program that plays raw samples from standard input, so the",
"// frames go to the device itself. runtime/audio.rs does all the mixing; this",
"// file only hands finished frames over and waits when the device is full.",
"//",
"// Together with runtime/win32.rs and runtime/adapter.rs this is the only part",
"// of the runtime that contains `unsafe` code; the sound device has no interface",
"// other than its C functions. The unsafe surface is the `extern \"system\"`",
"// declarations and their call sites. A program that plays sound therefore says",
"// `#![cfg_attr(windows, deny(unsafe_code))]` instead of `forbid`, and only this",
"// module is `#[allow(unsafe_code)]`; on unix the blanket `forbid` still holds.",
"//",
"// How it works: four buffers of 256 frames (about 46 ms of sound) go round. To",
"// write, the oldest buffer is waited for, refilled and handed back to the",
"// device, so `write` blocks exactly as a pipe to a player would and paces the",
"// mixer thread the same way. Every buffer stays at a fixed address for as long",
"// as the device may read it: they live in a boxed array that is only freed in",
"// `Drop`, after `waveOutReset` has taken every buffer back.",
"// ---------------------------------------------------------------------------",
"",
"type T_Handle = *mut std::ffi::c_void;",
"",
"const BUFFERS: usize = 4;",
"const FRAMES: usize = 256;",
"const BYTES: usize = FRAMES * 4; // 16-bit stereo",
"",
"const WAVE_MAPPER: usize = 0xffff_ffff;",
"const WAVE_FORMAT_PCM: u16 = 1;",
"const WHDR_DONE: u32 = 0x0000_0001;",
"const MMSYSERR_NOERROR: u32 = 0;",
"const CALLBACK_NULL: u32 = 0;",
"",
"#[repr(C)]",
"struct T_WaveFormat {",
"    format_tag: u16,",
"    channels: u16,",
"    samples_per_second: u32,",
"    bytes_per_second: u32,",
"    block_align: u16,",
"    bits_per_sample: u16,",
"    extra_size: u16,",
"}",
"",
"#[repr(C)]",
"struct T_WaveHeader {",
"    data: *mut u8,",
"    buffer_length: u32,",
"    bytes_recorded: u32,",
"    user: usize,",
"    flags: u32,",
"    loops: u32,",
"    next: *mut T_WaveHeader,",
"    reserved: usize,",
"}",
"",
"#[link(name = \"winmm\")]",
"extern \"system\" {",
"    fn waveOutOpen(out: *mut T_Handle, device: usize, format: *const T_WaveFormat,",
"                   callback: usize, instance: usize, flags: u32) -> u32;",
"    fn waveOutPrepareHeader(device: T_Handle, header: *mut T_WaveHeader, size: u32) -> u32;",
"    fn waveOutUnprepareHeader(device: T_Handle, header: *mut T_WaveHeader, size: u32) -> u32;",
"    fn waveOutWrite(device: T_Handle, header: *mut T_WaveHeader, size: u32) -> u32;",
"    fn waveOutReset(device: T_Handle) -> u32;",
"    fn waveOutClose(device: T_Handle) -> u32;",
"}",
"",
"#[link(name = \"kernel32\")]",
"extern \"system\" {",
"    fn Sleep(milliseconds: u32);",
"}",
"",
"struct T_Block {",
"    header: T_WaveHeader,",
"    samples: [u8; BYTES],",
"}",
"",
"pub struct TWaveOut {",
"    device: T_Handle,",
"    // Boxed, so the addresses the device was given never move.",
"    blocks: Box<[T_Block; BUFFERS]>,",
"    next: usize,",
"    queued: usize,",
"}",
"",
"// The mixer owns the device on its own thread and nothing else touches it.",
"unsafe impl Send for TWaveOut {}",
"",
"impl TWaveOut {",
"    /// Opens the default sound device, or returns None when there is none (a",
"    /// machine without a sound card, or a session that cannot reach it). A",
"    /// program then simply plays no sound, as it does without a player on unix.",
"    pub fn open() -> Option<TWaveOut> {",
"        let format = T_WaveFormat {",
"            format_tag: WAVE_FORMAT_PCM,",
"            channels: 2,",
"            samples_per_second: 22050,",
"            bytes_per_second: 22050 * 4,",
"            block_align: 4,",
"            bits_per_sample: 16,",
"            extra_size: 0,",
"        };",
"        let mut device: T_Handle = std::ptr::null_mut();",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            if waveOutOpen(&mut device, WAVE_MAPPER, &format, 0, 0, CALLBACK_NULL) != MMSYSERR_NOERROR {",
"                return None;",
"            }",
"        }",
"        let mut out = TWaveOut {",
"            device,",
"            blocks: Box::new(std::array::from_fn(|_| T_Block {",
"                header: T_WaveHeader {",
"                    data: std::ptr::null_mut(),",
"                    buffer_length: BYTES as u32,",
"                    bytes_recorded: 0,",
"                    user: 0,",
"                    // Starts as \"the device is done with it\", so the first four",
"                    // writes do not wait.",
"                    flags: WHDR_DONE,",
"                    loops: 0,",
"                    next: std::ptr::null_mut(),",
"                    reserved: 0,",
"                },",
"                samples: [0; BYTES],",
"            })),",
"            next: 0,",
"            queued: 0,",
"        };",
"        for i in 0..BUFFERS {",
"            let block = &mut out.blocks[i];",
"            block.header.data = block.samples.as_mut_ptr();",
"        }",
"        Some(out)",
"    }",
"",
"    /// Hands `frames` to the device, waiting until a buffer is free. False once",
"    /// the device refuses the sound, which stops the mixer.",
"    pub fn write(&mut self, frames: &[u8]) -> bool {",
"        if frames.len() != BYTES {",
"            return false;",
"        }",
"        let index = self.next;",
"        self.next = (self.next + 1) % BUFFERS;",
"        // Every buffer after the first round was prepared before and must be",
"        // released before it is prepared again.",
"        let used_before = self.queued > index;",
"        if !used_before {",
"            self.queued = index + 1;",
"        }",
"        let device = self.device;",
"        let size = std::mem::size_of::<T_WaveHeader>() as u32;",
"        let block: *mut T_Block = &mut self.blocks[index];",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            // Wait for the device to be done with this buffer. Every buffer is",
"            // 11.6 ms of sound, so a sleep of 1 ms costs at most a tenth of",
"            // that. The flag is written by the sound driver on its own thread,",
"            // so it is read afresh every time rather than kept in a register.",
"            let flags = std::ptr::addr_of!((*block).header.flags);",
"            let mut waited = 0u32;",
"            while std::ptr::read_volatile(flags) & WHDR_DONE == 0 {",
"                Sleep(1);",
"                waited += 1;",
"                // A device that never gives a buffer back (unplugged while it",
"                // was playing) must not hang the mixer thread for good.",
"                if waited > 1000 {",
"                    return false;",
"                }",
"            }",
"            let header = std::ptr::addr_of_mut!((*block).header);",
"            if used_before && waveOutUnprepareHeader(device, header, size) != MMSYSERR_NOERROR {",
"                return false;",
"            }",
"            (*block).samples.copy_from_slice(frames);",
"            (*block).header.flags = 0;",
"            waveOutPrepareHeader(device, header, size) == MMSYSERR_NOERROR",
"                && waveOutWrite(device, header, size) == MMSYSERR_NOERROR",
"        }",
"    }",
"}",
"",
"impl Drop for TWaveOut {",
"    fn drop(&mut self) {",
"        #[allow(unsafe_code)]",
"        unsafe {",
"            // Takes every buffer back from the device before they are freed.",
"            waveOutReset(self.device);",
"            let size = std::mem::size_of::<T_WaveHeader>() as u32;",
"            for i in 0..self.queued.min(BUFFERS) {",
"                let block: *mut T_Block = &mut self.blocks[i];",
"                waveOutUnprepareHeader(self.device, std::ptr::addr_of_mut!((*block).header), size);",
"            }",
"            waveOutClose(self.device);",
"        }",
"    }",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/extra.rs; do not edit by hand."
pub fn extra_runtime() -> Text {
let lines = [
"",
"// ---- Stage 1 runtime additions (draft 0.13). Not used by stage 0; may refer to types the stage 1",
"// code generator always emits (`T_FileError`). Safe Rust only, like the rest of the runtime.",
"",
"// Text",
"fn t_trim(t: &Rc<String>) -> Rc<String> { Rc::new(t.trim().to_string()) }",
"fn t_starts_with(t: &Rc<String>, part: &Rc<String>) -> bool { t.starts_with(part.as_str()) }",
"fn t_ends_with(t: &Rc<String>, part: &Rc<String>) -> bool { t.ends_with(part.as_str()) }",
"fn t_replace(t: &Rc<String>, old: &Rc<String>, new: &Rc<String>) -> Rc<String> {",
"    if old.is_empty() { return t.clone(); }",
"    let out = t.replace(old.as_str(), new.as_str());",
"    t_charge(out.len());",
"    Rc::new(out)",
"}",
"fn t_slice_text(t: Rc<String>, start: i64, end: i64, loc: &str) -> Rc<String> {",
"    let count = t.chars().count() as i64;",
"    if start < 0 || end < start || end > count {",
"        t_fail(\"R004\", format!(\"invalid slice_text {}..{} of a text of length {}\", start, end, count), loc)",
"    }",
"    Rc::new(t.chars().skip(start as usize).take((end - start) as usize).collect())",
"}",
"fn t_repeat(t: Rc<String>, times: i64, loc: &str) -> Rc<String> {",
"    if times < 0 { t_fail(\"R004\", format!(\"repeat count {} is negative\", times), loc) }",
"    t_charge(t.len().saturating_mul(times as usize));",
"    Rc::new(t.repeat(times as usize))",
"}",
"fn t_pad(t: &Rc<String>, width: i64, fill: &Rc<String>, left: bool, loc: &str) -> Rc<String> {",
"    let mut chars = fill.chars();",
"    let fill_char = match (chars.next(), chars.next()) {",
"        (Some(c), None) => c,",
"        _ => t_fail(\"R004\", format!(\"the fill text must be exactly one character, found {:?}\", fill.as_str()), loc),",
"    };",
"    let count = t.chars().count() as i64;",
"    if count >= width { return t.clone(); }",
"    let padding: String = std::iter::repeat(fill_char).take((width - count) as usize).collect();",
"    t_charge(padding.len());",
"    Rc::new(if left { padding + t.as_str() } else { t.to_string() + &padding })",
"}",
"fn t_pad_left(t: Rc<String>, width: i64, fill: Rc<String>, loc: &str) -> Rc<String> { t_pad(&t, width, &fill, true, loc) }",
"fn t_pad_right(t: Rc<String>, width: i64, fill: Rc<String>, loc: &str) -> Rc<String> { t_pad(&t, width, &fill, false, loc) }",
"fn t_lines(t: &Rc<String>) -> Rc<Vec<Rc<String>>> {",
"    Rc::new(t.lines().map(|line| Rc::new(line.to_string())).collect())",
"}",
"",
"// Standard input",
"// WebAssembly: standard input is the host's \"stdin\" value, read once and consumed line by line.",
"#[cfg(target_arch = \"wasm32\")]",
"thread_local! {",
"    static T_WASM_INPUT: std::cell::RefCell<Option<(Vec<u8>, usize)>> = std::cell::RefCell::new(None);",
"}",
"#[cfg(target_arch = \"wasm32\")]",
"fn t_wasm_input(all: bool) -> Option<Vec<u8>> {",
"    T_WASM_INPUT.with(|cell| {",
"        let mut state = cell.borrow_mut();",
"        let (data, at) = state.get_or_insert_with(|| (crate::wasm_get(\"stdin\").unwrap_or_default(), 0));",
"        if *at >= data.len() { return if all { Some(Vec::new()) } else { None }; }",
"        let end = if all { data.len() } else { data[*at..].iter().position(|&b| b == b'\\n').map(|i| *at + i + 1).unwrap_or(data.len()) };",
"        let piece = data[*at..end].to_vec();",
"        *at = end;",
"        Some(piece)",
"    })",
"}",
"fn t_read_line(loc: &str) -> Option<Rc<String>> {",
"    #[cfg(target_arch = \"wasm32\")]",
"    {",
"        let mut line = t_wasm_input(false)?;",
"        if line.last() == Some(&b'\\n') { line.pop(); }",
"        if line.last() == Some(&b'\\r') { line.pop(); }",
"        return match String::from_utf8(line) { Ok(s) => Some(Rc::new(s)), Err(_) => t_fail(\"R008\", \"standard input is not valid UTF-8\".to_string(), loc) };",
"    }",
"    let _ = std::io::stdout().flush();",
"    let mut buffer = Vec::new();",
"    let mut input = std::io::stdin().lock();",
"    match std::io::BufRead::read_until(&mut input, b'\\n', &mut buffer) {",
"        Ok(0) => None,",
"        Ok(_) => {",
"            if buffer.last() == Some(&b'\\n') { buffer.pop(); }",
"            if buffer.last() == Some(&b'\\r') { buffer.pop(); }",
"            match String::from_utf8(buffer) {",
"                Ok(s) => Some(Rc::new(s)),",
"                Err(_) => t_fail(\"R008\", \"standard input is not valid UTF-8\".to_string(), loc),",
"            }",
"        }",
"        Err(e) => t_fail(\"R006\", format!(\"cannot read standard input: {}\", e), loc),",
"    }",
"}",
"fn t_read_input(loc: &str) -> Rc<String> {",
"    #[cfg(target_arch = \"wasm32\")]",
"    return match String::from_utf8(t_wasm_input(true).unwrap_or_default()) { Ok(s) => Rc::new(s), Err(_) => t_fail(\"R008\", \"standard input is not valid UTF-8\".to_string(), loc) };",
"    let _ = std::io::stdout().flush();",
"    let mut buffer = Vec::new();",
"    if let Err(e) = std::io::Read::read_to_end(&mut std::io::stdin().lock(), &mut buffer) {",
"        t_fail(\"R006\", format!(\"cannot read standard input: {}\", e), loc)",
"    }",
"    t_charge(buffer.len());",
"    match String::from_utf8(buffer) {",
"        Ok(s) => Rc::new(s),",
"        Err(_) => t_fail(\"R008\", \"standard input is not valid UTF-8\".to_string(), loc),",
"    }",
"}",
"",
"// Files, with failures as values",
"fn t_file_error(e: std::io::Error) -> Rc<T_FileError> {",
"    Rc::new(match e.kind() {",
"        std::io::ErrorKind::NotFound => T_FileError::V_NotFound,",
"        std::io::ErrorKind::PermissionDenied => T_FileError::V_PermissionDenied,",
"        _ => T_FileError::V_Other(Rc::new(e.to_string())),",
"    })",
"}",
"// The file system: the host's files in WebAssembly, the real one elsewhere.",
"fn t_fs_read(path: &str, loc: &str) -> std::io::Result<Vec<u8>> {",
"    #[cfg(target_arch = \"wasm32\")]",
"    return t_wasm_read(path);",
"    #[cfg(not(target_arch = \"wasm32\"))]",
"    return std::fs::read(t_check_path(path, loc));",
"}",
"fn t_fs_write(path: &str, data: &[u8], loc: &str) -> std::io::Result<()> {",
"    #[cfg(target_arch = \"wasm32\")]",
"    return t_wasm_write(path, data);",
"    #[cfg(not(target_arch = \"wasm32\"))]",
"    return std::fs::write(t_check_path(path, loc), data);",
"}",
"fn t_read_text(path: Rc<String>, loc: &str) -> Result<Rc<String>, Rc<T_FileError>> {",
"    match t_fs_read(&path, loc) {",
"        Ok(bytes) => {",
"            t_charge(bytes.len());",
"            match String::from_utf8(bytes) {",
"                Ok(s) => Ok(Rc::new(s)),",
"                Err(_) => Err(Rc::new(T_FileError::V_Other(Rc::new(format!(\"`{}` is not valid UTF-8 text\", path))))),",
"            }",
"        }",
"        Err(e) => Err(t_file_error(e)),",
"    }",
"}",
"fn t_write_text(path: Rc<String>, content: Rc<String>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    t_fs_write(&path, content.as_bytes(), loc).map_err(t_file_error)",
"}",
"fn t_read_bytes(path: Rc<String>, loc: &str) -> Result<Rc<Vec<u8>>, Rc<T_FileError>> {",
"    match t_fs_read(&path, loc) {",
"        Ok(bytes) => { t_charge(bytes.len()); Ok(Rc::new(bytes)) }",
"        Err(e) => Err(t_file_error(e)),",
"    }",
"}",
"fn t_write_bytes(path: Rc<String>, data: Rc<Vec<u8>>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    t_fs_write(&path, data.as_slice(), loc).map_err(t_file_error)",
"}",
"fn t_list_directory(path: Rc<String>, loc: &str) -> Result<Rc<Vec<Rc<String>>>, Rc<T_FileError>> {",
"    let entries = std::fs::read_dir(t_check_path(&path, loc)).map_err(t_file_error)?;",
"    let mut names = Vec::new();",
"    for entry in entries {",
"        let entry = entry.map_err(t_file_error)?;",
"        names.push(Rc::new(entry.file_name().to_string_lossy().to_string()));",
"    }",
"    names.sort();",
"    Ok(Rc::new(names))",
"}",
"fn t_create_directory(path: Rc<String>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    // The host's files have no directories of their own: a path is just a name.",
"    #[cfg(target_arch = \"wasm32\")]",
"    return Ok(());",
"    std::fs::create_dir_all(t_check_path(&path, loc)).map_err(t_file_error)",
"}",
"fn t_remove_file(path: Rc<String>, loc: &str) -> Result<(), Rc<T_FileError>> {",
"    std::fs::remove_file(t_check_path(&path, loc)).map_err(t_file_error)",
"}",
"",
"// Logging: standard error, which hosts route to their error log.",
"fn t_log(level: Rc<String>, message: Rc<String>) {",
"    #[cfg(target_arch = \"wasm32\")]",
"    { crate::wasm_write(2, format!(\"[{}] {}\\n\", level, message).as_bytes()); return; }",
"    let _ = std::io::stdout().flush();",
"    eprintln!(\"[{}] {}\", level, message);",
"}",
"",
"// Maps (sorted by key, so output does not depend on hashing)",
"type TMap<K, V> = Rc<std::collections::BTreeMap<K, V>>;",
"fn t_map_new<K: Ord, V>(pairs: Vec<(K, V)>) -> TMap<K, V> { Rc::new(pairs.into_iter().collect()) }",
"fn t_map_get<K: Ord, V: Clone>(m: &TMap<K, V>, key: &K) -> Option<V> { m.get(key).cloned() }",
"fn t_map_put<K: Ord + Clone, V: Clone>(mut m: TMap<K, V>, key: K, value: V) -> TMap<K, V> {",
"    t_charge(std::mem::size_of::<K>() + std::mem::size_of::<V>());",
"    Rc::make_mut(&mut m).insert(key, value);",
"    m",
"}",
"fn t_map_remove<K: Ord + Clone, V: Clone>(mut m: TMap<K, V>, key: &K) -> TMap<K, V> {",
"    if m.contains_key(key) { Rc::make_mut(&mut m).remove(key); }",
"    m",
"}",
"fn t_map_keys<K: Ord + Clone, V>(m: &TMap<K, V>) -> Rc<Vec<K>> { Rc::new(m.keys().cloned().collect()) }",
"fn t_map_values<K: Ord, V: Clone>(m: &TMap<K, V>) -> Rc<Vec<V>> { Rc::new(m.values().cloned().collect()) }",
"fn t_map_length<K, V>(m: &TMap<K, V>) -> i64 { m.len() as i64 }",
"fn t_map_contains<K: Ord, V>(m: &TMap<K, V>, key: &K) -> bool { m.contains_key(key) }",
"",
"// Bytes",
"fn t_to_bytes(t: &Rc<String>) -> Rc<Vec<u8>> { Rc::new(t.as_bytes().to_vec()) }",
"fn t_from_bytes(b: &Rc<Vec<u8>>) -> Option<Rc<String>> { String::from_utf8(b.to_vec()).ok().map(Rc::new) }",
"fn t_bytes(values: Rc<Vec<i64>>, loc: &str) -> Rc<Vec<u8>> {",
"    let mut out = Vec::with_capacity(values.len());",
"    for &v in values.iter() {",
"        if !(0..=255).contains(&v) { t_fail(\"R018\", format!(\"byte value {} is outside 0..255\", v), loc) }",
"        out.push(v as u8);",
"    }",
"    Rc::new(out)",
"}",
"fn t_byte_values(b: &Rc<Vec<u8>>) -> Rc<Vec<i64>> { Rc::new(b.iter().map(|&x| x as i64).collect()) }",
"fn t_bytes_index(b: &Rc<Vec<u8>>, i: i64, loc: &str) -> i64 {",
"    if i < 0 || (i as u64) >= (b.len() as u64) {",
"        t_fail(\"R001\", format!(\"index {} is out of bounds for bytes of length {}\", i, b.len()), loc)",
"    }",
"    b[i as usize] as i64",
"}",
"",
"// Changing part of a variable (draft 0.14): `set xs[i] = v`, `set r.field = v`. `Rc::make_mut` copies",
"// a list or record only when another value still shares it, so the change is never observable elsewhere.",
"fn t_slot<'a, T: Clone>(l: &'a mut Rc<Vec<T>>, i: i64, loc: &str) -> &'a mut T {",
"    if i < 0 || (i as u64) >= (l.len() as u64) {",
"        t_fail(\"R001\", format!(\"list index {} is out of bounds for a list of length {}\", i, l.len()), loc)",
"    }",
"    if Rc::strong_count(l) > 1 { t_charge(l.len() * std::mem::size_of::<T>()); }",
"    &mut Rc::make_mut(l)[i as usize]",
"}",
"fn t_set_byte(b: &mut Rc<Vec<u8>>, i: i64, v: i64, loc: &str) {",
"    if i < 0 || (i as u64) >= (b.len() as u64) {",
"        t_fail(\"R001\", format!(\"index {} is out of bounds for bytes of length {}\", i, b.len()), loc)",
"    }",
"    if !(0..=255).contains(&v) { t_fail(\"R018\", format!(\"byte value {} is outside 0..255\", v), loc) }",
"    if Rc::strong_count(b) > 1 { t_charge(b.len()); }",
"    Rc::make_mut(b)[i as usize] = v as u8;",
"}",
"fn t_repeat_list<T: Clone>(l: Rc<Vec<T>>, times: i64, loc: &str) -> Rc<Vec<T>> {",
"    if times < 0 { t_fail(\"R004\", format!(\"repeat count {} is negative\", times), loc) }",
"    let total = l.len().saturating_mul(times as usize);",
"    t_charge(total.saturating_mul(std::mem::size_of::<T>()));",
"    let mut out = Vec::with_capacity(total);",
"    for _ in 0..times { out.extend(l.iter().cloned()); }",
"    Rc::new(out)",
"}",
"",
"// Float (draft 0.17): IEEE 754 binary64 that is always finite. A result that would be infinite is",
"// R002 (overflow), division by zero R003, and one that is not a number R021, so NaN and infinity",
"// never reach a program.",
"fn t_float_finite(r: f64, what: &str, loc: &str) -> f64 {",
"    if r.is_nan() { t_fail(\"R021\", format!(\"{} has no real result\", what), loc) }",
"    if r.is_infinite() { t_fail(\"R002\", format!(\"float overflow: {}\", what), loc) }",
"    r",
"}",
"fn t_float_add(a: f64, b: f64, loc: &str) -> f64 { t_float_finite(a + b, &format!(\"{:?} + {:?}\", a, b), loc) }",
"fn t_float_sub(a: f64, b: f64, loc: &str) -> f64 { t_float_finite(a - b, &format!(\"{:?} - {:?}\", a, b), loc) }",
"fn t_float_mul(a: f64, b: f64, loc: &str) -> f64 { t_float_finite(a * b, &format!(\"{:?} * {:?}\", a, b), loc) }",
"fn t_float_div(a: f64, b: f64, loc: &str) -> f64 {",
"    if b == 0.0 { t_fail(\"R003\", format!(\"division by zero: {:?} / {:?}\", a, b), loc) }",
"    t_float_finite(a / b, &format!(\"{:?} / {:?}\", a, b), loc)",
"}",
"fn t_float_sqrt(a: f64, loc: &str) -> f64 {",
"    if a < 0.0 { t_fail(\"R021\", format!(\"sqrt({:?}) has no real result\", a), loc) }",
"    a.sqrt()",
"}",
"fn t_float_ln(a: f64, loc: &str) -> f64 {",
"    if a <= 0.0 { t_fail(\"R021\", format!(\"ln({:?}) has no real result\", a), loc) }",
"    a.ln()",
"}",
"fn t_float_exp(a: f64, loc: &str) -> f64 { t_float_finite(a.exp(), &format!(\"exp({:?})\", a), loc) }",
"fn t_float_tan(a: f64, loc: &str) -> f64 { t_float_finite(a.tan(), &format!(\"tan({:?})\", a), loc) }",
"fn t_float_pow(a: f64, b: f64, loc: &str) -> f64 { t_float_finite(a.powf(b), &format!(\"pow({:?}, {:?})\", a, b), loc) }",
"fn t_float_to_int(a: f64, loc: &str) -> i64 {",
"    let t = a.trunc();",
"    if !(t >= -9223372036854775808.0 && t < 9223372036854775808.0) { t_fail(\"R002\", format!(\"{:?} does not fit in Int\", a), loc) }",
"    t as i64",
"}",
"fn t_float_round(a: f64, places: i64, loc: &str) -> f64 {",
"    if !(0..=15).contains(&places) { t_fail(\"R004\", format!(\"round: places {} is outside 0..15\", places), loc) }",
"    // Round the exact decimal expansion of `a` (at most 1074 decimals), half away from zero, then",
"    // take the nearest Float: 2.675 is stored as 2.67499999..., so it rounds to 2.67.",
"    let exact = format!(\"{:.1100}\", a.abs());",
"    let point = exact.find('.').unwrap();",
"    let keep = point + 1 + places as usize;",
"    let mut digits: Vec<u8> = exact.as_bytes()[..keep].to_vec();",
"    if exact.as_bytes()[keep] >= b'5' {",
"        let mut i = digits.len();",
"        loop {",
"            if i == 0 { digits.insert(0, b'1'); break; }",
"            i -= 1;",
"            if digits[i] == b'.' { continue; }",
"            if digits[i] == b'9' { digits[i] = b'0'; } else { digits[i] += 1; break; }",
"        }",
"    }",
"    let magnitude: f64 = String::from_utf8(digits).unwrap().trim_end_matches('.').parse().unwrap();",
"    t_float_finite(magnitude.copysign(a), &format!(\"round({:?}, {})\", a, places), loc)",
"}",
"fn t_float_to_text(a: f64) -> Rc<String> { Rc::new(format!(\"{:?}\", a)) }",
"fn t_parse_float(t: &Rc<String>) -> Option<f64> {",
"    let b = t.as_bytes();",
"    let mut i = 0;",
"    if i < b.len() && b[i] == b'-' { i += 1; }",
"    let digits = |i: &mut usize| { let s = *i; while *i < b.len() && b[*i].is_ascii_digit() { *i += 1; } *i > s };",
"    if !digits(&mut i) { return None; }",
"    if i < b.len() && b[i] == b'.' { i += 1; if !digits(&mut i) { return None; } }",
"    if i < b.len() && (b[i] == b'e' || b[i] == b'E') {",
"        i += 1;",
"        if i < b.len() && (b[i] == b'+' || b[i] == b'-') { i += 1; }",
"        if !digits(&mut i) { return None; }",
"    }",
"    if i != b.len() { return None; }",
"    match t.parse::<f64>() { Ok(v) if v.is_finite() => Some(v), _ => None }",
"}",
"fn t_sort_floats(mut l: Rc<Vec<f64>>) -> Rc<Vec<f64>> { Rc::make_mut(&mut l).sort_by(|a, b| a.total_cmp(b)); l }",
"fn t_sort_by_float<A: Clone>(mut l: Rc<Vec<A>>, f: fn(A) -> f64) -> Rc<Vec<A>> {",
"    Rc::make_mut(&mut l).sort_by(|x, y| f(x.clone()).total_cmp(&f(y.clone())));",
"    l",
"}",
"",
"// Bit operations (draft 0.14). Shifts never lose bits silently: `shift_left` is R002 when the",
"// result does not fit, like `*`; `shift_right` is arithmetic (rounds toward negative infinity).",
"fn t_shift_amount(n: i64, loc: &str) -> u32 {",
"    if !(0..=63).contains(&n) { t_fail(\"R020\", format!(\"shift amount {} is outside 0..63\", n), loc) }",
"    n as u32",
"}",
"fn t_shift_left(a: i64, n: i64, loc: &str) -> i64 {",
"    let n = t_shift_amount(n, loc);",
"    let r = a << n;",
"    if (r >> n) != a { t_fail(\"R002\", format!(\"shift_left({}, {}) does not fit in Int\", a, n), loc) }",
"    r",
"}",
"fn t_shift_right(a: i64, n: i64, loc: &str) -> i64 { a >> t_shift_amount(n, loc) }",
"",
"// Functions as values",
"fn t_map_list<A: Clone, B>(l: Rc<Vec<A>>, f: fn(A) -> B) -> Rc<Vec<B>> {",
"    t_charge(l.len() * std::mem::size_of::<B>());",
"    Rc::new(l.iter().cloned().map(f).collect())",
"}",
"fn t_filter<A: Clone>(l: Rc<Vec<A>>, f: fn(A) -> bool) -> Rc<Vec<A>> {",
"    Rc::new(l.iter().cloned().filter(|x| f(x.clone())).collect())",
"}",
"fn t_sort_by<A: Clone, K: Ord>(mut l: Rc<Vec<A>>, f: fn(A) -> K) -> Rc<Vec<A>> {",
"    Rc::make_mut(&mut l).sort_by_key(|x| f(x.clone()));",
"    l",
"}",
"",
"// Tests",
"fn t_assert(condition: bool, loc: &str) {",
"    if !condition { t_fail(\"R019\", \"assertion failed\".to_string(), loc) }",
"}",
"fn t_run_tests(tests: &[(&str, fn())]) {",
"    t_install_panic_hook();",
"    let mut failed = 0;",
"    for (name, test) in tests.iter() {",
"        let test = *test;",
"        let outcome = std::thread::Builder::new().stack_size(64 * 1024 * 1024).spawn(move || {",
"            t_limits_begin(64 * 1024 * 1024, 10_000, 0);",
"            test();",
"        });",
"        let result = match outcome { Ok(handle) => handle.join(), Err(_) => { eprintln!(\"runtime error R000: could not start a test thread\"); std::process::exit(70) } };",
"        match result {",
"            Ok(()) => println!(\"ok      {}\", name),",
"            Err(payload) => {",
"                failed += 1;",
"                if let Some(f) = payload.downcast_ref::<TFailure>() {",
"                    println!(\"FAILED  {}\\n        runtime error {}: {}\\n        at {}\", name, f.code, f.message, f.location);",
"                } else if payload.downcast_ref::<TExit>().is_some() {",
"                    println!(\"FAILED  {}\\n        the test called exit\", name);",
"                } else {",
"                    println!(\"FAILED  {}\", name);",
"                }",
"            }",
"        }",
"    }",
"    println!(\"{} passed, {} failed\", tests.len() - failed, failed);",
"    let _ = std::io::stdout().flush();",
"    std::process::exit(if failed == 0 { 0 } else { 1 });",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/web.rs; do not edit by hand."
pub fn web_runtime() -> Text {
let lines = [
"",
"// ---------------------------------------------------------------------------",
"// Tessera `web` runtime: decimals, time, randomness, crypto and encodings,",
"// SQLite (through the sqlite3 command-line program), an HTTP client and",
"// the web hosts (HTTP/1.1 server, FastCGI responder, CGI, a binary library",
"// protocol and a one-shot \"request\" test host). TLS for the client and the",
"// server lives in tls.rs, the primitives under it in crypto.rs.",
"// Pasted at top level after core.rs. Safe Rust and std only; every item is",
"// prefixed `tw_` / `TW_` (or is `TDecimal`, `TDatabase`, `RawRequest`,",
"// `RawResponse`) so it cannot clash with core.rs or generated code. No plain",
"// `use` of names: only `as _` trait imports, which can never clash.",
"// ---------------------------------------------------------------------------",
"",
"use std::io::Read as _;",
"use std::io::BufRead as _;",
"",
"// ===========================================================================",
"// 1. Decimal: fixed point with exactly 9 decimal places (value * 10^9 in i128)",
"// ===========================================================================",
"",
"#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]",
"pub struct TDecimal(pub i128);",
"",
"const TW_DEC_SCALE: i128 = 1_000_000_000;",
"const TW_LO64: u128 = 0xFFFF_FFFF_FFFF_FFFF;",
"",
"/// Full 128 x 128 -> 256 bit unsigned product, returned as (high, low).",
"fn tw_mul_wide(a: u128, b: u128) -> (u128, u128) {",
"    let (a1, a0) = (a >> 64, a & TW_LO64);",
"    let (b1, b0) = (b >> 64, b & TW_LO64);",
"    let p00 = a0 * b0;",
"    let p01 = a0 * b1;",
"    let p10 = a1 * b0;",
"    let p11 = a1 * b1;",
"    let mid = (p00 >> 64) + (p01 & TW_LO64) + (p10 & TW_LO64);",
"    let lo = (p00 & TW_LO64) | (mid << 64);",
"    let hi = p11 + (p01 >> 64) + (p10 >> 64) + (mid >> 64);",
"    (hi, lo)",
"}",
"",
"/// 256-bit (hi, lo) divided by d < 2^64: (quotient hi, quotient lo, remainder).",
"fn tw_div_wide_small(hi: u128, lo: u128, d: u128) -> (u128, u128, u128) {",
"    let limbs = [hi >> 64, hi & TW_LO64, lo >> 64, lo & TW_LO64];",
"    let mut q = [0u128; 4];",
"    let mut r = 0u128;",
"    for i in 0..4 {",
"        let cur = (r << 64) | limbs[i];",
"        q[i] = cur / d;",
"        r = cur % d;",
"    }",
"    ((q[0] << 64) | q[1], (q[2] << 64) | q[3], r)",
"}",
"",
"/// 256-bit (hi, lo) divided by 0 < d <= 2^127: (quotient hi, quotient lo, remainder).",
"fn tw_div_wide(hi: u128, lo: u128, d: u128) -> (u128, u128, u128) {",
"    if hi == 0 { return (0, lo / d, lo % d); }",
"    let (mut qh, mut ql, mut r) = (0u128, 0u128, 0u128);",
"    for i in (0..256u32).rev() {",
"        let bit = if i >= 128 { (hi >> (i - 128)) & 1 } else { (lo >> i) & 1 };",
"        r = (r << 1) | bit; // r < d <= 2^127, so this cannot overflow",
"        qh = (qh << 1) | (ql >> 127);",
"        ql <<= 1;",
"        if r >= d { r -= d; ql |= 1; }",
"    }",
"    (qh, ql, r)",
"}",
"",
"fn tw_wide_inc(hi: u128, lo: u128) -> (u128, u128) {",
"    let (l, carry) = lo.overflowing_add(1);",
"    (hi.wrapping_add(carry as u128), l)",
"}",
"",
"fn tw_dec_pack(neg: bool, hi: u128, lo: u128) -> Option<TDecimal> {",
"    if hi != 0 { return None; }",
"    if neg {",
"        if lo > (1u128 << 127) { return None; }",
"        Some(TDecimal((lo as i128).wrapping_neg()))",
"    } else {",
"        if lo > i128::MAX as u128 { return None; }",
"        Some(TDecimal(lo as i128))",
"    }",
"}",
"",
"fn tw_dec_overflow(op: &str, a: TDecimal, b: TDecimal, loc: &str) -> ! {",
"    t_fail(\"R002\", format!(\"decimal overflow: {} {} {}\", tw_dec_to_text(a), op, tw_dec_to_text(b)), loc)",
"}",
"",
"fn tw_dec_add(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    match a.0.checked_add(b.0) { Some(v) => TDecimal(v), None => tw_dec_overflow(\"+\", a, b, loc) }",
"}",
"fn tw_dec_sub(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    match a.0.checked_sub(b.0) { Some(v) => TDecimal(v), None => tw_dec_overflow(\"-\", a, b, loc) }",
"}",
"fn tw_dec_mul(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    let neg = (a.0 < 0) != (b.0 < 0);",
"    let (hi, lo) = tw_mul_wide(a.0.unsigned_abs(), b.0.unsigned_abs());",
"    let (mut qh, mut ql, r) = tw_div_wide_small(hi, lo, TW_DEC_SCALE as u128);",
"    if r * 2 >= TW_DEC_SCALE as u128 { (qh, ql) = tw_wide_inc(qh, ql); }",
"    match tw_dec_pack(neg, qh, ql) { Some(d) => d, None => tw_dec_overflow(\"*\", a, b, loc) }",
"}",
"fn tw_dec_div(a: TDecimal, b: TDecimal, loc: &str) -> TDecimal {",
"    if b.0 == 0 { t_fail(\"R003\", format!(\"division by zero: {} / 0\", tw_dec_to_text(a)), loc) }",
"    let neg = (a.0 < 0) != (b.0 < 0);",
"    let d = b.0.unsigned_abs();",
"    let (hi, lo) = tw_mul_wide(a.0.unsigned_abs(), TW_DEC_SCALE as u128);",
"    let (mut qh, mut ql, r) = tw_div_wide(hi, lo, d);",
"    if r >= d - r { (qh, ql) = tw_wide_inc(qh, ql); } // 2r >= d: round half away from zero",
"    match tw_dec_pack(neg, qh, ql) { Some(v) => v, None => tw_dec_overflow(\"/\", a, b, loc) }",
"}",
"fn tw_dec_neg(a: TDecimal, loc: &str) -> TDecimal {",
"    match a.0.checked_neg() {",
"        Some(v) => TDecimal(v),",
"        None => t_fail(\"R002\", format!(\"decimal overflow: -({})\", tw_dec_to_text(a)), loc),",
"    }",
"}",
"fn tw_dec_from_int(n: i64) -> TDecimal { TDecimal(n as i128 * TW_DEC_SCALE) }",
"fn tw_dec_to_int(d: TDecimal, loc: &str) -> i64 {",
"    match i64::try_from(d.0 / TW_DEC_SCALE) {",
"        Ok(v) => v,",
"        Err(_) => t_fail(\"R002\", format!(\"decimal {} does not fit in an Int\", tw_dec_to_text(d)), loc),",
"    }",
"}",
"fn tw_dec_round(d: TDecimal, places: i64, loc: &str) -> TDecimal {",
"    if !(0..=9).contains(&places) { t_fail(\"R004\", format!(\"round: places {} is outside 0..9\", places), loc) }",
"    if places == 9 { return d; }",
"    let f = 10i128.pow((9 - places) as u32);",
"    let mut q = d.0 / f;",
"    let r = d.0 % f;",
"    if r.unsigned_abs() * 2 >= f as u128 { q += d.0.signum(); }",
"    match q.checked_mul(f) {",
"        Some(v) => TDecimal(v),",
"        None => t_fail(\"R002\", format!(\"decimal overflow: round({}, {})\", tw_dec_to_text(d), places), loc),",
"    }",
"}",
"fn tw_dec_to_text(d: TDecimal) -> Rc<String> {",
"    let m = d.0.unsigned_abs();",
"    let ip = m / TW_DEC_SCALE as u128;",
"    let fp = m % TW_DEC_SCALE as u128;",
"    let mut s = String::new();",
"    if d.0 < 0 { s.push('-'); }",
"    s.push_str(&ip.to_string());",
"    if fp != 0 {",
"        let f = format!(\"{:09}\", fp);",
"        s.push('.');",
"        s.push_str(f.trim_end_matches('0'));",
"    }",
"    Rc::new(s)",
"}",
"fn tw_dec_parse(text: Rc<String>) -> Option<TDecimal> {",
"    let b = text.as_bytes();",
"    let mut i = 0;",
"    let neg = b.first() == Some(&b'-');",
"    if neg { i = 1; }",
"    let start = i;",
"    let mut ip: u128 = 0;",
"    while i < b.len() && b[i].is_ascii_digit() {",
"        ip = ip.checked_mul(10)?.checked_add((b[i] - b'0') as u128)?;",
"        i += 1;",
"    }",
"    if i == start { return None; }",
"    let mut fp: u128 = 0;",
"    if i < b.len() {",
"        if b[i] != b'.' { return None; }",
"        i += 1;",
"        let fs = i;",
"        while i < b.len() && b[i].is_ascii_digit() {",
"            fp = fp * 10 + (b[i] - b'0') as u128;",
"            i += 1;",
"        }",
"        let n = i - fs;",
"        if n == 0 || n > 9 || i != b.len() { return None; }",
"        fp *= 10u128.pow((9 - n) as u32);",
"    }",
"    let mag = ip.checked_mul(TW_DEC_SCALE as u128)?.checked_add(fp)?;",
"    tw_dec_pack(neg, 0, mag)",
"}",
"",
"// ===========================================================================",
"// 2. Time: Unix time in milliseconds (i64), proleptic Gregorian calendar, UTC",
"// ===========================================================================",
"",
"fn tw_now_ms() -> i64 {",
"    #[cfg(target_arch = \"wasm32\")]",
"    return crate::wasm_now().floor() as i64;",
"    match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) {",
"        Ok(d) => i64::try_from(d.as_millis()).unwrap_or(i64::MAX),",
"        Err(e) => {",
"            let d = e.duration();",
"            let ms = i64::try_from(d.as_millis()).unwrap_or(i64::MAX - 1);",
"            if d.subsec_nanos() % 1_000_000 != 0 { -ms - 1 } else { -ms }",
"        }",
"    }",
"}",
"static TW_MONO_START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();",
"fn tw_monotonic_ms() -> i64 {",
"    #[cfg(target_arch = \"wasm32\")]",
"    return crate::wasm_monotonic().floor() as i64;",
"    let start = TW_MONO_START.get_or_init(std::time::Instant::now);",
"    i64::try_from(start.elapsed().as_millis()).unwrap_or(i64::MAX)",
"}",
"fn tw_sleep_ms(ms: i64, loc: &str) {",
"    if ms < 0 { t_fail(\"R004\", format!(\"sleep: {} milliseconds is negative\", ms), loc) }",
"    // WebAssembly cannot block: wait on the host's clock (run scripts in a Web Worker to keep a page responsive).",
"    #[cfg(target_arch = \"wasm32\")]",
"    { let end = crate::wasm_monotonic() + ms as f64; while crate::wasm_monotonic() < end {} return; }",
"    std::thread::sleep(std::time::Duration::from_millis(ms as u64));",
"}",
"",
"/// Howard Hinnant's civil_from_days: days since 1970-01-01 -> (year, month, day).",
"fn tw_civil_from_days(days: i64) -> (i64, i64, i64) {",
"    let z = days + 719_468;",
"    let era = if z >= 0 { z } else { z - 146_096 } / 146_097;",
"    let doe = z - era * 146_097;",
"    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;",
"    let y = yoe + era * 400;",
"    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);",
"    let mp = (5 * doy + 2) / 153;",
"    let d = doy - (153 * mp + 2) / 5 + 1;",
"    let m = if mp < 10 { mp + 3 } else { mp - 9 };",
"    (if m <= 2 { y + 1 } else { y }, m, d)",
"}",
"/// Howard Hinnant's days_from_civil.",
"fn tw_days_from_civil(y: i64, m: i64, d: i64) -> i64 {",
"    let y = if m <= 2 { y - 1 } else { y };",
"    let era = if y >= 0 { y } else { y - 399 } / 400;",
"    let yoe = y - era * 400;",
"    let doy = (153 * (if m > 2 { m - 3 } else { m + 9 }) + 2) / 5 + d - 1;",
"    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;",
"    era * 146_097 + doe - 719_468",
"}",
"fn tw_is_leap(y: i64) -> bool { (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }",
"fn tw_days_in_month(y: i64, m: i64) -> i64 {",
"    match m { 1 | 3 | 5 | 7 | 8 | 10 | 12 => 31, 4 | 6 | 9 | 11 => 30, _ => if tw_is_leap(y) { 29 } else { 28 } }",
"}",
"fn tw_year_text(y: i64) -> String {",
"    // RFC 3339 only covers years 0000..9999; outside that range an explicit sign is used.",
"    if (0..=9999).contains(&y) { format!(\"{:04}\", y) } else { format!(\"{:+05}\", y) }",
"}",
"fn tw_format_time(ms: i64) -> Rc<String> {",
"    let days = ms.div_euclid(86_400_000);",
"    let rem = ms.rem_euclid(86_400_000);",
"    let (y, m, d) = tw_civil_from_days(days);",
"    Rc::new(format!(\"{}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z\", tw_year_text(y), m, d,",
"        rem / 3_600_000, rem / 60_000 % 60, rem / 1000 % 60, rem % 1000))",
"}",
"fn tw_digits(b: &[u8], start: usize, n: usize) -> Option<i64> {",
"    if start + n > b.len() { return None; }",
"    let mut v = 0i64;",
"    for &c in &b[start..start + n] {",
"        if !c.is_ascii_digit() { return None; }",
"        v = v * 10 + (c - b'0') as i64;",
"    }",
"    Some(v)",
"}",
"fn tw_parse_time(text: Rc<String>) -> Option<i64> {",
"    let b = text.as_bytes();",
"    if b.len() < 20 { return None; }",
"    let y = tw_digits(b, 0, 4)?;",
"    let mo = tw_digits(b, 5, 2)?;",
"    let d = tw_digits(b, 8, 2)?;",
"    let h = tw_digits(b, 11, 2)?;",
"    let mi = tw_digits(b, 14, 2)?;",
"    let s = tw_digits(b, 17, 2)?;",
"    if b[4] != b'-' || b[7] != b'-' || !(b[10] == b'T' || b[10] == b't') || b[13] != b':' || b[16] != b':' { return None; }",
"    if !(1..=12).contains(&mo) || d < 1 || d > tw_days_in_month(y, mo) || h > 23 || mi > 59 || s > 59 { return None; }",
"    let mut i = 19;",
"    let mut millis = 0i64;",
"    if b[i] == b'.' {",
"        i += 1;",
"        let fs = i;",
"        while i < b.len() && b[i].is_ascii_digit() {",
"            if i - fs < 3 { millis = millis * 10 + (b[i] - b'0') as i64; }",
"            i += 1;",
"        }",
"        let n = i - fs;",
"        if n == 0 { return None; }",
"        for _ in n..3 { millis *= 10; }",
"    }",
"    if i >= b.len() { return None; }",
"    let offset_min = match b[i] {",
"        b'Z' | b'z' => { if i + 1 != b.len() { return None; } 0 }",
"        b'+' | b'-' => {",
"            if i + 6 != b.len() || b[i + 3] != b':' { return None; }",
"            let oh = tw_digits(b, i + 1, 2)?;",
"            let om = tw_digits(b, i + 4, 2)?;",
"            if oh > 23 || om > 59 { return None; }",
"            let v = oh * 60 + om;",
"            if b[i] == b'-' { -v } else { v }",
"        }",
"        _ => return None,",
"    };",
"    let days = tw_days_from_civil(y, mo, d);",
"    let local = days * 86_400_000 + h * 3_600_000 + mi * 60_000 + s * 1000 + millis;",
"    Some(local - offset_min * 60_000)",
"}",
"fn tw_http_date(ms: i64) -> Rc<String> {",
"    const DAYS: [&str; 7] = [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"];",
"    const MONTHS: [&str; 12] = [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"];",
"    let days = ms.div_euclid(86_400_000);",
"    let rem = ms.rem_euclid(86_400_000);",
"    let (y, m, d) = tw_civil_from_days(days);",
"    let wd = (days + 4).rem_euclid(7) as usize; // 1970-01-01 was a Thursday",
"    Rc::new(format!(\"{}, {:02} {} {} {:02}:{:02}:{:02} GMT\", DAYS[wd], d, MONTHS[(m - 1) as usize], tw_year_text(y),",
"        rem / 3_600_000, rem / 60_000 % 60, rem / 1000 % 60))",
"}",
"",
"// ===========================================================================",
"// 3. Random numbers",
"// ===========================================================================",
"//",
"// Source: /dev/urandom on unix. Elsewhere (Windows: BCryptGenRandom needs FFI,",
"// which `#![forbid(unsafe_code)]` rules out), and on unix as a fallback when",
"// /dev/urandom cannot be read, a ChaCha20 generator (RFC 8439 block function)",
"// is used. Its key is SHA-256 over several `RandomState` hasher outputs (std",
"// seeds RandomState from the operating system's RNG, giving ~128 bits of OS",
"// entropy per thread), the time, the process id, a stack address (ASLR) and a",
"// global counter. After every request for bytes the key is replaced by unused",
"// generator output (\"fast key erasure\"), so earlier output cannot be",
"// reconstructed from the current state. The state lives in a thread_local.",
"",
"struct TwChaCha { key: [u32; 8], nonce: [u32; 3] }",
"",
"thread_local! {",
"    static TW_RNG: std::cell::RefCell<Option<TwChaCha>> = std::cell::RefCell::new(None);",
"}",
"static TW_RNG_COUNTER: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);",
"",
"fn tw_chacha_qr(w: &mut [u32; 16], a: usize, b: usize, c: usize, d: usize) {",
"    w[a] = w[a].wrapping_add(w[b]); w[d] ^= w[a]; w[d] = w[d].rotate_left(16);",
"    w[c] = w[c].wrapping_add(w[d]); w[b] ^= w[c]; w[b] = w[b].rotate_left(12);",
"    w[a] = w[a].wrapping_add(w[b]); w[d] ^= w[a]; w[d] = w[d].rotate_left(8);",
"    w[c] = w[c].wrapping_add(w[d]); w[b] ^= w[c]; w[b] = w[b].rotate_left(7);",
"}",
"/// RFC 8439 section 2.3 ChaCha20 block function.",
"fn tw_chacha20_block(key: &[u32; 8], counter: u32, nonce: &[u32; 3]) -> [u8; 64] {",
"    let mut s = [0u32; 16];",
"    s[0] = 0x6170_7865; s[1] = 0x3320_646e; s[2] = 0x7962_2d32; s[3] = 0x6b20_6574;",
"    s[4..12].copy_from_slice(key);",
"    s[12] = counter;",
"    s[13..16].copy_from_slice(nonce);",
"    let mut w = s;",
"    for _ in 0..10 {",
"        tw_chacha_qr(&mut w, 0, 4, 8, 12); tw_chacha_qr(&mut w, 1, 5, 9, 13);",
"        tw_chacha_qr(&mut w, 2, 6, 10, 14); tw_chacha_qr(&mut w, 3, 7, 11, 15);",
"        tw_chacha_qr(&mut w, 0, 5, 10, 15); tw_chacha_qr(&mut w, 1, 6, 11, 12);",
"        tw_chacha_qr(&mut w, 2, 7, 8, 13); tw_chacha_qr(&mut w, 3, 4, 9, 14);",
"    }",
"    let mut out = [0u8; 64];",
"    for i in 0..16 { out[i * 4..i * 4 + 4].copy_from_slice(&w[i].wrapping_add(s[i]).to_le_bytes()); }",
"    out",
"}",
"fn tw_words_le(b: &[u8]) -> Vec<u32> {",
"    b.chunks(4).map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]])).collect()",
"}",
"fn tw_chacha_seed() -> TwChaCha {",
"    use std::hash::{BuildHasher, Hasher};",
"    let mut material = TwSha256::new();",
"    let stack_marker = 0u8;",
"    let addr = &stack_marker as *const u8 as usize; // pointer-to-int cast is safe; adds ASLR entropy",
"    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);",
"    let thread = format!(\"{:?}\", std::thread::current().id());",
"    for i in 0..8u64 {",
"        let state = std::collections::hash_map::RandomState::new();",
"        let mut h = state.build_hasher();",
"        h.write_u64(TW_RNG_COUNTER.fetch_add(1, std::sync::atomic::Ordering::Relaxed));",
"        h.write_u64(i);",
"        h.write_u128(now);",
"        h.write_usize(addr);",
"        h.write_u32(std::process::id());",
"        h.write(thread.as_bytes());",
"        material.update(&h.finish().to_le_bytes());",
"    }",
"    material.update(&now.to_le_bytes());",
"    material.update(&(addr as u64).to_le_bytes());",
"    let mut nonce_material = material.clone();",
"    material.update(b\"key\");",
"    nonce_material.update(b\"nonce\");",
"    let k = material.finish();",
"    let n = nonce_material.finish();",
"    let kw = tw_words_le(&k);",
"    let nw = tw_words_le(&n[..12]);",
"    TwChaCha { key: [kw[0], kw[1], kw[2], kw[3], kw[4], kw[5], kw[6], kw[7]], nonce: [nw[0], nw[1], nw[2]] }",
"}",
"fn tw_chacha_fill(out: &mut [u8]) {",
"    TW_RNG.with(|cell| {",
"        let mut slot = cell.borrow_mut();",
"        if slot.is_none() { *slot = Some(tw_chacha_seed()); }",
"        if let Some(g) = slot.as_mut() {",
"            let mut counter = 0u32;",
"            for chunk in out.chunks_mut(64) {",
"                let block = tw_chacha20_block(&g.key, counter, &g.nonce);",
"                chunk.copy_from_slice(&block[..chunk.len()]);",
"                counter = counter.wrapping_add(1);",
"            }",
"            let next = tw_chacha20_block(&g.key, counter, &g.nonce);",
"            let kw = tw_words_le(&next[..32]);",
"            g.key.copy_from_slice(&kw);",
"        }",
"    });",
"}",
"#[cfg(unix)]",
"fn tw_os_random(buf: &mut [u8]) -> bool {",
"    match std::fs::File::open(\"/dev/urandom\") { Ok(mut f) => f.read_exact(buf).is_ok(), Err(_) => false }",
"}",
"#[cfg(target_arch = \"wasm32\")]",
"fn tw_os_random(buf: &mut [u8]) -> bool { crate::wasm_random(buf); true }",
"#[cfg(all(not(unix), not(target_arch = \"wasm32\")))]",
"fn tw_os_random(_buf: &mut [u8]) -> bool { false }",
"fn tw_fill_random(buf: &mut [u8]) {",
"    if buf.is_empty() { return; }",
"    if !tw_os_random(buf) { tw_chacha_fill(buf); }",
"}",
"fn tw_random_u64() -> u64 {",
"    let mut b = [0u8; 8];",
"    tw_fill_random(&mut b);",
"    u64::from_le_bytes(b)",
"}",
"fn tw_random_int(low: i64, high: i64, loc: &str) -> i64 {",
"    if low >= high { t_fail(\"R004\", format!(\"random_int: low ({}) must be less than high ({})\", low, high), loc) }",
"    let span = (high as i128 - low as i128) as u64; // 1 ..= 2^64 - 1",
"    // 2^64 mod span: values below this are rejected so that the rest is an exact multiple of span.",
"    let threshold = span.wrapping_neg() % span;",
"    loop {",
"        let x = tw_random_u64();",
"        if x >= threshold { return (low as i128 + (x % span) as i128) as i64; }",
"    }",
"}",
"fn tw_random_bytes(n: i64, loc: &str) -> Rc<Vec<u8>> {",
"    if !(0..=1_048_576).contains(&n) { t_fail(\"R004\", format!(\"random_bytes: count {} is outside 0..1048576\", n), loc) }",
"    let mut v = vec![0u8; n as usize];",
"    tw_fill_random(&mut v);",
"    Rc::new(v)",
"}",
"",
"// ===========================================================================",
"// 4. Crypto and encodings",
"// ===========================================================================",
"",
"const TW_SHA_K: [u32; 64] = [",
"    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,",
"    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,",
"    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,",
"    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,",
"    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,",
"    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,",
"    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,",
"    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,",
"];",
"",
"#[derive(Clone)]",
"struct TwSha256 { h: [u32; 8], buf: [u8; 64], len: usize, total: u64 }",
"",
"impl TwSha256 {",
"    fn new() -> TwSha256 {",
"        TwSha256 {",
"            h: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],",
"            buf: [0u8; 64], len: 0, total: 0,",
"        }",
"    }",
"    fn compress(h: &mut [u32; 8], block: &[u8]) {",
"        let mut w = [0u32; 64];",
"        for t in 0..16 { w[t] = u32::from_be_bytes([block[t * 4], block[t * 4 + 1], block[t * 4 + 2], block[t * 4 + 3]]); }",
"        for t in 16..64 {",
"            let s0 = w[t - 15].rotate_right(7) ^ w[t - 15].rotate_right(18) ^ (w[t - 15] >> 3);",
"            let s1 = w[t - 2].rotate_right(17) ^ w[t - 2].rotate_right(19) ^ (w[t - 2] >> 10);",
"            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);",
"        }",
"        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) = (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);",
"        for t in 0..64 {",
"            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);",
"            let ch = (e & f) ^ (!e & g);",
"            let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(TW_SHA_K[t]).wrapping_add(w[t]);",
"            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);",
"            let maj = (a & b) ^ (a & c) ^ (b & c);",
"            let t2 = s0.wrapping_add(maj);",
"            hh = g; g = f; f = e; e = d.wrapping_add(t1); d = c; c = b; b = a; a = t1.wrapping_add(t2);",
"        }",
"        h[0] = h[0].wrapping_add(a); h[1] = h[1].wrapping_add(b); h[2] = h[2].wrapping_add(c); h[3] = h[3].wrapping_add(d);",
"        h[4] = h[4].wrapping_add(e); h[5] = h[5].wrapping_add(f); h[6] = h[6].wrapping_add(g); h[7] = h[7].wrapping_add(hh);",
"    }",
"    fn update(&mut self, mut data: &[u8]) {",
"        self.total = self.total.wrapping_add(data.len() as u64);",
"        if self.len > 0 {",
"            let take = (64 - self.len).min(data.len());",
"            self.buf[self.len..self.len + take].copy_from_slice(&data[..take]);",
"            self.len += take;",
"            data = &data[take..];",
"            if self.len == 64 {",
"                TwSha256::compress(&mut self.h, &self.buf);",
"                self.len = 0;",
"            }",
"        }",
"        while data.len() >= 64 {",
"            TwSha256::compress(&mut self.h, &data[..64]);",
"            data = &data[64..];",
"        }",
"        if !data.is_empty() {",
"            self.buf[..data.len()].copy_from_slice(data);",
"            self.len = data.len();",
"        }",
"    }",
"    fn finish(mut self) -> [u8; 32] {",
"        let bits = self.total.wrapping_mul(8);",
"        self.update(&[0x80]);",
"        while self.len != 56 { self.update(&[0]); }",
"        self.update(&bits.to_be_bytes());",
"        let mut out = [0u8; 32];",
"        for i in 0..8 { out[i * 4..i * 4 + 4].copy_from_slice(&self.h[i].to_be_bytes()); }",
"        out",
"    }",
"}",
"fn tw_sha256_raw(data: &[u8]) -> [u8; 32] {",
"    let mut s = TwSha256::new();",
"    s.update(data);",
"    s.finish()",
"}",
"",
"#[derive(Clone)]",
"struct TwHmac { inner: TwSha256, outer: TwSha256 }",
"fn tw_hmac_new(key: &[u8]) -> TwHmac {",
"    let mut k = [0u8; 64];",
"    if key.len() > 64 { k[..32].copy_from_slice(&tw_sha256_raw(key)); } else { k[..key.len()].copy_from_slice(key); }",
"    let mut ipad = [0u8; 64];",
"    let mut opad = [0u8; 64];",
"    for i in 0..64 { ipad[i] = k[i] ^ 0x36; opad[i] = k[i] ^ 0x5c; }",
"    let mut inner = TwSha256::new();",
"    inner.update(&ipad);",
"    let mut outer = TwSha256::new();",
"    outer.update(&opad);",
"    TwHmac { inner, outer }",
"}",
"fn tw_hmac_once(mac: &TwHmac, message: &[u8]) -> [u8; 32] {",
"    let mut i = mac.inner.clone();",
"    i.update(message);",
"    let digest = i.finish();",
"    let mut o = mac.outer.clone();",
"    o.update(&digest);",
"    o.finish()",
"}",
"fn tw_pbkdf2_sha256(password: &[u8], salt: &[u8], iterations: u32, dk_len: usize) -> Vec<u8> {",
"    let mac = tw_hmac_new(password);",
"    let mut out = Vec::with_capacity(dk_len);",
"    let mut block = 1u32;",
"    while out.len() < dk_len {",
"        let mut m = salt.to_vec();",
"        m.extend_from_slice(&block.to_be_bytes());",
"        let mut u = tw_hmac_once(&mac, &m);",
"        let mut t = u;",
"        for _ in 1..iterations {",
"            u = tw_hmac_once(&mac, &u);",
"            for j in 0..32 { t[j] ^= u[j]; }",
"        }",
"        let take = 32.min(dk_len - out.len());",
"        out.extend_from_slice(&t[..take]);",
"        block = block.wrapping_add(1);",
"    }",
"    out",
"}",
"",
"fn tw_sha256(data: Rc<Vec<u8>>) -> Rc<Vec<u8>> { Rc::new(tw_sha256_raw(&data).to_vec()) }",
"fn tw_hmac_sha256(key: Rc<Vec<u8>>, message: Rc<Vec<u8>>) -> Rc<Vec<u8>> {",
"    Rc::new(tw_hmac_once(&tw_hmac_new(&key), &message).to_vec())",
"}",
"",
"const TW_B64: &[u8; 64] = b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";",
"fn tw_b64_encode_raw(data: &[u8], pad: bool) -> String {",
"    let mut s = String::with_capacity((data.len() + 2) / 3 * 4);",
"    for c in data.chunks(3) {",
"        let n = (c[0] as u32) << 16 | (*c.get(1).unwrap_or(&0) as u32) << 8 | *c.get(2).unwrap_or(&0) as u32;",
"        let chars = c.len() + 1;",
"        for i in 0..4 {",
"            if i < chars { s.push(TW_B64[((n >> (18 - 6 * i)) & 63) as usize] as char); } else if pad { s.push('='); }",
"        }",
"    }",
"    s",
"}",
"fn tw_b64_value(c: u8) -> Option<u32> {",
"    match c {",
"        b'A'..=b'Z' => Some((c - b'A') as u32),",
"        b'a'..=b'z' => Some((c - b'a') as u32 + 26),",
"        b'0'..=b'9' => Some((c - b'0') as u32 + 52),",
"        b'+' | b'-' => Some(62),",
"        b'/' | b'_' => Some(63),",
"        _ => None,",
"    }",
"}",
"fn tw_b64_decode_raw(s: &[u8]) -> Option<Vec<u8>> {",
"    let mut end = s.len();",
"    let mut pads = 0;",
"    while end > 0 && s[end - 1] == b'=' { end -= 1; pads += 1; }",
"    let body = &s[..end];",
"    if body.len() % 4 == 1 || pads > 2 { return None; }",
"    if pads > 0 && (s.len() % 4 != 0 || (4 - body.len() % 4) % 4 != pads) { return None; }",
"    let mut out = Vec::with_capacity(body.len() / 4 * 3 + 2);",
"    for c in body.chunks(4) {",
"        let mut n = 0u32;",
"        for (i, &ch) in c.iter().enumerate() { n |= tw_b64_value(ch)? << (18 - 6 * i); }",
"        match c.len() {",
"            4 => { out.push((n >> 16) as u8); out.push((n >> 8) as u8); out.push(n as u8); }",
"            3 => { if n & 0xFF != 0 { return None; } out.push((n >> 16) as u8); out.push((n >> 8) as u8); }",
"            2 => { if n & 0xFFFF != 0 { return None; } out.push((n >> 16) as u8); }",
"            _ => return None,",
"        }",
"    }",
"    Some(out)",
"}",
"fn tw_base64_encode(data: Rc<Vec<u8>>) -> Rc<String> { Rc::new(tw_b64_encode_raw(&data, true)) }",
"fn tw_base64_decode(text: Rc<String>) -> Option<Rc<Vec<u8>>> { tw_b64_decode_raw(text.as_bytes()).map(Rc::new) }",
"",
"fn tw_hex_raw(data: &[u8]) -> String {",
"    const HEX: &[u8; 16] = b\"0123456789abcdef\";",
"    let mut s = String::with_capacity(data.len() * 2);",
"    for &b in data { s.push(HEX[(b >> 4) as usize] as char); s.push(HEX[(b & 15) as usize] as char); }",
"    s",
"}",
"fn tw_hex_encode(data: Rc<Vec<u8>>) -> Rc<String> { Rc::new(tw_hex_raw(&data)) }",
"fn tw_hex_decode(text: Rc<String>) -> Option<Rc<Vec<u8>>> {",
"    let b = text.as_bytes();",
"    if b.len() % 2 != 0 { return None; }",
"    let nib = |c: u8| -> Option<u8> {",
"        match c { b'0'..=b'9' => Some(c - b'0'), b'a'..=b'f' => Some(c - b'a' + 10), b'A'..=b'F' => Some(c - b'A' + 10), _ => None }",
"    };",
"    let mut out = Vec::with_capacity(b.len() / 2);",
"    for p in b.chunks(2) { out.push(nib(p[0])? << 4 | nib(p[1])?); }",
"    Some(Rc::new(out))",
"}",
"fn tw_ct_eq(a: &[u8], b: &[u8]) -> bool {",
"    if a.len() != b.len() { return false; } // the length is not treated as secret",
"    let mut acc = 0u8;",
"    for i in 0..a.len() { acc = std::hint::black_box(acc | (a[i] ^ b[i])); }",
"    acc == 0",
"}",
"fn tw_equal_constant_time(a: Rc<Vec<u8>>, b: Rc<Vec<u8>>) -> bool { tw_ct_eq(&a, &b) }",
"",
"const TW_PBKDF2_ITERATIONS: u32 = 600_000;",
"fn tw_password_hash(password: Rc<String>, loc: &str) -> Rc<String> {",
"    let salt = tw_random_bytes(16, loc);",
"    let key = tw_pbkdf2_sha256(password.as_bytes(), &salt, TW_PBKDF2_ITERATIONS, 32);",
"    Rc::new(format!(\"$pbkdf2-sha256$i={}${}${}\", TW_PBKDF2_ITERATIONS, tw_b64_encode_raw(&salt, false), tw_b64_encode_raw(&key, false)))",
"}",
"fn tw_password_verify(password: Rc<String>, hash: Rc<String>) -> bool {",
"    let parts: Vec<&str> = hash.split('$').collect();",
"    if parts.len() != 5 || !parts[0].is_empty() || parts[1] != \"pbkdf2-sha256\" { return false; }",
"    let digits = match parts[2].strip_prefix(\"i=\") { Some(d) => d, None => return false };",
"    if digits.is_empty() || digits.len() > 8 || !digits.bytes().all(|c| c.is_ascii_digit()) { return false; }",
"    let iterations: u32 = match digits.parse() { Ok(v) => v, Err(_) => return false };",
"    if !(1..=10_000_000).contains(&iterations) { return false; }",
"    let salt = match tw_b64_decode_raw(parts[3].as_bytes()) { Some(s) => s, None => return false };",
"    let key = match tw_b64_decode_raw(parts[4].as_bytes()) { Some(k) => k, None => return false };",
"    if salt.len() > 1024 || key.is_empty() || key.len() > 1024 { return false; }",
"    let computed = tw_pbkdf2_sha256(password.as_bytes(), &salt, iterations, key.len());",
"    tw_ct_eq(&computed, &key)",
"}",
"",
"// ===========================================================================",
"// 5. SQLite through the sqlite3 command-line program",
"// ===========================================================================",
"//",
"// One persistent `sqlite3 -batch <file>` child per open database (so",
"// transactions can span calls). Per call the runtime writes:",
"//   DELETE FROM temp.sqlite_parameters;",
"//   REPLACE INTO temp.sqlite_parameters(key,value) VALUES('?N',CAST(X'<hex>' AS TEXT));  (per parameter)",
"//   DELETE FROM temp.sqlite_parameters WHERE 0;      -- resets changes() to 0",
"//   <the statement, unchanged>",
"//   ;",
"//   SELECT changes() AS tessera_changes;              -- execute only",
"//   .print TESSERA_END_<random>                       -- stdout sync marker",
"//   .tessera_sync_<random>                            -- unknown command: stderr sync marker",
"// Parameter values are hex encoded, so they can never end a literal, start a",
"// new statement or a dot-command. The statement is checked to be exactly one",
"// complete statement (balanced quotes/comments, no second statement, does",
"// not start with '.' or '#', no \"GO\" or \"/\" terminator lines), so it cannot",
"// swallow the markers or run dot-commands either.",
"",
"struct TwDb {",
"    child: std::process::Child,",
"    stdin: Option<std::process::ChildStdin>,",
"    stdout: std::io::BufReader<std::process::ChildStdout>,",
"    errors: std::sync::mpsc::Receiver<String>,",
"    broken: bool,",
"}",
"impl Drop for TwDb {",
"    fn drop(&mut self) {",
"        self.stdin.take(); // EOF makes sqlite3 exit cleanly",
"        for _ in 0..100 {",
"            match self.child.try_wait() {",
"                Ok(Some(_)) => return,",
"                Ok(None) => std::thread::sleep(std::time::Duration::from_millis(10)),",
"                Err(_) => break,",
"            }",
"        }",
"        let _ = self.child.kill();",
"        let _ = self.child.wait();",
"    }",
"}",
"",
"#[derive(Clone)]",
"pub struct TDatabase(Rc<std::cell::RefCell<TwDb>>);",
"impl PartialEq for TDatabase {",
"    fn eq(&self, other: &TDatabase) -> bool { Rc::ptr_eq(&self.0, &other.0) }",
"}",
"impl Eq for TDatabase {}",
"impl std::fmt::Debug for TDatabase {",
"    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { write!(f, \"<database>\") }",
"}",
"",
"fn tw_db_open(path: Rc<String>, loc: &str) -> Result<TDatabase, Rc<String>> {",
"    if path.is_empty() { return Err(t_text(\"empty database path\")); }",
"    let target: std::ffi::OsString = if path.as_str() == \":memory:\" {",
"        std::ffi::OsString::from(\":memory:\")",
"    } else {",
"        let p = t_check_path(path.as_str(), loc).into_os_string();",
"        let lossy = p.to_string_lossy().to_string();",
"        // Never let the path be read as an option or a URI filename.",
"        if lossy.starts_with('-') || lossy.to_ascii_lowercase().starts_with(\"file:\") {",
"            let mut o = std::ffi::OsString::from(\"./\");",
"            o.push(&p);",
"            o",
"        } else { p }",
"    };",
"    let program = match std::env::var(\"TESSERA_SQLITE3\") { Ok(p) if !p.is_empty() => p, _ => \"sqlite3\".to_string() };",
"    let spawned = std::process::Command::new(&program)",
"        .arg(\"-batch\")",
"        .arg(&target)",
"        .stdin(std::process::Stdio::piped())",
"        .stdout(std::process::Stdio::piped())",
"        .stderr(std::process::Stdio::piped())",
"        .spawn();",
"    let mut child = match spawned {",
"        Ok(c) => c,",
"        Err(e) => return Err(Rc::new(format!(\"cannot start `{}`: {}\", program, e))),",
"    };",
"    let (stdin, stdout, stderr) = match (child.stdin.take(), child.stdout.take(), child.stderr.take()) {",
"        (Some(a), Some(b), Some(c)) => (a, b, c),",
"        _ => { let _ = child.kill(); let _ = child.wait(); return Err(t_text(\"cannot connect to sqlite3\")); }",
"    };",
"    let (tx, rx) = std::sync::mpsc::channel::<String>();",
"    let reader = std::thread::Builder::new().name(\"tessera-sqlite3-stderr\".to_string()).spawn(move || {",
"        let mut r = std::io::BufReader::new(stderr);",
"        let mut line = Vec::new();",
"        loop {",
"            line.clear();",
"            match r.read_until(b'\\n', &mut line) {",
"                Ok(0) | Err(_) => break,",
"                Ok(_) => {",
"                    let s = String::from_utf8_lossy(&line).trim_end_matches(&['\\r', '\\n'][..]).to_string();",
"                    if tx.send(s).is_err() { break; }",
"                }",
"            }",
"        }",
"    });",
"    if reader.is_err() { let _ = child.kill(); let _ = child.wait(); return Err(t_text(\"cannot start a thread for sqlite3\")); }",
"    let mut db = TwDb { child, stdin: Some(stdin), stdout: std::io::BufReader::new(stdout), errors: rx, broken: false };",
"    let setup = \".bail off\\n.echo off\\n.changes off\\n.timer off\\n.eqp off\\n.stats off\\n.output\\n.mode json\\n.timeout 5000\\n.parameter init\\n\";",
"    match tw_db_roundtrip(&mut db, setup) {",
"        Ok(_) => Ok(TDatabase(Rc::new(std::cell::RefCell::new(db)))),",
"        Err(e) => Err(Rc::new(e)),",
"    }",
"}",
"",
"fn tw_sqlite_error_text(lines: &[String]) -> String {",
"    let mut out = Vec::new();",
"    for (i, l) in lines.iter().enumerate() {",
"        let mut s = l.as_str();",
"        if i == 0 {",
"            for prefix in [\"Parse error near line \", \"Runtime error near line \", \"Error: near line \", \"Error: in prepare, \"] {",
"                if let Some(rest) = s.strip_prefix(prefix) {",
"                    s = match rest.find(\": \") { Some(p) if prefix.ends_with(\"line \") => &rest[p + 2..], _ => rest };",
"                    break;",
"                }",
"            }",
"            if let Some(rest) = s.strip_prefix(\"Error: \") { s = rest; }",
"        }",
"        out.push(s.trim_end().to_string());",
"    }",
"    let joined = out.join(\"\\n\");",
"    joined.trim().to_string()",
"}",
"",
"fn tw_db_roundtrip(db: &mut TwDb, script: &str) -> Result<Vec<String>, String> {",
"    if db.broken { return Err(\"the database connection is closed (sqlite3 is no longer running)\".to_string()); }",
"    let mut tag = [0u8; 16];",
"    tw_fill_random(&mut tag);",
"    let tag = tw_hex_raw(&tag);",
"    let marker = format!(\"TESSERA_END_{}\", tag);",
"    let sync = format!(\"tessera_sync_{}\", tag);",
"    let full = format!(\"{}.print {}\\n.{}\\n\", script, marker, sync);",
"    let written = match db.stdin.as_mut() {",
"        Some(w) => w.write_all(full.as_bytes()).and_then(|_| w.flush()).is_ok(),",
"        None => false,",
"    };",
"    if !written {",
"        db.broken = true;",
"        return Err(tw_db_dead_message(db));",
"    }",
"    let mut lines = Vec::new();",
"    loop {",
"        let mut buf = Vec::new();",
"        match db.stdout.read_until(b'\\n', &mut buf) {",
"            Ok(0) | Err(_) => { db.broken = true; return Err(tw_db_dead_message(db)); }",
"            Ok(_) => {}",
"        }",
"        let line = String::from_utf8_lossy(&buf).trim_end_matches(&['\\r', '\\n'][..]).to_string();",
"        if line == marker { break; }",
"        lines.push(line);",
"    }",
"    let mut errors = Vec::new();",
"    loop {",
"        match db.errors.recv_timeout(std::time::Duration::from_secs(30)) {",
"            Ok(l) => { if l.contains(&sync) { break; } errors.push(l); }",
"            Err(_) => { db.broken = true; return Err(\"sqlite3 stopped responding\".to_string()); }",
"        }",
"    }",
"    if !errors.is_empty() { return Err(tw_sqlite_error_text(&errors)); }",
"    Ok(lines)",
"}",
"fn tw_db_dead_message(db: &mut TwDb) -> String {",
"    let mut errors = Vec::new();",
"    while let Ok(l) = db.errors.recv_timeout(std::time::Duration::from_millis(500)) { errors.push(l); }",
"    if errors.is_empty() { \"sqlite3 exited unexpectedly\".to_string() } else { format!(\"sqlite3 exited: {}\", tw_sqlite_error_text(&errors)) }",
"}",
"",
"/// Validates that `sql` is exactly one complete statement and returns it (leading",
"/// whitespace/comments removed, trailing ';' removed).",
"fn tw_sql_prepare(sql: &str) -> Result<String, String> {",
"    let b = sql.as_bytes();",
"    let n = b.len();",
"    let mut i = 0;",
"    // Skips whitespace and comments starting at i; Err on an unterminated block comment.",
"    fn skip_space(b: &[u8], mut i: usize) -> Result<usize, String> {",
"        let n = b.len();",
"        loop {",
"            while i < n && b[i].is_ascii_whitespace() { i += 1; }",
"            if i + 1 < n && b[i] == b'-' && b[i + 1] == b'-' {",
"                while i < n && b[i] != b'\\n' { i += 1; }",
"            } else if i + 1 < n && b[i] == b'/' && b[i + 1] == b'*' {",
"                match sql_find(b, i + 2, b\"*/\") { Some(p) => i = p + 2, None => return Err(\"unterminated comment in SQL\".to_string()) }",
"            } else {",
"                return Ok(i);",
"            }",
"        }",
"    }",
"    fn sql_find(b: &[u8], from: usize, pat: &[u8]) -> Option<usize> {",
"        if from > b.len() { return None; }",
"        b[from..].windows(pat.len()).position(|w| w == pat).map(|p| p + from)",
"    }",
"    i = skip_space(b, i)?;",
"    let start = i;",
"    if start == n { return Err(\"empty SQL statement\".to_string()); }",
"    if b[start] == b'.' || b[start] == b'#' { return Err(\"an SQL statement cannot start with '.' or '#'\".to_string()); }",
"    let mut end = n;",
"    while i < n {",
"        match b[i] {",
"            q @ (b'\\'' | b'\"' | b'`') => {",
"                match b[i + 1..].iter().position(|&c| c == q) { Some(p) => i = i + 1 + p + 1, None => return Err(\"unterminated quoted text in SQL\".to_string()) }",
"            }",
"            b'[' => {",
"                match b[i + 1..].iter().position(|&c| c == b']') { Some(p) => i = i + 1 + p + 1, None => return Err(\"unterminated [identifier] in SQL\".to_string()) }",
"            }",
"            b'-' if i + 1 < n && b[i + 1] == b'-' => { while i < n && b[i] != b'\\n' { i += 1; } }",
"            b'/' if i + 1 < n && b[i + 1] == b'*' => {",
"                match sql_find(b, i + 2, b\"*/\") { Some(p) => i = p + 2, None => return Err(\"unterminated comment in SQL\".to_string()) }",
"            }",
"            b';' => {",
"                end = i;",
"                if skip_space(b, i + 1)? != n { return Err(\"only one SQL statement is allowed per call\".to_string()); }",
"                break;",
"            }",
"            _ => i += 1,",
"        }",
"    }",
"    let body = sql[start..end].trim_end().to_string();",
"    for line in body.lines() {",
"        let t = line.trim();",
"        if t.eq_ignore_ascii_case(\"go\") || t == \"/\" { return Err(\"an SQL statement cannot contain a line with only `GO` or `/`\".to_string()); }",
"    }",
"    Ok(body)",
"}",
"",
"fn tw_db_run(db: &TDatabase, sql: &str, params: &[Rc<String>], want_changes: bool) -> Result<Vec<TwJson>, String> {",
"    let body = tw_sql_prepare(sql)?;",
"    let mut script = String::from(\"DELETE FROM temp.sqlite_parameters;\\n\");",
"    for (i, p) in params.iter().enumerate() {",
"        script.push_str(&format!(\"REPLACE INTO temp.sqlite_parameters(key,value) VALUES('?{}',CAST(X'{}' AS TEXT));\\n\", i + 1, tw_hex_raw(p.as_bytes())));",
"    }",
"    script.push_str(\"DELETE FROM temp.sqlite_parameters WHERE 0;\\n\");",
"    script.push_str(&body);",
"    script.push_str(\"\\n;\\n\");",
"    if want_changes { script.push_str(\"SELECT changes() AS tessera_changes;\\n\"); }",
"    let mut inner = db.0.borrow_mut();",
"    let lines = tw_db_roundtrip(&mut inner, &script)?;",
"    tw_json_parse_all(&lines.join(\"\\n\")).ok_or_else(|| \"cannot parse the output of sqlite3\".to_string())",
"}",
"",
"fn tw_db_query(db: TDatabase, sql: Rc<String>, params: Rc<Vec<Rc<String>>>, loc: &str)",
"    -> Result<Rc<Vec<Rc<std::collections::BTreeMap<Rc<String>, Rc<String>>>>>, Rc<String>> {",
"    let values = tw_db_run(&db, &sql, &params, false).map_err(Rc::new)?;",
"    let mut rows = Vec::new();",
"    for v in values {",
"        if let TwJson::Arr(items) = v {",
"            for item in items {",
"                if let TwJson::Obj(fields) = item {",
"                    let mut row = std::collections::BTreeMap::new();",
"                    for (k, val) in fields {",
"                        let text = match val {",
"                            TwJson::Null => continue,",
"                            TwJson::Str(s) => s,",
"                            TwJson::Num(n) => tw_sql_number_text(&n),",
"                            TwJson::Bool(b) => b.to_string(),",
"                            TwJson::Arr(_) | TwJson::Obj(_) => continue,",
"                        };",
"                        row.insert(Rc::new(k), Rc::new(text));",
"                    }",
"                    rows.push(Rc::new(row));",
"                }",
"            }",
"        }",
"    }",
"    Ok(Rc::new(rows))",
"}",
"fn tw_db_execute(db: TDatabase, sql: Rc<String>, params: Rc<Vec<Rc<String>>>, loc: &str) -> Result<i64, Rc<String>> {",
"    let values = tw_db_run(&db, &sql, &params, true).map_err(Rc::new)?;",
"    if let Some(TwJson::Arr(items)) = values.last() {",
"        if let Some(TwJson::Obj(fields)) = items.first() {",
"            for (k, v) in fields {",
"                if k == \"tessera_changes\" {",
"                    if let TwJson::Num(n) = v { if let Ok(c) = n.parse::<i64>() { return Ok(c); } }",
"                }",
"            }",
"        }",
"    }",
"    Err(t_text(\"cannot read the number of changed rows from sqlite3\"))",
"}",
"fn tw_sql_number_text(raw: &str) -> String {",
"    let digits = raw.strip_prefix('-').unwrap_or(raw);",
"    if !digits.is_empty() && digits.bytes().all(|c| c.is_ascii_digit()) { return raw.to_string(); }",
"    match raw.parse::<f64>() {",
"        Ok(f) if f.is_finite() => format!(\"{:?}\", f), // shortest text that round-trips",
"        _ => raw.to_string(),",
"    }",
"}",
"",
"enum TwJson { Null, Bool(bool), Num(String), Str(String), Arr(Vec<TwJson>), Obj(Vec<(String, TwJson)>) }",
"",
"struct TwJsonParser<'a> { b: &'a [u8], i: usize, depth: usize }",
"impl<'a> TwJsonParser<'a> {",
"    fn ws(&mut self) { while self.i < self.b.len() && self.b[self.i].is_ascii_whitespace() { self.i += 1; } }",
"    fn value(&mut self) -> Option<TwJson> {",
"        self.ws();",
"        let c = *self.b.get(self.i)?;",
"        match c {",
"            b'[' => {",
"                self.depth += 1;",
"                if self.depth > 64 { return None; }",
"                self.i += 1;",
"                let mut items = Vec::new();",
"                self.ws();",
"                if self.b.get(self.i) == Some(&b']') { self.i += 1; self.depth -= 1; return Some(TwJson::Arr(items)); }",
"                loop {",
"                    items.push(self.value()?);",
"                    self.ws();",
"                    match self.b.get(self.i)? { b',' => self.i += 1, b']' => { self.i += 1; break; } _ => return None }",
"                }",
"                self.depth -= 1;",
"                Some(TwJson::Arr(items))",
"            }",
"            b'{' => {",
"                self.depth += 1;",
"                if self.depth > 64 { return None; }",
"                self.i += 1;",
"                let mut fields = Vec::new();",
"                self.ws();",
"                if self.b.get(self.i) == Some(&b'}') { self.i += 1; self.depth -= 1; return Some(TwJson::Obj(fields)); }",
"                loop {",
"                    self.ws();",
"                    let k = match self.value()? { TwJson::Str(s) => s, _ => return None };",
"                    self.ws();",
"                    if self.b.get(self.i)? != &b':' { return None; }",
"                    self.i += 1;",
"                    let v = self.value()?;",
"                    fields.push((k, v));",
"                    self.ws();",
"                    match self.b.get(self.i)? { b',' => self.i += 1, b'}' => { self.i += 1; break; } _ => return None }",
"                }",
"                self.depth -= 1;",
"                Some(TwJson::Obj(fields))",
"            }",
"            b'\"' => {",
"                self.i += 1;",
"                let mut out: Vec<u8> = Vec::new();",
"                loop {",
"                    let c = *self.b.get(self.i)?;",
"                    self.i += 1;",
"                    match c {",
"                        b'\"' => break,",
"                        b'\\\\' => {",
"                            let e = *self.b.get(self.i)?;",
"                            self.i += 1;",
"                            match e {",
"                                b'\"' => out.push(b'\"'), b'\\\\' => out.push(b'\\\\'), b'/' => out.push(b'/'),",
"                                b'b' => out.push(8), b'f' => out.push(12), b'n' => out.push(b'\\n'), b'r' => out.push(b'\\r'), b't' => out.push(b'\\t'),",
"                                b'u' => {",
"                                    let mut cp = self.hex4()?;",
"                                    if (0xD800..0xDC00).contains(&cp) && self.b.get(self.i) == Some(&b'\\\\') && self.b.get(self.i + 1) == Some(&b'u') {",
"                                        let save = self.i;",
"                                        self.i += 2;",
"                                        let lo = self.hex4()?;",
"                                        if (0xDC00..0xE000).contains(&lo) { cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00); } else { self.i = save; }",
"                                    }",
"                                    let ch = char::from_u32(cp).unwrap_or('\\u{FFFD}');",
"                                    let mut tmp = [0u8; 4];",
"                                    out.extend_from_slice(ch.encode_utf8(&mut tmp).as_bytes());",
"                                }",
"                                _ => return None,",
"                            }",
"                        }",
"                        _ => out.push(c),",
"                    }",
"                }",
"                Some(TwJson::Str(String::from_utf8_lossy(&out).to_string()))",
"            }",
"            _ => {",
"                let s = self.i;",
"                while self.i < self.b.len() && (self.b[self.i].is_ascii_alphanumeric() || b\"+-.\".contains(&self.b[self.i])) { self.i += 1; }",
"                if s == self.i { return None; }",
"                let tok = String::from_utf8_lossy(&self.b[s..self.i]).to_string();",
"                Some(match tok.as_str() { \"null\" => TwJson::Null, \"true\" => TwJson::Bool(true), \"false\" => TwJson::Bool(false), _ => TwJson::Num(tok) })",
"            }",
"        }",
"    }",
"    fn hex4(&mut self) -> Option<u32> {",
"        let h = self.b.get(self.i..self.i + 4)?;",
"        let s = std::str::from_utf8(h).ok()?;",
"        let v = u32::from_str_radix(s, 16).ok()?;",
"        self.i += 4;",
"        Some(v)",
"    }",
"}",
"fn tw_json_parse_all(text: &str) -> Option<Vec<TwJson>> {",
"    let mut p = TwJsonParser { b: text.as_bytes(), i: 0, depth: 0 };",
"    let mut out = Vec::new();",
"    loop {",
"        p.ws();",
"        if p.i >= p.b.len() { return Some(out); }",
"        out.push(p.value()?);",
"    }",
"}",
"",
"// ===========================================================================",
"// Shared HTTP helpers",
"// ===========================================================================",
"",
"fn tw_reason(status: u16) -> &'static str {",
"    match status {",
"        100 => \"Continue\", 101 => \"Switching Protocols\",",
"        200 => \"OK\", 201 => \"Created\", 202 => \"Accepted\", 203 => \"Non-Authoritative Information\", 204 => \"No Content\",",
"        205 => \"Reset Content\", 206 => \"Partial Content\",",
"        300 => \"Multiple Choices\", 301 => \"Moved Permanently\", 302 => \"Found\", 303 => \"See Other\", 304 => \"Not Modified\",",
"        307 => \"Temporary Redirect\", 308 => \"Permanent Redirect\",",
"        400 => \"Bad Request\", 401 => \"Unauthorized\", 402 => \"Payment Required\", 403 => \"Forbidden\", 404 => \"Not Found\",",
"        405 => \"Method Not Allowed\", 406 => \"Not Acceptable\", 407 => \"Proxy Authentication Required\", 408 => \"Request Timeout\",",
"        409 => \"Conflict\", 410 => \"Gone\", 411 => \"Length Required\", 412 => \"Precondition Failed\", 413 => \"Content Too Large\",",
"        414 => \"URI Too Long\", 415 => \"Unsupported Media Type\", 416 => \"Range Not Satisfiable\", 417 => \"Expectation Failed\",",
"        421 => \"Misdirected Request\", 422 => \"Unprocessable Content\", 425 => \"Too Early\", 426 => \"Upgrade Required\",",
"        428 => \"Precondition Required\", 429 => \"Too Many Requests\", 431 => \"Request Header Fields Too Large\",",
"        451 => \"Unavailable For Legal Reasons\",",
"        500 => \"Internal Server Error\", 501 => \"Not Implemented\", 502 => \"Bad Gateway\", 503 => \"Service Unavailable\",",
"        504 => \"Gateway Timeout\", 505 => \"HTTP Version Not Supported\",",
"        _ => \"Unknown\",",
"    }",
"}",
"",
"fn tw_is_token(s: &str) -> bool {",
"    !s.is_empty() && s.bytes().all(|c| c.is_ascii_alphanumeric() || b\"!#$%&'*+-.^_`|~\".contains(&c))",
"}",
"",
"/// Buffered reader with line-length limits, used by the HTTP client and server.",
"struct TwReader<R: std::io::Read> { inner: R, buf: Vec<u8>, start: usize }",
"#[derive(Debug, PartialEq)]",
"enum TwRd { Eof, TooLong, Io }",
"impl<R: std::io::Read> TwReader<R> {",
"    fn new(inner: R) -> TwReader<R> { TwReader { inner, buf: Vec::new(), start: 0 } }",
"    fn avail(&self) -> &[u8] { &self.buf[self.start..] }",
"    fn fill(&mut self) -> Result<usize, TwRd> {",
"        if self.start > 0 { self.buf.drain(..self.start); self.start = 0; }",
"        let mut tmp = [0u8; 16384];",
"        loop {",
"            match self.inner.read(&mut tmp) {",
"                Ok(n) => { self.buf.extend_from_slice(&tmp[..n]); return Ok(n); }",
"                Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,",
"                Err(_) => return Err(TwRd::Io),",
"            }",
"        }",
"    }",
"    /// One line without its LF (and CR); `max` limits the content length.",
"    fn read_line(&mut self, max: usize) -> Result<Vec<u8>, TwRd> {",
"        let mut scanned = 0;",
"        loop {",
"            let avail = &self.buf[self.start..];",
"            if let Some(p) = avail[scanned..].iter().position(|&c| c == b'\\n') {",
"                let p = scanned + p;",
"                let content = if p > 0 && avail[p - 1] == b'\\r' { p - 1 } else { p };",
"                if content > max { return Err(TwRd::TooLong); }",
"                let line = avail[..content].to_vec();",
"                self.start += p + 1;",
"                return Ok(line);",
"            }",
"            scanned = avail.len();",
"            if avail.len() > max + 1 { return Err(TwRd::TooLong); }",
"            if self.fill()? == 0 { return Err(TwRd::Eof); }",
"        }",
"    }",
"    fn read_exact_vec(&mut self, n: usize) -> Result<Vec<u8>, TwRd> {",
"        while self.avail().len() < n {",
"            if self.fill()? == 0 { return Err(TwRd::Eof); }",
"        }",
"        let v = self.buf[self.start..self.start + n].to_vec();",
"        self.start += n;",
"        Ok(v)",
"    }",
"    fn read_to_end_limit(&mut self, limit: usize) -> Result<Vec<u8>, TwRd> {",
"        loop {",
"            if self.avail().len() > limit { return Err(TwRd::TooLong); }",
"            if self.fill()? == 0 { break; }",
"        }",
"        let v = self.avail().to_vec();",
"        self.start = self.buf.len();",
"        Ok(v)",
"    }",
"}",
"",
"#[derive(Debug, PartialEq)]",
"enum TwBodyErr { TooLarge, Bad, Closed }",
"fn tw_read_chunked<R: std::io::Read>(r: &mut TwReader<R>, limit: usize) -> Result<Vec<u8>, TwBodyErr> {",
"    let map = |e: TwRd| match e { TwRd::TooLong => TwBodyErr::Bad, _ => TwBodyErr::Closed };",
"    let mut out = Vec::new();",
"    loop {",
"        let line = r.read_line(4096).map_err(map)?;",
"        let line = String::from_utf8_lossy(&line).to_string();",
"        let size_text = line.split(';').next().unwrap_or(\"\").trim();",
"        if size_text.is_empty() || size_text.len() > 15 || !size_text.bytes().all(|c| c.is_ascii_hexdigit()) { return Err(TwBodyErr::Bad); }",
"        let size = usize::from_str_radix(size_text, 16).map_err(|_| TwBodyErr::Bad)?;",
"        if size == 0 {",
"            // trailers: ignored, but bounded",
"            for _ in 0..101 {",
"                let t = r.read_line(8192).map_err(map)?;",
"                if t.is_empty() { return Ok(out); }",
"            }",
"            return Err(TwBodyErr::Bad);",
"        }",
"        if out.len() + size > limit { return Err(TwBodyErr::TooLarge); }",
"        let data = r.read_exact_vec(size).map_err(map)?;",
"        out.extend_from_slice(&data);",
"        let end = r.read_line(0).map_err(map)?;",
"        if !end.is_empty() { return Err(TwBodyErr::Bad); }",
"    }",
"}",
"",
"// ===========================================================================",
"// 6. HTTP client (http:// and https://)",
"// ===========================================================================",
"",
"const TW_CLIENT_MAX_RESPONSE: usize = 256 * 1024 * 1024;",
"",
"/// A plain TCP stream or a TLS connection, for the HTTP client.",
"trait TwConn: std::io::Read + std::io::Write {}",
"impl<T: std::io::Read + std::io::Write> TwConn for T {}",
"",
"fn tw_net_request(method: Rc<String>, url: Rc<String>, header_lines: Rc<Vec<Rc<String>>>, body: Rc<Vec<u8>>, loc: &str) -> Result<Rc<Vec<u8>>, Rc<String>> {",
"    tw_http_client(&method, &url, &header_lines, &body).map(Rc::new).map_err(Rc::new)",
"}",
"",
"fn tw_http_client(method: &str, url: &str, header_lines: &[Rc<String>], body: &[u8]) -> Result<Vec<u8>, String> {",
"    if !tw_is_token(method) { return Err(format!(\"invalid HTTP method `{}`\", method)); }",
"    let lower = url.to_ascii_lowercase();",
"    let secure = lower.starts_with(\"https://\");",
"    if !secure && !lower.starts_with(\"http://\") { return Err(format!(\"unsupported URL `{}`: only http:// and https:// URLs are supported\", url)); }",
"    let rest = if secure { &url[8..] } else { &url[7..] };",
"    let auth_end = rest.find(|c| c == '/' || c == '?' || c == '#').unwrap_or(rest.len());",
"    let authority = &rest[..auth_end];",
"    let mut target = &rest[auth_end..];",
"    if let Some(p) = target.find('#') { target = &target[..p]; }",
"    let target = if target.starts_with('/') { target.to_string() } else { format!(\"/{}\", target) };",
"    if target.bytes().any(|c| c <= 0x20 || c == 0x7f) { return Err(format!(\"invalid character in URL `{}`\", url)); }",
"    if authority.contains('@') { return Err(\"user names or passwords in URLs are not supported\".to_string()); }",
"    let (host, port_text) = if let Some(after) = authority.strip_prefix('[') {",
"        match after.find(']') {",
"            Some(p) => {",
"                let tail = &after[p + 1..];",
"                let port = if tail.is_empty() { None } else if let Some(pt) = tail.strip_prefix(':') { Some(pt) } else { return Err(format!(\"invalid URL `{}`\", url)) };",
"                (&after[..p], port)",
"            }",
"            None => return Err(format!(\"invalid URL `{}`\", url)),",
"        }",
"    } else {",
"        match authority.rfind(':') { Some(p) => (&authority[..p], Some(&authority[p + 1..])), None => (authority, None) }",
"    };",
"    if host.is_empty() || host.bytes().any(|c| c <= 0x20 || c == 0x7f || c == b'/' ) { return Err(format!(\"invalid host in URL `{}`\", url)); }",
"    let port: u16 = match port_text {",
"        None => if secure { 443 } else { 80 },",
"        Some(p) => match p.parse::<u16>() { Ok(v) if !p.starts_with('+') && v > 0 => v, _ => return Err(format!(\"invalid port in URL `{}`\", url)) },",
"    };",
"    let host_lower = host.to_ascii_lowercase();",
"    let host_shown = if host_lower.contains(':') { format!(\"[{}]\", host_lower) } else { host_lower.clone() };",
"    let host_port = format!(\"{}:{}\", host_shown, port);",
"    if let Ok(allow) = std::env::var(\"TESSERA_NET_ALLOW\") {",
"        let ok = allow.split(',').map(|e| e.trim().to_ascii_lowercase()).any(|e| !e.is_empty() && (e == host_lower || e == host_shown || e == host_port));",
"        if !ok { return Err(format!(\"network access to {} is not allowed\", host_port)); }",
"    }",
"    let mut user_headers = String::new();",
"    let mut has_host = false;",
"    for line in header_lines {",
"        if line.contains('\\r') || line.contains('\\n') || line.contains('\\0') { return Err(format!(\"invalid header line `{}`\", line.escape_debug())); }",
"        let (name, value) = match line.find(':') { Some(p) => (line[..p].trim(), line[p + 1..].trim()), None => return Err(format!(\"invalid header line `{}`\", line)) };",
"        if !tw_is_token(name) { return Err(format!(\"invalid header name `{}`\", name)); }",
"        let ln = name.to_ascii_lowercase();",
"        if ln == \"connection\" || ln == \"content-length\" || ln == \"transfer-encoding\" { continue; } // managed by the runtime",
"        if ln == \"host\" { has_host = true; }",
"        user_headers.push_str(&format!(\"{}: {}\\r\\n\", name, value));",
"    }",
"    let mut request = format!(\"{} {} HTTP/1.1\\r\\n\", method, target);",
"    if !has_host { request.push_str(&format!(\"Host: {}\\r\\n\", authority)); }",
"    request.push_str(\"Connection: close\\r\\n\");",
"    let upper = method.to_ascii_uppercase();",
"    if !body.is_empty() || upper == \"POST\" || upper == \"PUT\" || upper == \"PATCH\" { request.push_str(&format!(\"Content-Length: {}\\r\\n\", body.len())); }",
"    request.push_str(&user_headers);",
"    request.push_str(\"\\r\\n\");",
"    let mut out_bytes = request.into_bytes();",
"    out_bytes.extend_from_slice(body);",
"",
"    let addrs: Vec<std::net::SocketAddr> = match std::net::ToSocketAddrs::to_socket_addrs(&(host, port)) {",
"        Ok(a) => a.collect(),",
"        Err(e) => return Err(format!(\"cannot resolve {}: {}\", host_port, e)),",
"    };",
"    let timeout = std::time::Duration::from_secs(30);",
"    let mut last_err = format!(\"cannot resolve {}\", host_port);",
"    let mut stream = None;",
"    for a in addrs {",
"        match std::net::TcpStream::connect_timeout(&a, timeout) {",
"            Ok(s) => { stream = Some(s); break; }",
"            Err(e) => last_err = format!(\"cannot connect to {}: {}\", host_port, e),",
"        }",
"    }",
"    let stream = match stream { Some(s) => s, None => return Err(last_err) };",
"    let _ = stream.set_read_timeout(Some(timeout));",
"    let _ = stream.set_write_timeout(Some(timeout));",
"    let mut conn: Box<dyn TwConn> = if secure {",
"        match tw_tls_connect(stream, &host_lower) {",
"            Ok(tls) => Box::new(TwTlsStream::new(tls)),",
"            Err(e) => return Err(format!(\"TLS handshake with {} failed: {}\", host_port, e)),",
"        }",
"    } else {",
"        Box::new(stream)",
"    };",
"    if let Err(e) = conn.write_all(&out_bytes).and_then(|_| conn.flush()) { return Err(format!(\"cannot send the request to {}: {}\", host_port, e)); }",
"    let mut r = TwReader::new(conn);",
"    let rd_err = |e: TwRd| match e {",
"        TwRd::Eof => \"the connection was closed before the response was complete\".to_string(),",
"        TwRd::Io => \"error while reading the response (timeout or connection reset)\".to_string(),",
"        TwRd::TooLong => \"the response is too large\".to_string(),",
"    };",
"    let (status, reason, headers) = loop {",
"        let line = r.read_line(65536).map_err(rd_err)?;",
"        let line = String::from_utf8_lossy(&line).to_string();",
"        let mut parts = line.splitn(3, ' ');",
"        let version = parts.next().unwrap_or(\"\");",
"        let code = parts.next().unwrap_or(\"\");",
"        let reason = parts.next().unwrap_or(\"\").to_string();",
"        if !version.starts_with(\"HTTP/1.\") || code.len() != 3 { return Err(format!(\"invalid response status line `{}`\", line)); }",
"        let status: u16 = code.parse().map_err(|_| format!(\"invalid response status line `{}`\", line))?;",
"        let mut headers: Vec<(String, String)> = Vec::new();",
"        let mut total = 0;",
"        loop {",
"            let h = r.read_line(65536).map_err(rd_err)?;",
"            if h.is_empty() { break; }",
"            total += h.len();",
"            if total > 1024 * 1024 || headers.len() > 1000 { return Err(\"the response headers are too large\".to_string()); }",
"            let h = String::from_utf8_lossy(&h).to_string();",
"            match h.find(':') {",
"                Some(p) => headers.push((h[..p].trim().to_string(), h[p + 1..].trim().to_string())),",
"                None => return Err(format!(\"invalid response header `{}`\", h)),",
"            }",
"        }",
"        if (100..200).contains(&status) && status != 101 { continue; }",
"        break (status, reason, headers);",
"    };",
"    let header = |name: &str| -> Vec<&str> { headers.iter().filter(|(n, _)| n.eq_ignore_ascii_case(name)).map(|(_, v)| v.as_str()).collect() };",
"    let chunked = header(\"transfer-encoding\").iter().any(|v| v.to_ascii_lowercase().contains(\"chunked\"));",
"    let no_body = upper == \"HEAD\" || status == 204 || status == 304 || status < 200;",
"    let resp_body = if no_body {",
"        Vec::new()",
"    } else if chunked {",
"        match tw_read_chunked(&mut r, TW_CLIENT_MAX_RESPONSE) {",
"            Ok(b) => b,",
"            Err(TwBodyErr::TooLarge) => return Err(\"the response is too large\".to_string()),",
"            Err(TwBodyErr::Bad) => return Err(\"invalid chunked response body\".to_string()),",
"            Err(TwBodyErr::Closed) => return Err(\"the connection was closed before the response was complete\".to_string()),",
"        }",
"    } else if let Some(cl) = header(\"content-length\").first() {",
"        let n: usize = cl.parse().map_err(|_| format!(\"invalid Content-Length `{}`\", cl))?;",
"        if n > TW_CLIENT_MAX_RESPONSE { return Err(\"the response is too large\".to_string()); }",
"        r.read_exact_vec(n).map_err(rd_err)?",
"    } else {",
"        r.read_to_end_limit(TW_CLIENT_MAX_RESPONSE).map_err(rd_err)?",
"    };",
"    let mut out = format!(\"HTTP/1.1 {} {}\\r\\n\", status, reason).into_bytes();",
"    for (n, v) in &headers {",
"        if n.eq_ignore_ascii_case(\"transfer-encoding\") { continue; }",
"        out.extend_from_slice(format!(\"{}: {}\\r\\n\", n, v).as_bytes());",
"    }",
"    out.extend_from_slice(b\"\\r\\n\");",
"    out.extend_from_slice(&resp_body);",
"    Ok(out)",
"}",
"",
"// ===========================================================================",
"// 7. Web hosts",
"// ===========================================================================",
"",
"#[derive(Clone, Debug, PartialEq)]",
"pub struct RawRequest {",
"    pub method: String,",
"    pub path: String,",
"    pub query: String,",
"    pub remote_addr: String,",
"    pub headers: Vec<(String, String)>,",
"    pub body: Vec<u8>,",
"}",
"#[derive(Clone, Debug, PartialEq)]",
"pub struct RawResponse {",
"    pub status: u16,",
"    pub headers: Vec<(String, String)>,",
"    pub body: Vec<u8>,",
"}",
"",
"// ---- binary wire format (little-endian u32 lengths) -----------------------",
"",
"fn tw_put_u32(out: &mut Vec<u8>, v: u32) { out.extend_from_slice(&v.to_le_bytes()); }",
"fn tw_put_bytes(out: &mut Vec<u8>, b: &[u8]) { tw_put_u32(out, b.len() as u32); out.extend_from_slice(b); }",
"struct TwWire<'a> { b: &'a [u8], i: usize }",
"impl<'a> TwWire<'a> {",
"    fn remaining(&self) -> usize { self.b.len() - self.i }",
"    fn u32(&mut self) -> Option<u32> {",
"        if self.remaining() < 4 { return None; }",
"        let v = u32::from_le_bytes([self.b[self.i], self.b[self.i + 1], self.b[self.i + 2], self.b[self.i + 3]]);",
"        self.i += 4;",
"        Some(v)",
"    }",
"    fn bytes(&mut self) -> Option<&'a [u8]> {",
"        let n = self.u32()? as usize;",
"        if n > self.remaining() { return None; }",
"        let s = &self.b[self.i..self.i + n];",
"        self.i += n;",
"        Some(s)",
"    }",
"    fn text(&mut self) -> Option<String> { self.bytes().map(|b| String::from_utf8_lossy(b).to_string()) }",
"    fn headers(&mut self) -> Option<Vec<(String, String)>> {",
"        let count = self.u32()? as usize;",
"        if count > self.remaining() / 8 { return None; }",
"        let mut h = Vec::with_capacity(count);",
"        for _ in 0..count { let n = self.text()?; let v = self.text()?; h.push((n, v)); }",
"        Some(h)",
"    }",
"}",
"pub fn tw_encode_request(r: &RawRequest) -> Vec<u8> {",
"    let mut out = Vec::new();",
"    tw_put_u32(&mut out, 1);",
"    tw_put_bytes(&mut out, r.method.as_bytes());",
"    tw_put_bytes(&mut out, r.path.as_bytes());",
"    tw_put_bytes(&mut out, r.query.as_bytes());",
"    tw_put_bytes(&mut out, r.remote_addr.as_bytes());",
"    tw_put_u32(&mut out, r.headers.len() as u32);",
"    for (n, v) in &r.headers { tw_put_bytes(&mut out, n.as_bytes()); tw_put_bytes(&mut out, v.as_bytes()); }",
"    tw_put_bytes(&mut out, &r.body);",
"    out",
"}",
"pub fn tw_decode_request(b: &[u8]) -> Option<RawRequest> {",
"    let mut w = TwWire { b, i: 0 };",
"    if w.u32()? != 1 { return None; }",
"    let method = w.text()?;",
"    let path = w.text()?;",
"    let query = w.text()?;",
"    let remote_addr = w.text()?;",
"    let headers = w.headers()?;",
"    let body = w.bytes()?.to_vec();",
"    if w.remaining() != 0 { return None; }",
"    Some(RawRequest { method, path, query, remote_addr, headers, body })",
"}",
"pub fn tw_encode_response(r: &RawResponse) -> Vec<u8> {",
"    let mut out = Vec::new();",
"    tw_put_u32(&mut out, 1);",
"    tw_put_u32(&mut out, r.status as u32);",
"    tw_put_u32(&mut out, r.headers.len() as u32);",
"    for (n, v) in &r.headers { tw_put_bytes(&mut out, n.as_bytes()); tw_put_bytes(&mut out, v.as_bytes()); }",
"    tw_put_bytes(&mut out, &r.body);",
"    out",
"}",
"pub fn tw_decode_response(b: &[u8]) -> Option<RawResponse> {",
"    let mut w = TwWire { b, i: 0 };",
"    if w.u32()? != 1 { return None; }",
"    let status = u16::try_from(w.u32()?).ok()?;",
"    let headers = w.headers()?;",
"    let body = w.bytes()?.to_vec();",
"    if w.remaining() != 0 { return None; }",
"    Some(RawResponse { status, headers, body })",
"}",
"",
"// ---- running one request ----------------------------------------------------",
"",
"fn tw_env_u64(name: &str, default: u64) -> u64 {",
"    match std::env::var(name) { Ok(v) => v.trim().parse::<u64>().unwrap_or(default), Err(_) => default }",
"}",
"fn tw_max_body() -> usize {",
"    (tw_env_u64(\"TESSERA_MAX_BODY_MB\", 10) as usize).saturating_mul(1024 * 1024)",
"}",
"fn tw_text_response(status: u16, text: &str) -> RawResponse {",
"    RawResponse { status, headers: vec![(\"content-type\".to_string(), \"text/plain; charset=utf-8\".to_string())], body: text.as_bytes().to_vec() }",
"}",
"fn tw_status_response(status: u16) -> RawResponse { tw_text_response(status, &format!(\"{}\\n\", tw_reason(status))) }",
"fn tw_log(message: &str) {",
"    let err = std::io::stderr();",
"    let mut lock = err.lock();",
"    let _ = lock.write_all(message.as_bytes());",
"    let _ = lock.flush();",
"}",
"",
"static TW_PANIC_HOOK: std::sync::Once = std::sync::Once::new();",
"",
"pub fn tw_run_request(app: fn(RawRequest) -> RawResponse, req: RawRequest) -> RawResponse {",
"    TW_PANIC_HOOK.call_once(|| t_install_panic_hook());",
"    let stack_mb = match tw_env_u64(\"TESSERA_STACK_MB\", 64) { 0 => 64, v => v };",
"    let stack_bytes = (stack_mb as usize).saturating_mul(1024 * 1024);",
"    let time_ms = tw_env_u64(\"TESSERA_TIME_LIMIT_MS\", 30_000);",
"    let memory_bytes = tw_env_u64(\"TESSERA_MEMORY_LIMIT_MB\", 512).saturating_mul(1024 * 1024);",
"    let spawned = std::thread::Builder::new()",
"        .name(\"tessera-request\".to_string())",
"        .stack_size(stack_bytes)",
"        .spawn(move || {",
"            t_limits_begin(stack_bytes, time_ms, memory_bytes);",
"            std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| app(req)))",
"        });",
"    let handle = match spawned {",
"        Ok(h) => h,",
"        Err(e) => {",
"            tw_log(&format!(\"runtime error R000: cannot start a thread for the request: {}\\n\", e));",
"            return tw_status_response(503);",
"        }",
"    };",
"    let payload = match handle.join() {",
"        Ok(Ok(resp)) => return resp,",
"        Ok(Err(p)) => p,",
"        Err(p) => p,",
"    };",
"    if let Some(f) = payload.downcast_ref::<TFailure>() {",
"        tw_log(&format!(\"runtime error {}: {}\\n  at {}\\n\", f.code, f.message, f.location));",
"    } else if payload.downcast_ref::<TExit>().is_some() {",
"        tw_log(\"runtime error R017: exit called while handling a request\\n\");",
"    } else if let Some(s) = payload.downcast_ref::<&str>() {",
"        tw_log(&format!(\"runtime error R000: panic while handling a request: {}\\n\", s));",
"    } else if let Some(s) = payload.downcast_ref::<String>() {",
"        tw_log(&format!(\"runtime error R000: panic while handling a request: {}\\n\", s));",
"    } else {",
"        tw_log(\"runtime error R000: panic while handling a request\\n\");",
"    }",
"    tw_text_response(500, \"Internal Server Error\\n\")",
"}",
"",
"pub fn tw_library_handle(app: fn(RawRequest) -> RawResponse, input: &[u8]) -> Vec<u8> {",
"    match tw_decode_request(input) {",
"        Some(req) => tw_encode_response(&tw_run_request(app, req)),",
"        None => tw_encode_response(&tw_text_response(400, \"Bad Request\\n\")),",
"    }",
"}",
"",
"/// Whether an application-provided response header may be sent.",
"fn tw_header_allowed(name: &str, value: &str, cgi: bool) -> bool {",
"    if !tw_is_token(name) || value.bytes().any(|c| c == b'\\r' || c == b'\\n' || c == 0) { return false; }",
"    let n = name.to_ascii_lowercase();",
"    !(n == \"content-length\" || n == \"transfer-encoding\" || n == \"connection\" || (cgi && n == \"status\"))",
"}",
"fn tw_valid_status(status: u16) -> u16 { if (200..=599).contains(&status) { status } else { 500 } }",
"",
"// ---- CGI -----------------------------------------------------------------------",
"",
"/// Builds a request from CGI-style variables (also used for FastCGI PARAMS).",
"/// Without CONTENT_LENGTH the body is empty, unless `read_all_without_length`.",
"/// Err(status) for a malformed (400) or too large (413) request.",
"pub fn tw_cgi_request(vars: &[(String, String)], body: &mut dyn std::io::Read, max_body: usize, read_all_without_length: bool) -> Result<RawRequest, u16> {",
"    let get = |name: &str| -> Option<&str> { vars.iter().find(|(n, _)| n == name).map(|(_, v)| v.as_str()).filter(|v| !v.is_empty()) };",
"    let method = get(\"REQUEST_METHOD\").unwrap_or(\"GET\").to_string();",
"    if !tw_is_token(&method) { return Err(400); }",
"    let path = match get(\"REQUEST_URI\").map(|u| u.split('?').next().unwrap_or(\"\")).filter(|p| !p.is_empty()) {",
"        Some(p) => p.to_string(),",
"        None => get(\"PATH_INFO\").unwrap_or(\"/\").to_string(),",
"    };",
"    let query = get(\"QUERY_STRING\").unwrap_or(\"\").to_string();",
"    let remote_addr = get(\"REMOTE_ADDR\").unwrap_or(\"\").to_string();",
"    let mut headers = Vec::new();",
"    for (n, v) in vars {",
"        if let Some(rest) = n.strip_prefix(\"HTTP_\") {",
"            if rest.is_empty() { continue; }",
"            headers.push((rest.to_ascii_lowercase().replace('_', \"-\"), v.clone()));",
"        } else if n == \"CONTENT_TYPE\" && !v.is_empty() {",
"            headers.push((\"content-type\".to_string(), v.clone()));",
"        } else if n == \"CONTENT_LENGTH\" && !v.is_empty() {",
"            headers.push((\"content-length\".to_string(), v.clone()));",
"        }",
"    }",
"    let mut data = Vec::new();",
"    match get(\"CONTENT_LENGTH\") {",
"        Some(cl) => {",
"            let cl = cl.trim();",
"            if cl.is_empty() || cl.len() > 19 || !cl.bytes().all(|c| c.is_ascii_digit()) { return Err(400); }",
"            let n: u64 = cl.parse().map_err(|_| 400u16)?;",
"            if n > max_body as u64 { return Err(413); }",
"            if body.take(n).read_to_end(&mut data).is_err() || data.len() as u64 != n { return Err(400); }",
"        }",
"        None => {",
"            if read_all_without_length {",
"                if body.take(max_body as u64 + 1).read_to_end(&mut data).is_err() { return Err(400); }",
"                if data.len() > max_body { return Err(413); }",
"            }",
"        }",
"    }",
"    Ok(RawRequest { method, path, query, remote_addr, headers, body: data })",
"}",
"",
"/// A response in CGI format: `Status:` line, headers, blank line, body.",
"pub fn tw_cgi_response_bytes(resp: &RawResponse, head: bool) -> Vec<u8> {",
"    let status = tw_valid_status(resp.status);",
"    let mut out = format!(\"Status: {} {}\\r\\n\", status, tw_reason(status));",
"    for (n, v) in &resp.headers {",
"        if tw_header_allowed(n, v, true) { out.push_str(&format!(\"{}: {}\\r\\n\", n, v)); }",
"    }",
"    if status != 204 && status != 304 { out.push_str(&format!(\"Content-Length: {}\\r\\n\", resp.body.len())); }",
"    out.push_str(\"\\r\\n\");",
"    let mut bytes = out.into_bytes();",
"    if !head && status != 204 && status != 304 { bytes.extend_from_slice(&resp.body); }",
"    bytes",
"}",
"",
"fn tw_cgi_main(app: fn(RawRequest) -> RawResponse) {",
"    let vars: Vec<(String, String)> = std::env::vars_os()",
"        .map(|(k, v)| (k.to_string_lossy().to_string(), v.to_string_lossy().to_string()))",
"        .collect();",
"    let stdin = std::io::stdin();",
"    let mut lock = stdin.lock();",
"    let bytes = match tw_cgi_request(&vars, &mut lock, tw_max_body(), false) {",
"        Ok(req) => {",
"            let head = req.method == \"HEAD\";",
"            tw_cgi_response_bytes(&tw_run_request(app, req), head)",
"        }",
"        Err(code) => tw_cgi_response_bytes(&tw_status_response(code), false),",
"    };",
"    let out = std::io::stdout();",
"    let mut o = out.lock();",
"    let _ = o.write_all(&bytes);",
"    let _ = o.flush();",
"}",
"",
"// ---- HTTP/1.1 server ----------------------------------------------------------",
"",
"const TW_MAX_CONNECTIONS: usize = 256;",
"/// At most this many connections are being turned away with a 503 at once.",
"const TW_MAX_REFUSALS: usize = 64;",
"const TW_HEAD_LIMIT: usize = 64 * 1024;",
"const TW_MAX_HEADERS: usize = 100;",
"",
"struct TwConnGuard(std::sync::Arc<std::sync::atomic::AtomicUsize>);",
"impl Drop for TwConnGuard {",
"    fn drop(&mut self) { self.0.fetch_sub(1, std::sync::atomic::Ordering::SeqCst); }",
"}",
"",
"/// Ends a connection after a response that closes it. A client that is still",
"/// sending leaves bytes in the receive buffer, and closing a socket with unread",
"/// bytes resets the connection on Windows, which throws away the response the",
"/// client has not read yet. Saying there is nothing more to send and then",
"/// reading the rest away makes the close orderly on every system. Bounded in",
"/// bytes and in time, so a client that keeps talking cannot hold the thread.",
"fn tw_close_after_response(stream: &std::net::TcpStream) {",
"    let _ = stream.shutdown(std::net::Shutdown::Write);",
"    let _ = stream.set_read_timeout(Some(std::time::Duration::from_millis(100)));",
"    let deadline = std::time::Instant::now() + std::time::Duration::from_millis(250);",
"    let mut left: i64 = 1 << 20;",
"    let mut sink = [0u8; 8192];",
"    let mut source = stream;",
"    while left > 0 && std::time::Instant::now() < deadline {",
"        match source.read(&mut sink) {",
"            Ok(0) | Err(_) => break,",
"            Ok(n) => left -= n as i64,",
"        }",
"    }",
"}",
"",
"/// HTTP/1.1 response bytes with Content-Length, Date and Connection headers.",
"fn tw_http_response_bytes(resp: &RawResponse, head: bool, keep_alive: bool) -> Vec<u8> {",
"    let status = tw_valid_status(resp.status);",
"    let mut out = format!(\"HTTP/1.1 {} {}\\r\\n\", status, tw_reason(status));",
"    let mut has_date = false;",
"    for (n, v) in &resp.headers {",
"        if !tw_header_allowed(n, v, false) { continue; }",
"        if n.eq_ignore_ascii_case(\"date\") { has_date = true; }",
"        out.push_str(&format!(\"{}: {}\\r\\n\", n, v));",
"    }",
"    if !has_date { out.push_str(&format!(\"Date: {}\\r\\n\", tw_http_date(tw_now_ms()))); }",
"    let bodyless = status == 204 || status == 304;",
"    if !bodyless { out.push_str(&format!(\"Content-Length: {}\\r\\n\", resp.body.len())); }",
"    out.push_str(if keep_alive { \"Connection: keep-alive\\r\\n\" } else { \"Connection: close\\r\\n\" });",
"    out.push_str(\"\\r\\n\");",
"    let mut bytes = out.into_bytes();",
"    if !head && !bodyless { bytes.extend_from_slice(&resp.body); }",
"    bytes",
"}",
"",
"enum TwReqErr { Closed, Status(u16) }",
"",
"/// Reads one request. Ok((request, keep_alive)).",
"fn tw_http_read_request<R: std::io::Read>(r: &mut TwReader<R>, w: &mut dyn std::io::Write, remote: &str, max_body: usize) -> Result<(RawRequest, bool), TwReqErr> {",
"    let mut used = 0usize;",
"    let line = loop {",
"        match r.read_line(TW_HEAD_LIMIT.saturating_sub(used)) {",
"            Ok(l) => {",
"                used += l.len() + 2;",
"                if used > TW_HEAD_LIMIT { return Err(TwReqErr::Status(431)); }",
"                if l.is_empty() { continue; } // tolerate empty lines before a request",
"                break l;",
"            }",
"            Err(TwRd::TooLong) => return Err(TwReqErr::Status(431)),",
"            Err(_) => return Err(TwReqErr::Closed),",
"        }",
"    };",
"    let line = String::from_utf8(line).map_err(|_| TwReqErr::Status(400))?;",
"    let parts: Vec<&str> = line.split(' ').collect();",
"    if parts.len() != 3 { return Err(TwReqErr::Status(400)); }",
"    let (method, target, version) = (parts[0], parts[1], parts[2]);",
"    if !tw_is_token(method) { return Err(TwReqErr::Status(400)); }",
"    let v11 = match version {",
"        \"HTTP/1.1\" => true,",
"        \"HTTP/1.0\" => false,",
"        v if v.starts_with(\"HTTP/\") => return Err(TwReqErr::Status(505)),",
"        _ => return Err(TwReqErr::Status(400)),",
"    };",
"    if target.is_empty() || target.bytes().any(|c| c <= 0x20 || c == 0x7f) { return Err(TwReqErr::Status(400)); }",
"    let origin = if target.starts_with('/') || target == \"*\" {",
"        target.to_string()",
"    } else {",
"        let lower = target.to_ascii_lowercase();",
"        let rest = if lower.starts_with(\"http://\") { &target[7..] } else if lower.starts_with(\"https://\") { &target[8..] } else { return Err(TwReqErr::Status(400)) };",
"        match rest.find(|c| c == '/' || c == '?') { Some(p) if rest.as_bytes()[p] == b'/' => rest[p..].to_string(), Some(p) => format!(\"/{}\", &rest[p..]), None => \"/\".to_string() }",
"    };",
"    let (path, query) = match origin.find('?') { Some(p) => (origin[..p].to_string(), origin[p + 1..].to_string()), None => (origin, String::new()) };",
"",
"    let mut headers: Vec<(String, String)> = Vec::new();",
"    loop {",
"        let h = match r.read_line(TW_HEAD_LIMIT.saturating_sub(used)) {",
"            Ok(h) => h,",
"            Err(TwRd::TooLong) => return Err(TwReqErr::Status(431)),",
"            Err(_) => return Err(TwReqErr::Closed),",
"        };",
"        used += h.len() + 2;",
"        if used > TW_HEAD_LIMIT { return Err(TwReqErr::Status(431)); }",
"        if h.is_empty() { break; }",
"        if headers.len() >= TW_MAX_HEADERS { return Err(TwReqErr::Status(431)); }",
"        if h[0] == b' ' || h[0] == b'\\t' { return Err(TwReqErr::Status(400)); } // obsolete line folding",
"        let colon = match h.iter().position(|&c| c == b':') { Some(p) => p, None => return Err(TwReqErr::Status(400)) };",
"        let name = String::from_utf8_lossy(&h[..colon]).to_string();",
"        if !tw_is_token(&name) { return Err(TwReqErr::Status(400)); }",
"        let value = &h[colon + 1..];",
"        if value.iter().any(|&c| c == b'\\r' || c == 0) { return Err(TwReqErr::Status(400)); }",
"        let value = String::from_utf8_lossy(value).trim_matches(|c| c == ' ' || c == '\\t').to_string();",
"        headers.push((name.to_ascii_lowercase(), value));",
"    }",
"    let values = |name: &str| -> Vec<String> { headers.iter().filter(|(n, _)| n == name).map(|(_, v)| v.clone()).collect() };",
"    if v11 && values(\"host\").is_empty() { return Err(TwReqErr::Status(400)); }",
"    let connection: Vec<String> = values(\"connection\").iter().flat_map(|v| v.split(',').map(|t| t.trim().to_ascii_lowercase()).collect::<Vec<_>>()).collect();",
"    let keep_alive = if v11 { !connection.iter().any(|t| t == \"close\") } else { connection.iter().any(|t| t == \"keep-alive\") };",
"    let te: Vec<String> = values(\"transfer-encoding\").iter().flat_map(|v| v.split(',').map(|t| t.trim().to_ascii_lowercase()).collect::<Vec<_>>()).filter(|t| !t.is_empty()).collect();",
"    let cl_values = values(\"content-length\");",
"    let chunked = !te.is_empty();",
"    if chunked {",
"        if !cl_values.is_empty() || !v11 { return Err(TwReqErr::Status(400)); }",
"        if te != [\"chunked\"] { return Err(TwReqErr::Status(501)); }",
"    }",
"    let mut content_length: Option<u64> = None;",
"    for v in &cl_values {",
"        for part in v.split(',') {",
"            let p = part.trim();",
"            if p.is_empty() || p.len() > 19 || !p.bytes().all(|c| c.is_ascii_digit()) { return Err(TwReqErr::Status(400)); }",
"            let n: u64 = p.parse().map_err(|_| TwReqErr::Status(400))?;",
"            if content_length.map_or(false, |c| c != n) { return Err(TwReqErr::Status(400)); }",
"            content_length = Some(n);",
"        }",
"    }",
"    if let Some(n) = content_length { if n > max_body as u64 { return Err(TwReqErr::Status(413)); } }",
"    let expects = values(\"expect\");",
"    if let Some(e) = expects.first() {",
"        if !e.eq_ignore_ascii_case(\"100-continue\") { return Err(TwReqErr::Status(417)); }",
"        if v11 && (chunked || content_length.unwrap_or(0) > 0) {",
"            if w.write_all(b\"HTTP/1.1 100 Continue\\r\\n\\r\\n\").and_then(|_| w.flush()).is_err() { return Err(TwReqErr::Closed); }",
"        }",
"    }",
"    let body = if chunked {",
"        match tw_read_chunked(r, max_body) {",
"            Ok(b) => b,",
"            Err(TwBodyErr::TooLarge) => return Err(TwReqErr::Status(413)),",
"            Err(TwBodyErr::Bad) => return Err(TwReqErr::Status(400)),",
"            Err(TwBodyErr::Closed) => return Err(TwReqErr::Closed),",
"        }",
"    } else if let Some(n) = content_length {",
"        r.read_exact_vec(n as usize).map_err(|_| TwReqErr::Closed)?",
"    } else {",
"        Vec::new()",
"    };",
"    Ok((RawRequest { method: method.to_string(), path, query, remote_addr: remote.to_string(), headers, body }, keep_alive))",
"}",
"",
"fn tw_http_connection(app: fn(RawRequest) -> RawResponse, stream: std::net::TcpStream, max_body: usize, tls: Option<&TwTlsConfig>) {",
"    let timeout = Some(std::time::Duration::from_secs(30));",
"    let _ = stream.set_read_timeout(timeout);",
"    let _ = stream.set_write_timeout(timeout);",
"    let _ = stream.set_nodelay(true);",
"    let remote = stream.peer_addr().map(|a| a.ip().to_string()).unwrap_or_default();",
"    let tcp = match stream.try_clone() { Ok(s) => s, Err(_) => return };",
"    match tls {",
"        None => {",
"            let mut writer = match stream.try_clone() { Ok(s) => s, Err(_) => return };",
"            let reader = TwReader::new(stream);",
"            tw_http_exchange(app, reader, &mut writer, &remote, max_body, &mut |drain| {",
"                if drain { tw_close_after_response(&tcp) } else { let _ = tcp.shutdown(std::net::Shutdown::Write); }",
"            });",
"        }",
"        Some(config) => {",
"            // A failed handshake (a scanner, a client that does not trust the",
"            // certificate) is the client's problem and is not logged.",
"            let conn = match tw_tls_accept(stream, config) { Ok(t) => TwTlsStream::new(t), Err(_) => return };",
"            let mut writer = conn.clone();",
"            let reader = TwReader::new(conn.clone());",
"            tw_http_exchange(app, reader, &mut writer, &remote, max_body, &mut |drain| {",
"                conn.close();",
"                if drain { tw_close_after_response(&tcp) } else { let _ = tcp.shutdown(std::net::Shutdown::Write); }",
"            });",
"        }",
"    }",
"}",
"",
"/// Requests and responses on one connection until it closes. `finish(drain)`",
"/// ends the connection: after an error response (drain the client's unread",
"/// bytes) or after a response that closes it.",
"fn tw_http_exchange<R: std::io::Read, W: std::io::Write>(app: fn(RawRequest) -> RawResponse, mut reader: TwReader<R>, writer: &mut W, remote: &str, max_body: usize, finish: &mut dyn FnMut(bool)) {",
"    loop {",
"        match tw_http_read_request(&mut reader, writer, remote, max_body) {",
"            Err(TwReqErr::Closed) => return,",
"            Err(TwReqErr::Status(code)) => {",
"                let _ = writer.write_all(&tw_http_response_bytes(&tw_status_response(code), false, false));",
"                let _ = writer.flush();",
"                finish(true);",
"                return;",
"            }",
"            Ok((req, keep_alive)) => {",
"                let head = req.method == \"HEAD\";",
"                let resp = tw_run_request(app, req);",
"                if writer.write_all(&tw_http_response_bytes(&resp, head, keep_alive)).and_then(|_| writer.flush()).is_err() { return; }",
"                if !keep_alive { finish(false); return; }",
"            }",
"        }",
"    }",
"}",
"",
"fn tw_accept_loop(app: fn(RawRequest) -> RawResponse, listener: std::net::TcpListener, fastcgi: bool, tls: Option<std::sync::Arc<TwTlsConfig>>) -> ! {",
"    let active = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));",
"    // Turning a connection away also takes a moment (the 503 has to be written",
"    // and the connection closed in an orderly way), and the accept loop must",
"    // not wait for that, so it happens on short-lived threads of its own. They",
"    // are counted too: an overload may not turn into unlimited threads.",
"    let refusing = std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0));",
"    let max_body = tw_max_body();",
"    loop {",
"        match listener.accept() {",
"            Ok((mut stream, _)) => {",
"                if active.load(std::sync::atomic::Ordering::SeqCst) >= TW_MAX_CONNECTIONS {",
"                    if !fastcgi && tls.is_none() && refusing.load(std::sync::atomic::Ordering::SeqCst) < TW_MAX_REFUSALS {",
"                        refusing.fetch_add(1, std::sync::atomic::Ordering::SeqCst);",
"                        let guard = TwConnGuard(refusing.clone());",
"                        let _ = std::thread::Builder::new().name(\"tessera-overload\".to_string()).spawn(move || {",
"                            let _guard = guard;",
"                            let _ = stream.set_write_timeout(Some(std::time::Duration::from_secs(1)));",
"                            let _ = stream.write_all(&tw_http_response_bytes(&tw_status_response(503), false, false));",
"                            tw_close_after_response(&stream);",
"                        });",
"                    }",
"                    continue;",
"                }",
"                active.fetch_add(1, std::sync::atomic::Ordering::SeqCst);",
"                let guard = TwConnGuard(active.clone());",
"                let tls = tls.clone();",
"                let _ = std::thread::Builder::new().name(\"tessera-connection\".to_string()).spawn(move || {",
"                    let _guard = guard;",
"                    if fastcgi { tw_fcgi_connection(app, stream, max_body) } else { tw_http_connection(app, stream, max_body, tls.as_deref()) }",
"                });",
"            }",
"            Err(_) => std::thread::sleep(std::time::Duration::from_millis(10)),",
"        }",
"    }",
"}",
"",
"/// HTTP/1.1 server on an already bound listener. Never returns.",
"pub fn tw_serve_listener(app: fn(RawRequest) -> RawResponse, listener: std::net::TcpListener) -> ! {",
"    tw_accept_loop(app, listener, false, None)",
"}",
"fn tw_host_port_text(host: &str, port: u16) -> String {",
"    if host.contains(':') { format!(\"[{}]:{}\", host, port) } else { format!(\"{}:{}\", host, port) }",
"}",
"/// Binds host:port and runs the HTTP/1.1 server; returns only if binding fails.",
"pub fn tw_serve(app: fn(RawRequest) -> RawResponse, host: &str, port: u16) -> std::io::Result<()> {",
"    let listener = std::net::TcpListener::bind((host, port))?;",
"    tw_log(&format!(\"listening on http://{}\\n\", tw_host_port_text(host, port)));",
"    tw_serve_listener(app, listener)",
"}",
"/// Binds host:port and runs the HTTPS (TLS 1.3) server; returns only if binding fails.",
"pub fn tw_serve_tls(app: fn(RawRequest) -> RawResponse, host: &str, port: u16, config: TwTlsConfig) -> std::io::Result<()> {",
"    let listener = std::net::TcpListener::bind((host, port))?;",
"    tw_log(&format!(\"listening on https://{}\\n\", tw_host_port_text(host, port)));",
"    tw_accept_loop(app, listener, false, Some(std::sync::Arc::new(config)))",
"}",
"",
"// ---- FastCGI responder ----------------------------------------------------------",
"",
"const TW_FCGI_BEGIN_REQUEST: u8 = 1;",
"const TW_FCGI_ABORT_REQUEST: u8 = 2;",
"const TW_FCGI_END_REQUEST: u8 = 3;",
"const TW_FCGI_PARAMS: u8 = 4;",
"const TW_FCGI_STDIN: u8 = 5;",
"const TW_FCGI_STDOUT: u8 = 6;",
"const TW_FCGI_DATA: u8 = 8;",
"const TW_FCGI_GET_VALUES: u8 = 9;",
"const TW_FCGI_GET_VALUES_RESULT: u8 = 10;",
"const TW_FCGI_UNKNOWN_TYPE: u8 = 11;",
"",
"fn tw_fcgi_record(ty: u8, id: u16, content: &[u8]) -> Vec<u8> {",
"    let len = content.len().min(65535);",
"    let pad = (8 - len % 8) % 8;",
"    let mut out = Vec::with_capacity(8 + len + pad);",
"    out.extend_from_slice(&[1, ty, (id >> 8) as u8, id as u8, (len >> 8) as u8, len as u8, pad as u8, 0]);",
"    out.extend_from_slice(&content[..len]);",
"    out.extend(std::iter::repeat(0u8).take(pad));",
"    out",
"}",
"fn tw_fcgi_end_request(id: u16, app_status: u32, protocol_status: u8) -> Vec<u8> {",
"    let s = app_status.to_be_bytes();",
"    tw_fcgi_record(TW_FCGI_END_REQUEST, id, &[s[0], s[1], s[2], s[3], protocol_status, 0, 0, 0])",
"}",
"fn tw_fcgi_read_record<R: std::io::Read>(r: &mut R) -> Option<(u8, u16, Vec<u8>)> {",
"    let mut h = [0u8; 8];",
"    r.read_exact(&mut h).ok()?;",
"    if h[0] != 1 { return None; }",
"    let id = u16::from_be_bytes([h[2], h[3]]);",
"    let len = u16::from_be_bytes([h[4], h[5]]) as usize;",
"    let mut content = vec![0u8; len];",
"    r.read_exact(&mut content).ok()?;",
"    let mut pad = vec![0u8; h[6] as usize];",
"    r.read_exact(&mut pad).ok()?;",
"    Some((h[1], id, content))",
"}",
"pub fn tw_fcgi_encode_pair(out: &mut Vec<u8>, name: &[u8], value: &[u8]) {",
"    for len in [name.len(), value.len()] {",
"        if len < 128 { out.push(len as u8); } else { out.extend_from_slice(&((len as u32) | 0x8000_0000).to_be_bytes()); }",
"    }",
"    out.extend_from_slice(name);",
"    out.extend_from_slice(value);",
"}",
"pub fn tw_fcgi_decode_pairs(b: &[u8]) -> Option<Vec<(Vec<u8>, Vec<u8>)>> {",
"    let mut i = 0;",
"    let mut out = Vec::new();",
"    let read_len = |i: &mut usize| -> Option<usize> {",
"        let first = *b.get(*i)?;",
"        if first < 128 { *i += 1; return Some(first as usize); }",
"        let s = b.get(*i..*i + 4)?;",
"        *i += 4;",
"        Some((u32::from_be_bytes([s[0], s[1], s[2], s[3]]) & 0x7FFF_FFFF) as usize)",
"    };",
"    while i < b.len() {",
"        let nl = read_len(&mut i)?;",
"        let vl = read_len(&mut i)?;",
"        if nl > b.len() - i { return None; }",
"        let name = b[i..i + nl].to_vec();",
"        i += nl;",
"        if vl > b.len() - i { return None; }",
"        let value = b[i..i + vl].to_vec();",
"        i += vl;",
"        out.push((name, value));",
"    }",
"    Some(out)",
"}",
"",
"struct TwFcgiRequest { id: u16, keep: bool, params: Vec<u8>, params_too_large: bool, stdin: Vec<u8>, too_large: bool }",
"",
"fn tw_fcgi_handle(app: fn(RawRequest) -> RawResponse, req: &TwFcgiRequest, max_body: usize) -> Vec<u8> {",
"    if req.params_too_large { return tw_cgi_response_bytes(&tw_status_response(431), false); }",
"    if req.too_large { return tw_cgi_response_bytes(&tw_status_response(413), false); }",
"    let pairs = match tw_fcgi_decode_pairs(&req.params) { Some(p) => p, None => return tw_cgi_response_bytes(&tw_status_response(400), false) };",
"    let vars: Vec<(String, String)> = pairs.iter().map(|(n, v)| (String::from_utf8_lossy(n).to_string(), String::from_utf8_lossy(v).to_string())).collect();",
"    let mut stdin: &[u8] = &req.stdin;",
"    match tw_cgi_request(&vars, &mut stdin, max_body, true) {",
"        Ok(r) => {",
"            let head = r.method == \"HEAD\";",
"            tw_cgi_response_bytes(&tw_run_request(app, r), head)",
"        }",
"        Err(code) => tw_cgi_response_bytes(&tw_status_response(code), false),",
"    }",
"}",
"",
"fn tw_fcgi_connection(app: fn(RawRequest) -> RawResponse, stream: std::net::TcpStream, max_body: usize) {",
"    let timeout = Some(std::time::Duration::from_secs(30));",
"    let _ = stream.set_read_timeout(timeout);",
"    let _ = stream.set_write_timeout(timeout);",
"    let mut w = match stream.try_clone() { Ok(s) => s, Err(_) => return };",
"    let mut r = std::io::BufReader::new(stream);",
"    let mut cur: Option<TwFcgiRequest> = None;",
"    loop {",
"        let (ty, id, content) = match tw_fcgi_read_record(&mut r) { Some(x) => x, None => return };",
"        let mut out: Vec<u8> = Vec::new();",
"        let mut close = false;",
"        match ty {",
"            TW_FCGI_GET_VALUES if id == 0 => {",
"                let mut result = Vec::new();",
"                for (name, _) in tw_fcgi_decode_pairs(&content).unwrap_or_default() {",
"                    let value: &[u8] = match name.as_slice() {",
"                        b\"FCGI_MAX_CONNS\" => b\"256\",",
"                        b\"FCGI_MAX_REQS\" => b\"256\",",
"                        b\"FCGI_MPXS_CONNS\" => b\"0\",",
"                        _ => continue,",
"                    };",
"                    tw_fcgi_encode_pair(&mut result, &name, value);",
"                }",
"                out = tw_fcgi_record(TW_FCGI_GET_VALUES_RESULT, 0, &result);",
"            }",
"            TW_FCGI_BEGIN_REQUEST if id != 0 => {",
"                if content.len() < 8 { continue; }",
"                let role = u16::from_be_bytes([content[0], content[1]]);",
"                let keep = content[2] & 1 != 0;",
"                if let Some(c) = &cur {",
"                    if c.id != id { out = tw_fcgi_end_request(id, 0, 1); } // FCGI_CANT_MPX_CONN",
"                } else if role != 1 {",
"                    out = tw_fcgi_end_request(id, 0, 3); // FCGI_UNKNOWN_ROLE",
"                    close = !keep;",
"                } else {",
"                    cur = Some(TwFcgiRequest { id, keep, params: Vec::new(), params_too_large: false, stdin: Vec::new(), too_large: false });",
"                }",
"            }",
"            TW_FCGI_ABORT_REQUEST => {",
"                if cur.as_ref().map_or(false, |c| c.id == id) {",
"                    let c = cur.take();",
"                    out = tw_fcgi_end_request(id, 0, 0);",
"                    close = !c.map_or(false, |c| c.keep);",
"                }",
"            }",
"            TW_FCGI_PARAMS => {",
"                if let Some(c) = cur.as_mut().filter(|c| c.id == id) {",
"                    if c.params.len() + content.len() > 1024 * 1024 { c.params_too_large = true; } else { c.params.extend_from_slice(&content); }",
"                }",
"            }",
"            TW_FCGI_STDIN => {",
"                if cur.as_ref().map_or(false, |c| c.id == id) {",
"                    if content.is_empty() {",
"                        if let Some(c) = cur.take() {",
"                            let resp = tw_fcgi_handle(app, &c, max_body);",
"                            for chunk in resp.chunks(32768) { out.extend_from_slice(&tw_fcgi_record(TW_FCGI_STDOUT, id, chunk)); }",
"                            out.extend_from_slice(&tw_fcgi_record(TW_FCGI_STDOUT, id, &[]));",
"                            out.extend_from_slice(&tw_fcgi_end_request(id, 0, 0));",
"                            close = !c.keep;",
"                        }",
"                    } else if let Some(c) = cur.as_mut() {",
"                        if c.too_large || c.stdin.len() + content.len() > max_body {",
"                            c.too_large = true;",
"                            c.stdin = Vec::new();",
"                        } else {",
"                            c.stdin.extend_from_slice(&content);",
"                        }",
"                    }",
"                }",
"            }",
"            TW_FCGI_DATA => {}",
"            _ => {",
"                if id == 0 { out = tw_fcgi_record(TW_FCGI_UNKNOWN_TYPE, 0, &[ty, 0, 0, 0, 0, 0, 0, 0]); }",
"            }",
"        }",
"        if !out.is_empty() && w.write_all(&out).and_then(|_| w.flush()).is_err() { return; }",
"        if close { let _ = w.shutdown(std::net::Shutdown::Both); return; }",
"    }",
"}",
"",
"/// FastCGI responder on an already bound listener. Never returns.",
"pub fn tw_fastcgi_serve_listener(app: fn(RawRequest) -> RawResponse, listener: std::net::TcpListener) -> ! {",
"    tw_accept_loop(app, listener, true, None)",
"}",
"/// Binds host:port and runs the FastCGI responder; returns only if binding fails.",
"pub fn tw_fastcgi_serve(app: fn(RawRequest) -> RawResponse, host: &str, port: u16) -> std::io::Result<()> {",
"    let listener = std::net::TcpListener::bind((host, port))?;",
"    tw_log(&format!(\"listening for FastCGI on {}\\n\", tw_host_port_text(host, port)));",
"    tw_fastcgi_serve_listener(app, listener)",
"}",
"",
"// ---- one-shot request host and main ---------------------------------------------",
"",
"fn tw_usage() -> ! {",
"    let program = std::env::args().next().unwrap_or_else(|| \"app\".to_string());",
"    tw_log(&format!(",
"        \"usage:\\n  {0} serve [--host HOST] [--port PORT] [--tls-cert FILE --tls-key FILE]\\n                                             HTTP/1.1 server (default 127.0.0.1:8080); HTTPS with a PEM certificate chain and key\\n  {0} fastcgi [--host HOST] [--port PORT]    FastCGI responder (default 127.0.0.1:9000)\\n  {0} request METHOD PATH[?QUERY] [-H \\\"Name: value\\\"]... [--body TEXT]\\n  run as a CGI program when GATEWAY_INTERFACE is set\\n\",",
"        program));",
"    std::process::exit(2)",
"}",
"fn tw_parse_host_port(args: &[String], default_port: u16) -> (String, u16) {",
"    let (host, port, cert, key) = tw_parse_serve_args(args, default_port);",
"    if cert.is_some() || key.is_some() { tw_usage() }",
"    (host, port)",
"}",
"/// --host, --port and the optional --tls-cert and --tls-key.",
"fn tw_parse_serve_args(args: &[String], default_port: u16) -> (String, u16, Option<String>, Option<String>) {",
"    let mut host = \"127.0.0.1\".to_string();",
"    let mut port = default_port;",
"    let (mut cert, mut key) = (None, None);",
"    let mut i = 0;",
"    while i < args.len() {",
"        match (args[i].as_str(), args.get(i + 1)) {",
"            (\"--host\", Some(h)) if !h.is_empty() => host = h.clone(),",
"            (\"--port\", Some(p)) => match p.parse::<u16>() { Ok(v) => port = v, Err(_) => tw_usage() },",
"            (\"--tls-cert\", Some(c)) if !c.is_empty() => cert = Some(c.clone()),",
"            (\"--tls-key\", Some(k)) if !k.is_empty() => key = Some(k.clone()),",
"            _ => tw_usage(),",
"        }",
"        i += 2;",
"    }",
"    (host, port, cert, key)",
"}",
"fn tw_default_http_port() -> u16 {",
"    for name in [\"HTTP_PLATFORM_PORT\", \"ASPNETCORE_PORT\", \"PORT\"] {",
"        if let Ok(v) = std::env::var(name) { if let Ok(p) = v.trim().parse::<u16>() { return p; } }",
"    }",
"    8080",
"}",
"",
"/// `request` host: runs one request and returns the printed output.",
"pub fn tw_request_command(app: fn(RawRequest) -> RawResponse, args: &[String]) -> Option<Vec<u8>> {",
"    if args.len() < 2 { return None; }",
"    let method = args[0].clone();",
"    if !tw_is_token(&method) { return None; }",
"    let (path, query) = match args[1].find('?') { Some(p) => (args[1][..p].to_string(), args[1][p + 1..].to_string()), None => (args[1].clone(), String::new()) };",
"    let mut headers: Vec<(String, String)> = Vec::new();",
"    let mut body = Vec::new();",
"    let mut i = 2;",
"    while i < args.len() {",
"        match (args[i].as_str(), args.get(i + 1)) {",
"            (\"-H\", Some(h)) => {",
"                let p = h.find(':')?;",
"                let name = h[..p].trim();",
"                if !tw_is_token(name) { return None; }",
"                headers.push((name.to_ascii_lowercase(), h[p + 1..].trim().to_string()));",
"            }",
"            (\"--body\", Some(b)) => body = b.as_bytes().to_vec(),",
"            _ => return None,",
"        }",
"        i += 2;",
"    }",
"    if !body.is_empty() && !headers.iter().any(|(n, _)| n == \"content-length\") {",
"        headers.push((\"content-length\".to_string(), body.len().to_string()));",
"    }",
"    let head = method == \"HEAD\";",
"    let resp = tw_run_request(app, RawRequest { method, path, query, remote_addr: \"127.0.0.1\".to_string(), headers, body });",
"    let mut out = format!(\"HTTP/1.1 {} {}\\n\", resp.status, tw_reason(resp.status));",
"    for (n, v) in &resp.headers {",
"        out.push_str(&format!(\"{}: {}\\n\", n.replace(['\\r', '\\n'], \" \"), v.replace(['\\r', '\\n'], \" \")));",
"    }",
"    out.push('\\n');",
"    let mut bytes = out.into_bytes();",
"    if !head { bytes.extend_from_slice(&resp.body); }",
"    Some(bytes)",
"}",
"",
"/// `main` of a compiled web application.",
"pub fn tw_web_main(app: fn(RawRequest) -> RawResponse) {",
"    if std::env::var(\"GATEWAY_INTERFACE\").map_or(false, |g| g.starts_with(\"CGI/\")) {",
"        tw_cgi_main(app);",
"        return;",
"    }",
"    let args: Vec<String> = std::env::args_os().skip(1).map(|a| a.to_string_lossy().to_string()).collect();",
"    let iis = std::env::var(\"HTTP_PLATFORM_PORT\").is_ok() || std::env::var(\"ASPNETCORE_PORT\").is_ok();",
"    match args.first().map(|s| s.as_str()) {",
"        None if iis => {",
"            let port = tw_default_http_port();",
"            if let Err(e) = tw_serve(app, \"127.0.0.1\", port) { tw_log(&format!(\"cannot listen on 127.0.0.1:{}: {}\\n\", port, e)); std::process::exit(1) }",
"        }",
"        Some(\"serve\") => {",
"            let (host, port, cert, key) = tw_parse_serve_args(&args[1..], tw_default_http_port());",
"            let result = match (cert, key) {",
"                (None, None) => tw_serve(app, &host, port),",
"                (Some(cert), Some(key)) => match tw_tls_load_config(&cert, &key) {",
"                    Ok(config) => tw_serve_tls(app, &host, port, config),",
"                    Err(e) => { tw_log(&format!(\"{}\\n\", e)); std::process::exit(1) }",
"                },",
"                _ => { tw_log(\"--tls-cert and --tls-key go together\\n\"); std::process::exit(2) }",
"            };",
"            if let Err(e) = result { tw_log(&format!(\"cannot listen on {}: {}\\n\", tw_host_port_text(&host, port), e)); std::process::exit(1) }",
"        }",
"        Some(\"fastcgi\") => {",
"            let (host, port) = tw_parse_host_port(&args[1..], 9000);",
"            if let Err(e) = tw_fastcgi_serve(app, &host, port) { tw_log(&format!(\"cannot listen on {}: {}\\n\", tw_host_port_text(&host, port), e)); std::process::exit(1) }",
"        }",
"        Some(\"request\") => match tw_request_command(app, &args[1..]) {",
"            Some(bytes) => {",
"                let out = std::io::stdout();",
"                let mut o = out.lock();",
"                let _ = o.write_all(&bytes);",
"                let _ = o.flush();",
"            }",
"            None => tw_usage(),",
"        },",
"        _ => tw_usage(),",
"    }",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/crypto.rs; do not edit by hand."
pub fn crypto_runtime() -> Text {
let lines = [
"// ---------------------------------------------------------------------------",
"// Tessera crypto runtime: the primitives TLS 1.3 needs and the `std/crypto`",
"// built-ins use. Pasted at top level after web.rs (it uses TwSha256,",
"// tw_chacha20_block, tw_words_le, tw_fill_random and tw_ct_eq from there).",
"// Safe Rust and std only; every item is prefixed `tw_` / `TW_` / `Tw`.",
"//",
"// Everything that touches secret data runs in constant time: no branches and",
"// no table lookups indexed by secret values. That is why AES is bitsliced",
"// (the S-box is computed as an inversion in GF(2^8), not looked up), GHASH",
"// multiplies bit by bit with masks, and the field and Montgomery arithmetic",
"// select with masks instead of branching. Public data (signatures, public",
"// keys, certificates) may take data-dependent time.",
"//",
"//   1. SHA-384 / SHA-512, HMAC and HKDF over SHA-256/384/512",
"//   2. ChaCha20-Poly1305 (RFC 8439)",
"//   3. AES-128/256 and GCM (FIPS 197, SP 800-38D)",
"//   4. X25519 (RFC 7748)",
"//   5. Montgomery arithmetic on fixed-length numbers",
"//   6. P-256 and P-384: ECDH and ECDSA (complete formulas, Renes-Costello-Batina 2015)",
"//   7. RSA: PKCS #1 v1.5 and PSS verification, PSS signing with CRT (RFC 8017)",
"//   8. Built-ins: sha512, hmac_sha512, hkdf_sha256, aead_seal, aead_open",
"// ---------------------------------------------------------------------------",
"",
"// ===========================================================================",
"// 1. SHA-384 / SHA-512, HMAC, HKDF",
"// ===========================================================================",
"",
"const TW_SHA512_K: [u64; 80] = [",
"    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc, 0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,",
"    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2, 0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,",
"    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65, 0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,",
"    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4, 0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,",
"    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df, 0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,",
"    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30, 0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,",
"    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8, 0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,",
"    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec, 0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,",
"    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178, 0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,",
"    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c, 0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817,",
"];",
"",
"#[derive(Clone)]",
"struct TwSha512 { h: [u64; 8], buf: [u8; 128], len: usize, total: u128, out_len: usize }",
"",
"impl TwSha512 {",
"    fn new() -> TwSha512 {",
"        TwSha512 {",
"            h: [0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1, 0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179],",
"            buf: [0u8; 128], len: 0, total: 0, out_len: 64,",
"        }",
"    }",
"    fn new384() -> TwSha512 {",
"        TwSha512 {",
"            h: [0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939, 0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4],",
"            buf: [0u8; 128], len: 0, total: 0, out_len: 48,",
"        }",
"    }",
"    fn compress(h: &mut [u64; 8], block: &[u8]) {",
"        let mut w = [0u64; 80];",
"        for t in 0..16 {",
"            let mut b = [0u8; 8];",
"            b.copy_from_slice(&block[t * 8..t * 8 + 8]);",
"            w[t] = u64::from_be_bytes(b);",
"        }",
"        for t in 16..80 {",
"            let s0 = w[t - 15].rotate_right(1) ^ w[t - 15].rotate_right(8) ^ (w[t - 15] >> 7);",
"            let s1 = w[t - 2].rotate_right(19) ^ w[t - 2].rotate_right(61) ^ (w[t - 2] >> 6);",
"            w[t] = w[t - 16].wrapping_add(s0).wrapping_add(w[t - 7]).wrapping_add(s1);",
"        }",
"        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) = (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);",
"        for t in 0..80 {",
"            let s1 = e.rotate_right(14) ^ e.rotate_right(18) ^ e.rotate_right(41);",
"            let ch = (e & f) ^ (!e & g);",
"            let t1 = hh.wrapping_add(s1).wrapping_add(ch).wrapping_add(TW_SHA512_K[t]).wrapping_add(w[t]);",
"            let s0 = a.rotate_right(28) ^ a.rotate_right(34) ^ a.rotate_right(39);",
"            let maj = (a & b) ^ (a & c) ^ (b & c);",
"            let t2 = s0.wrapping_add(maj);",
"            hh = g; g = f; f = e; e = d.wrapping_add(t1); d = c; c = b; b = a; a = t1.wrapping_add(t2);",
"        }",
"        h[0] = h[0].wrapping_add(a); h[1] = h[1].wrapping_add(b); h[2] = h[2].wrapping_add(c); h[3] = h[3].wrapping_add(d);",
"        h[4] = h[4].wrapping_add(e); h[5] = h[5].wrapping_add(f); h[6] = h[6].wrapping_add(g); h[7] = h[7].wrapping_add(hh);",
"    }",
"    fn update(&mut self, mut data: &[u8]) {",
"        self.total = self.total.wrapping_add(data.len() as u128);",
"        if self.len > 0 {",
"            let take = (128 - self.len).min(data.len());",
"            self.buf[self.len..self.len + take].copy_from_slice(&data[..take]);",
"            self.len += take;",
"            data = &data[take..];",
"            if self.len == 128 {",
"                TwSha512::compress(&mut self.h, &self.buf);",
"                self.len = 0;",
"            }",
"        }",
"        while data.len() >= 128 {",
"            TwSha512::compress(&mut self.h, &data[..128]);",
"            data = &data[128..];",
"        }",
"        if !data.is_empty() {",
"            self.buf[..data.len()].copy_from_slice(data);",
"            self.len = data.len();",
"        }",
"    }",
"    fn finish(mut self) -> Vec<u8> {",
"        let bits = self.total.wrapping_mul(8);",
"        self.update(&[0x80]);",
"        while self.len != 112 { self.update(&[0]); }",
"        self.update(&bits.to_be_bytes());",
"        let mut out = Vec::with_capacity(64);",
"        for i in 0..8 { out.extend_from_slice(&self.h[i].to_be_bytes()); }",
"        out.truncate(self.out_len);",
"        out",
"    }",
"}",
"",
"#[derive(Clone, Copy, PartialEq, Debug)]",
"enum TwHashAlg { Sha256, Sha384, Sha512 }",
"",
"impl TwHashAlg {",
"    fn len(self) -> usize { match self { TwHashAlg::Sha256 => 32, TwHashAlg::Sha384 => 48, TwHashAlg::Sha512 => 64 } }",
"    fn block(self) -> usize { match self { TwHashAlg::Sha256 => 64, _ => 128 } }",
"}",
"",
"#[derive(Clone)]",
"enum TwHasher { S256(TwSha256), S512(TwSha512) }",
"",
"impl TwHasher {",
"    fn new(alg: TwHashAlg) -> TwHasher {",
"        match alg {",
"            TwHashAlg::Sha256 => TwHasher::S256(TwSha256::new()),",
"            TwHashAlg::Sha384 => TwHasher::S512(TwSha512::new384()),",
"            TwHashAlg::Sha512 => TwHasher::S512(TwSha512::new()),",
"        }",
"    }",
"    fn update(&mut self, data: &[u8]) {",
"        match self { TwHasher::S256(h) => h.update(data), TwHasher::S512(h) => h.update(data) }",
"    }",
"    fn finish(self) -> Vec<u8> {",
"        match self { TwHasher::S256(h) => h.finish().to_vec(), TwHasher::S512(h) => h.finish() }",
"    }",
"}",
"",
"fn tw_hash(alg: TwHashAlg, data: &[u8]) -> Vec<u8> {",
"    let mut h = TwHasher::new(alg);",
"    h.update(data);",
"    h.finish()",
"}",
"",
"/// HMAC (RFC 2104) over any of the three hashes.",
"fn tw_hmac(alg: TwHashAlg, key: &[u8], message: &[u8]) -> Vec<u8> {",
"    let block = alg.block();",
"    let mut k = vec![0u8; block];",
"    if key.len() > block { let d = tw_hash(alg, key); k[..d.len()].copy_from_slice(&d); } else { k[..key.len()].copy_from_slice(key); }",
"    let mut inner = TwHasher::new(alg);",
"    inner.update(&k.iter().map(|b| b ^ 0x36).collect::<Vec<u8>>());",
"    inner.update(message);",
"    let digest = inner.finish();",
"    let mut outer = TwHasher::new(alg);",
"    outer.update(&k.iter().map(|b| b ^ 0x5c).collect::<Vec<u8>>());",
"    outer.update(&digest);",
"    outer.finish()",
"}",
"",
"/// HKDF-Extract (RFC 5869). An empty salt acts as a string of zero bytes.",
"fn tw_hkdf_extract(alg: TwHashAlg, salt: &[u8], ikm: &[u8]) -> Vec<u8> { tw_hmac(alg, salt, ikm) }",
"",
"/// HKDF-Expand (RFC 5869); `length` at most 255 hash lengths.",
"fn tw_hkdf_expand(alg: TwHashAlg, prk: &[u8], info: &[u8], length: usize) -> Vec<u8> {",
"    let mut out = Vec::with_capacity(length);",
"    let mut t: Vec<u8> = Vec::new();",
"    let mut counter = 1u8;",
"    while out.len() < length {",
"        let mut m = t.clone();",
"        m.extend_from_slice(info);",
"        m.push(counter);",
"        t = tw_hmac(alg, prk, &m);",
"        let take = t.len().min(length - out.len());",
"        out.extend_from_slice(&t[..take]);",
"        counter = counter.wrapping_add(1);",
"    }",
"    out",
"}",
"",
"// ===========================================================================",
"// 2. ChaCha20-Poly1305 (RFC 8439)",
"// ===========================================================================",
"",
"fn tw_le32(b: &[u8]) -> u32 { u32::from_le_bytes([b[0], b[1], b[2], b[3]]) }",
"",
"/// Poly1305 one-time authenticator, 26-bit limbs.",
"fn tw_poly1305(key: &[u8], msg: &[u8]) -> [u8; 16] {",
"    const M: u32 = 0x3ff_ffff;",
"    let r0 = tw_le32(&key[0..]) & 0x3ff_ffff;",
"    let r1 = (tw_le32(&key[3..]) >> 2) & 0x3ff_ff03;",
"    let r2 = (tw_le32(&key[6..]) >> 4) & 0x3ff_c0ff;",
"    let r3 = (tw_le32(&key[9..]) >> 6) & 0x3f0_3fff;",
"    let r4 = (tw_le32(&key[12..]) >> 8) & 0x00f_ffff;",
"    let (s1, s2, s3, s4) = (r1 * 5, r2 * 5, r3 * 5, r4 * 5);",
"    let (mut h0, mut h1, mut h2, mut h3, mut h4) = (0u32, 0u32, 0u32, 0u32, 0u32);",
"    for chunk in msg.chunks(16) {",
"        let mut b = [0u8; 17];",
"        b[..chunk.len()].copy_from_slice(chunk);",
"        let hibit: u32 = if chunk.len() == 16 { 1 << 24 } else { b[chunk.len()] = 1; 0 };",
"        h0 = h0.wrapping_add(tw_le32(&b[0..]) & M);",
"        h1 = h1.wrapping_add((tw_le32(&b[3..]) >> 2) & M);",
"        h2 = h2.wrapping_add((tw_le32(&b[6..]) >> 4) & M);",
"        h3 = h3.wrapping_add((tw_le32(&b[9..]) >> 6) & M);",
"        h4 = h4.wrapping_add((tw_le32(&b[12..]) >> 8) | hibit);",
"        let m = |a: u32, b: u32| a as u64 * b as u64;",
"        let d0 = m(h0, r0) + m(h1, s4) + m(h2, s3) + m(h3, s2) + m(h4, s1);",
"        let mut d1 = m(h0, r1) + m(h1, r0) + m(h2, s4) + m(h3, s3) + m(h4, s2);",
"        let mut d2 = m(h0, r2) + m(h1, r1) + m(h2, r0) + m(h3, s4) + m(h4, s3);",
"        let mut d3 = m(h0, r3) + m(h1, r2) + m(h2, r1) + m(h3, r0) + m(h4, s4);",
"        let mut d4 = m(h0, r4) + m(h1, r3) + m(h2, r2) + m(h3, r1) + m(h4, r0);",
"        let mut c = d0 >> 26; h0 = d0 as u32 & M;",
"        d1 += c; c = d1 >> 26; h1 = d1 as u32 & M;",
"        d2 += c; c = d2 >> 26; h2 = d2 as u32 & M;",
"        d3 += c; c = d3 >> 26; h3 = d3 as u32 & M;",
"        d4 += c; c = d4 >> 26; h4 = d4 as u32 & M;",
"        h0 = h0.wrapping_add((c as u32).wrapping_mul(5));",
"        let c2 = h0 >> 26; h0 &= M; h1 = h1.wrapping_add(c2);",
"    }",
"    let mut c = h1 >> 26; h1 &= M;",
"    h2 += c; c = h2 >> 26; h2 &= M;",
"    h3 += c; c = h3 >> 26; h3 &= M;",
"    h4 += c; c = h4 >> 26; h4 &= M;",
"    h0 += c * 5; c = h0 >> 26; h0 &= M;",
"    h1 += c;",
"    let mut g0 = h0.wrapping_add(5); c = g0 >> 26; g0 &= M;",
"    let mut g1 = h1.wrapping_add(c); c = g1 >> 26; g1 &= M;",
"    let mut g2 = h2.wrapping_add(c); c = g2 >> 26; g2 &= M;",
"    let mut g3 = h3.wrapping_add(c); c = g3 >> 26; g3 &= M;",
"    let mut g4 = h4.wrapping_add(c).wrapping_sub(1 << 26);",
"    let mask = (g4 >> 31).wrapping_sub(1); // all ones when h >= p: take g",
"    g0 &= mask; g1 &= mask; g2 &= mask; g3 &= mask; g4 &= mask;",
"    let keep = !mask;",
"    h0 = (h0 & keep) | g0; h1 = (h1 & keep) | g1; h2 = (h2 & keep) | g2; h3 = (h3 & keep) | g3; h4 = (h4 & keep) | g4;",
"    let w0 = h0 | (h1 << 26);",
"    let w1 = (h1 >> 6) | (h2 << 20);",
"    let w2 = (h2 >> 12) | (h3 << 14);",
"    let w3 = (h3 >> 18) | (h4 << 8);",
"    let mut f = w0 as u64 + tw_le32(&key[16..]) as u64;",
"    let o0 = f as u32;",
"    f = w1 as u64 + tw_le32(&key[20..]) as u64 + (f >> 32);",
"    let o1 = f as u32;",
"    f = w2 as u64 + tw_le32(&key[24..]) as u64 + (f >> 32);",
"    let o2 = f as u32;",
"    f = w3 as u64 + tw_le32(&key[28..]) as u64 + (f >> 32);",
"    let o3 = f as u32;",
"    let mut out = [0u8; 16];",
"    out[0..4].copy_from_slice(&o0.to_le_bytes()); out[4..8].copy_from_slice(&o1.to_le_bytes());",
"    out[8..12].copy_from_slice(&o2.to_le_bytes()); out[12..16].copy_from_slice(&o3.to_le_bytes());",
"    out",
"}",
"",
"fn tw_chacha_key(key: &[u8]) -> [u32; 8] {",
"    let k = tw_words_le(key);",
"    [k[0], k[1], k[2], k[3], k[4], k[5], k[6], k[7]]",
"}",
"",
"fn tw_chacha20_xor(key: &[u32; 8], nonce: &[u32; 3], counter: u32, data: &mut [u8]) {",
"    let mut ctr = counter;",
"    for chunk in data.chunks_mut(64) {",
"        let block = tw_chacha20_block(key, ctr, nonce);",
"        for (d, k) in chunk.iter_mut().zip(block.iter()) { *d ^= k; }",
"        ctr = ctr.wrapping_add(1);",
"    }",
"}",
"",
"fn tw_aead_mac_data(aad: &[u8], ct: &[u8]) -> Vec<u8> {",
"    let mut m = Vec::with_capacity(aad.len() + ct.len() + 48);",
"    m.extend_from_slice(aad);",
"    while m.len() % 16 != 0 { m.push(0); }",
"    m.extend_from_slice(ct);",
"    while m.len() % 16 != 0 { m.push(0); }",
"    m.extend_from_slice(&(aad.len() as u64).to_le_bytes());",
"    m.extend_from_slice(&(ct.len() as u64).to_le_bytes());",
"    m",
"}",
"",
"/// ChaCha20-Poly1305 encryption: ciphertext followed by the 16-byte tag. Key 32 bytes, nonce 12.",
"fn tw_chacha20_poly1305_seal(key: &[u8], nonce: &[u8], aad: &[u8], plaintext: &[u8]) -> Vec<u8> {",
"    let k = tw_chacha_key(key);",
"    let nw = tw_words_le(nonce);",
"    let n = [nw[0], nw[1], nw[2]];",
"    let otk = tw_chacha20_block(&k, 0, &n);",
"    let mut out = plaintext.to_vec();",
"    tw_chacha20_xor(&k, &n, 1, &mut out);",
"    let tag = tw_poly1305(&otk[..32], &tw_aead_mac_data(aad, &out));",
"    out.extend_from_slice(&tag);",
"    out",
"}",
"",
"fn tw_chacha20_poly1305_open(key: &[u8], nonce: &[u8], aad: &[u8], sealed: &[u8]) -> Option<Vec<u8>> {",
"    if sealed.len() < 16 { return None; }",
"    let (ct, tag) = sealed.split_at(sealed.len() - 16);",
"    let k = tw_chacha_key(key);",
"    let nw = tw_words_le(nonce);",
"    let n = [nw[0], nw[1], nw[2]];",
"    let otk = tw_chacha20_block(&k, 0, &n);",
"    let expected = tw_poly1305(&otk[..32], &tw_aead_mac_data(aad, ct));",
"    if !tw_ct_eq(&expected, tag) { return None; }",
"    let mut out = ct.to_vec();",
"    tw_chacha20_xor(&k, &n, 1, &mut out);",
"    Some(out)",
"}",
"",
"// ===========================================================================",
"// 3. AES and GCM",
"// ===========================================================================",
"//",
"// Bitsliced: up to four blocks (64 bytes) are transposed into eight 64-bit",
"// planes, plane b holding bit b of every byte. SubBytes is the inverse in",
"// GF(2^8) (x^254, by multiplying planes) followed by the affine map, so no",
"// secret-indexed table exists. ShiftRows and MixColumns work on bytes with",
"// fixed indexes and masks.",
"",
"fn tw_gf8_mul_planes(a: &[u64; 8], b: &[u64; 8]) -> [u64; 8] {",
"    let mut c = [0u64; 15];",
"    for i in 0..8 { for j in 0..8 { c[i + j] ^= a[i] & b[j]; } }",
"    // x^8 = x^4 + x^3 + x + 1",
"    for k in (8..15).rev() {",
"        let t = c[k];",
"        c[k - 4] ^= t; c[k - 5] ^= t; c[k - 7] ^= t; c[k - 8] ^= t;",
"    }",
"    [c[0], c[1], c[2], c[3], c[4], c[5], c[6], c[7]]",
"}",
"",
"fn tw_aes_sbox_planes(x: &[u64; 8]) -> [u64; 8] {",
"    let sq = |a: &[u64; 8]| tw_gf8_mul_planes(a, a);",
"    let x2 = sq(x);",
"    let x3 = tw_gf8_mul_planes(&x2, x);",
"    let x6 = sq(&x3);",
"    let x12 = sq(&x6);",
"    let x15 = tw_gf8_mul_planes(&x12, &x3);",
"    let x240 = sq(&sq(&sq(&sq(&x15))));",
"    let x252 = tw_gf8_mul_planes(&x240, &x12);",
"    let inv = tw_gf8_mul_planes(&x252, &x2); // x^254: the inverse, 0 for 0",
"    let mut s = [0u64; 8];",
"    for i in 0..8 {",
"        s[i] = inv[i] ^ inv[(i + 4) % 8] ^ inv[(i + 5) % 8] ^ inv[(i + 6) % 8] ^ inv[(i + 7) % 8];",
"    }",
"    // constant 0x63: bits 0, 1, 5, 6",
"    s[0] = !s[0]; s[1] = !s[1]; s[5] = !s[5]; s[6] = !s[6];",
"    s",
"}",
"",
"/// SubBytes on up to 64 bytes at once.",
"fn tw_aes_sub_bytes(state: &mut [u8]) {",
"    let mut p = [0u64; 8];",
"    for (i, &v) in state.iter().enumerate() {",
"        for b in 0..8 { p[b] |= (((v >> b) & 1) as u64) << i; }",
"    }",
"    let s = tw_aes_sbox_planes(&p);",
"    for (i, v) in state.iter_mut().enumerate() {",
"        let mut o = 0u8;",
"        for b in 0..8 { o |= (((s[b] >> i) & 1) as u8) << b; }",
"        *v = o;",
"    }",
"}",
"",
"fn tw_xtime(x: u8) -> u8 { (x << 1) ^ (0x1b & 0u8.wrapping_sub(x >> 7)) }",
"",
"#[derive(Clone)]",
"struct TwAes { rk: Vec<[u8; 16]> }",
"",
"impl TwAes {",
"    /// Key of 16 bytes (AES-128) or 32 bytes (AES-256).",
"    fn new(key: &[u8]) -> TwAes {",
"        let nk = key.len() / 4;",
"        let nr = nk + 6;",
"        let mut w: Vec<[u8; 4]> = Vec::with_capacity(4 * (nr + 1));",
"        for i in 0..nk { w.push([key[4 * i], key[4 * i + 1], key[4 * i + 2], key[4 * i + 3]]); }",
"        let mut rcon = 1u8;",
"        for i in nk..4 * (nr + 1) {",
"            let mut t = w[i - 1];",
"            if i % nk == 0 {",
"                t = [t[1], t[2], t[3], t[0]];",
"                tw_aes_sub_bytes(&mut t);",
"                t[0] ^= rcon;",
"                rcon = tw_xtime(rcon);",
"            } else if nk > 6 && i % nk == 4 {",
"                tw_aes_sub_bytes(&mut t);",
"            }",
"            let p = w[i - nk];",
"            w.push([p[0] ^ t[0], p[1] ^ t[1], p[2] ^ t[2], p[3] ^ t[3]]);",
"        }",
"        let mut rk = Vec::with_capacity(nr + 1);",
"        for r in 0..=nr {",
"            let mut k = [0u8; 16];",
"            for c in 0..4 { k[4 * c..4 * c + 4].copy_from_slice(&w[4 * r + c]); }",
"            rk.push(k);",
"        }",
"        TwAes { rk }",
"    }",
"    /// Encrypts up to four blocks in place.",
"    fn encrypt_blocks(&self, blocks: &mut [[u8; 16]]) {",
"        let n = blocks.len();",
"        let nr = self.rk.len() - 1;",
"        let mut flat = [0u8; 64];",
"        for (i, b) in blocks.iter().enumerate() { flat[16 * i..16 * i + 16].copy_from_slice(b); }",
"        for i in 0..n { for j in 0..16 { flat[16 * i + j] ^= self.rk[0][j]; } }",
"        for round in 1..=nr {",
"            tw_aes_sub_bytes(&mut flat[..16 * n]);",
"            for i in 0..n {",
"                let s = &mut flat[16 * i..16 * i + 16];",
"                let old = [s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7], s[8], s[9], s[10], s[11], s[12], s[13], s[14], s[15]];",
"                for c in 0..4 { for r in 0..4 { s[r + 4 * c] = old[r + 4 * ((c + r) % 4)]; } }",
"                if round != nr {",
"                    for c in 0..4 {",
"                        let a = [s[4 * c], s[4 * c + 1], s[4 * c + 2], s[4 * c + 3]];",
"                        let all = a[0] ^ a[1] ^ a[2] ^ a[3];",
"                        for r in 0..4 { s[4 * c + r] = a[r] ^ all ^ tw_xtime(a[r] ^ a[(r + 1) % 4]); }",
"                    }",
"                }",
"                for j in 0..16 { s[j] ^= self.rk[round][j]; }",
"            }",
"        }",
"        for (i, b) in blocks.iter_mut().enumerate() { b.copy_from_slice(&flat[16 * i..16 * i + 16]); }",
"    }",
"}",
"",
"/// GF(2^128) multiplication in GCM's bit order, bit by bit with masks.",
"fn tw_gf128_mul(x: u128, y: u128) -> u128 {",
"    let r: u128 = 0xe1 << 120;",
"    let mut z = 0u128;",
"    let mut v = y;",
"    for i in 0..128 {",
"        let bit = (x >> (127 - i)) & 1;",
"        z ^= v & 0u128.wrapping_sub(bit);",
"        let lsb = v & 1;",
"        v = (v >> 1) ^ (r & 0u128.wrapping_sub(lsb));",
"    }",
"    z",
"}",
"",
"#[derive(Clone)]",
"struct TwAesGcm { aes: TwAes, h: u128 }",
"",
"impl TwAesGcm {",
"    fn new(key: &[u8]) -> TwAesGcm {",
"        let aes = TwAes::new(key);",
"        let mut z = [[0u8; 16]];",
"        aes.encrypt_blocks(&mut z);",
"        TwAesGcm { aes, h: u128::from_be_bytes(z[0]) }",
"    }",
"    fn ctr(&self, nonce: &[u8], data: &mut [u8]) {",
"        let mut counter = 2u32;",
"        for group in data.chunks_mut(64) {",
"            let nblocks = (group.len() + 15) / 16;",
"            let mut ks = [[0u8; 16]; 4];",
"            for b in ks.iter_mut().take(nblocks) {",
"                b[..12].copy_from_slice(nonce);",
"                b[12..].copy_from_slice(&counter.to_be_bytes());",
"                counter = counter.wrapping_add(1);",
"            }",
"            self.aes.encrypt_blocks(&mut ks[..nblocks]);",
"            for (i, d) in group.iter_mut().enumerate() { *d ^= ks[i / 16][i % 16]; }",
"        }",
"    }",
"    fn tag(&self, nonce: &[u8], aad: &[u8], ct: &[u8]) -> [u8; 16] {",
"        let mut y = 0u128;",
"        for part in [aad, ct] {",
"            for chunk in part.chunks(16) {",
"                let mut b = [0u8; 16];",
"                b[..chunk.len()].copy_from_slice(chunk);",
"                y = tw_gf128_mul(y ^ u128::from_be_bytes(b), self.h);",
"            }",
"        }",
"        let lens = ((aad.len() as u128 * 8) << 64) | (ct.len() as u128 * 8);",
"        y = tw_gf128_mul(y ^ lens, self.h);",
"        let mut j0 = [[0u8; 16]];",
"        j0[0][..12].copy_from_slice(nonce);",
"        j0[0][15] = 1;",
"        self.aes.encrypt_blocks(&mut j0);",
"        (y ^ u128::from_be_bytes(j0[0])).to_be_bytes()",
"    }",
"    fn seal(&self, nonce: &[u8], aad: &[u8], plaintext: &[u8]) -> Vec<u8> {",
"        let mut out = plaintext.to_vec();",
"        self.ctr(nonce, &mut out);",
"        let t = self.tag(nonce, aad, &out);",
"        out.extend_from_slice(&t);",
"        out",
"    }",
"    fn open(&self, nonce: &[u8], aad: &[u8], sealed: &[u8]) -> Option<Vec<u8>> {",
"        if sealed.len() < 16 { return None; }",
"        let (ct, tag) = sealed.split_at(sealed.len() - 16);",
"        if !tw_ct_eq(&self.tag(nonce, aad, ct), tag) { return None; }",
"        let mut out = ct.to_vec();",
"        self.ctr(nonce, &mut out);",
"        Some(out)",
"    }",
"}",
"",
"// ===========================================================================",
"// 4. X25519 (RFC 7748): field elements as five 51-bit limbs",
"// ===========================================================================",
"",
"type TwFe = [u64; 5];",
"const TW_MASK51: u64 = (1 << 51) - 1;",
"",
"fn tw_le64(b: &[u8]) -> u64 { let mut a = [0u8; 8]; a.copy_from_slice(&b[..8]); u64::from_le_bytes(a) }",
"",
"fn tw_fe_from_bytes(b: &[u8]) -> TwFe {",
"    [",
"        tw_le64(&b[0..]) & TW_MASK51,",
"        (tw_le64(&b[6..]) >> 3) & TW_MASK51,",
"        (tw_le64(&b[12..]) >> 6) & TW_MASK51,",
"        (tw_le64(&b[19..]) >> 1) & TW_MASK51,",
"        (tw_le64(&b[24..]) >> 12) & TW_MASK51,",
"    ]",
"}",
"fn tw_fe_carry(mut h: TwFe) -> TwFe {",
"    let mut c;",
"    c = h[0] >> 51; h[0] &= TW_MASK51; h[1] += c;",
"    c = h[1] >> 51; h[1] &= TW_MASK51; h[2] += c;",
"    c = h[2] >> 51; h[2] &= TW_MASK51; h[3] += c;",
"    c = h[3] >> 51; h[3] &= TW_MASK51; h[4] += c;",
"    c = h[4] >> 51; h[4] &= TW_MASK51; h[0] += c * 19;",
"    c = h[0] >> 51; h[0] &= TW_MASK51; h[1] += c;",
"    h",
"}",
"fn tw_fe_add(a: &TwFe, b: &TwFe) -> TwFe { tw_fe_carry([a[0] + b[0], a[1] + b[1], a[2] + b[2], a[3] + b[3], a[4] + b[4]]) }",
"fn tw_fe_sub(a: &TwFe, b: &TwFe) -> TwFe {",
"    // a + 4p - b keeps every limb positive for carried inputs",
"    tw_fe_carry([",
"        a[0] + 0x1f_ffff_ffff_ffb4 - b[0],",
"        a[1] + 0x1f_ffff_ffff_fffc - b[1],",
"        a[2] + 0x1f_ffff_ffff_fffc - b[2],",
"        a[3] + 0x1f_ffff_ffff_fffc - b[3],",
"        a[4] + 0x1f_ffff_ffff_fffc - b[4],",
"    ])",
"}",
"fn tw_fe_mul(a: &TwFe, b: &TwFe) -> TwFe {",
"    let m = |x: u64, y: u64| x as u128 * y as u128;",
"    let (b1, b2, b3, b4) = (b[1] * 19, b[2] * 19, b[3] * 19, b[4] * 19);",
"    let r0 = m(a[0], b[0]) + m(a[1], b4) + m(a[2], b3) + m(a[3], b2) + m(a[4], b1);",
"    let mut r1 = m(a[0], b[1]) + m(a[1], b[0]) + m(a[2], b4) + m(a[3], b3) + m(a[4], b2);",
"    let mut r2 = m(a[0], b[2]) + m(a[1], b[1]) + m(a[2], b[0]) + m(a[3], b4) + m(a[4], b3);",
"    let mut r3 = m(a[0], b[3]) + m(a[1], b[2]) + m(a[2], b[1]) + m(a[3], b[0]) + m(a[4], b4);",
"    let mut r4 = m(a[0], b[4]) + m(a[1], b[3]) + m(a[2], b[2]) + m(a[3], b[1]) + m(a[4], b[0]);",
"    let mask = TW_MASK51 as u128;",
"    let mut c = r0 >> 51; let h0 = (r0 & mask) as u64;",
"    r1 += c; c = r1 >> 51; let h1 = (r1 & mask) as u64;",
"    r2 += c; c = r2 >> 51; let h2 = (r2 & mask) as u64;",
"    r3 += c; c = r3 >> 51; let h3 = (r3 & mask) as u64;",
"    r4 += c; c = r4 >> 51; let h4 = (r4 & mask) as u64;",
"    let h0 = h0 + (c as u64) * 19;",
"    tw_fe_carry([h0, h1, h2, h3, h4])",
"}",
"fn tw_fe_sq(a: &TwFe) -> TwFe { tw_fe_mul(a, a) }",
"/// z^(p-2) with p = 2^255 - 19; the exponent is public.",
"fn tw_fe_invert(z: &TwFe) -> TwFe {",
"    // p - 2 = 2^255 - 21: bits 254..5 set, then 01011",
"    let mut r: TwFe = [1, 0, 0, 0, 0];",
"    for i in (0..255).rev() {",
"        r = tw_fe_sq(&r);",
"        let bit = if i >= 5 { 1 } else { (0b01011u32 >> i) & 1 };",
"        if bit == 1 { r = tw_fe_mul(&r, z); }",
"    }",
"    r",
"}",
"fn tw_fe_to_bytes(h: &TwFe) -> [u8; 32] {",
"    let mut h = tw_fe_carry(tw_fe_carry(*h));",
"    let mut q = (h[0] + 19) >> 51;",
"    q = (h[1] + q) >> 51; q = (h[2] + q) >> 51; q = (h[3] + q) >> 51; q = (h[4] + q) >> 51;",
"    h[0] += 19 * q;",
"    let mut c;",
"    c = h[0] >> 51; h[0] &= TW_MASK51; h[1] += c;",
"    c = h[1] >> 51; h[1] &= TW_MASK51; h[2] += c;",
"    c = h[2] >> 51; h[2] &= TW_MASK51; h[3] += c;",
"    c = h[3] >> 51; h[3] &= TW_MASK51; h[4] += c;",
"    h[4] &= TW_MASK51;",
"    let w = [h[0] | (h[1] << 51), (h[1] >> 13) | (h[2] << 38), (h[2] >> 26) | (h[3] << 25), (h[3] >> 39) | (h[4] << 12)];",
"    let mut out = [0u8; 32];",
"    for i in 0..4 { out[8 * i..8 * i + 8].copy_from_slice(&w[i].to_le_bytes()); }",
"    out",
"}",
"fn tw_fe_cswap(swap: u64, a: &mut TwFe, b: &mut TwFe) {",
"    let mask = 0u64.wrapping_sub(swap);",
"    for i in 0..5 { let t = mask & (a[i] ^ b[i]); a[i] ^= t; b[i] ^= t; }",
"}",
"",
"/// X25519(scalar, u): both 32 bytes.",
"fn tw_x25519(scalar: &[u8], u: &[u8]) -> [u8; 32] {",
"    let mut k = [0u8; 32];",
"    k.copy_from_slice(&scalar[..32]);",
"    k[0] &= 248; k[31] &= 127; k[31] |= 64;",
"    let x1 = tw_fe_from_bytes(u);",
"    let mut x2: TwFe = [1, 0, 0, 0, 0];",
"    let mut z2: TwFe = [0; 5];",
"    let mut x3 = x1;",
"    let mut z3: TwFe = [1, 0, 0, 0, 0];",
"    let a24: TwFe = [121665, 0, 0, 0, 0];",
"    let mut swap = 0u64;",
"    for t in (0..255).rev() {",
"        let kt = ((k[t / 8] >> (t % 8)) & 1) as u64;",
"        swap ^= kt;",
"        tw_fe_cswap(swap, &mut x2, &mut x3);",
"        tw_fe_cswap(swap, &mut z2, &mut z3);",
"        swap = kt;",
"        let a = tw_fe_add(&x2, &z2);",
"        let aa = tw_fe_sq(&a);",
"        let b = tw_fe_sub(&x2, &z2);",
"        let bb = tw_fe_sq(&b);",
"        let e = tw_fe_sub(&aa, &bb);",
"        let c = tw_fe_add(&x3, &z3);",
"        let d = tw_fe_sub(&x3, &z3);",
"        let da = tw_fe_mul(&d, &a);",
"        let cb = tw_fe_mul(&c, &b);",
"        x3 = tw_fe_sq(&tw_fe_add(&da, &cb));",
"        z3 = tw_fe_mul(&x1, &tw_fe_sq(&tw_fe_sub(&da, &cb)));",
"        x2 = tw_fe_mul(&aa, &bb);",
"        z2 = tw_fe_mul(&e, &tw_fe_add(&aa, &tw_fe_mul(&a24, &e)));",
"    }",
"    tw_fe_cswap(swap, &mut x2, &mut x3);",
"    tw_fe_cswap(swap, &mut z2, &mut z3);",
"    tw_fe_to_bytes(&tw_fe_mul(&x2, &tw_fe_invert(&z2)))",
"}",
"",
"fn tw_x25519_base(scalar: &[u8]) -> [u8; 32] {",
"    let mut nine = [0u8; 32];",
"    nine[0] = 9;",
"    tw_x25519(scalar, &nine)",
"}",
"",
"// ===========================================================================",
"// 5. Montgomery arithmetic on fixed-length numbers (little-endian u64 limbs)",
"// ===========================================================================",
"",
"/// Big-endian bytes to `limbs` limbs; None when the value does not fit.",
"fn tw_bn_from_be(bytes: &[u8], limbs: usize) -> Option<Vec<u64>> {",
"    let mut start = 0;",
"    while start < bytes.len() && bytes[start] == 0 && bytes.len() - start > limbs * 8 { start += 1; }",
"    let b = &bytes[start..];",
"    if b.len() > limbs * 8 { return None; }",
"    let mut out = vec![0u64; limbs];",
"    for (i, &byte) in b.iter().rev().enumerate() { out[i / 8] |= (byte as u64) << (8 * (i % 8)); }",
"    Some(out)",
"}",
"fn tw_bn_to_be(a: &[u64], len: usize) -> Vec<u8> {",
"    let mut out = vec![0u8; len];",
"    for i in 0..len {",
"        let limb = i / 8;",
"        if limb < a.len() { out[len - 1 - i] = (a[limb] >> (8 * (i % 8))) as u8; }",
"    }",
"    out",
"}",
"/// a - b and the final borrow (0 or 1).",
"fn tw_bn_sub(a: &[u64], b: &[u64]) -> (Vec<u64>, u64) {",
"    let mut out = vec![0u64; a.len()];",
"    let mut borrow = 0u64;",
"    for i in 0..a.len() {",
"        let bi = if i < b.len() { b[i] } else { 0 };",
"        let (d1, o1) = a[i].overflowing_sub(bi);",
"        let (d2, o2) = d1.overflowing_sub(borrow);",
"        out[i] = d2;",
"        borrow = (o1 | o2) as u64;",
"    }",
"    (out, borrow)",
"}",
"fn tw_bn_add(a: &[u64], b: &[u64]) -> (Vec<u64>, u64) {",
"    let mut out = vec![0u64; a.len()];",
"    let mut carry = 0u64;",
"    for i in 0..a.len() {",
"        let bi = if i < b.len() { b[i] } else { 0 };",
"        let s = a[i] as u128 + bi as u128 + carry as u128;",
"        out[i] = s as u64;",
"        carry = (s >> 64) as u64;",
"    }",
"    (out, carry)",
"}",
"/// Constant-time: mask all ones selects `a`, zero selects `b`.",
"fn tw_bn_select(mask: u64, a: &[u64], b: &[u64]) -> Vec<u64> {",
"    a.iter().zip(b.iter()).map(|(x, y)| (x & mask) | (y & !mask)).collect()",
"}",
"fn tw_bn_is_zero(a: &[u64]) -> bool { a.iter().fold(0u64, |acc, x| acc | x) == 0 }",
"fn tw_bn_lt(a: &[u64], b: &[u64]) -> bool { tw_bn_sub(a, b).1 == 1 }",
"fn tw_bn_bits(a: &[u64]) -> usize {",
"    for i in (0..a.len()).rev() { if a[i] != 0 { return 64 * i + 64 - a[i].leading_zeros() as usize; } }",
"    0",
"}",
"/// Plain product, a.len() + b.len() limbs.",
"fn tw_bn_mul(a: &[u64], b: &[u64]) -> Vec<u64> {",
"    let mut out = vec![0u64; a.len() + b.len()];",
"    for i in 0..a.len() {",
"        let mut carry = 0u128;",
"        for j in 0..b.len() {",
"            let t = out[i + j] as u128 + a[i] as u128 * b[j] as u128 + carry;",
"            out[i + j] = t as u64;",
"            carry = t >> 64;",
"        }",
"        out[i + b.len()] = carry as u64;",
"    }",
"    out",
"}",
"",
"#[derive(Clone)]",
"struct TwMont { m: Vec<u64>, n0: u64, r2: Vec<u64>, one: Vec<u64> }",
"",
"impl TwMont {",
"    /// `m` must be odd and its top limb non-zero.",
"    fn new(m: Vec<u64>) -> TwMont {",
"        let mut inv = 1u64;",
"        for _ in 0..6 { inv = inv.wrapping_mul(2u64.wrapping_sub(m[0].wrapping_mul(inv))); }",
"        let n0 = inv.wrapping_neg();",
"        let n = m.len();",
"        let mut mont = TwMont { m, n0, r2: Vec::new(), one: Vec::new() };",
"        // R^2 mod m by doubling 1 (2 * 64 * n) times",
"        let mut x = vec![0u64; n];",
"        x[0] = 1;",
"        let x = { let mut v = mont.reduce_once(x); for _ in 0..128 * n { v = mont.add(&v, &v); } v };",
"        mont.r2 = x;",
"        let mut unit = vec![0u64; n];",
"        unit[0] = 1;",
"        mont.one = mont.mul(&unit, &mont.r2.clone());",
"        mont",
"    }",
"    fn len(&self) -> usize { self.m.len() }",
"    fn reduce_once(&self, a: Vec<u64>) -> Vec<u64> {",
"        let (d, borrow) = tw_bn_sub(&a, &self.m);",
"        tw_bn_select(0u64.wrapping_sub(borrow), &a, &d)",
"    }",
"    /// a * b / R mod m (CIOS). Requires a < R and b < m.",
"    fn mul(&self, a: &[u64], b: &[u64]) -> Vec<u64> {",
"        let n = self.m.len();",
"        let mut t = vec![0u64; n + 2];",
"        for i in 0..n {",
"            let mut c = 0u128;",
"            for j in 0..n {",
"                let v = t[j] as u128 + a[j] as u128 * b[i] as u128 + c;",
"                t[j] = v as u64;",
"                c = v >> 64;",
"            }",
"            let v = t[n] as u128 + c;",
"            t[n] = v as u64;",
"            t[n + 1] = (v >> 64) as u64;",
"            let mm = t[0].wrapping_mul(self.n0);",
"            let v = t[0] as u128 + mm as u128 * self.m[0] as u128;",
"            let mut c = v >> 64;",
"            for j in 1..n {",
"                let v = t[j] as u128 + mm as u128 * self.m[j] as u128 + c;",
"                t[j - 1] = v as u64;",
"                c = v >> 64;",
"            }",
"            let v = t[n] as u128 + c;",
"            t[n - 1] = v as u64;",
"            t[n] = t[n + 1] + (v >> 64) as u64;",
"        }",
"        let top = t[n];",
"        t.truncate(n);",
"        let (d, borrow) = tw_bn_sub(&t, &self.m);",
"        // keep t only when it is below m: no carry out and a borrow",
"        let keep_t = 0u64.wrapping_sub(borrow & (1 ^ (top & 1)));",
"        tw_bn_select(keep_t, &t, &d)",
"    }",
"    fn add(&self, a: &[u64], b: &[u64]) -> Vec<u64> {",
"        let (s, carry) = tw_bn_add(a, b);",
"        let (d, borrow) = tw_bn_sub(&s, &self.m);",
"        let keep_s = 0u64.wrapping_sub(borrow & (1 ^ carry));",
"        tw_bn_select(keep_s, &s, &d)",
"    }",
"    fn sub(&self, a: &[u64], b: &[u64]) -> Vec<u64> {",
"        let (d, borrow) = tw_bn_sub(a, b);",
"        let mask = 0u64.wrapping_sub(borrow);",
"        let masked: Vec<u64> = self.m.iter().map(|x| x & mask).collect();",
"        tw_bn_add(&d, &masked).0",
"    }",
"    fn to_mont(&self, a: &[u64]) -> Vec<u64> { self.mul(a, &self.r2) }",
"    fn from_mont(&self, a: &[u64]) -> Vec<u64> {",
"        let mut unit = vec![0u64; self.len()];",
"        unit[0] = 1;",
"        self.mul(a, &unit)",
"    }",
"    /// Any big-endian number of at most 2 * len limbs, reduced mod m (normal form).",
"    fn reduce_bytes(&self, bytes: &[u8]) -> Option<Vec<u64>> {",
"        let n = self.len();",
"        let wide = tw_bn_from_be(bytes, 2 * n)?;",
"        let lo = &wide[..n];",
"        let hi = &wide[n..];",
"        let a = self.mul(lo, &self.r2); // lo * R",
"        let b = self.mul(&self.mul(hi, &self.r2), &self.r2); // hi * R^2",
"        Some(self.from_mont(&self.add(&a, &b)))",
"    }",
"    /// base^exp with `base` in Montgomery form; exp big-endian. Fixed 4-bit",
"    /// windows and a table read that touches every entry: constant time in the",
"    /// exponent's value (its length is public).",
"    fn pow(&self, base: &[u64], exp: &[u8]) -> Vec<u64> {",
"        let mut table: Vec<Vec<u64>> = Vec::with_capacity(16);",
"        table.push(self.one.clone());",
"        for i in 1..16 { let next = self.mul(&table[i - 1], base); table.push(next); }",
"        let mut r = self.one.clone();",
"        for &byte in exp {",
"            for nibble in [byte >> 4, byte & 15] {",
"                for _ in 0..4 { r = self.mul(&r, &r); }",
"                let mut sel = vec![0u64; self.len()];",
"                for (i, t) in table.iter().enumerate() {",
"                    let eq = ((i as u64 ^ nibble as u64).wrapping_sub(1) >> 63) & 1; // 1 when equal",
"                    let mask = 0u64.wrapping_sub(eq);",
"                    for k in 0..sel.len() { sel[k] |= t[k] & mask; }",
"                }",
"                r = self.mul(&r, &sel);",
"            }",
"        }",
"        r",
"    }",
"    /// Inverse for a prime modulus (Fermat), Montgomery form in and out.",
"    fn invert_prime(&self, a: &[u64]) -> Vec<u64> {",
"        let mut two = vec![0u64; self.len()];",
"        two[0] = 2;",
"        let e = tw_bn_sub(&self.m, &two).0;",
"        self.pow(a, &tw_bn_to_be(&e, self.len() * 8))",
"    }",
"}",
"",
"// ===========================================================================",
"// 6. P-256 and P-384 (short Weierstrass, a = -3)",
"// ===========================================================================",
"",
"struct TwCurve { name: &'static str, fp: TwMont, fnn: TwMont, b: Vec<u64>, gx: Vec<u64>, gy: Vec<u64>, size: usize }",
"",
"fn tw_hex_bytes(s: &str) -> Vec<u8> {",
"    (0..s.len() / 2).map(|i| u8::from_str_radix(&s[2 * i..2 * i + 2], 16).unwrap_or(0)).collect()",
"}",
"",
"fn tw_make_curve(name: &'static str, p: &str, n: &str, b: &str, gx: &str, gy: &str) -> TwCurve {",
"    let size = p.len() / 2;",
"    let limbs = (size + 7) / 8;",
"    let fp = TwMont::new(tw_bn_from_be(&tw_hex_bytes(p), limbs).unwrap_or_default());",
"    let fnn = TwMont::new(tw_bn_from_be(&tw_hex_bytes(n), limbs).unwrap_or_default());",
"    let to = |h: &str| fp.to_mont(&tw_bn_from_be(&tw_hex_bytes(h), limbs).unwrap_or_default());",
"    let (b, gx, gy) = (to(b), to(gx), to(gy));",
"    TwCurve { name, fp, fnn, b, gx, gy, size }",
"}",
"",
"static TW_P256: std::sync::OnceLock<TwCurve> = std::sync::OnceLock::new();",
"static TW_P384: std::sync::OnceLock<TwCurve> = std::sync::OnceLock::new();",
"",
"fn tw_p256() -> &'static TwCurve {",
"    TW_P256.get_or_init(|| tw_make_curve(\"P-256\",",
"        \"ffffffff00000001000000000000000000000000ffffffffffffffffffffffff\",",
"        \"ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551\",",
"        \"5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b\",",
"        \"6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296\",",
"        \"4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5\"))",
"}",
"fn tw_p384() -> &'static TwCurve {",
"    TW_P384.get_or_init(|| tw_make_curve(\"P-384\",",
"        \"fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff\",",
"        \"ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973\",",
"        \"b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef\",",
"        \"aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7\",",
"        \"3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f\"))",
"}",
"",
"/// Projective point (X : Y : Z), coordinates in Montgomery form; Z = 0 is the point at infinity.",
"#[derive(Clone)]",
"struct TwPoint { x: Vec<u64>, y: Vec<u64>, z: Vec<u64> }",
"",
"impl TwCurve {",
"    fn infinity(&self) -> TwPoint { TwPoint { x: vec![0; self.fp.len()], y: self.fp.one.clone(), z: vec![0; self.fp.len()] } }",
"    fn generator(&self) -> TwPoint { TwPoint { x: self.gx.clone(), y: self.gy.clone(), z: self.fp.one.clone() } }",
"    /// Complete addition for a = -3 (Renes, Costello, Batina 2015, algorithm 4);",
"    /// also correct for doubling and the point at infinity.",
"    fn add(&self, p: &TwPoint, q: &TwPoint) -> TwPoint {",
"        let f = &self.fp;",
"        let mul = |a: &[u64], b: &[u64]| f.mul(a, b);",
"        let add = |a: &[u64], b: &[u64]| f.add(a, b);",
"        let sub = |a: &[u64], b: &[u64]| f.sub(a, b);",
"        let (x1, y1, z1, x2, y2, z2) = (&p.x, &p.y, &p.z, &q.x, &q.y, &q.z);",
"        let mut t0 = mul(x1, x2);",
"        let mut t1 = mul(y1, y2);",
"        let mut t2 = mul(z1, z2);",
"        let mut t3 = add(x1, y1);",
"        let mut t4 = add(x2, y2);",
"        t3 = mul(&t3, &t4);",
"        t4 = add(&t0, &t1);",
"        t3 = sub(&t3, &t4);",
"        t4 = add(y1, z1);",
"        let mut x3 = add(y2, z2);",
"        t4 = mul(&t4, &x3);",
"        x3 = add(&t1, &t2);",
"        t4 = sub(&t4, &x3);",
"        x3 = add(x1, z1);",
"        let mut y3 = add(x2, z2);",
"        x3 = mul(&x3, &y3);",
"        y3 = add(&t0, &t2);",
"        y3 = sub(&x3, &y3);",
"        let mut z3 = mul(&self.b, &t2);",
"        x3 = sub(&y3, &z3);",
"        z3 = add(&x3, &x3);",
"        x3 = add(&x3, &z3);",
"        z3 = sub(&t1, &x3);",
"        x3 = add(&t1, &x3);",
"        y3 = mul(&self.b, &y3);",
"        t1 = add(&t2, &t2);",
"        t2 = add(&t1, &t2);",
"        y3 = sub(&y3, &t2);",
"        y3 = sub(&y3, &t0);",
"        t1 = add(&y3, &y3);",
"        y3 = add(&t1, &y3);",
"        t1 = add(&t0, &t0);",
"        t0 = add(&t1, &t0);",
"        t0 = sub(&t0, &t2);",
"        t1 = mul(&t4, &y3);",
"        t2 = mul(&t0, &y3);",
"        y3 = mul(&x3, &z3);",
"        y3 = add(&y3, &t2);",
"        x3 = mul(&t3, &x3);",
"        x3 = sub(&x3, &t1);",
"        z3 = mul(&t4, &z3);",
"        t1 = mul(&t3, &t0);",
"        z3 = add(&z3, &t1);",
"        TwPoint { x: x3, y: y3, z: z3 }",
"    }",
"    /// k * P for a big-endian scalar; double and always add, selection by mask.",
"    fn mul_scalar(&self, k: &[u8], p: &TwPoint) -> TwPoint {",
"        let mut r = self.infinity();",
"        for &byte in k {",
"            for bit in (0..8).rev() {",
"                r = self.add(&r, &r);",
"                let t = self.add(&r, p);",
"                let mask = 0u64.wrapping_sub(((byte >> bit) & 1) as u64);",
"                r = TwPoint { x: tw_bn_select(mask, &t.x, &r.x), y: tw_bn_select(mask, &t.y, &r.y), z: tw_bn_select(mask, &t.z, &r.z) };",
"            }",
"        }",
"        r",
"    }",
"    /// Affine (x, y) in normal form; None for the point at infinity.",
"    fn to_affine(&self, p: &TwPoint) -> Option<(Vec<u64>, Vec<u64>)> {",
"        if tw_bn_is_zero(&p.z) { return None; }",
"        let zi = self.fp.invert_prime(&p.z);",
"        Some((self.fp.from_mont(&self.fp.mul(&p.x, &zi)), self.fp.from_mont(&self.fp.mul(&p.y, &zi))))",
"    }",
"    fn encode_point(&self, p: &TwPoint) -> Option<Vec<u8>> {",
"        let (x, y) = self.to_affine(p)?;",
"        let mut out = vec![4u8];",
"        out.extend_from_slice(&tw_bn_to_be(&x, self.size));",
"        out.extend_from_slice(&tw_bn_to_be(&y, self.size));",
"        Some(out)",
"    }",
"    /// Uncompressed point 04 || x || y, checked to be on the curve.",
"    fn decode_point(&self, data: &[u8]) -> Option<TwPoint> {",
"        if data.len() != 1 + 2 * self.size || data[0] != 4 { return None; }",
"        let n = self.fp.len();",
"        let x = tw_bn_from_be(&data[1..1 + self.size], n)?;",
"        let y = tw_bn_from_be(&data[1 + self.size..], n)?;",
"        if !tw_bn_lt(&x, &self.fp.m) || !tw_bn_lt(&y, &self.fp.m) { return None; }",
"        let (xm, ym) = (self.fp.to_mont(&x), self.fp.to_mont(&y));",
"        let f = &self.fp;",
"        let y2 = f.mul(&ym, &ym);",
"        let x3 = f.mul(&f.mul(&xm, &xm), &xm);",
"        let three_x = f.add(&f.add(&xm, &xm), &xm);",
"        let rhs = f.add(&f.sub(&x3, &three_x), &self.b);",
"        if y2 != rhs { return None; }",
"        Some(TwPoint { x: xm, y: ym, z: f.one.clone() })",
"    }",
"    /// A random private scalar in [1, n - 1], as `size` big-endian bytes.",
"    fn random_scalar(&self) -> Vec<u8> {",
"        loop {",
"            let mut wide = vec![0u8; 2 * self.size];",
"            tw_fill_random(&mut wide);",
"            if let Some(k) = self.fnn.reduce_bytes(&wide) {",
"                if !tw_bn_is_zero(&k) { return tw_bn_to_be(&k, self.size); }",
"            }",
"        }",
"    }",
"    fn public_key(&self, d: &[u8]) -> Option<Vec<u8>> { self.encode_point(&self.mul_scalar(d, &self.generator())) }",
"    /// ECDH: the x coordinate of d * peer.",
"    fn ecdh(&self, d: &[u8], peer: &[u8]) -> Option<Vec<u8>> {",
"        let q = self.decode_point(peer)?;",
"        let (x, _) = self.to_affine(&self.mul_scalar(d, &q))?;",
"        Some(tw_bn_to_be(&x, self.size))",
"    }",
"    /// The hash as a scalar: its leftmost `size` bytes, reduced mod n.",
"    fn hash_scalar(&self, hash: &[u8]) -> Vec<u64> {",
"        let take = hash.len().min(self.size);",
"        self.fnn.reduce_bytes(&hash[..take]).unwrap_or_default()",
"    }",
"    fn verify(&self, public: &[u8], hash: &[u8], r: &[u8], s: &[u8]) -> bool {",
"        let n = self.fnn.len();",
"        let q = match self.decode_point(public) { Some(q) => q, None => return false };",
"        let (r, s) = match (tw_bn_from_be(r, n), tw_bn_from_be(s, n)) { (Some(r), Some(s)) => (r, s), _ => return false };",
"        if tw_bn_is_zero(&r) || tw_bn_is_zero(&s) || !tw_bn_lt(&r, &self.fnn.m) || !tw_bn_lt(&s, &self.fnn.m) { return false; }",
"        let fnn = &self.fnn;",
"        let e = self.hash_scalar(hash);",
"        let w = fnn.invert_prime(&fnn.to_mont(&s)); // s^-1 * R",
"        let u1 = fnn.mul(&w, &e); // e / s, normal form",
"        let u2 = fnn.mul(&w, &r);",
"        let p = self.add(&self.mul_scalar(&tw_bn_to_be(&u1, self.size), &self.generator()), &self.mul_scalar(&tw_bn_to_be(&u2, self.size), &q));",
"        let (x, _) = match self.to_affine(&p) { Some(a) => a, None => return false };",
"        let xr = fnn.reduce_bytes(&tw_bn_to_be(&x, self.size)).unwrap_or_default();",
"        xr == r",
"    }",
"    /// ECDSA signature (r, s) as big-endian `size`-byte values. The nonce is",
"    /// derived from fresh randomness, the key and the hash together, so a weak",
"    /// random source alone does not reveal the key.",
"    fn sign(&self, d: &[u8], hash: &[u8]) -> (Vec<u8>, Vec<u8>) {",
"        let fnn = &self.fnn;",
"        let n = fnn.len();",
"        let dn = tw_bn_from_be(d, n).unwrap_or_default();",
"        let e = self.hash_scalar(hash);",
"        loop {",
"            let mut seed = vec![0u8; 32];",
"            tw_fill_random(&mut seed);",
"            let mut material = seed.clone();",
"            material.extend_from_slice(d);",
"            material.extend_from_slice(hash);",
"            let mut wide = tw_hash(TwHashAlg::Sha512, &material);",
"            material.push(1);",
"            wide.extend_from_slice(&tw_hash(TwHashAlg::Sha512, &material));",
"            let k = match fnn.reduce_bytes(&wide[..2 * self.size]) { Some(k) => k, None => continue };",
"            if tw_bn_is_zero(&k) { continue; }",
"            let kb = tw_bn_to_be(&k, self.size);",
"            let (x, _) = match self.to_affine(&self.mul_scalar(&kb, &self.generator())) { Some(a) => a, None => continue };",
"            let r = fnn.reduce_bytes(&tw_bn_to_be(&x, self.size)).unwrap_or_default();",
"            if tw_bn_is_zero(&r) { continue; }",
"            let kinv = fnn.invert_prime(&fnn.to_mont(&k)); // k^-1 * R",
"            let rd = fnn.mul(&fnn.to_mont(&r), &dn); // r * d",
"            let s = fnn.mul(&kinv, &fnn.add(&e, &rd)); // (e + r d) / k",
"            if tw_bn_is_zero(&s) { continue; }",
"            return (tw_bn_to_be(&r, self.size), tw_bn_to_be(&s, self.size));",
"        }",
"    }",
"}",
"",
"// ===========================================================================",
"// 7. RSA (RFC 8017)",
"// ===========================================================================",
"",
"fn tw_strip_zeros(b: &[u8]) -> &[u8] {",
"    let mut i = 0;",
"    while i < b.len() && b[i] == 0 { i += 1; }",
"    &b[i..]",
"}",
"",
"/// s^e mod n for a public key; the result has the length of n in bytes.",
"fn tw_rsa_public(n: &[u8], e: &[u8], sig: &[u8]) -> Option<Vec<u8>> {",
"    let n = tw_strip_zeros(n);",
"    let e = tw_strip_zeros(e);",
"    if n.len() < 128 || n.len() > 1024 || e.is_empty() || e.len() > 8 || n[n.len() - 1] & 1 == 0 { return None; } // 1024 to 8192 bits",
"    if sig.len() != n.len() { return None; }",
"    let limbs = (n.len() + 7) / 8;",
"    let m = TwMont::new(tw_bn_from_be(n, limbs)?);",
"    let s = tw_bn_from_be(sig, limbs)?;",
"    if !tw_bn_lt(&s, &m.m) { return None; }",
"    let r = m.from_mont(&m.pow(&m.to_mont(&s), e));",
"    Some(tw_bn_to_be(&r, n.len()))",
"}",
"",
"fn tw_digest_info_prefix(alg: TwHashAlg) -> Vec<u8> {",
"    tw_hex_bytes(match alg {",
"        TwHashAlg::Sha256 => \"3031300d060960864801650304020105000420\",",
"        TwHashAlg::Sha384 => \"3041300d060960864801650304020205000430\",",
"        TwHashAlg::Sha512 => \"3051300d060960864801650304020305000440\",",
"    })",
"}",
"",
"fn tw_rsa_verify_pkcs1(n: &[u8], e: &[u8], alg: TwHashAlg, message: &[u8], sig: &[u8]) -> bool {",
"    let em = match tw_rsa_public(n, e, sig) { Some(m) => m, None => return false };",
"    let mut t = tw_digest_info_prefix(alg);",
"    t.extend_from_slice(&tw_hash(alg, message));",
"    if em.len() < t.len() + 11 { return false; }",
"    let mut expected = vec![0u8, 1];",
"    expected.resize(em.len() - t.len() - 1, 0xff);",
"    expected.push(0);",
"    expected.extend_from_slice(&t);",
"    em == expected",
"}",
"",
"fn tw_mgf1(alg: TwHashAlg, seed: &[u8], len: usize) -> Vec<u8> {",
"    let mut out = Vec::with_capacity(len);",
"    let mut counter = 0u32;",
"    while out.len() < len {",
"        let mut m = seed.to_vec();",
"        m.extend_from_slice(&counter.to_be_bytes());",
"        out.extend_from_slice(&tw_hash(alg, &m));",
"        counter += 1;",
"    }",
"    out.truncate(len);",
"    out",
"}",
"",
"fn tw_rsa_mod_bits(n: &[u8]) -> usize {",
"    let n = tw_strip_zeros(n);",
"    if n.is_empty() { 0 } else { 8 * n.len() - n[0].leading_zeros() as usize }",
"}",
"",
"/// RSASSA-PSS verification with MGF1 of the same hash and a salt as long as the hash.",
"fn tw_rsa_verify_pss(n: &[u8], e: &[u8], alg: TwHashAlg, message: &[u8], sig: &[u8]) -> bool {",
"    let em_full = match tw_rsa_public(n, e, sig) { Some(m) => m, None => return false };",
"    let em_bits = tw_rsa_mod_bits(n) - 1;",
"    let em_len = (em_bits + 7) / 8;",
"    let em = &em_full[em_full.len() - em_len..];",
"    if em_full.len() > em_len && em_full[0] != 0 { return false; }",
"    let h_len = alg.len();",
"    let s_len = h_len;",
"    if em_len < h_len + s_len + 2 || em[em_len - 1] != 0xbc { return false; }",
"    let masked = &em[..em_len - h_len - 1];",
"    let h = &em[em_len - h_len - 1..em_len - 1];",
"    let top_bits = 8 * em_len - em_bits;",
"    if top_bits > 0 && masked[0] >> (8 - top_bits) != 0 { return false; }",
"    let mask = tw_mgf1(alg, h, masked.len());",
"    let mut db: Vec<u8> = masked.iter().zip(mask.iter()).map(|(a, b)| a ^ b).collect();",
"    if top_bits > 0 { db[0] &= 0xff >> top_bits; }",
"    let ps_len = em_len - h_len - s_len - 2;",
"    if db[..ps_len].iter().any(|&b| b != 0) || db[ps_len] != 1 { return false; }",
"    let salt = &db[ps_len + 1..];",
"    let mut m2 = vec![0u8; 8];",
"    m2.extend_from_slice(&tw_hash(alg, message));",
"    m2.extend_from_slice(salt);",
"    tw_ct_eq(&tw_hash(alg, &m2), h)",
"}",
"",
"/// An RSA private key; all numbers big-endian.",
"#[derive(Clone)]",
"struct TwRsaKey { n: Vec<u8>, e: Vec<u8>, p: Vec<u8>, q: Vec<u8>, dp: Vec<u8>, dq: Vec<u8>, qinv: Vec<u8> }",
"",
"/// m^d mod n with the Chinese remainder theorem; constant-time exponentiation.",
"/// The result is checked with the public key, so a computing fault cannot leak the key.",
"fn tw_rsa_private(key: &TwRsaKey, m: &[u8]) -> Option<Vec<u8>> {",
"    let k = tw_strip_zeros(&key.n).len();",
"    let p = tw_strip_zeros(&key.p);",
"    let q = tw_strip_zeros(&key.q);",
"    let (lp, lq) = ((p.len() + 7) / 8, (q.len() + 7) / 8);",
"    let mp = TwMont::new(tw_bn_from_be(p, lp)?);",
"    let mq = TwMont::new(tw_bn_from_be(q, lq)?);",
"    if 2 * lp < (k + 7) / 8 || 2 * lq < (k + 7) / 8 { return None; }",
"    let m1 = mp.from_mont(&mp.pow(&mp.to_mont(&mp.reduce_bytes(m)?), &key.dp));",
"    let m2 = mq.from_mont(&mq.pow(&mq.to_mont(&mq.reduce_bytes(m)?), &key.dq));",
"    let m2p = mp.reduce_bytes(&tw_bn_to_be(&m2, lq * 8))?;",
"    let diff = mp.sub(&m1, &m2p);",
"    let qinv = mp.reduce_bytes(&key.qinv)?;",
"    let h = mp.mul(&mp.to_mont(&qinv), &diff); // qinv * (m1 - m2) mod p",
"    let hq = tw_bn_mul(&h, &tw_bn_from_be(q, lq)?);",
"    let (s, _) = tw_bn_add(&hq, &m2);",
"    let sig = tw_bn_to_be(&s, k);",
"    let check = tw_rsa_public(&key.n, &key.e, &sig)?;",
"    let mut padded = vec![0u8; k.saturating_sub(m.len())];",
"    padded.extend_from_slice(m);",
"    if !tw_ct_eq(&check, &padded) { return None; }",
"    Some(sig)",
"}",
"",
"/// RSASSA-PSS signature, salt as long as the hash.",
"fn tw_rsa_sign_pss(key: &TwRsaKey, alg: TwHashAlg, message: &[u8]) -> Option<Vec<u8>> {",
"    let em_bits = tw_rsa_mod_bits(&key.n) - 1;",
"    let em_len = (em_bits + 7) / 8;",
"    let h_len = alg.len();",
"    if em_len < 2 * h_len + 2 { return None; }",
"    let mut salt = vec![0u8; h_len];",
"    tw_fill_random(&mut salt);",
"    let mut m2 = vec![0u8; 8];",
"    m2.extend_from_slice(&tw_hash(alg, message));",
"    m2.extend_from_slice(&salt);",
"    let h = tw_hash(alg, &m2);",
"    let mut db = vec![0u8; em_len - 2 * h_len - 2];",
"    db.push(1);",
"    db.extend_from_slice(&salt);",
"    let mask = tw_mgf1(alg, &h, db.len());",
"    for (d, m) in db.iter_mut().zip(mask.iter()) { *d ^= m; }",
"    let top_bits = 8 * em_len - em_bits;",
"    if top_bits > 0 { db[0] &= 0xff >> top_bits; }",
"    let mut em = db;",
"    em.extend_from_slice(&h);",
"    em.push(0xbc);",
"    tw_rsa_private(key, &em)",
"}",
"",
"// ===========================================================================",
"// 8. Built-ins (section 10 of the specification; std/crypto builds on them)",
"// ===========================================================================",
"",
"fn tw_sha512(data: Rc<Vec<u8>>) -> Rc<Vec<u8>> { Rc::new(tw_hash(TwHashAlg::Sha512, &data)) }",
"fn tw_hmac_sha512(key: Rc<Vec<u8>>, message: Rc<Vec<u8>>) -> Rc<Vec<u8>> { Rc::new(tw_hmac(TwHashAlg::Sha512, &key, &message)) }",
"fn tw_hkdf_sha256(secret: Rc<Vec<u8>>, salt: Rc<Vec<u8>>, info: Rc<Vec<u8>>, length: i64, loc: &str) -> Rc<Vec<u8>> {",
"    if !(1..=8160).contains(&length) { t_fail(\"R004\", format!(\"hkdf_sha256: length {} is outside 1..8160\", length), loc) }",
"    Rc::new(tw_hkdf_expand(TwHashAlg::Sha256, &tw_hkdf_extract(TwHashAlg::Sha256, &salt, &secret), &info, length as usize))",
"}",
"fn tw_aead_check(name: &str, key: &[u8], nonce: &[u8], loc: &str) {",
"    if key.len() != 32 { t_fail(\"R004\", format!(\"{}: the key must be 32 bytes, not {}\", name, key.len()), loc) }",
"    if nonce.len() != 12 { t_fail(\"R004\", format!(\"{}: the nonce must be 12 bytes, not {}\", name, nonce.len()), loc) }",
"}",
"fn tw_aead_seal(key: Rc<Vec<u8>>, nonce: Rc<Vec<u8>>, plaintext: Rc<Vec<u8>>, associated: Rc<Vec<u8>>, loc: &str) -> Rc<Vec<u8>> {",
"    tw_aead_check(\"aead_seal\", &key, &nonce, loc);",
"    Rc::new(tw_chacha20_poly1305_seal(&key, &nonce, &associated, &plaintext))",
"}",
"fn tw_aead_open(key: Rc<Vec<u8>>, nonce: Rc<Vec<u8>>, sealed: Rc<Vec<u8>>, associated: Rc<Vec<u8>>, loc: &str) -> Option<Rc<Vec<u8>>> {",
"    tw_aead_check(\"aead_open\", &key, &nonce, loc);",
"    tw_chacha20_poly1305_open(&key, &nonce, &associated, &sealed).map(Rc::new)",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/tls.rs; do not edit by hand."
pub fn tls_runtime() -> Text {
let lines = [
"// ---------------------------------------------------------------------------",
"// Tessera TLS runtime: TLS 1.3 (RFC 8446) for the HTTP client (`https://` in",
"// `net_request`) and the HTTP server (`serve --tls-cert FILE --tls-key FILE`).",
"// Pasted at top level after web.rs and crypto.rs. Safe Rust and std only.",
"//",
"// Only TLS 1.3: SSL 2/3 and TLS 1.0/1.1 are broken or deprecated (RFC 8996)",
"// and TLS 1.2 is not implemented. Cipher suites TLS_AES_128_GCM_SHA256,",
"// TLS_AES_256_GCM_SHA384 and TLS_CHACHA20_POLY1305_SHA256; key exchange",
"// X25519 or secp256r1; certificates with RSA (PKCS #1 v1.5 and PSS) or ECDSA",
"// P-256/P-384 keys. No session resumption, 0-RTT or client certificates.",
"//",
"// The client checks the server's certificate chain against the system's",
"// trusted certificates (or the PEM file in TESSERA_CA_FILE), its validity",
"// dates, key usage, the host name (subjectAltName only) and DNS/IP name",
"// constraints. There is no switch to turn this off.",
"//",
"//   1. DER and PEM",
"//   2. X.509 certificates and chain validation",
"//   3. Trusted certificates",
"//   4. Record layer and key schedule",
"//   5. Client handshake",
"//   6. Server handshake and configuration",
"//   7. Streams for the HTTP code",
"// ---------------------------------------------------------------------------",
"",
"// ===========================================================================",
"// 1. DER and PEM",
"// ===========================================================================",
"",
"struct TwDer<'a> { data: &'a [u8], pos: usize }",
"",
"impl<'a> TwDer<'a> {",
"    fn new(data: &'a [u8]) -> TwDer<'a> { TwDer { data, pos: 0 } }",
"    fn is_empty(&self) -> bool { self.pos >= self.data.len() }",
"    fn peek_tag(&self) -> Option<u8> { self.data.get(self.pos).copied() }",
"    /// One element: (tag, contents, the whole encoding).",
"    fn read(&mut self) -> Option<(u8, &'a [u8], &'a [u8])> {",
"        let start = self.pos;",
"        let tag = *self.data.get(self.pos)?;",
"        if tag & 0x1f == 0x1f { return None; } // high tag numbers are not used here",
"        let first = *self.data.get(self.pos + 1)? as usize;",
"        let mut p = self.pos + 2;",
"        let len = if first < 0x80 {",
"            first",
"        } else {",
"            let n = first & 0x7f;",
"            if n == 0 || n > 3 { return None; }",
"            let mut l = 0usize;",
"            for _ in 0..n { l = (l << 8) | *self.data.get(p)? as usize; p += 1; }",
"            if l < 0x80 || (n > 1 && l < (1 << (8 * (n - 1)))) { return None; } // not minimal",
"            l",
"        };",
"        let end = p.checked_add(len)?;",
"        if end > self.data.len() { return None; }",
"        self.pos = end;",
"        Some((tag, &self.data[p..end], &self.data[start..end]))",
"    }",
"    fn expect(&mut self, tag: u8) -> Option<&'a [u8]> {",
"        let (t, c, _) = self.read()?;",
"        if t == tag { Some(c) } else { None }",
"    }",
"    /// The next element when it has this tag, else nothing is consumed.",
"    fn optional(&mut self, tag: u8) -> Option<&'a [u8]> {",
"        if self.peek_tag() == Some(tag) { self.expect(tag) } else { None }",
"    }",
"}",
"",
"/// Positive INTEGER contents without sign padding.",
"fn tw_der_uint(c: &[u8]) -> Option<Vec<u8>> {",
"    if c.is_empty() || c[0] & 0x80 != 0 { return None; }",
"    Some(tw_strip_zeros(c).to_vec())",
"}",
"fn tw_der_int_bytes(v: &[u8]) -> Vec<u8> {",
"    let mut b = tw_strip_zeros(v).to_vec();",
"    if b.is_empty() || b[0] & 0x80 != 0 { b.insert(0, 0); }",
"    b",
"}",
"fn tw_der_wrap(tag: u8, content: &[u8]) -> Vec<u8> {",
"    let mut out = vec![tag];",
"    let l = content.len();",
"    if l < 0x80 { out.push(l as u8); } else if l < 0x100 { out.extend_from_slice(&[0x81, l as u8]); } else { out.extend_from_slice(&[0x82, (l >> 8) as u8, l as u8]); }",
"    out.extend_from_slice(content);",
"    out",
"}",
"",
"/// All PEM blocks of a text: (label, DER bytes).",
"fn tw_pem_blocks(text: &str) -> Vec<(String, Vec<u8>)> {",
"    let mut out = Vec::new();",
"    let mut label: Option<String> = None;",
"    let mut body = String::new();",
"    for line in text.lines() {",
"        let line = line.trim();",
"        if let Some(rest) = line.strip_prefix(\"-----BEGIN \") {",
"            label = Some(rest.trim_end_matches('-').to_string());",
"            body.clear();",
"        } else if line.starts_with(\"-----END \") {",
"            if let Some(l) = label.take() {",
"                if let Some(der) = tw_b64_decode_raw(body.as_bytes()) { out.push((l, der)); }",
"            }",
"        } else if label.is_some() {",
"            if line.contains(':') { continue; } // old-style headers (Proc-Type ...)",
"            body.push_str(line);",
"        }",
"    }",
"    out",
"}",
"",
"// ===========================================================================",
"// 2. X.509 certificates and chain validation (RFC 5280)",
"// ===========================================================================",
"",
"const TW_OID_RSA: &[u8] = &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01];",
"const TW_OID_RSA_PSS: &[u8] = &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0a];",
"const TW_OID_RSA_SHA256: &[u8] = &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0b];",
"const TW_OID_RSA_SHA384: &[u8] = &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0c];",
"const TW_OID_RSA_SHA512: &[u8] = &[0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0d];",
"const TW_OID_EC: &[u8] = &[0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01];",
"const TW_OID_P256: &[u8] = &[0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07];",
"const TW_OID_P384: &[u8] = &[0x2b, 0x81, 0x04, 0x00, 0x22];",
"const TW_OID_ECDSA_SHA256: &[u8] = &[0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x02];",
"const TW_OID_ECDSA_SHA384: &[u8] = &[0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x03];",
"const TW_OID_ECDSA_SHA512: &[u8] = &[0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x04];",
"const TW_OID_SHA256: &[u8] = &[0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01];",
"const TW_OID_SHA384: &[u8] = &[0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02];",
"const TW_OID_SHA512: &[u8] = &[0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03];",
"const TW_OID_BASIC_CONSTRAINTS: &[u8] = &[0x55, 0x1d, 0x13];",
"const TW_OID_KEY_USAGE: &[u8] = &[0x55, 0x1d, 0x0f];",
"const TW_OID_SAN: &[u8] = &[0x55, 0x1d, 0x11];",
"const TW_OID_EKU: &[u8] = &[0x55, 0x1d, 0x25];",
"const TW_OID_NAME_CONSTRAINTS: &[u8] = &[0x55, 0x1d, 0x1e];",
"const TW_OID_CERT_POLICIES: &[u8] = &[0x55, 0x1d, 0x20];",
"const TW_OID_EKU_SERVER: &[u8] = &[0x2b, 0x06, 0x01, 0x05, 0x05, 0x07, 0x03, 0x01];",
"const TW_OID_EKU_ANY: &[u8] = &[0x55, 0x1d, 0x25, 0x00];",
"",
"#[derive(Clone, Copy, PartialEq, Debug)]",
"enum TwCurveId { P256, P384 }",
"fn tw_curve(id: TwCurveId) -> &'static TwCurve { match id { TwCurveId::P256 => tw_p256(), TwCurveId::P384 => tw_p384() } }",
"",
"#[derive(Clone, Debug, PartialEq)]",
"enum TwPubKey { Rsa { n: Vec<u8>, e: Vec<u8> }, Ec { curve: TwCurveId, point: Vec<u8> }, Unsupported }",
"",
"#[derive(Clone, Copy, PartialEq, Debug)]",
"enum TwSigAlg { RsaPkcs1(TwHashAlg), RsaPss(TwHashAlg), Ecdsa(TwHashAlg), Unsupported }",
"",
"#[derive(Clone, Debug)]",
"struct TwCert {",
"    raw: Vec<u8>,",
"    tbs: Vec<u8>,",
"    sig_alg: TwSigAlg,",
"    signature: Vec<u8>,",
"    issuer: Vec<u8>,",
"    subject: Vec<u8>,",
"    not_before: i64,",
"    not_after: i64,",
"    key: TwPubKey,",
"    is_ca: bool,",
"    path_len: Option<u64>,",
"    key_usage: Option<u16>,",
"    /// None when the certificate has no extended key usage.",
"    server_auth: Option<bool>,",
"    dns_names: Vec<String>,",
"    ip_addrs: Vec<Vec<u8>>,",
"    /// Name constraints: (permitted, excluded); each a list of DNS names or IP (address, mask) pairs.",
"    constraints: Option<(Vec<TwNameRule>, Vec<TwNameRule>)>,",
"    unknown_critical: bool,",
"}",
"",
"#[derive(Clone, Debug)]",
"enum TwNameRule { Dns(String), Ip(Vec<u8>, Vec<u8>), Other }",
"",
"fn tw_parse_sig_alg(c: &[u8]) -> TwSigAlg {",
"    let mut d = TwDer::new(c);",
"    let oid = match d.expect(0x06) { Some(o) => o, None => return TwSigAlg::Unsupported };",
"    let hash_of = |o: &[u8]| if o == TW_OID_SHA256 { Some(TwHashAlg::Sha256) } else if o == TW_OID_SHA384 { Some(TwHashAlg::Sha384) } else if o == TW_OID_SHA512 { Some(TwHashAlg::Sha512) } else { None };",
"    if oid == TW_OID_RSA_SHA256 { TwSigAlg::RsaPkcs1(TwHashAlg::Sha256) }",
"    else if oid == TW_OID_RSA_SHA384 { TwSigAlg::RsaPkcs1(TwHashAlg::Sha384) }",
"    else if oid == TW_OID_RSA_SHA512 { TwSigAlg::RsaPkcs1(TwHashAlg::Sha512) }",
"    else if oid == TW_OID_ECDSA_SHA256 { TwSigAlg::Ecdsa(TwHashAlg::Sha256) }",
"    else if oid == TW_OID_ECDSA_SHA384 { TwSigAlg::Ecdsa(TwHashAlg::Sha384) }",
"    else if oid == TW_OID_ECDSA_SHA512 { TwSigAlg::Ecdsa(TwHashAlg::Sha512) }",
"    else if oid == TW_OID_RSA_PSS {",
"        // RSASSA-PSS-params: hash [0], MGF [1] (assumed MGF1 with the same hash), salt length [2]",
"        let params = match d.expect(0x30) { Some(p) => p, None => return TwSigAlg::Unsupported };",
"        let mut p = TwDer::new(params);",
"        let mut hash = None;",
"        let mut salt = 20u64;",
"        while let Some((tag, content, _)) = p.read() {",
"            match tag {",
"                0xa0 => { let mut h = TwDer::new(content); hash = h.expect(0x30).and_then(|a| TwDer::new(a).expect(0x06)).and_then(hash_of); }",
"                0xa2 => { salt = TwDer::new(content).expect(0x02).map(|v| v.iter().fold(0u64, |a, b| (a << 8) | *b as u64)).unwrap_or(0); }",
"                _ => {}",
"            }",
"        }",
"        match hash { Some(h) if salt == h.len() as u64 => TwSigAlg::RsaPss(h), _ => TwSigAlg::Unsupported }",
"    } else { TwSigAlg::Unsupported }",
"}",
"",
"fn tw_parse_spki(c: &[u8]) -> Option<TwPubKey> {",
"    let mut d = TwDer::new(c);",
"    let alg = d.expect(0x30)?;",
"    let bits = d.expect(0x03)?;",
"    if bits.first() != Some(&0) { return None; }",
"    let key = &bits[1..];",
"    let mut a = TwDer::new(alg);",
"    let oid = a.expect(0x06)?;",
"    if oid == TW_OID_RSA {",
"        let mut k = TwDer::new(TwDer::new(key).expect(0x30)?);",
"        let n = tw_der_uint(k.expect(0x02)?)?;",
"        let e = tw_der_uint(k.expect(0x02)?)?;",
"        Some(TwPubKey::Rsa { n, e })",
"    } else if oid == TW_OID_EC {",
"        let curve = a.expect(0x06)?;",
"        let id = if curve == TW_OID_P256 { TwCurveId::P256 } else if curve == TW_OID_P384 { TwCurveId::P384 } else { return Some(TwPubKey::Unsupported) };",
"        Some(TwPubKey::Ec { curve: id, point: key.to_vec() })",
"    } else {",
"        Some(TwPubKey::Unsupported)",
"    }",
"}",
"",
"/// UTCTime or GeneralizedTime to milliseconds since 1970.",
"fn tw_parse_x509_time(tag: u8, c: &[u8]) -> Option<i64> {",
"    let s = std::str::from_utf8(c).ok()?;",
"    if !s.ends_with('Z') || !s[..s.len() - 1].bytes().all(|b| b.is_ascii_digit()) { return None; }",
"    let (year, rest) = match (tag, s.len()) {",
"        (0x17, 13) => { let y: i64 = s[..2].parse().ok()?; (if y < 50 { 2000 + y } else { 1900 + y }, &s[2..]) }",
"        (0x18, 15) => (s[..4].parse().ok()?, &s[4..]),",
"        _ => return None,",
"    };",
"    let n = |i: usize| -> Option<i64> { rest[i..i + 2].parse().ok() };",
"    let (mo, d, h, mi, se) = (n(0)?, n(2)?, n(4)?, n(6)?, n(8)?);",
"    if !(1..=12).contains(&mo) || d < 1 || d > tw_days_in_month(year, mo) || h > 23 || mi > 59 || se > 60 { return None; }",
"    Some(((tw_days_from_civil(year, mo, d) * 24 + h) * 60 + mi) * 60_000 + se * 1000)",
"}",
"",
"fn tw_parse_general_names(c: &[u8], cert: &mut TwCert) -> Option<()> {",
"    let mut d = TwDer::new(c);",
"    while !d.is_empty() {",
"        let (tag, v, _) = d.read()?;",
"        match tag {",
"            0x82 => cert.dns_names.push(std::str::from_utf8(v).ok()?.to_ascii_lowercase()),",
"            0x87 => cert.ip_addrs.push(v.to_vec()),",
"            _ => {}",
"        }",
"    }",
"    Some(())",
"}",
"",
"fn tw_parse_name_rules(c: &[u8]) -> Option<Vec<TwNameRule>> {",
"    let mut out = Vec::new();",
"    let mut d = TwDer::new(c);",
"    while !d.is_empty() {",
"        let subtree = d.expect(0x30)?;",
"        let mut s = TwDer::new(subtree);",
"        let (tag, v, _) = s.read()?;",
"        if !s.is_empty() { out.push(TwNameRule::Other); continue; } // minimum/maximum are not used in practice",
"        out.push(match tag {",
"            0x82 => TwNameRule::Dns(std::str::from_utf8(v).ok()?.to_ascii_lowercase()),",
"            0x87 if v.len() == 8 || v.len() == 32 => TwNameRule::Ip(v[..v.len() / 2].to_vec(), v[v.len() / 2..].to_vec()),",
"            _ => TwNameRule::Other,",
"        });",
"    }",
"    Some(out)",
"}",
"",
"fn tw_parse_cert(raw: &[u8]) -> Option<TwCert> {",
"    let mut outer = TwDer::new(raw);",
"    let body = outer.expect(0x30)?;",
"    if !outer.is_empty() { return None; }",
"    let mut c = TwDer::new(body);",
"    let (tbs_tag, tbs_content, tbs_raw) = c.read()?;",
"    if tbs_tag != 0x30 { return None; }",
"    let sig_alg = tw_parse_sig_alg(c.expect(0x30)?);",
"    let sig_bits = c.expect(0x03)?;",
"    if sig_bits.first() != Some(&0) { return None; }",
"    let mut t = TwDer::new(tbs_content);",
"    let version = match t.optional(0xa0) { Some(v) => *TwDer::new(v).expect(0x02)?.last()?, None => 0 };",
"    t.expect(0x02)?; // serial",
"    t.expect(0x30)?; // signature algorithm (repeated)",
"    let (it, _, issuer) = t.read()?;",
"    let validity = t.expect(0x30)?;",
"    let (st, _, subject) = t.read()?;",
"    let (pt, spki, _) = t.read()?;",
"    if it != 0x30 || st != 0x30 || pt != 0x30 { return None; }",
"    let mut v = TwDer::new(validity);",
"    let (nbt, nb, _) = v.read()?;",
"    let (nat, na, _) = v.read()?;",
"    let mut cert = TwCert {",
"        raw: raw.to_vec(), tbs: tbs_raw.to_vec(), sig_alg, signature: sig_bits[1..].to_vec(),",
"        issuer: issuer.to_vec(), subject: subject.to_vec(),",
"        not_before: tw_parse_x509_time(nbt, nb)?, not_after: tw_parse_x509_time(nat, na)?,",
"        key: tw_parse_spki(spki)?, is_ca: false, path_len: None, key_usage: None, server_auth: None,",
"        dns_names: Vec::new(), ip_addrs: Vec::new(), constraints: None, unknown_critical: false,",
"    };",
"    t.optional(0x81); // issuerUniqueID",
"    t.optional(0x82); // subjectUniqueID",
"    if let Some(ext_wrap) = t.optional(0xa3) {",
"        if version != 2 { return None; }",
"        let mut exts = TwDer::new(TwDer::new(ext_wrap).expect(0x30)?);",
"        while !exts.is_empty() {",
"            let mut e = TwDer::new(exts.expect(0x30)?);",
"            let oid = e.expect(0x06)?;",
"            let critical = match e.optional(0x01) { Some(b) => b == [0xff], None => false };",
"            let value = e.expect(0x04)?;",
"            if oid == TW_OID_BASIC_CONSTRAINTS {",
"                let mut b = TwDer::new(TwDer::new(value).expect(0x30)?);",
"                if let Some(ca) = b.optional(0x01) { cert.is_ca = ca == [0xff]; }",
"                if let Some(pl) = b.optional(0x02) { cert.path_len = Some(pl.iter().fold(0u64, |a, x| (a << 8) | *x as u64)); }",
"            } else if oid == TW_OID_KEY_USAGE {",
"                let bits = TwDer::new(value).expect(0x03)?;",
"                let b0 = *bits.get(1).unwrap_or(&0) as u16;",
"                let b1 = *bits.get(2).unwrap_or(&0) as u16;",
"                cert.key_usage = Some((b0 << 8) | b1);",
"            } else if oid == TW_OID_SAN {",
"                tw_parse_general_names(TwDer::new(value).expect(0x30)?, &mut cert)?;",
"            } else if oid == TW_OID_EKU {",
"                let mut k = TwDer::new(TwDer::new(value).expect(0x30)?);",
"                let mut ok = false;",
"                while !k.is_empty() { let o = k.expect(0x06)?; if o == TW_OID_EKU_SERVER || o == TW_OID_EKU_ANY { ok = true; } }",
"                cert.server_auth = Some(ok);",
"            } else if oid == TW_OID_NAME_CONSTRAINTS {",
"                let mut n = TwDer::new(TwDer::new(value).expect(0x30)?);",
"                let permitted = match n.optional(0xa0) { Some(p) => tw_parse_name_rules(p)?, None => Vec::new() };",
"                let excluded = match n.optional(0xa1) { Some(x) => tw_parse_name_rules(x)?, None => Vec::new() };",
"                cert.constraints = Some((permitted, excluded));",
"            } else if oid == TW_OID_CERT_POLICIES {",
"                // policies are not evaluated (no policy is required), which RFC 5280 allows",
"            } else if critical {",
"                cert.unknown_critical = true;",
"            }",
"        }",
"    }",
"    Some(cert)",
"}",
"",
"/// ECDSA-Sig-Value (DER) to (r, s).",
"fn tw_ecdsa_der_decode(sig: &[u8]) -> Option<(Vec<u8>, Vec<u8>)> {",
"    let mut d = TwDer::new(sig);",
"    let body = d.expect(0x30)?;",
"    if !d.is_empty() { return None; }",
"    let mut b = TwDer::new(body);",
"    let r = tw_der_uint(b.expect(0x02)?)?;",
"    let s = tw_der_uint(b.expect(0x02)?)?;",
"    if !b.is_empty() { return None; }",
"    Some((r, s))",
"}",
"fn tw_ecdsa_der_encode(r: &[u8], s: &[u8]) -> Vec<u8> {",
"    let mut body = tw_der_wrap(0x02, &tw_der_int_bytes(r));",
"    body.extend_from_slice(&tw_der_wrap(0x02, &tw_der_int_bytes(s)));",
"    tw_der_wrap(0x30, &body)",
"}",
"",
"fn tw_verify_signature(key: &TwPubKey, alg: TwSigAlg, message: &[u8], sig: &[u8]) -> bool {",
"    match (key, alg) {",
"        (TwPubKey::Rsa { n, e }, TwSigAlg::RsaPkcs1(h)) => tw_rsa_mod_bits(n) >= 2048 && tw_rsa_verify_pkcs1(n, e, h, message, sig),",
"        (TwPubKey::Rsa { n, e }, TwSigAlg::RsaPss(h)) => tw_rsa_mod_bits(n) >= 2048 && tw_rsa_verify_pss(n, e, h, message, sig),",
"        (TwPubKey::Ec { curve, point }, TwSigAlg::Ecdsa(h)) => match tw_ecdsa_der_decode(sig) {",
"            Some((r, s)) => tw_curve(*curve).verify(point, &tw_hash(h, message), &r, &s),",
"            None => false,",
"        },",
"        _ => false,",
"    }",
"}",
"",
"fn tw_dns_matches(pattern: &str, host: &str) -> bool {",
"    let pattern = pattern.trim_end_matches('.');",
"    if let Some(suffix) = pattern.strip_prefix(\"*.\") {",
"        if !suffix.contains('.') || suffix.contains('*') { return false; }",
"        match host.find('.') { Some(p) => p > 0 && &host[p + 1..] == suffix, None => false }",
"    } else {",
"        !pattern.contains('*') && pattern == host",
"    }",
"}",
"",
"fn tw_host_ip(host: &str) -> Option<Vec<u8>> {",
"    match host.parse::<std::net::IpAddr>().ok()? {",
"        std::net::IpAddr::V4(a) => Some(a.octets().to_vec()),",
"        std::net::IpAddr::V6(a) => Some(a.octets().to_vec()),",
"    }",
"}",
"",
"/// Is `name` inside the DNS subtree `rule` (\"example.com\" covers the name and its subdomains; \".example.com\" only subdomains)?",
"fn tw_dns_in_subtree(name: &str, rule: &str) -> bool {",
"    let name = name.trim_start_matches(\"*.\");",
"    if rule.is_empty() { return true; }",
"    if let Some(r) = rule.strip_prefix('.') { return name.ends_with(&format!(\".{}\", r)); }",
"    name == rule || name.ends_with(&format!(\".{}\", rule))",
"}",
"",
"fn tw_check_constraints(ca: &TwCert, leaf: &TwCert) -> Result<(), String> {",
"    let (permitted, excluded) = match &ca.constraints { Some(c) => c, None => return Ok(()) };",
"    if permitted.iter().chain(excluded.iter()).any(|r| matches!(r, TwNameRule::Other)) {",
"        return Err(\"a CA certificate has name constraints of a kind that is not supported\".to_string());",
"    }",
"    let ip_in = |ip: &[u8], net: &[u8], mask: &[u8]| ip.len() == net.len() && ip.iter().zip(net.iter()).zip(mask.iter()).all(|((a, n), m)| a & m == n & m);",
"    for name in &leaf.dns_names {",
"        if excluded.iter().any(|r| matches!(r, TwNameRule::Dns(d) if tw_dns_in_subtree(name, d))) { return Err(format!(\"the name {} is excluded by a CA's name constraints\", name)); }",
"        let rules: Vec<&String> = permitted.iter().filter_map(|r| if let TwNameRule::Dns(d) = r { Some(d) } else { None }).collect();",
"        if !rules.is_empty() && !rules.iter().any(|d| tw_dns_in_subtree(name, d)) { return Err(format!(\"the name {} is outside a CA's name constraints\", name)); }",
"    }",
"    for ip in &leaf.ip_addrs {",
"        if excluded.iter().any(|r| matches!(r, TwNameRule::Ip(n, m) if ip_in(ip, n, m))) { return Err(\"an IP address is excluded by a CA's name constraints\".to_string()); }",
"        let rules: Vec<(&Vec<u8>, &Vec<u8>)> = permitted.iter().filter_map(|r| if let TwNameRule::Ip(n, m) = r { Some((n, m)) } else { None }).collect();",
"        if !rules.is_empty() && !rules.iter().any(|(n, m)| ip_in(ip, n, m)) { return Err(\"an IP address is outside a CA's name constraints\".to_string()); }",
"    }",
"    Ok(())",
"}",
"",
"const TW_KU_DIGITAL_SIGNATURE: u16 = 0x8000;",
"const TW_KU_KEY_CERT_SIGN: u16 = 0x0400;",
"",
"fn tw_check_validity(cert: &TwCert, now: i64, what: &str) -> Result<(), String> {",
"    if now < cert.not_before { return Err(format!(\"the {} certificate is not valid yet (from {})\", what, tw_format_time(cert.not_before))); }",
"    if now > cert.not_after { return Err(format!(\"the {} certificate has expired (on {})\", what, tw_format_time(cert.not_after))); }",
"    if cert.unknown_critical { return Err(format!(\"the {} certificate has a critical extension that is not supported\", what)); }",
"    if cert.server_auth == Some(false) { return Err(format!(\"the {} certificate is not meant for TLS servers (extended key usage)\", what)); }",
"    Ok(())",
"}",
"",
"/// Checks the chain the server sent (leaf first) for `host` against `anchors`.",
"fn tw_verify_chain(chain: &[Vec<u8>], host: &str, anchors: &[TwCert], now: i64) -> Result<(), String> {",
"    let first = chain.first().ok_or_else(|| \"the server sent no certificate\".to_string())?;",
"    let leaf = tw_parse_cert(first).ok_or_else(|| \"the server certificate cannot be read\".to_string())?;",
"    tw_check_validity(&leaf, now, \"server\")?;",
"    if let Some(ku) = leaf.key_usage { if ku & TW_KU_DIGITAL_SIGNATURE == 0 { return Err(\"the server certificate may not be used for signatures (key usage)\".to_string()); } }",
"    let host = host.trim_end_matches('.').to_ascii_lowercase();",
"    let name_ok = match tw_host_ip(&host) {",
"        Some(ip) => leaf.ip_addrs.iter().any(|a| *a == ip),",
"        None => leaf.dns_names.iter().any(|p| tw_dns_matches(p, &host)),",
"    };",
"    if !name_ok {",
"        let names: Vec<String> = leaf.dns_names.iter().cloned().chain(leaf.ip_addrs.iter().filter_map(|a| match a.len() {",
"            4 => Some(std::net::Ipv4Addr::new(a[0], a[1], a[2], a[3]).to_string()),",
"            16 => { let mut b = [0u8; 16]; b.copy_from_slice(a); Some(std::net::Ipv6Addr::from(b).to_string()) }",
"            _ => None,",
"        })).collect();",
"        return Err(format!(\"the server certificate is not valid for {} (it names: {})\", host, if names.is_empty() { \"nothing\".to_string() } else { names.join(\", \") }));",
"    }",
"    if anchors.iter().any(|a| a.raw == leaf.raw) { return Ok(()); }",
"    let intermediates: Vec<TwCert> = chain[1..].iter().filter_map(|c| tw_parse_cert(c)).collect();",
"    let mut last_err = \"the server certificate was not issued by a trusted certificate authority\".to_string();",
"    if tw_build_path(&leaf, &leaf, &intermediates, anchors, now, 0, &mut last_err) { Ok(()) } else { Err(last_err) }",
"}",
"",
"fn tw_issuer_ok(ca: &TwCert, child: &TwCert, leaf: &TwCert, depth: usize, now: i64, is_anchor: bool) -> Result<(), String> {",
"    if !is_anchor {",
"        tw_check_validity(ca, now, \"intermediate\")?;",
"        if !ca.is_ca { return Err(\"an intermediate certificate is not a CA certificate\".to_string()); }",
"    } else if now > ca.not_after || now < ca.not_before {",
"        return Err(\"the trusted root certificate is outside its validity period\".to_string());",
"    }",
"    if let Some(ku) = ca.key_usage { if ku & TW_KU_KEY_CERT_SIGN == 0 { return Err(\"a CA certificate may not sign certificates (key usage)\".to_string()); } }",
"    if let Some(pl) = ca.path_len { if (depth as u64) > pl { return Err(\"the certificate chain is longer than a CA allows (path length)\".to_string()); } }",
"    if child.sig_alg == TwSigAlg::Unsupported { return Err(\"a certificate uses a signature algorithm that is not supported\".to_string()); }",
"    if !tw_verify_signature(&ca.key, child.sig_alg, &child.tbs, &child.signature) { return Err(\"a certificate signature is invalid\".to_string()); }",
"    tw_check_constraints(ca, leaf)",
"}",
"",
"/// Depth-first search from `child` up to a trust anchor; `depth` counts the CA certificates below.",
"fn tw_build_path(child: &TwCert, leaf: &TwCert, intermediates: &[TwCert], anchors: &[TwCert], now: i64, depth: usize, err: &mut String) -> bool {",
"    if depth > 8 { *err = \"the certificate chain is too long\".to_string(); return false; }",
"    for a in anchors.iter().filter(|a| a.subject == child.issuer) {",
"        match tw_issuer_ok(a, child, leaf, depth, now, true) { Ok(()) => return true, Err(e) => *err = e }",
"    }",
"    for c in intermediates.iter().filter(|c| c.subject == child.issuer && c.raw != child.raw) {",
"        match tw_issuer_ok(c, child, leaf, depth, now, false) {",
"            Ok(()) => { if tw_build_path(c, leaf, intermediates, anchors, now, depth + 1, err) { return true; } }",
"            Err(e) => *err = e,",
"        }",
"    }",
"    false",
"}",
"",
"// ===========================================================================",
"// 3. Trusted certificates",
"// ===========================================================================",
"",
"static TW_TRUST: std::sync::OnceLock<Result<Vec<TwCert>, String>> = std::sync::OnceLock::new();",
"",
"fn tw_certs_from_pem(text: &str) -> Vec<TwCert> {",
"    tw_pem_blocks(text).into_iter().filter(|(l, _)| l == \"CERTIFICATE\" || l == \"TRUSTED CERTIFICATE\").filter_map(|(_, der)| tw_parse_cert(&der)).collect()",
"}",
"",
"#[cfg(windows)]",
"fn tw_system_roots() -> Result<Vec<TwCert>, String> {",
"    // The Windows certificate store is reachable only through CryptoAPI (FFI,",
"    // which generated code may not use), so PowerShell exports it.",
"    let script = \"$ErrorActionPreference='SilentlyContinue'; foreach ($s in 'Cert:\\\\LocalMachine\\\\Root','Cert:\\\\LocalMachine\\\\AuthRoot','Cert:\\\\CurrentUser\\\\Root') { Get-ChildItem $s | ForEach-Object { [Convert]::ToBase64String($_.RawData) } }\";",
"    let out = std::process::Command::new(\"powershell\").args([\"-NoProfile\", \"-NonInteractive\", \"-Command\", script]).output()",
"        .map_err(|e| format!(\"cannot read the Windows certificate store through PowerShell: {}\", e))?;",
"    let certs: Vec<TwCert> = String::from_utf8_lossy(&out.stdout).lines()",
"        .filter_map(|l| tw_b64_decode_raw(l.trim().as_bytes())).filter_map(|der| tw_parse_cert(&der)).collect();",
"    if certs.is_empty() { return Err(\"the Windows certificate store has no usable root certificates; set TESSERA_CA_FILE to a PEM file\".to_string()); }",
"    Ok(certs)",
"}",
"",
"#[cfg(not(windows))]",
"fn tw_system_roots() -> Result<Vec<TwCert>, String> {",
"    let mut paths: Vec<String> = Vec::new();",
"    if let Ok(p) = std::env::var(\"SSL_CERT_FILE\") { if !p.is_empty() { paths.push(p); } }",
"    for p in [\"/etc/ssl/certs/ca-certificates.crt\", \"/etc/pki/tls/certs/ca-bundle.crt\", \"/etc/ssl/ca-bundle.pem\", \"/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem\", \"/etc/ssl/cert.pem\", \"/usr/local/etc/openssl/cert.pem\", \"/opt/homebrew/etc/openssl@3/cert.pem\"] {",
"        paths.push(p.to_string());",
"    }",
"    for p in &paths {",
"        if let Ok(text) = std::fs::read_to_string(p) {",
"            let certs = tw_certs_from_pem(&text);",
"            if !certs.is_empty() { return Ok(certs); }",
"        }",
"    }",
"    Err(\"no trusted certificates found (looked for the system CA bundle); set TESSERA_CA_FILE to a PEM file\".to_string())",
"}",
"",
"/// The trust anchors: TESSERA_CA_FILE when set (instead of the system's), else the system's. Loaded once.",
"fn tw_trust_anchors() -> Result<&'static Vec<TwCert>, String> {",
"    TW_TRUST.get_or_init(|| {",
"        match std::env::var(\"TESSERA_CA_FILE\") {",
"            Ok(p) if !p.is_empty() => {",
"                let text = std::fs::read_to_string(&p).map_err(|e| format!(\"cannot read TESSERA_CA_FILE {}: {}\", p, e))?;",
"                let certs = tw_certs_from_pem(&text);",
"                if certs.is_empty() { Err(format!(\"TESSERA_CA_FILE {} holds no certificates\", p)) } else { Ok(certs) }",
"            }",
"            _ => tw_system_roots(),",
"        }",
"    }).as_ref().map_err(|e| e.clone())",
"}",
"",
"// ===========================================================================",
"// 4. Record layer and key schedule",
"// ===========================================================================",
"",
"const TW_CT_CCS: u8 = 20;",
"const TW_CT_ALERT: u8 = 21;",
"const TW_CT_HANDSHAKE: u8 = 22;",
"const TW_CT_APP: u8 = 23;",
"",
"const TW_HS_CLIENT_HELLO: u8 = 1;",
"const TW_HS_SERVER_HELLO: u8 = 2;",
"const TW_HS_NEW_SESSION_TICKET: u8 = 4;",
"const TW_HS_ENCRYPTED_EXTENSIONS: u8 = 8;",
"const TW_HS_CERTIFICATE: u8 = 11;",
"const TW_HS_CERTIFICATE_REQUEST: u8 = 13;",
"const TW_HS_CERTIFICATE_VERIFY: u8 = 15;",
"const TW_HS_FINISHED: u8 = 20;",
"const TW_HS_KEY_UPDATE: u8 = 24;",
"",
"const TW_SUITE_AES128: u16 = 0x1301;",
"const TW_SUITE_AES256: u16 = 0x1302;",
"const TW_SUITE_CHACHA: u16 = 0x1303;",
"const TW_GROUP_X25519: u16 = 0x001d;",
"const TW_GROUP_P256: u16 = 0x0017;",
"",
"const TW_SIG_ECDSA_P256: u16 = 0x0403;",
"const TW_SIG_ECDSA_P384: u16 = 0x0503;",
"const TW_SIG_PSS_256: u16 = 0x0804;",
"const TW_SIG_PSS_384: u16 = 0x0805;",
"const TW_SIG_PSS_512: u16 = 0x0806;",
"const TW_SIG_PKCS1_256: u16 = 0x0401;",
"const TW_SIG_PKCS1_384: u16 = 0x0501;",
"const TW_SIG_PKCS1_512: u16 = 0x0601;",
"",
"const TW_ALERT_CLOSE_NOTIFY: u8 = 0;",
"const TW_ALERT_UNEXPECTED_MESSAGE: u8 = 10;",
"const TW_ALERT_BAD_RECORD_MAC: u8 = 20;",
"const TW_ALERT_HANDSHAKE_FAILURE: u8 = 40;",
"const TW_ALERT_BAD_CERTIFICATE: u8 = 42;",
"const TW_ALERT_ILLEGAL_PARAMETER: u8 = 47;",
"const TW_ALERT_UNKNOWN_CA: u8 = 48;",
"const TW_ALERT_DECODE_ERROR: u8 = 50;",
"const TW_ALERT_DECRYPT_ERROR: u8 = 51;",
"const TW_ALERT_PROTOCOL_VERSION: u8 = 70;",
"const TW_ALERT_INTERNAL_ERROR: u8 = 80;",
"const TW_ALERT_MISSING_EXTENSION: u8 = 109;",
"const TW_ALERT_NO_APPLICATION_PROTOCOL: u8 = 120;",
"",
"const TW_HRR_RANDOM: [u8; 32] = [",
"    0xcf, 0x21, 0xad, 0x74, 0xe5, 0x9a, 0x61, 0x11, 0xbe, 0x1d, 0x8c, 0x02, 0x1e, 0x65, 0xb8, 0x91,",
"    0xc2, 0xa2, 0x11, 0x16, 0x7a, 0xbb, 0x8c, 0x5e, 0x07, 0x9e, 0x09, 0xe2, 0xc8, 0xa8, 0x33, 0x9c,",
"];",
"",
"fn tw_alert_name(code: u8) -> &'static str {",
"    match code {",
"        0 => \"close_notify\", 10 => \"unexpected_message\", 20 => \"bad_record_mac\", 22 => \"record_overflow\",",
"        40 => \"handshake_failure\", 42 => \"bad_certificate\", 43 => \"unsupported_certificate\", 44 => \"certificate_revoked\",",
"        45 => \"certificate_expired\", 46 => \"certificate_unknown\", 47 => \"illegal_parameter\", 48 => \"unknown_ca\",",
"        49 => \"access_denied\", 50 => \"decode_error\", 51 => \"decrypt_error\", 70 => \"protocol_version\",",
"        71 => \"insufficient_security\", 80 => \"internal_error\", 86 => \"inappropriate_fallback\", 90 => \"user_canceled\",",
"        109 => \"missing_extension\", 110 => \"unsupported_extension\", 112 => \"unrecognized_name\", 116 => \"certificate_required\",",
"        120 => \"no_application_protocol\", _ => \"unknown alert\",",
"    }",
"}",
"",
"fn tw_suite_hash(suite: u16) -> TwHashAlg { if suite == TW_SUITE_AES256 { TwHashAlg::Sha384 } else { TwHashAlg::Sha256 } }",
"",
"#[derive(Clone)]",
"enum TwAead { Aes(TwAesGcm), ChaCha(Vec<u8>) }",
"",
"#[derive(Clone)]",
"struct TwKeys { aead: TwAead, iv: [u8; 12], seq: u64 }",
"",
"fn tw_expand_label(alg: TwHashAlg, secret: &[u8], label: &str, context: &[u8], len: usize) -> Vec<u8> {",
"    let full = format!(\"tls13 {}\", label);",
"    let mut info = Vec::with_capacity(4 + full.len() + context.len());",
"    info.extend_from_slice(&(len as u16).to_be_bytes());",
"    info.push(full.len() as u8);",
"    info.extend_from_slice(full.as_bytes());",
"    info.push(context.len() as u8);",
"    info.extend_from_slice(context);",
"    tw_hkdf_expand(alg, secret, &info, len)",
"}",
"",
"fn tw_traffic_keys(suite: u16, secret: &[u8]) -> TwKeys {",
"    let alg = tw_suite_hash(suite);",
"    let key_len = if suite == TW_SUITE_AES128 { 16 } else { 32 };",
"    let key = tw_expand_label(alg, secret, \"key\", &[], key_len);",
"    let ivv = tw_expand_label(alg, secret, \"iv\", &[], 12);",
"    let mut iv = [0u8; 12];",
"    iv.copy_from_slice(&ivv);",
"    let aead = if suite == TW_SUITE_CHACHA { TwAead::ChaCha(key) } else { TwAead::Aes(TwAesGcm::new(&key)) };",
"    TwKeys { aead, iv, seq: 0 }",
"}",
"",
"impl TwKeys {",
"    fn nonce(&self) -> [u8; 12] {",
"        let mut n = self.iv;",
"        for (i, b) in self.seq.to_be_bytes().iter().enumerate() { n[4 + i] ^= b; }",
"        n",
"    }",
"    fn seal(&mut self, aad: &[u8], pt: &[u8]) -> Vec<u8> {",
"        let n = self.nonce();",
"        self.seq += 1;",
"        match &self.aead { TwAead::Aes(g) => g.seal(&n, aad, pt), TwAead::ChaCha(k) => tw_chacha20_poly1305_seal(k, &n, aad, pt) }",
"    }",
"    fn open(&mut self, aad: &[u8], ct: &[u8]) -> Option<Vec<u8>> {",
"        let n = self.nonce();",
"        self.seq += 1;",
"        match &self.aead { TwAead::Aes(g) => g.open(&n, aad, ct), TwAead::ChaCha(k) => tw_chacha20_poly1305_open(k, &n, aad, ct) }",
"    }",
"}",
"",
"/// A TLS 1.3 connection over a TCP stream, after or during the handshake.",
"struct TwTls {",
"    sock: std::net::TcpStream,",
"    suite: u16,",
"    read_keys: Option<TwKeys>,",
"    write_keys: Option<TwKeys>,",
"    read_secret: Vec<u8>,",
"    write_secret: Vec<u8>,",
"    raw: Vec<u8>,",
"    hs: Vec<u8>,",
"    app: Vec<u8>,",
"    app_pos: usize,",
"    peer_closed: bool,",
"    sent_close: bool,",
"    transcript: Vec<u8>,",
"    handshake_done: bool,",
"}",
"",
"/// A failure with the alert to send for it.",
"struct TwTlsErr { alert: u8, message: String }",
"fn tw_tls_err(alert: u8, message: impl Into<String>) -> TwTlsErr { TwTlsErr { alert, message: message.into() } }",
"",
"const TW_MAX_HANDSHAKE_MESSAGE: usize = 256 * 1024;",
"",
"impl TwTls {",
"    fn new(sock: std::net::TcpStream) -> TwTls {",
"        TwTls { sock, suite: 0, read_keys: None, write_keys: None, read_secret: Vec::new(), write_secret: Vec::new(), raw: Vec::new(), hs: Vec::new(), app: Vec::new(), app_pos: 0, peer_closed: false, sent_close: false, transcript: Vec::new(), handshake_done: false }",
"    }",
"    fn hash(&self) -> TwHashAlg { tw_suite_hash(self.suite) }",
"    fn transcript_hash(&self) -> Vec<u8> { tw_hash(self.hash(), &self.transcript) }",
"",
"    fn send_raw(&mut self, data: &[u8]) -> Result<(), TwTlsErr> {",
"        self.sock.write_all(data).map_err(|e| tw_tls_err(TW_ALERT_INTERNAL_ERROR, format!(\"cannot send: {}\", e)))",
"    }",
"    fn write_record(&mut self, ctype: u8, data: &[u8]) -> Result<(), TwTlsErr> {",
"        let mut out = Vec::with_capacity(data.len() + 64);",
"        let chunks: Vec<&[u8]> = if data.is_empty() { vec![data] } else { data.chunks(16384).collect() };",
"        for chunk in chunks {",
"            match self.write_keys.as_mut() {",
"                None => {",
"                    out.extend_from_slice(&[ctype, 3, if ctype == TW_CT_HANDSHAKE && chunk.first() == Some(&TW_HS_CLIENT_HELLO) { 1 } else { 3 }]);",
"                    out.extend_from_slice(&(chunk.len() as u16).to_be_bytes());",
"                    out.extend_from_slice(chunk);",
"                }",
"                Some(keys) => {",
"                    let mut inner = chunk.to_vec();",
"                    inner.push(ctype);",
"                    let len = (inner.len() + 16) as u16;",
"                    let header = [TW_CT_APP, 3, 3, (len >> 8) as u8, len as u8];",
"                    out.extend_from_slice(&header);",
"                    out.extend_from_slice(&keys.seal(&header, &inner));",
"                }",
"            }",
"        }",
"        self.send_raw(&out)",
"    }",
"    fn send_handshake(&mut self, msg: &[u8]) -> Result<(), TwTlsErr> {",
"        self.transcript.extend_from_slice(msg);",
"        self.write_record(TW_CT_HANDSHAKE, msg)",
"    }",
"    fn send_alert(&mut self, code: u8) {",
"        if self.sent_close { return; }",
"        self.sent_close = true;",
"        let level = if code == TW_ALERT_CLOSE_NOTIFY { 1 } else { 2 };",
"        let _ = self.write_record(TW_CT_ALERT, &[level, code]);",
"        let _ = self.sock.flush();",
"    }",
"    fn fill(&mut self, need: usize) -> Result<bool, TwTlsErr> {",
"        let mut tmp = [0u8; 16384 + 512];",
"        while self.raw.len() < need {",
"            match self.sock.read(&mut tmp) {",
"                Ok(0) => return Ok(false),",
"                Ok(n) => self.raw.extend_from_slice(&tmp[..n]),",
"                Err(e) if e.kind() == std::io::ErrorKind::Interrupted => continue,",
"                Err(e) => return Err(tw_tls_err(TW_ALERT_INTERNAL_ERROR, format!(\"cannot receive: {}\", e))),",
"            }",
"        }",
"        Ok(true)",
"    }",
"    /// The next record as (content type, plaintext); None at a clean end of the stream.",
"    fn read_record(&mut self) -> Result<Option<(u8, Vec<u8>)>, TwTlsErr> {",
"        loop {",
"            if !self.fill(5)? {",
"                if self.raw.is_empty() { return Ok(None); }",
"                return Err(tw_tls_err(TW_ALERT_DECODE_ERROR, \"the connection was closed in the middle of a record\"));",
"            }",
"            let ctype = self.raw[0];",
"            let len = ((self.raw[3] as usize) << 8) | self.raw[4] as usize;",
"            if self.raw[1] != 3 { return Err(tw_tls_err(TW_ALERT_DECODE_ERROR, \"not a TLS record (is this an https server?)\")); }",
"            if len > 16384 + 256 { return Err(tw_tls_err(22, \"record too long\")); }",
"            if !self.fill(5 + len)? { return Err(tw_tls_err(TW_ALERT_DECODE_ERROR, \"the connection was closed in the middle of a record\")); }",
"            let header: Vec<u8> = self.raw[..5].to_vec();",
"            let body: Vec<u8> = self.raw[5..5 + len].to_vec();",
"            self.raw.drain(..5 + len);",
"            if ctype == TW_CT_CCS {",
"                if self.handshake_done || body != [1] { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"unexpected change_cipher_spec\")); }",
"                continue; // compatibility record, ignored (RFC 8446 section 5)",
"            }",
"            let (ctype, plain) = match self.read_keys.as_mut() {",
"                None => (ctype, body),",
"                Some(keys) => {",
"                    if ctype != TW_CT_APP { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"unencrypted record after the key exchange\")); }",
"                    let mut inner = keys.open(&header, &body).ok_or_else(|| tw_tls_err(TW_ALERT_BAD_RECORD_MAC, \"a record failed authentication (bad_record_mac)\"))?;",
"                    while inner.last() == Some(&0) { inner.pop(); }",
"                    let t = inner.pop().ok_or_else(|| tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"record without content type\"))?;",
"                    if inner.len() > 16384 { return Err(tw_tls_err(22, \"record too long\")); }",
"                    (t, inner)",
"                }",
"            };",
"            if ctype == TW_CT_ALERT {",
"                if plain.len() != 2 { return Err(tw_tls_err(TW_ALERT_DECODE_ERROR, \"malformed alert\")); }",
"                if plain[1] == TW_ALERT_CLOSE_NOTIFY { self.peer_closed = true; return Ok(None); }",
"                self.sent_close = true; // no alert in reply to a fatal one",
"                return Err(tw_tls_err(TW_ALERT_CLOSE_NOTIFY, format!(\"the peer sent the TLS alert {} ({})\", tw_alert_name(plain[1]), plain[1])));",
"            }",
"            if ctype != TW_CT_HANDSHAKE && ctype != TW_CT_APP { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, format!(\"unexpected record type {}\", ctype))); }",
"            if ctype == TW_CT_HANDSHAKE && plain.is_empty() { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"empty handshake record\")); }",
"            return Ok(Some((ctype, plain)));",
"        }",
"    }",
"    /// The next whole handshake message (header included), during the handshake.",
"    fn read_handshake(&mut self) -> Result<Vec<u8>, TwTlsErr> {",
"        loop {",
"            if self.hs.len() >= 4 {",
"                let len = ((self.hs[1] as usize) << 16) | ((self.hs[2] as usize) << 8) | self.hs[3] as usize;",
"                if len > TW_MAX_HANDSHAKE_MESSAGE { return Err(tw_tls_err(TW_ALERT_DECODE_ERROR, \"handshake message too long\")); }",
"                if self.hs.len() >= 4 + len {",
"                    let msg: Vec<u8> = self.hs.drain(..4 + len).collect();",
"                    return Ok(msg);",
"                }",
"            }",
"            match self.read_record()? {",
"                None => return Err(tw_tls_err(TW_ALERT_DECODE_ERROR, \"the connection was closed during the handshake\")),",
"                Some((TW_CT_HANDSHAKE, data)) => self.hs.extend_from_slice(&data),",
"                Some(_) => return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"application data during the handshake\")),",
"            }",
"        }",
"    }",
"    fn expect_handshake(&mut self, kind: u8, what: &str) -> Result<Vec<u8>, TwTlsErr> {",
"        let msg = self.read_handshake()?;",
"        if msg[0] != kind { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, format!(\"expected {}, got handshake message {}\", what, msg[0]))); }",
"        Ok(msg)",
"    }",
"    fn finished_data(&self, base_secret: &[u8]) -> Vec<u8> {",
"        let alg = self.hash();",
"        let key = tw_expand_label(alg, base_secret, \"finished\", &[], alg.len());",
"        tw_hmac(alg, &key, &self.transcript_hash())",
"    }",
"    fn set_read_secret(&mut self, secret: Vec<u8>) { self.read_keys = Some(tw_traffic_keys(self.suite, &secret)); self.read_secret = secret; }",
"    fn set_write_secret(&mut self, secret: Vec<u8>) { self.write_keys = Some(tw_traffic_keys(self.suite, &secret)); self.write_secret = secret; }",
"    fn update_read(&mut self) {",
"        let next = tw_expand_label(self.hash(), &self.read_secret, \"traffic upd\", &[], self.hash().len());",
"        self.set_read_secret(next);",
"    }",
"    fn update_write(&mut self) {",
"        let next = tw_expand_label(self.hash(), &self.write_secret, \"traffic upd\", &[], self.hash().len());",
"        self.set_write_secret(next);",
"    }",
"",
"    /// Application data after the handshake; handles post-handshake messages. 0 at the end.",
"    fn read_app(&mut self, out: &mut [u8]) -> std::io::Result<usize> {",
"        loop {",
"            if self.app_pos < self.app.len() {",
"                let n = out.len().min(self.app.len() - self.app_pos);",
"                out[..n].copy_from_slice(&self.app[self.app_pos..self.app_pos + n]);",
"                self.app_pos += n;",
"                if self.app_pos == self.app.len() { self.app.clear(); self.app_pos = 0; }",
"                return Ok(n);",
"            }",
"            if self.peer_closed { return Ok(0); }",
"            match self.read_record() {",
"                Ok(None) => {",
"                    if self.peer_closed { return Ok(0); }",
"                    // closed without close_notify: possibly a truncation attack",
"                    return Err(std::io::Error::new(std::io::ErrorKind::UnexpectedEof, \"TLS connection closed without close_notify\"));",
"                }",
"                Ok(Some((TW_CT_APP, data))) => { self.app = data; self.app_pos = 0; }",
"                Ok(Some((_, data))) => {",
"                    self.hs.extend_from_slice(&data);",
"                    while self.hs.len() >= 4 {",
"                        let len = ((self.hs[1] as usize) << 16) | ((self.hs[2] as usize) << 8) | self.hs[3] as usize;",
"                        if len > TW_MAX_HANDSHAKE_MESSAGE { self.send_alert(TW_ALERT_DECODE_ERROR); return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, \"TLS message too long\")); }",
"                        if self.hs.len() < 4 + len { break; }",
"                        let msg: Vec<u8> = self.hs.drain(..4 + len).collect();",
"                        match msg[0] {",
"                            TW_HS_NEW_SESSION_TICKET => {} // resumption is not supported",
"                            TW_HS_KEY_UPDATE if len == 1 && msg[4] <= 1 => {",
"                                self.update_read();",
"                                if msg[4] == 1 {",
"                                    if self.write_record(TW_CT_HANDSHAKE, &[TW_HS_KEY_UPDATE, 0, 0, 1, 0]).is_err() { return Err(std::io::Error::new(std::io::ErrorKind::BrokenPipe, \"TLS send failed\")); }",
"                                    self.update_write();",
"                                }",
"                            }",
"                            _ => { self.send_alert(TW_ALERT_UNEXPECTED_MESSAGE); return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, \"unexpected TLS handshake message\")); }",
"                        }",
"                    }",
"                }",
"                Err(e) => {",
"                    let alert = e.alert;",
"                    if alert != TW_ALERT_CLOSE_NOTIFY { self.send_alert(alert); }",
"                    return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, e.message));",
"                }",
"            }",
"        }",
"    }",
"    fn write_app(&mut self, data: &[u8]) -> std::io::Result<usize> {",
"        if data.is_empty() { return Ok(0); }",
"        self.write_record(TW_CT_APP, data).map_err(|e| std::io::Error::new(std::io::ErrorKind::BrokenPipe, e.message))?;",
"        Ok(data.len())",
"    }",
"}",
"",
"/// Handshake message: type, 24-bit length, body.",
"fn tw_hs_msg(kind: u8, body: &[u8]) -> Vec<u8> {",
"    let mut m = vec![kind, (body.len() >> 16) as u8, (body.len() >> 8) as u8, body.len() as u8];",
"    m.extend_from_slice(body);",
"    m",
"}",
"fn tw_put_u16(out: &mut Vec<u8>, v: usize) { out.extend_from_slice(&(v as u16).to_be_bytes()); }",
"fn tw_put_u24(out: &mut Vec<u8>, v: usize) { out.extend_from_slice(&[(v >> 16) as u8, (v >> 8) as u8, v as u8]); }",
"fn tw_ext(out: &mut Vec<u8>, kind: u16, body: &[u8]) { tw_put_u16(out, kind as usize); tw_put_u16(out, body.len()); out.extend_from_slice(body); }",
"",
"/// Reader for handshake message bodies; every failure is a decode_error.",
"struct TwBuf<'a> { d: &'a [u8], p: usize }",
"impl<'a> TwBuf<'a> {",
"    fn new(d: &'a [u8]) -> TwBuf<'a> { TwBuf { d, p: 0 } }",
"    fn err() -> TwTlsErr { tw_tls_err(TW_ALERT_DECODE_ERROR, \"malformed handshake message\") }",
"    fn bytes(&mut self, n: usize) -> Result<&'a [u8], TwTlsErr> {",
"        if self.p + n > self.d.len() { return Err(TwBuf::err()); }",
"        let s = &self.d[self.p..self.p + n];",
"        self.p += n;",
"        Ok(s)",
"    }",
"    fn u8(&mut self) -> Result<usize, TwTlsErr> { Ok(self.bytes(1)?[0] as usize) }",
"    fn u16(&mut self) -> Result<usize, TwTlsErr> { let b = self.bytes(2)?; Ok(((b[0] as usize) << 8) | b[1] as usize) }",
"    fn u24(&mut self) -> Result<usize, TwTlsErr> { let b = self.bytes(3)?; Ok(((b[0] as usize) << 16) | ((b[1] as usize) << 8) | b[2] as usize) }",
"    fn vec8(&mut self) -> Result<&'a [u8], TwTlsErr> { let n = self.u8()?; self.bytes(n) }",
"    fn vec16(&mut self) -> Result<&'a [u8], TwTlsErr> { let n = self.u16()?; self.bytes(n) }",
"    fn vec24(&mut self) -> Result<&'a [u8], TwTlsErr> { let n = self.u24()?; self.bytes(n) }",
"    fn done(&self) -> bool { self.p == self.d.len() }",
"    fn end(&self) -> Result<(), TwTlsErr> { if self.done() { Ok(()) } else { Err(TwBuf::err()) } }",
"}",
"",
"/// Extensions as (type, body), refusing duplicates.",
"fn tw_parse_exts(data: &[u8]) -> Result<Vec<(u16, Vec<u8>)>, TwTlsErr> {",
"    let mut b = TwBuf::new(data);",
"    let mut out: Vec<(u16, Vec<u8>)> = Vec::new();",
"    while !b.done() {",
"        let t = b.u16()? as u16;",
"        let v = b.vec16()?.to_vec();",
"        if out.iter().any(|(k, _)| *k == t) { return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"duplicate TLS extension\")); }",
"        out.push((t, v));",
"    }",
"    Ok(out)",
"}",
"fn tw_find_ext(exts: &[(u16, Vec<u8>)], t: u16) -> Option<&[u8]> { exts.iter().find(|(k, _)| *k == t).map(|(_, v)| v.as_slice()) }",
"",
"/// Key schedule secrets derived from the (EC)DHE shared secret.",
"fn tw_handshake_secret(alg: TwHashAlg, shared: &[u8]) -> Vec<u8> {",
"    let zeros = vec![0u8; alg.len()];",
"    let early = tw_hkdf_extract(alg, &[], &zeros);",
"    let derived = tw_expand_label(alg, &early, \"derived\", &tw_hash(alg, &[]), alg.len());",
"    tw_hkdf_extract(alg, &derived, shared)",
"}",
"fn tw_master_secret(alg: TwHashAlg, hs_secret: &[u8]) -> Vec<u8> {",
"    let derived = tw_expand_label(alg, hs_secret, \"derived\", &tw_hash(alg, &[]), alg.len());",
"    tw_hkdf_extract(alg, &derived, &vec![0u8; alg.len()])",
"}",
"",
"/// The content a CertificateVerify signs (RFC 8446 section 4.4.3).",
"fn tw_cv_content(server: bool, transcript_hash: &[u8]) -> Vec<u8> {",
"    let mut m = vec![0x20u8; 64];",
"    m.extend_from_slice(if server { b\"TLS 1.3, server CertificateVerify\" } else { b\"TLS 1.3, client CertificateVerify\" });",
"    m.push(0);",
"    m.extend_from_slice(transcript_hash);",
"    m",
"}",
"",
"fn tw_scheme_alg(scheme: u16) -> Option<TwSigAlg> {",
"    Some(match scheme {",
"        TW_SIG_ECDSA_P256 => TwSigAlg::Ecdsa(TwHashAlg::Sha256),",
"        TW_SIG_ECDSA_P384 => TwSigAlg::Ecdsa(TwHashAlg::Sha384),",
"        TW_SIG_PSS_256 => TwSigAlg::RsaPss(TwHashAlg::Sha256),",
"        TW_SIG_PSS_384 => TwSigAlg::RsaPss(TwHashAlg::Sha384),",
"        TW_SIG_PSS_512 => TwSigAlg::RsaPss(TwHashAlg::Sha512),",
"        _ => return None,",
"    })",
"}",
"",
"/// Our key share for one group: (private, public).",
"fn tw_key_share(group: u16) -> (Vec<u8>, Vec<u8>) {",
"    if group == TW_GROUP_X25519 {",
"        let mut k = vec![0u8; 32];",
"        tw_fill_random(&mut k);",
"        let p = tw_x25519_base(&k).to_vec();",
"        (k, p)",
"    } else {",
"        let c = tw_p256();",
"        let d = c.random_scalar();",
"        let p = c.public_key(&d).unwrap_or_default();",
"        (d, p)",
"    }",
"}",
"fn tw_shared_secret(group: u16, private: &[u8], peer: &[u8]) -> Result<Vec<u8>, TwTlsErr> {",
"    if group == TW_GROUP_X25519 {",
"        if peer.len() != 32 { return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"bad X25519 key share\")); }",
"        let s = tw_x25519(private, peer);",
"        if s.iter().all(|&b| b == 0) { return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"bad X25519 key share\")); }",
"        Ok(s.to_vec())",
"    } else {",
"        tw_p256().ecdh(private, peer).ok_or_else(|| tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"bad secp256r1 key share\"))",
"    }",
"}",
"",
"// ===========================================================================",
"// 5. Client handshake",
"// ===========================================================================",
"",
"/// TLS 1.3 handshake as a client over `sock`, verifying the certificate for `host`.",
"fn tw_tls_connect(sock: std::net::TcpStream, host: &str) -> Result<TwTls, String> {",
"    let anchors = tw_trust_anchors()?;",
"    tw_tls_connect_with(sock, host, anchors)",
"}",
"fn tw_tls_connect_with(sock: std::net::TcpStream, host: &str, anchors: &[TwCert]) -> Result<TwTls, String> {",
"    let mut tls = TwTls::new(sock);",
"    match tw_tls_client_handshake(&mut tls, host, anchors) {",
"        Ok(()) => Ok(tls),",
"        Err(e) => {",
"            if e.alert != TW_ALERT_CLOSE_NOTIFY { tls.send_alert(e.alert); }",
"            Err(e.message)",
"        }",
"    }",
"}",
"",
"fn tw_tls_client_handshake(tls: &mut TwTls, host: &str, anchors: &[TwCert]) -> Result<(), TwTlsErr> {",
"    let (x_priv, x_pub) = tw_key_share(TW_GROUP_X25519);",
"    let (p_priv, p_pub) = tw_key_share(TW_GROUP_P256);",
"    let mut random = [0u8; 32];",
"    tw_fill_random(&mut random);",
"    let mut session_id = [0u8; 32];",
"    tw_fill_random(&mut session_id);",
"",
"    let mut exts = Vec::new();",
"    let sni_host = host.trim_end_matches('.');",
"    if tw_host_ip(sni_host).is_none() {",
"        let mut sni = Vec::new();",
"        tw_put_u16(&mut sni, sni_host.len() + 3);",
"        sni.push(0);",
"        tw_put_u16(&mut sni, sni_host.len());",
"        sni.extend_from_slice(sni_host.as_bytes());",
"        tw_ext(&mut exts, 0, &sni);",
"    }",
"    tw_ext(&mut exts, 10, &[0, 4, 0x00, 0x1d, 0x00, 0x17]);",
"    let schemes = [TW_SIG_ECDSA_P256, TW_SIG_ECDSA_P384, TW_SIG_PSS_256, TW_SIG_PSS_384, TW_SIG_PSS_512, TW_SIG_PKCS1_256, TW_SIG_PKCS1_384, TW_SIG_PKCS1_512];",
"    let mut sa = Vec::new();",
"    tw_put_u16(&mut sa, schemes.len() * 2);",
"    for s in schemes { tw_put_u16(&mut sa, s as usize); }",
"    tw_ext(&mut exts, 13, &sa);",
"    tw_ext(&mut exts, 16, b\"\\x00\\x09\\x08http/1.1\");",
"    tw_ext(&mut exts, 43, &[2, 3, 4]);",
"    let mut ks = Vec::new();",
"    tw_put_u16(&mut ks, 4 + x_pub.len() + 4 + p_pub.len());",
"    tw_put_u16(&mut ks, TW_GROUP_X25519 as usize); tw_put_u16(&mut ks, x_pub.len()); ks.extend_from_slice(&x_pub);",
"    tw_put_u16(&mut ks, TW_GROUP_P256 as usize); tw_put_u16(&mut ks, p_pub.len()); ks.extend_from_slice(&p_pub);",
"    tw_ext(&mut exts, 51, &ks);",
"",
"    let mut body = vec![3, 3];",
"    body.extend_from_slice(&random);",
"    body.push(32);",
"    body.extend_from_slice(&session_id);",
"    body.extend_from_slice(&[0, 6, 0x13, 0x01, 0x13, 0x03, 0x13, 0x02, 1, 0]);",
"    tw_put_u16(&mut body, exts.len());",
"    body.extend_from_slice(&exts);",
"    tls.send_handshake(&tw_hs_msg(TW_HS_CLIENT_HELLO, &body))?;",
"",
"    // ServerHello",
"    let sh = tls.expect_handshake(TW_HS_SERVER_HELLO, \"ServerHello\").map_err(|mut e| {",
"        if e.message.contains(\"alert\") || e.message.contains(\"closed\") { e.message.push_str(\" in reply to the ClientHello; the server probably does not support TLS 1.3 (TLS 1.2 and older are not supported)\"); }",
"        e",
"    })?;",
"    let mut b = TwBuf::new(&sh[4..]);",
"    let legacy = b.u16()?;",
"    let server_random = b.bytes(32)?;",
"    let echo = b.vec8()?;",
"    let suite = b.u16()? as u16;",
"    let compression = b.u8()?;",
"    let sexts = tw_parse_exts(b.vec16()?)?;",
"    b.end()?;",
"    let version = tw_find_ext(&sexts, 43);",
"    if legacy != 0x0303 || version != Some(&[3, 4][..]) {",
"        return Err(tw_tls_err(TW_ALERT_PROTOCOL_VERSION, \"the server does not support TLS 1.3 (TLS 1.2 and older are not supported)\"));",
"    }",
"    if server_random == TW_HRR_RANDOM { return Err(tw_tls_err(TW_ALERT_HANDSHAKE_FAILURE, \"the server asked for a key exchange group that is not supported (HelloRetryRequest)\")); }",
"    if echo != session_id || compression != 0 || ![TW_SUITE_AES128, TW_SUITE_AES256, TW_SUITE_CHACHA].contains(&suite) {",
"        return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"invalid ServerHello\"));",
"    }",
"    let share = tw_find_ext(&sexts, 51).ok_or_else(|| tw_tls_err(TW_ALERT_MISSING_EXTENSION, \"the server sent no key share (pre-shared keys are not supported)\"))?;",
"    let mut sb = TwBuf::new(share);",
"    let group = sb.u16()? as u16;",
"    let peer = sb.vec16()?;",
"    sb.end()?;",
"    let shared = match group {",
"        TW_GROUP_X25519 => tw_shared_secret(group, &x_priv, peer)?,",
"        TW_GROUP_P256 => tw_shared_secret(group, &p_priv, peer)?,",
"        _ => return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"the server chose a key exchange group that was not offered\")),",
"    };",
"    tls.suite = suite;",
"    if !tls.hs.is_empty() { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"handshake data after the ServerHello in the same record\")); }",
"    tls.transcript.extend_from_slice(&sh);",
"    let alg = tls.hash();",
"    let hs_secret = tw_handshake_secret(alg, &shared);",
"    let th = tls.transcript_hash();",
"    let c_hs = tw_expand_label(alg, &hs_secret, \"c hs traffic\", &th, alg.len());",
"    let s_hs = tw_expand_label(alg, &hs_secret, \"s hs traffic\", &th, alg.len());",
"    tls.set_read_secret(s_hs.clone());",
"",
"    // EncryptedExtensions, [CertificateRequest], Certificate, CertificateVerify, Finished",
"    let ee = tls.expect_handshake(TW_HS_ENCRYPTED_EXTENSIONS, \"EncryptedExtensions\")?;",
"    let mut eb = TwBuf::new(&ee[4..]);",
"    let eexts = tw_parse_exts(eb.vec16()?)?;",
"    eb.end()?;",
"    if let Some(alpn) = tw_find_ext(&eexts, 16) { if alpn != b\"\\x00\\x09\\x08http/1.1\" { return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"the server chose an application protocol other than http/1.1\")); } }",
"    tls.transcript.extend_from_slice(&ee);",
"    let mut msg = tls.read_handshake()?;",
"    let mut cert_requested = false;",
"    if msg[0] == TW_HS_CERTIFICATE_REQUEST {",
"        cert_requested = true;",
"        tls.transcript.extend_from_slice(&msg);",
"        msg = tls.read_handshake()?;",
"    }",
"    if msg[0] != TW_HS_CERTIFICATE { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"expected the server's Certificate\")); }",
"    let mut cb = TwBuf::new(&msg[4..]);",
"    let context = cb.vec8()?;",
"    let list = cb.vec24()?;",
"    cb.end()?;",
"    if !context.is_empty() { return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"invalid Certificate\")); }",
"    let mut lb = TwBuf::new(list);",
"    let mut chain: Vec<Vec<u8>> = Vec::new();",
"    while !lb.done() {",
"        chain.push(lb.vec24()?.to_vec());",
"        lb.vec16()?;",
"        if chain.len() > 16 { return Err(tw_tls_err(TW_ALERT_BAD_CERTIFICATE, \"the certificate chain is too long\")); }",
"    }",
"    let now = tw_now_ms();",
"    if let Err(e) = tw_verify_chain(&chain, host, anchors, now) {",
"        let alert = if e.contains(\"trusted\") { TW_ALERT_UNKNOWN_CA } else { TW_ALERT_BAD_CERTIFICATE };",
"        return Err(tw_tls_err(alert, format!(\"certificate check failed: {}\", e)));",
"    }",
"    let leaf = tw_parse_cert(&chain[0]).ok_or_else(|| tw_tls_err(TW_ALERT_BAD_CERTIFICATE, \"the server certificate cannot be read\"))?;",
"    tls.transcript.extend_from_slice(&msg);",
"",
"    let cv = tls.expect_handshake(TW_HS_CERTIFICATE_VERIFY, \"CertificateVerify\")?;",
"    let mut vb = TwBuf::new(&cv[4..]);",
"    let scheme = vb.u16()? as u16;",
"    let sig = vb.vec16()?;",
"    vb.end()?;",
"    let sig_alg = tw_scheme_alg(scheme).ok_or_else(|| tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"the server used a signature scheme that was not offered\"))?;",
"    let curve_ok = match (&leaf.key, scheme) {",
"        (TwPubKey::Ec { curve: TwCurveId::P256, .. }, TW_SIG_ECDSA_P256) | (TwPubKey::Ec { curve: TwCurveId::P384, .. }, TW_SIG_ECDSA_P384) => true,",
"        (TwPubKey::Rsa { .. }, TW_SIG_PSS_256 | TW_SIG_PSS_384 | TW_SIG_PSS_512) => true,",
"        _ => false,",
"    };",
"    if !curve_ok || !tw_verify_signature(&leaf.key, sig_alg, &tw_cv_content(true, &tls.transcript_hash()), sig) {",
"        return Err(tw_tls_err(TW_ALERT_DECRYPT_ERROR, \"the server's handshake signature is invalid\"));",
"    }",
"    tls.transcript.extend_from_slice(&cv);",
"",
"    let fin = tls.expect_handshake(TW_HS_FINISHED, \"Finished\")?;",
"    let expected = tls.finished_data(&s_hs);",
"    if !tw_ct_eq(&fin[4..], &expected) { return Err(tw_tls_err(TW_ALERT_DECRYPT_ERROR, \"the server's Finished message is wrong\")); }",
"    tls.transcript.extend_from_slice(&fin);",
"    if !tls.hs.is_empty() { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"handshake data after the server's Finished\")); }",
"",
"    let master = tw_master_secret(alg, &hs_secret);",
"    let th = tls.transcript_hash();",
"    let c_ap = tw_expand_label(alg, &master, \"c ap traffic\", &th, alg.len());",
"    let s_ap = tw_expand_label(alg, &master, \"s ap traffic\", &th, alg.len());",
"",
"    tls.send_raw(&[TW_CT_CCS, 3, 3, 0, 1, 1])?;",
"    tls.set_write_secret(c_hs.clone());",
"    if cert_requested { tls.send_handshake(&tw_hs_msg(TW_HS_CERTIFICATE, &[0, 0, 0, 0]))?; }",
"    let ours = tls.finished_data(&c_hs);",
"    tls.send_handshake(&tw_hs_msg(TW_HS_FINISHED, &ours))?;",
"    tls.set_write_secret(c_ap);",
"    tls.set_read_secret(s_ap);",
"    tls.handshake_done = true;",
"    Ok(())",
"}",
"",
"// ===========================================================================",
"// 6. Server handshake and configuration",
"// ===========================================================================",
"",
"#[derive(Clone)]",
"enum TwPrivateKey { Ec { curve: TwCurveId, d: Vec<u8> }, Rsa(TwRsaKey) }",
"",
"/// Certificate chain (leaf first, DER) and private key for `serve`.",
"#[derive(Clone)]",
"pub struct TwTlsConfig { chain: Vec<Vec<u8>>, key: TwPrivateKey }",
"",
"fn tw_parse_rsa_private(der: &[u8]) -> Option<TwRsaKey> {",
"    let mut d = TwDer::new(TwDer::new(der).expect(0x30)?);",
"    d.expect(0x02)?; // version",
"    let mut next = || tw_der_uint(d.expect(0x02)?);",
"    let n = next()?; let e = next()?; let _dd = next()?; let p = next()?; let q = next()?;",
"    let dp = next()?; let dq = next()?; let qinv = next()?;",
"    Some(TwRsaKey { n, e, p, q, dp, dq, qinv })",
"}",
"fn tw_parse_ec_private(der: &[u8], curve: Option<TwCurveId>) -> Option<TwPrivateKey> {",
"    let mut d = TwDer::new(TwDer::new(der).expect(0x30)?);",
"    d.expect(0x02)?;",
"    let key = d.expect(0x04)?.to_vec();",
"    let mut id = curve;",
"    if let Some(params) = d.optional(0xa0) {",
"        let oid = TwDer::new(params).expect(0x06)?;",
"        id = if oid == TW_OID_P256 { Some(TwCurveId::P256) } else if oid == TW_OID_P384 { Some(TwCurveId::P384) } else { None };",
"    }",
"    let id = id?;",
"    let size = tw_curve(id).size;",
"    if key.len() > size { return None; }",
"    let mut padded = vec![0u8; size - key.len()];",
"    padded.extend_from_slice(&key);",
"    Some(TwPrivateKey::Ec { curve: id, d: padded })",
"}",
"fn tw_parse_pkcs8(der: &[u8]) -> Option<TwPrivateKey> {",
"    let mut d = TwDer::new(TwDer::new(der).expect(0x30)?);",
"    d.expect(0x02)?;",
"    let mut alg = TwDer::new(d.expect(0x30)?);",
"    let oid = alg.expect(0x06)?;",
"    let key = d.expect(0x04)?;",
"    if oid == TW_OID_RSA { return tw_parse_rsa_private(key).map(TwPrivateKey::Rsa); }",
"    if oid == TW_OID_EC {",
"        let c = alg.expect(0x06)?;",
"        let id = if c == TW_OID_P256 { TwCurveId::P256 } else if c == TW_OID_P384 { TwCurveId::P384 } else { return None };",
"        return tw_parse_ec_private(key, Some(id));",
"    }",
"    None",
"}",
"",
"/// Reads a PEM certificate chain and a PEM private key (PKCS #8, SEC 1 or PKCS #1; RSA or ECDSA P-256/P-384).",
"pub fn tw_tls_load_config(cert_path: &str, key_path: &str) -> Result<TwTlsConfig, String> {",
"    let cert_text = std::fs::read_to_string(cert_path).map_err(|e| format!(\"cannot read the certificate file {}: {}\", cert_path, e))?;",
"    let key_text = std::fs::read_to_string(key_path).map_err(|e| format!(\"cannot read the key file {}: {}\", key_path, e))?;",
"    let chain: Vec<Vec<u8>> = tw_pem_blocks(&cert_text).into_iter().filter(|(l, _)| l == \"CERTIFICATE\").map(|(_, d)| d).collect();",
"    if chain.is_empty() { return Err(format!(\"{} holds no PEM certificate\", cert_path)); }",
"    let leaf = tw_parse_cert(&chain[0]).ok_or_else(|| format!(\"the first certificate in {} cannot be read\", cert_path))?;",
"    let mut key = None;",
"    for (label, der) in tw_pem_blocks(&key_text) {",
"        key = match label.as_str() {",
"            \"PRIVATE KEY\" => tw_parse_pkcs8(&der),",
"            \"EC PRIVATE KEY\" => tw_parse_ec_private(&der, None),",
"            \"RSA PRIVATE KEY\" => tw_parse_rsa_private(&der).map(TwPrivateKey::Rsa),",
"            \"ENCRYPTED PRIVATE KEY\" => return Err(format!(\"{} is encrypted; store the key without a passphrase (openssl pkey -in {} -out plain.pem)\", key_path, key_path)),",
"            _ => continue,",
"        };",
"        if key.is_some() { break; }",
"        return Err(format!(\"the key in {} is not supported (use RSA of 2048 bits or more, or ECDSA P-256/P-384)\", key_path));",
"    }",
"    let key = key.ok_or_else(|| format!(\"{} holds no PEM private key\", key_path))?;",
"    let matches = match (&key, &leaf.key) {",
"        (TwPrivateKey::Ec { curve, d }, TwPubKey::Ec { curve: c2, point }) => curve == c2 && tw_curve(*curve).public_key(d).as_deref() == Some(point.as_slice()),",
"        (TwPrivateKey::Rsa(k), TwPubKey::Rsa { n, e }) => tw_strip_zeros(&k.n) == tw_strip_zeros(n) && tw_strip_zeros(&k.e) == tw_strip_zeros(e) && tw_rsa_mod_bits(n) >= 2048,",
"        _ => false,",
"    };",
"    if !matches { return Err(format!(\"the private key in {} does not belong to the certificate in {}\", key_path, cert_path)); }",
"    Ok(TwTlsConfig { chain, key })",
"}",
"",
"/// TLS 1.3 handshake as a server.",
"fn tw_tls_accept(sock: std::net::TcpStream, config: &TwTlsConfig) -> Result<TwTls, String> {",
"    let mut tls = TwTls::new(sock);",
"    match tw_tls_server_handshake(&mut tls, config) {",
"        Ok(()) => Ok(tls),",
"        Err(e) => {",
"            if e.alert != TW_ALERT_CLOSE_NOTIFY { tls.send_alert(e.alert); }",
"            Err(e.message)",
"        }",
"    }",
"}",
"",
"fn tw_tls_server_handshake(tls: &mut TwTls, config: &TwTlsConfig) -> Result<(), TwTlsErr> {",
"    let ch = tls.expect_handshake(TW_HS_CLIENT_HELLO, \"ClientHello\")?;",
"    if !tls.hs.is_empty() { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"handshake data after the ClientHello\")); }",
"    let mut b = TwBuf::new(&ch[4..]);",
"    b.u16()?;",
"    b.bytes(32)?;",
"    let session_id = b.vec8()?.to_vec();",
"    let suites_raw = b.vec16()?;",
"    let compression = b.vec8()?;",
"    let exts = if b.done() { Vec::new() } else { tw_parse_exts(b.vec16()?)? };",
"    b.end()?;",
"    if session_id.len() > 32 || !compression.contains(&0) { return Err(tw_tls_err(TW_ALERT_ILLEGAL_PARAMETER, \"invalid ClientHello\")); }",
"    let versions = tw_find_ext(&exts, 43).unwrap_or(&[]);",
"    let offers_13 = versions.len() >= 3 && versions[1..].chunks(2).any(|v| v == [3, 4]);",
"    if !offers_13 { return Err(tw_tls_err(TW_ALERT_PROTOCOL_VERSION, \"the client does not offer TLS 1.3\")); }",
"    let suites: Vec<u16> = suites_raw.chunks(2).filter(|c| c.len() == 2).map(|c| ((c[0] as u16) << 8) | c[1] as u16).collect();",
"    let suite = [TW_SUITE_CHACHA, TW_SUITE_AES128, TW_SUITE_AES256].into_iter().find(|s| suites.contains(s))",
"        .ok_or_else(|| tw_tls_err(TW_ALERT_HANDSHAKE_FAILURE, \"no common cipher suite\"))?;",
"    // key share",
"    let ks = tw_find_ext(&exts, 51).ok_or_else(|| tw_tls_err(TW_ALERT_MISSING_EXTENSION, \"the client sent no key share\"))?;",
"    let mut kb = TwBuf::new(ks);",
"    let mut kl = TwBuf::new(kb.vec16()?);",
"    kb.end()?;",
"    let mut chosen: Option<(u16, Vec<u8>)> = None;",
"    while !kl.done() {",
"        let g = kl.u16()? as u16;",
"        let k = kl.vec16()?.to_vec();",
"        if chosen.is_none() && (g == TW_GROUP_X25519 || g == TW_GROUP_P256) { chosen = Some((g, k)); }",
"    }",
"    let (group, peer) = chosen.ok_or_else(|| tw_tls_err(TW_ALERT_HANDSHAKE_FAILURE, \"the client offered no X25519 or secp256r1 key share\"))?;",
"    // signature scheme for our key",
"    let sig_algs: Vec<u16> = match tw_find_ext(&exts, 13) {",
"        Some(s) => { let mut sb = TwBuf::new(s); sb.vec16()?.chunks(2).filter(|c| c.len() == 2).map(|c| ((c[0] as u16) << 8) | c[1] as u16).collect() }",
"        None => return Err(tw_tls_err(TW_ALERT_MISSING_EXTENSION, \"the client sent no signature algorithms\")),",
"    };",
"    let scheme = match &config.key {",
"        TwPrivateKey::Ec { curve: TwCurveId::P256, .. } => Some(TW_SIG_ECDSA_P256).filter(|s| sig_algs.contains(s)),",
"        TwPrivateKey::Ec { curve: TwCurveId::P384, .. } => Some(TW_SIG_ECDSA_P384).filter(|s| sig_algs.contains(s)),",
"        TwPrivateKey::Rsa(_) => [TW_SIG_PSS_256, TW_SIG_PSS_384, TW_SIG_PSS_512].into_iter().find(|s| sig_algs.contains(s)),",
"    }.ok_or_else(|| tw_tls_err(TW_ALERT_HANDSHAKE_FAILURE, \"the client accepts no signature scheme for this server's key\"))?;",
"    // ALPN: http/1.1 only",
"    let mut alpn_reply: Option<Vec<u8>> = None;",
"    if let Some(a) = tw_find_ext(&exts, 16) {",
"        let mut ab = TwBuf::new(a);",
"        let mut list = TwBuf::new(ab.vec16()?);",
"        let mut found = false;",
"        while !list.done() { if list.vec8()? == b\"http/1.1\" { found = true; } }",
"        if !found { return Err(tw_tls_err(TW_ALERT_NO_APPLICATION_PROTOCOL, \"the client does not speak http/1.1\")); }",
"        alpn_reply = Some(b\"\\x00\\x09\\x08http/1.1\".to_vec());",
"    }",
"",
"    let (private, public) = tw_key_share(group);",
"    let shared = tw_shared_secret(group, &private, &peer)?;",
"    tls.suite = suite;",
"    tls.transcript.extend_from_slice(&ch);",
"    let mut random = [0u8; 32];",
"    tw_fill_random(&mut random);",
"    let mut sexts = Vec::new();",
"    tw_ext(&mut sexts, 43, &[3, 4]);",
"    let mut share = Vec::new();",
"    tw_put_u16(&mut share, group as usize);",
"    tw_put_u16(&mut share, public.len());",
"    share.extend_from_slice(&public);",
"    tw_ext(&mut sexts, 51, &share);",
"    let mut body = vec![3, 3];",
"    body.extend_from_slice(&random);",
"    body.push(session_id.len() as u8);",
"    body.extend_from_slice(&session_id);",
"    tw_put_u16(&mut body, suite as usize);",
"    body.push(0);",
"    tw_put_u16(&mut body, sexts.len());",
"    body.extend_from_slice(&sexts);",
"    tls.send_handshake(&tw_hs_msg(TW_HS_SERVER_HELLO, &body))?;",
"    if !session_id.is_empty() { tls.send_raw(&[TW_CT_CCS, 3, 3, 0, 1, 1])?; }",
"",
"    let alg = tls.hash();",
"    let hs_secret = tw_handshake_secret(alg, &shared);",
"    let th = tls.transcript_hash();",
"    let c_hs = tw_expand_label(alg, &hs_secret, \"c hs traffic\", &th, alg.len());",
"    let s_hs = tw_expand_label(alg, &hs_secret, \"s hs traffic\", &th, alg.len());",
"    tls.set_write_secret(s_hs.clone());",
"    tls.set_read_secret(c_hs.clone());",
"",
"    let mut ee = Vec::new();",
"    if let Some(a) = &alpn_reply { tw_ext(&mut ee, 16, a); }",
"    let mut eeb = Vec::new();",
"    tw_put_u16(&mut eeb, ee.len());",
"    eeb.extend_from_slice(&ee);",
"    let mut flight = Vec::new();",
"    let ee_msg = tw_hs_msg(TW_HS_ENCRYPTED_EXTENSIONS, &eeb);",
"    tls.transcript.extend_from_slice(&ee_msg);",
"    flight.extend_from_slice(&ee_msg);",
"    let mut list = Vec::new();",
"    for c in &config.chain { tw_put_u24(&mut list, c.len()); list.extend_from_slice(c); tw_put_u16(&mut list, 0); }",
"    let mut cbody = vec![0u8];",
"    tw_put_u24(&mut cbody, list.len());",
"    cbody.extend_from_slice(&list);",
"    let cert_msg = tw_hs_msg(TW_HS_CERTIFICATE, &cbody);",
"    tls.transcript.extend_from_slice(&cert_msg);",
"    flight.extend_from_slice(&cert_msg);",
"    let content = tw_cv_content(true, &tls.transcript_hash());",
"    let signature = match &config.key {",
"        TwPrivateKey::Ec { curve, d } => {",
"            let h = if *curve == TwCurveId::P256 { TwHashAlg::Sha256 } else { TwHashAlg::Sha384 };",
"            let (r, s) = tw_curve(*curve).sign(d, &tw_hash(h, &content));",
"            tw_ecdsa_der_encode(&r, &s)",
"        }",
"        TwPrivateKey::Rsa(k) => {",
"            let h = match scheme { TW_SIG_PSS_384 => TwHashAlg::Sha384, TW_SIG_PSS_512 => TwHashAlg::Sha512, _ => TwHashAlg::Sha256 };",
"            tw_rsa_sign_pss(k, h, &content).ok_or_else(|| tw_tls_err(TW_ALERT_INTERNAL_ERROR, \"RSA signing failed\"))?",
"        }",
"    };",
"    let mut cv = Vec::new();",
"    tw_put_u16(&mut cv, scheme as usize);",
"    tw_put_u16(&mut cv, signature.len());",
"    cv.extend_from_slice(&signature);",
"    let cv_msg = tw_hs_msg(TW_HS_CERTIFICATE_VERIFY, &cv);",
"    tls.transcript.extend_from_slice(&cv_msg);",
"    flight.extend_from_slice(&cv_msg);",
"    let fin = tw_hs_msg(TW_HS_FINISHED, &tls.finished_data(&s_hs));",
"    tls.transcript.extend_from_slice(&fin);",
"    flight.extend_from_slice(&fin);",
"    tls.write_record(TW_CT_HANDSHAKE, &flight)?;",
"",
"    let master = tw_master_secret(alg, &hs_secret);",
"    let th = tls.transcript_hash();",
"    let c_ap = tw_expand_label(alg, &master, \"c ap traffic\", &th, alg.len());",
"    let s_ap = tw_expand_label(alg, &master, \"s ap traffic\", &th, alg.len());",
"    tls.set_write_secret(s_ap);",
"",
"    let cfin = tls.expect_handshake(TW_HS_FINISHED, \"the client's Finished\")?;",
"    let expected = tls.finished_data(&c_hs);",
"    if !tw_ct_eq(&cfin[4..], &expected) { return Err(tw_tls_err(TW_ALERT_DECRYPT_ERROR, \"the client's Finished message is wrong\")); }",
"    if !tls.hs.is_empty() { return Err(tw_tls_err(TW_ALERT_UNEXPECTED_MESSAGE, \"handshake data after the client's Finished\")); }",
"    tls.set_read_secret(c_ap);",
"    tls.handshake_done = true;",
"    Ok(())",
"}",
"",
"// ===========================================================================",
"// 7. Streams for the HTTP code",
"// ===========================================================================",
"",
"/// A shared handle to one TLS connection; the HTTP reader and writer each hold one.",
"#[derive(Clone)]",
"struct TwTlsStream(std::rc::Rc<std::cell::RefCell<TwTls>>);",
"",
"impl TwTlsStream {",
"    fn new(tls: TwTls) -> TwTlsStream { TwTlsStream(std::rc::Rc::new(std::cell::RefCell::new(tls))) }",
"    /// Sends close_notify (once).",
"    fn close(&self) { self.0.borrow_mut().send_alert(TW_ALERT_CLOSE_NOTIFY); }",
"    fn tcp(&self) -> Option<std::net::TcpStream> { self.0.borrow().sock.try_clone().ok() }",
"}",
"impl std::io::Read for TwTlsStream {",
"    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> { self.0.borrow_mut().read_app(buf) }",
"}",
"impl std::io::Write for TwTlsStream {",
"    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> { self.0.borrow_mut().write_app(buf) }",
"    fn flush(&mut self) -> std::io::Result<()> { self.0.borrow_mut().sock.flush() }",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/adapter.rs; do not edit by hand."
pub fn adapter_runtime() -> Text {
let lines = [
"// Tessera shared-library adapter (C ABI) for in-process web server modules.",
"//",
"// This file is the crate root of a `--crate-type cdylib` build:",
"//",
"//   rustc --edition 2021 --crate-type cdylib -C opt-level=2 -C panic=unwind \\",
"//         -o libapp.so adapter.rs",
"//",
"// next to the generated `app.rs`. It is the ONLY part of the Tessera runtime",
"// that contains `unsafe` code. The unsafe surface is limited to:",
"//   1. turning the caller's (pointer, length) request into a `&[u8]`,",
"//   2. writing the response pointer/length into the caller's out-parameters,",
"//   3. reconstructing the `Box<[u8]>` in `tessera_free`.",
"// Everything else (decoding, running the application, limits, error -> 500,",
"// encoding) happens in safe code in `app.rs` (`tw_library_handle`).",
"//",
"// The wire format and C declarations are documented in hosts/include/tessera.h.",
"",
"#![deny(unsafe_op_in_unsafe_fn)]",
"",
"#[path = \"app.rs\"]",
"mod app;",
"",
"use std::panic::{catch_unwind, AssertUnwindSafe};",
"",
"/// ABI version implemented by this library. Hosts refuse to use a library",
"/// that reports a different version.",
"pub const TESSERA_ABI_VERSION: i32 = 1;",
"",
"/// Result codes of `tessera_handle`.",
"const OK: i32 = 0;",
"const ERR_NULL_ARGUMENT: i32 = 1;",
"const ERR_INTERNAL: i32 = 2;",
"",
"#[no_mangle]",
"pub extern \"C\" fn tessera_abi_version() -> i32 {",
"    TESSERA_ABI_VERSION",
"}",
"",
"/// Handle one wire-format request.",
"///",
"/// On success returns 0 and stores a Rust-allocated buffer in `*response` /",
"/// `*response_len`; the caller must release it with `tessera_free` using the",
"/// same pointer and length. Application errors are reported as HTTP 500 in",
"/// the response, not as a nonzero return value. A nonzero return value means",
"/// invalid arguments (1) or an internal failure that should never happen (2);",
"/// in that case `*response` is set to NULL and `*response_len` to 0 (when",
"/// those pointers are non-null).",
"///",
"/// # Safety",
"/// `request` must point to `request_len` readable bytes (it may be NULL only",
"/// when `request_len` is 0). `response` and `response_len` must be valid,",
"/// writable, non-NULL pointers. The request buffer is only read during the call.",
"#[no_mangle]",
"pub unsafe extern \"C\" fn tessera_handle(",
"    request: *const u8,",
"    request_len: usize,",
"    response: *mut *mut u8,",
"    response_len: *mut usize,",
") -> i32 {",
"    if response.is_null() || response_len.is_null() {",
"        return ERR_NULL_ARGUMENT;",
"    }",
"    // SAFETY: both out-pointers were checked for NULL above; the caller",
"    // guarantees they are valid and writable.",
"    unsafe {",
"        *response = std::ptr::null_mut();",
"        *response_len = 0;",
"    }",
"    if request.is_null() && request_len != 0 {",
"        return ERR_NULL_ARGUMENT;",
"    }",
"    let input: &[u8] = if request_len == 0 {",
"        &[]",
"    } else {",
"        // SAFETY: non-NULL (checked above) and the caller guarantees",
"        // `request_len` readable bytes that stay valid for this call.",
"        unsafe { std::slice::from_raw_parts(request, request_len) }",
"    };",
"",
"    // Unwinding across `extern \"C\"` is undefined behaviour / an abort, so",
"    // catch everything here. tw_library_handle is designed never to panic;",
"    // this is a last line of defence.",
"    let result = catch_unwind(AssertUnwindSafe(|| app::tw_library_handle(app::tessera_app, input)));",
"    let bytes: Vec<u8> = match result {",
"        Ok(bytes) => bytes,",
"        Err(_) => return ERR_INTERNAL,",
"    };",
"",
"    let boxed: Box<[u8]> = bytes.into_boxed_slice();",
"    let len = boxed.len();",
"    let ptr = Box::into_raw(boxed) as *mut u8;",
"    // SAFETY: out-pointers checked for NULL above. Ownership of the buffer",
"    // passes to the caller until tessera_free(ptr, len).",
"    unsafe {",
"        *response = ptr;",
"        *response_len = len;",
"    }",
"    OK",
"}",
"",
"/// Release a response buffer returned by `tessera_handle`.",
"///",
"/// # Safety",
"/// `response` and `response_len` must be exactly the values produced by one",
"/// successful `tessera_handle` call, and each buffer must be freed only once.",
"/// Passing NULL is allowed and does nothing.",
"#[no_mangle]",
"pub unsafe extern \"C\" fn tessera_free(response: *mut u8, response_len: usize) {",
"    if response.is_null() {",
"        return;",
"    }",
"    let _ = catch_unwind(AssertUnwindSafe(|| {",
"        // SAFETY: (response, response_len) came from Box::<[u8]>::into_raw in",
"        // tessera_handle (a zero-length box yields a dangling non-NULL pointer,",
"        // which is also reconstructed correctly here).",
"        let slice = std::ptr::slice_from_raw_parts_mut(response, response_len);",
"        drop(unsafe { Box::from_raw(slice) });",
"    }));",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/wasm.rs; do not edit by hand."
pub fn wasm_runtime() -> Text {
let lines = [
"// Tessera WebAssembly adapter: the crate root of `tessera1 build --wasm`.",
"//",
"//   rustc --edition 2021 --target wasm32-unknown-unknown --crate-type cdylib \\",
"//         -C opt-level=s -C link-arg=-zstack-size=<bytes> -o app.wasm wasm.rs",
"//",
"// next to the generated `app.rs`. In a browser the \"operating system\" is the",
"// JavaScript host (browser/tessera.js), and these are its system calls. This",
"// file, like adapter.rs, win32.rs and winmm.rs, is one of the few parts of the",
"// runtime allowed to contain `unsafe`: calling the host's imported functions",
"// and handing it a pointer into this module's memory, nothing else. The",
"// runtime reaches the host only through the safe functions below",
"// (`#[cfg(target_arch = \"wasm32\")]` branches in core.rs, extra.rs and web.rs).",
"//",
"// Host interface (import module \"tessera\"; documented in browser/README.md):",
"//   get(key, key_len) -> i32       makes the value of `key` ready and returns its",
"//                                  length in bytes, or -1 when there is none",
"//   take(destination)              copies the value made ready by `get`",
"//   put(key, key_len, value, value_len) -> i32   0 when accepted, -1 refused",
"//   now() -> f64                   milliseconds since 1970 (UTC)",
"//   monotonic() -> f64             milliseconds from an arbitrary start",
"//   random(destination, len)       fills with secure random bytes",
"// Keys: \"args\" (arguments separated by NUL), \"stdin\", \"env/NAME\",",
"// \"file/PATH\" (get and put), \"stdout\", \"stderr\" and \"exit\" (put; the code as",
"// decimal text, sent once just before the program ends), and for the `page`",
"// effect \"page/\" followed by a JSON array of an operation and its arguments",
"// (get; runtime/page.rs).",
"// Export: `tessera_main() -> i32` runs `main` and returns its exit code. A",
"// runtime error or `exit` ends the run by a trap (Rust panics abort on this",
"// target) after \"exit\" was put; the host treats that trap as the end of the run.",
"",
"#![deny(unsafe_op_in_unsafe_fn)]",
"",
"#[path = \"app.rs\"]",
"mod app;",
"",
"mod host {",
"    #[link(wasm_import_module = \"tessera\")]",
"    extern \"C\" {",
"        pub fn get(key: *const u8, key_len: usize) -> i32;",
"        pub fn take(destination: *mut u8);",
"        pub fn put(key: *const u8, key_len: usize, value: *const u8, value_len: usize) -> i32;",
"        pub fn now() -> f64;",
"        pub fn monotonic() -> f64;",
"        pub fn random(destination: *mut u8, len: usize);",
"    }",
"}",
"",
"/// The host's value for `key`, or `None` when it has none.",
"fn wasm_get(key: &str) -> Option<Vec<u8>> {",
"    // SAFETY: the pointer and length describe `key`, which is valid for the whole call.",
"    let length = unsafe { host::get(key.as_ptr(), key.len()) };",
"    if length < 0 {",
"        return None;",
"    }",
"    let mut value = vec![0u8; length as usize];",
"    // SAFETY: `value` has exactly the length the host reported for the value it will copy.",
"    unsafe { host::take(value.as_mut_ptr()) };",
"    Some(value)",
"}",
"",
"/// Gives `value` to the host under `key`; false when the host refuses it.",
"fn wasm_put(key: &str, value: &[u8]) -> bool {",
"    // SAFETY: both pointers and lengths describe live slices; the host only reads them during the call.",
"    unsafe { host::put(key.as_ptr(), key.len(), value.as_ptr(), value.len()) == 0 }",
"}",
"",
"/// Standard output (1) or standard error (2).",
"fn wasm_write(stream: i32, bytes: &[u8]) {",
"    let _ = wasm_put(if stream == 2 { \"stderr\" } else { \"stdout\" }, bytes);",
"}",
"",
"fn wasm_now() -> f64 {",
"    // SAFETY: no arguments; the host returns a number.",
"    unsafe { host::now() }",
"}",
"",
"fn wasm_monotonic() -> f64 {",
"    // SAFETY: no arguments; the host returns a number.",
"    unsafe { host::monotonic() }",
"}",
"",
"fn wasm_random(buffer: &mut [u8]) {",
"    // SAFETY: the pointer and length describe `buffer`, which the host fills during the call.",
"    unsafe { host::random(buffer.as_mut_ptr(), buffer.len()) }",
"}",
"",
"/// Runs `main`; returns 0 when it returns. Runtime errors and `exit` end in a trap instead.",
"#[no_mangle]",
"pub extern \"C\" fn tessera_main() -> i32 {",
"    app::tessera_wasm_main()",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/page.rs; do not edit by hand."
pub fn page_runtime() -> Text {
let lines = [
"",
"// ===========================================================================",
"// The `page` effect (spec section 21.5): the web page of a browser host.",
"// Embedded when a program uses it. In WebAssembly every call is one `get`",
"// from the host with the key \"page/\" and a JSON array of the operation and",
"// its arguments (runtime/wasm.rs, browser/tessera.js); a list of elements",
"// comes back as their ids separated by NUL. Anywhere else there is no page,",
"// and every call is runtime error R022.",
"// ===========================================================================",
"",
"fn t_page_call(op: &str, args: &[&str], loc: &str) -> Option<String> {",
"    #[cfg(target_arch = \"wasm32\")]",
"    {",
"        let _ = loc;",
"        let mut key = String::from(\"page/[\");",
"        t_page_json(&mut key, op);",
"        for a in args {",
"            key.push(',');",
"            t_page_json(&mut key, a);",
"        }",
"        key.push(']');",
"        return crate::wasm_get(&key).map(|v| String::from_utf8_lossy(&v).into_owned());",
"    }",
"    #[cfg(not(target_arch = \"wasm32\"))]",
"    {",
"        let _ = args;",
"        t_fail(\"R022\", format!(\"`{}` needs a web page: run the program in a browser with browser/tessera.js\", op), loc)",
"    }",
"}",
"#[cfg(target_arch = \"wasm32\")]",
"fn t_page_json(out: &mut String, text: &str) {",
"    out.push('\"');",
"    for c in text.chars() {",
"        match c {",
"            '\"' => out.push_str(\"\\\\\\\"\"),",
"            '\\\\' => out.push_str(\"\\\\\\\\\"),",
"            c if (c as u32) < 32 => out.push_str(&format!(\"\\\\u{:04x}\", c as u32)),",
"            c => out.push(c),",
"        }",
"    }",
"    out.push('\"');",
"}",
"fn t_page_element(id: i64) -> Rc<T_PageElement> { Rc::new(T_PageElement { f_id: id }) }",
"fn t_page_elements(found: Option<String>) -> Rc<Vec<Rc<T_PageElement>>> {",
"    let text = found.unwrap_or_default();",
"    Rc::new(text.split('\\0').filter(|part| !part.is_empty()).filter_map(|part| part.parse::<i64>().ok()).map(t_page_element).collect())",
"}",
"fn t_page_id(e: &Rc<T_PageElement>) -> String { e.f_id.to_string() }",
"fn t_page_select(selector: Rc<String>, loc: &str) -> Rc<Vec<Rc<T_PageElement>>> {",
"    t_page_elements(t_page_call(\"page_select\", &[&selector], loc))",
"}",
"fn t_element_select(e: Rc<T_PageElement>, selector: Rc<String>, loc: &str) -> Rc<Vec<Rc<T_PageElement>>> {",
"    t_page_elements(t_page_call(\"element_select\", &[&t_page_id(&e), &selector], loc))",
"}",
"fn t_element_text(e: Rc<T_PageElement>, loc: &str) -> Rc<String> {",
"    Rc::new(t_page_call(\"element_text\", &[&t_page_id(&e)], loc).unwrap_or_default())",
"}",
"fn t_set_element_text(e: Rc<T_PageElement>, text: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"set_element_text\", &[&t_page_id(&e), &text], loc);",
"}",
"fn t_element_attribute(e: Rc<T_PageElement>, name: Rc<String>, loc: &str) -> Option<Rc<String>> {",
"    t_page_call(\"element_attribute\", &[&t_page_id(&e), &name], loc).map(Rc::new)",
"}",
"fn t_set_element_attribute(e: Rc<T_PageElement>, name: Rc<String>, value: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"set_element_attribute\", &[&t_page_id(&e), &name, &value], loc);",
"}",
"fn t_remove_element_attribute(e: Rc<T_PageElement>, name: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"remove_element_attribute\", &[&t_page_id(&e), &name], loc);",
"}",
"fn t_element_has_class(e: Rc<T_PageElement>, name: Rc<String>, loc: &str) -> bool {",
"    t_page_call(\"element_has_class\", &[&t_page_id(&e), &name], loc).as_deref() == Some(\"true\")",
"}",
"fn t_add_element_class(e: Rc<T_PageElement>, name: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"add_element_class\", &[&t_page_id(&e), &name], loc);",
"}",
"fn t_remove_element_class(e: Rc<T_PageElement>, name: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"remove_element_class\", &[&t_page_id(&e), &name], loc);",
"}",
"fn t_set_element_style(e: Rc<T_PageElement>, property: Rc<String>, value: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"set_element_style\", &[&t_page_id(&e), &property, &value], loc);",
"}",
"fn t_create_element(tag: Rc<String>, loc: &str) -> Rc<T_PageElement> {",
"    t_page_element(t_page_call(\"create_element\", &[&tag], loc).and_then(|id| id.parse::<i64>().ok()).unwrap_or(0))",
"}",
"fn t_append_element(parent: Rc<T_PageElement>, child: Rc<T_PageElement>, loc: &str) {",
"    let _ = t_page_call(\"append_element\", &[&t_page_id(&parent), &t_page_id(&child)], loc);",
"}",
"fn t_insert_element_before(parent: Rc<T_PageElement>, child: Rc<T_PageElement>, before: Rc<T_PageElement>, loc: &str) {",
"    let _ = t_page_call(\"insert_element_before\", &[&t_page_id(&parent), &t_page_id(&child), &t_page_id(&before)], loc);",
"}",
"// A compiled program has no names for its function values, which the host needs to call a handler",
"// back; handlers work in interpreted programs (`tessera.js` `run`), see spec section 21.5.",
"fn t_on_event(e: Rc<T_PageElement>, kind: Rc<String>, handler: fn(Rc<T_PageEvent>), loc: &str) {",
"    let _ = (e, kind, handler);",
"    t_fail(\"R022\", \"`on_event` needs the interpreter: run the program with browser/tessera.js\".to_string(), loc)",
"}",
"fn t_on_timer(e: Rc<T_PageElement>, ms: i64, handler: fn(Rc<T_PageEvent>), loc: &str) {",
"    let _ = (e, ms, handler);",
"    t_fail(\"R022\", \"`on_timer` needs the interpreter: run the program with browser/tessera.js\".to_string(), loc)",
"}",
"fn t_prevent_default(loc: &str) {",
"    let _ = t_page_call(\"prevent_default\", &[], loc);",
"}",
"fn t_page_confirm(message: Rc<String>, loc: &str) -> bool {",
"    t_page_call(\"page_confirm\", &[&message], loc).as_deref() == Some(\"true\")",
"}",
"fn t_copy_to_clipboard(text: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"copy_to_clipboard\", &[&text], loc);",
"}",
"fn t_media_matches(query: Rc<String>, loc: &str) -> bool {",
"    t_page_call(\"media_matches\", &[&query], loc).as_deref() == Some(\"true\")",
"}",
"fn t_stored_text(key: Rc<String>, loc: &str) -> Option<Rc<String>> {",
"    t_page_call(\"stored_text\", &[&key], loc).map(Rc::new)",
"}",
"fn t_store_text(key: Rc<String>, value: Rc<String>, loc: &str) {",
"    let _ = t_page_call(\"store_text\", &[&key, &value], loc);",
"}",
"",
]
join(lines, "\n")
}

note "Generated from runtime/tessera.gbnf; do not edit by hand."
pub fn grammar_gbnf() -> Text {
let lines = [
"# Tessera canonical text (spec sections 14 and 20.3), in GBNF for grammar-constrained decoding.",
"# It accepts the canonical form that `tessera1 format` writes: no indentation, single spaces,",
"# one statement per line. A decoder that follows it cannot produce a syntax error the",
"# canonical printer would not; type and effect errors are still the compiler's to find.",
"# Exported by `tessera1 grammar --format gbnf`; harness/tools/check_grammar.py checks it",
"# against every canonical file in the repository.",
"",
"root ::= gap* (item gap*)*",
"gap ::= \"\\n\" | comment \"\\n\"",
"comment ::= \"//\" [^\\n]*",
"",
"item ::= notes? declaration | import | test",
"notes ::= (\"note \" text \"\\n\")+",
"declaration ::= (\"pub \")? (function | record | enum)",
"import ::= \"import \" modpath (\" uses \" (\"nothing\" | name (\", \" name)*))? \"\\n\"",
"modpath ::= name (\"/\" name)*",
"test ::= \"test \" text \" \" block \"\\n\"",
"",
"function ::= \"fn \" name \"(\" (param (\", \" param)*)? \") -> \" type (\" uses \" name (\", \" name)*)? (\" = \" expr | \" \" block) \"\\n\"",
"param ::= name \": \" type",
"record ::= \"type \" upper \" {\" (\"}\" | \"\\n\" (field \"\\n\" | comment \"\\n\")* \"}\") \"\\n\"",
"field ::= name \": \" type",
"enum ::= \"enum \" upper \" {\\n\" (variant \"\\n\" | comment \"\\n\")* \"}\\n\"",
"variant ::= upper (\"(\" field (\", \" field)* \")\")?",
"",
"type ::= typename (\"[\" type (\", \" type)* \"]\")? | \"fn(\" (type (\", \" type)*)? \") -> \" type (\" uses \" name (\", \" name)*)?",
"typename ::= (name \".\")? upper",
"",
"block ::= \"{}\" | \"{\\n\" (line \"\\n\")* \"}\"",
"line ::= comment | statement",
"statement ::= binding | assignment | for | while | expr",
"binding ::= (\"let \" | \"var \") (name | \"_\") (\": \" type)? \" = \" expr (\" else \" expr)?",
"assignment ::= \"set \" place (\" = \" | \" += \" | \" -= \") expr",
"place ::= name (\".\" name | \"[\" expr \"]\")*",
"for ::= \"for \" (name | \"_\") \" in \" expr \" \" block",
"while ::= \"while \" expr \" \" block",
"",
"expr ::= comparison ((\" and \" | \" or \") comparison)*",
"comparison ::= sum ((\" == \" | \" != \" | \" < \" | \" <= \" | \" > \" | \" >= \") sum)?",
"sum ::= product ((\" + \" | \" - \") product)*",
"product ::= prefix ((\" * \" | \" / \" | \" % \") prefix)*",
"prefix ::= \"-\" prefix | \"not \" prefix | \"try \" prefix | postfix",
"postfix ::= primary (\"[\" expr \"]\" | \".\" name | \"(\" args? \")\" | \" with \" inits)*",
"args ::= expr (\", \" expr)*",
"inits ::= \"{}\" | \"{ \" init (\", \" init)* \" }\"",
"init ::= name \": \" expr",
"",
"primary ::= number | text | \"true\" | \"false\" | \"()\" | \"(\" expr \")\" | list | map | call | name",
"  | record-literal | variant-literal | if | match | block",
"  | \"return\" (\" \" expr)? | \"break\" | \"continue\"",
"call ::= name (\".\" name)? \"(\" args? \")\"",
"list ::= \"[\" args? \"]\"",
"map ::= \"[:]\" | \"[\" expr \": \" expr (\", \" expr \": \" expr)* \"]\"",
"record-literal ::= typename \" \" inits",
"variant-literal ::= typename? \".\" upper (\"(\" args \")\")?",
"if ::= \"if \" expr \" \" branch (\" else \" (if | branch))?",
"branch ::= block | \"{ \" expr \" }\"",
"match ::= \"match \" expr \" {\\n\" (arm \"\\n\" | comment \"\\n\")* \"}\"",
"arm ::= pattern \" => \" (binding | assignment | for | while | expr)",
"pattern ::= \"_\" | \"-\"? digits | text | \"true\" | \"false\" | typename? \".\" upper (\"(\" binder (\", \" binder)* \")\")?",
"binder ::= name | \"_\"",
"",
"name ::= [a-z] [a-z0-9_]*",
"upper ::= [A-Z] [A-Za-z0-9]*",
"digits ::= [0-9]+",
"number ::= digits (\".\" digits)? ([eE] [+-]? digits)?",
"text ::= \"\\\"\" (text-char | escape | \"\\\\(\" expr \")\")* \"\\\"\"",
"text-char ::= [^\"\\\\\\n]",
"escape ::= \"\\\\\" [\"\\\\nt] | \"\\\\u{\" [0-9a-fA-F]+ \"}\"",
"",
]
join(lines, "\n")
}

note "Generated from std/bytes.tes; do not edit by hand."
pub fn std_bytes() -> Text {
let lines = [
"// std/bytes: little-endian numbers and ASCII names in binary data (WAD, BMP, WAV and most other file formats).",
"// Effects: none. Reading past the end of the data is runtime error R001, as for `data[i]`.",
"",
"note \"Unsigned 16-bit little-endian number at `at`: 0 to 65535.\"",
"pub fn read_u16_le(data: Bytes, at: Int) -> Int = bit_or(data[at], shift_left(data[at + 1], 8))",
"",
"note \"Signed 16-bit little-endian number at `at`: -32768 to 32767.\"",
"pub fn read_i16_le(data: Bytes, at: Int) -> Int {",
"let raw = read_u16_le(data, at)",
"if raw >= 32768 { raw - 65536 } else { raw }",
"}",
"",
"note \"Unsigned 32-bit little-endian number at `at`: 0 to 4294967295.\"",
"pub fn read_u32_le(data: Bytes, at: Int) -> Int = bit_or(read_u16_le(data, at), shift_left(read_u16_le(data, at + 2), 16))",
"",
"note \"Signed 32-bit little-endian number at `at`: -2147483648 to 2147483647.\"",
"pub fn read_i32_le(data: Bytes, at: Int) -> Int {",
"let raw = read_u32_le(data, at)",
"if raw >= 2147483648 { raw - 4294967296 } else { raw }",
"}",
"",
"note \"`count` bytes from `at` as text, ending early at the first zero byte, as in zero-padded names. Bytes above 127 become `?`. R004 if the range is outside the data.\"",
"pub fn read_ascii(data: Bytes, at: Int, count: Int) -> Text {",
"var codes: List[Int] = []",
"for value in byte_values(slice(data, at, at + count)) {",
"if value == 0 {",
"break",
"}",
"set codes += [if value > 127 { 63 } else { value }]",
"}",
"from_code_points(codes)",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/config.tes; do not edit by hand."
pub fn std_config() -> Text {
let lines = [
"// std/config: settings from configuration files, defaults and environment variables (draft 0.23).",
"//",
"// A configuration file has one `key = value` per line, `[section]` headers and",
"// comment lines starting with `#` or `;`:",
"//",
"//     # app.conf",
"//     name = Shop",
"//     [server]",
"//     port = 8080",
"//     greeting = \"  Welcome!  \"",
"//",
"// Keys are named by their section: `server.port`. A value is the rest of the line",
"// without outer spaces; in double quotes it keeps its spaces and may use the",
"// escapes `\\\"`, `\\\\`, `\\n`, `\\r` and `\\t`. A `#` after a value is part of the value.",
"//",
"//     import std/config",
"//     let defaults = config.from_map([\"server.port\": \"8080\", \"log.level\": \"info\"], \"default\")",
"//     let file = try config.load(\"app.conf\")",
"//     let settings = config.from_environment(config.merge(defaults, file), \"SHOP\")",
"//     let port = try config.get_int(settings, \"server.port\")",
"//",
"// Every error names the key and where its value came from, such as `app.conf line 3`.",
"",
"pub type Config {",
"values: Map[Text, Text]",
"origins: Map[Text, Text]",
"}",
"",
"note \"A configuration without settings.\"",
"pub fn empty() -> Config = Config { values: [:], origins: [:] }",
"",
"note \"A configuration with the given settings, for defaults. `origin` names them in error messages, such as `\\\"default\\\"`.\"",
"pub fn from_map(values: Map[Text, Text], origin: Text) -> Config {",
"var origins: Map[Text, Text] = [:]",
"for key in keys(values) {",
"set origins = put(origins, key, origin)",
"}",
"Config { values: values, origins: origins }",
"}",
"",
"note \"The settings in the text of a configuration file. `name` is used in error messages, usually the file name. A line that is not a comment, a section or `key = value`, a key used twice and a quoted value without its closing quote are errors.\"",
"pub fn parse(text: Text, name: Text) -> Result[Config, Text] {",
"var out = empty()",
"var section = \"\"",
"var number = 0",
"for raw in lines(text) {",
"set number += 1",
"let line = trim(raw)",
"let place = \"\\(name) line \\(number)\"",
"if line == \"\" or starts_with(line, \"#\") or starts_with(line, \";\") {",
"continue",
"}",
"if starts_with(line, \"[\") {",
"if not ends_with(line, \"]\") {",
"return .Error(\"\\(place): a section header ends with `]`\")",
"}",
"let header = trim(slice_text(line, 1, length(line) - 1))",
"if not valid_key(header) {",
"return .Error(\"\\(place): `\\(header)` is not a valid section name (letters, digits, `_`, `-` and `.`)\")",
"}",
"set section = \"\\(header).\"",
"continue",
"}",
"let at = index_of(line, \"=\") else return .Error(\"\\(place): expected `key = value`, `[section]` or a comment\")",
"let key_part = trim(slice_text(line, 0, at))",
"if not valid_key(key_part) {",
"return .Error(\"\\(place): `\\(key_part)` is not a valid key (letters, digits, `_`, `-` and `.`)\")",
"}",
"let key = section + key_part",
"if contains(out.values, key) {",
"return .Error(\"\\(place): `\\(key)` is already set on \\(value_or(get(out.origins, key), \"an earlier line\"))\")",
"}",
"let value = try parse_value(trim(slice_text(line, at + 1, length(line))), place)",
"set out = Config { values: put(out.values, key, value), origins: put(out.origins, key, place) }",
"}",
".Ok(out)",
"}",
"",
"fn valid_key(key: Text) -> Bool {",
"if key == \"\" or starts_with(key, \".\") or ends_with(key, \".\") or contains(key, \"..\") {",
"return false",
"}",
"for code in code_points(key) {",
"let letter = (code >= 97 and code <= 122) or (code >= 65 and code <= 90)",
"let digit = code >= 48 and code <= 57",
"if not (letter or digit or code == 95 or code == 45 or code == 46) {",
"return false",
"}",
"}",
"true",
"}",
"",
"fn parse_value(text: Text, place: Text) -> Result[Text, Text] {",
"if not starts_with(text, \"\\\"\") {",
"return .Ok(text)",
"}",
"let parts = split(text, \"\")",
"var out = \"\"",
"var index = 1",
"while index < length(parts) {",
"let part = parts[index]",
"if part == \"\\\"\" {",
"if index != length(parts) - 1 {",
"return .Error(\"\\(place): nothing may follow the closing quote\")",
"}",
"return .Ok(out)",
"}",
"if part == \"\\\\\" {",
"if index + 1 >= length(parts) {",
"break",
"}",
"let next = parts[index + 1]",
"set out += match next {",
"\"\\\"\" => \"\\\"\"",
"\"\\\\\" => \"\\\\\"",
"\"n\" => \"\\n\"",
"\"t\" => \"\\t\"",
"\"r\" => from_code_point(13)",
"_ => return .Error(\"\\(place): unknown escape `\\\\\\(next)` (use `\\\\\\\"`, `\\\\\\\\`, `\\\\n`, `\\\\r` or `\\\\t`)\")",
"}",
"set index += 2",
"continue",
"}",
"set out += part",
"set index += 1",
"}",
".Error(\"\\(place): the quoted value has no closing `\\\"`\")",
"}",
"",
"note \"Reads and parses the configuration file at `path`.\"",
"pub fn load(path: Text) -> Result[Config, Text] uses fs {",
"let text = match read_text(path) {",
".Ok(t) => t",
".Error(e) => return .Error(\"cannot read the configuration file `\\(path)`: \\(file_error_text(e))\")",
"}",
"parse(text, path)",
"}",
"",
"fn file_error_text(error: FileError) -> Text {",
"match error {",
".NotFound => \"it does not exist\"",
".PermissionDenied => \"permission denied\"",
".Other(message) => message",
"}",
"}",
"",
"note \"`base` with every setting of `top` added; where both have a key, the value of `top` wins.\"",
"pub fn merge(base: Config, top: Config) -> Config {",
"var out = base",
"for key in keys(top.values) {",
"set out = Config { values: put(out.values, key, value_or(get(top.values, key), \"\")), origins: put(out.origins, key, value_or(get(top.origins, key), \"\")) }",
"}",
"out",
"}",
"",
"note \"A copy of `config` with `key` set to `value`; `origin` names it in error messages.\"",
"pub fn with_value(config: Config, key: Text, value: Text, origin: Text) -> Config = Config { values: put(config.values, key, value), origins: put(config.origins, key, origin) }",
"",
"note \"The environment variable that `from_environment` reads for a key: `prefix`, `_` and the key in upper case with `.` and `-` replaced by `_`, so `server.port` with prefix `SHOP` is `SHOP_SERVER_PORT`.\"",
"pub fn environment_name(prefix: Text, key: Text) -> Text {",
"let name = to_upper(replace(replace(key, \".\", \"_\"), \"-\", \"_\"))",
"if prefix == \"\" { name } else { \"\\(prefix)_\\(name)\" }",
"}",
"",
"note \"A copy of `config` in which every key it already has is replaced by its environment variable (see `environment_name`), when that variable is set and not empty. Only known keys are read, so give every setting a default first.\"",
"pub fn from_environment(config: Config, prefix: Text) -> Config uses env {",
"var out = config",
"for key in keys(config.values) {",
"let name = environment_name(prefix, key)",
"let value = environment_variable(name)",
"if value != \"\" {",
"set out = with_value(out, key, value, \"environment variable \\(name)\")",
"}",
"}",
"out",
"}",
"",
"note \"Whether `config` has a setting for `key`.\"",
"pub fn has(config: Config, key: Text) -> Bool = contains(config.values, key)",
"",
"note \"The value of `key`, or `.None` when it is not set.\"",
"pub fn find(config: Config, key: Text) -> Option[Text] = get(config.values, key)",
"",
"note \"All keys in sorted order.\"",
"pub fn names(config: Config) -> List[Text] = keys(config.values)",
"",
"note \"The settings whose key starts with `prefix.`, with that part removed: `section(c, \\\"server\\\")` turns `server.port` into `port`.\"",
"pub fn section(config: Config, prefix: Text) -> Config {",
"var out = empty()",
"let start = \"\\(prefix).\"",
"for key in keys(config.values) {",
"if starts_with(key, start) {",
"let short = slice_text(key, length(start), length(key))",
"set out = with_value(out, short, value_or(get(config.values, key), \"\"), value_or(get(config.origins, key), \"\"))",
"}",
"}",
"out",
"}",
"",
"note \"Where the value of `key` came from, such as `app.conf line 3`, `default` or `environment variable SHOP_SERVER_PORT`; `\\\"\\\"` when it is not set.\"",
"pub fn origin(config: Config, key: Text) -> Text = value_or(get(config.origins, key), \"\")",
"",
"fn invalid(config: Config, key: Text, value: Text, expected: Text) -> Text = \"setting `\\(key)` (\\(origin(config, key))) is \\\"\\(value)\\\", expected \\(expected)\"",
"",
"note \"The value of `key`, or an error when it is not set.\"",
"pub fn get_text(config: Config, key: Text) -> Result[Text, Text] {",
"match get(config.values, key) {",
".Some(value) => .Ok(value)",
".None => .Error(\"setting `\\(key)` is missing\")",
"}",
"}",
"",
"note \"The value of `key` as a whole number; an error when it is missing or not one.\"",
"pub fn get_int(config: Config, key: Text) -> Result[Int, Text] {",
"let value = try get_text(config, key)",
"match parse_int(value) {",
".Some(n) => .Ok(n)",
".None => .Error(invalid(config, key, value, \"a whole number\"))",
"}",
"}",
"",
"note \"The value of `key` as a `Decimal`; an error when it is missing or not a number.\"",
"pub fn get_decimal(config: Config, key: Text) -> Result[Decimal, Text] {",
"let value = try get_text(config, key)",
"match parse_decimal(value) {",
".Some(n) => .Ok(n)",
".None => .Error(invalid(config, key, value, \"a number\"))",
"}",
"}",
"",
"note \"The value of `key` as a `Float`; an error when it is missing or not a number.\"",
"pub fn get_float(config: Config, key: Text) -> Result[Float, Text] {",
"let value = try get_text(config, key)",
"match parse_float(value) {",
".Some(n) => .Ok(n)",
".None => .Error(invalid(config, key, value, \"a number\"))",
"}",
"}",
"",
"note \"The value of `key` as a `Bool`: `true`, `yes`, `on` and `1` are true, `false`, `no`, `off` and `0` are false, in any case. Anything else, and a missing key, is an error.\"",
"pub fn get_bool(config: Config, key: Text) -> Result[Bool, Text] {",
"let value = try get_text(config, key)",
"match to_lower(value) {",
"\"true\" => .Ok(true)",
"\"yes\" => .Ok(true)",
"\"on\" => .Ok(true)",
"\"1\" => .Ok(true)",
"\"false\" => .Ok(false)",
"\"no\" => .Ok(false)",
"\"off\" => .Ok(false)",
"\"0\" => .Ok(false)",
"_ => .Error(invalid(config, key, value, \"true or false\"))",
"}",
"}",
"",
"note \"The value of `key` split at commas, each part without outer spaces; an empty value is an empty list. An error when the key is missing.\"",
"pub fn get_list(config: Config, key: Text) -> Result[List[Text], Text] {",
"let value = try get_text(config, key)",
"if trim(value) == \"\" {",
"return .Ok([])",
"}",
".Ok(map(split(value, \",\"), trim))",
"}",
"",
"note \"The configuration as file text that `parse` reads back to the same settings: keys without a section first, then one `[section]` per first key part, both in key order. Values with outer spaces, quotes, backslashes or line breaks are quoted.\"",
"pub fn encode(config: Config) -> Text {",
"var top = \"\"",
"var sections: Map[Text, Text] = [:]",
"for key in keys(config.values) {",
"let value = encode_value(value_or(get(config.values, key), \"\"))",
"match index_of(key, \".\") {",
".Some(at) => {",
"let name = slice_text(key, 0, at)",
"let rest = slice_text(key, at + 1, length(key))",
"set sections = put(sections, name, value_or(get(sections, name), \"\") + (\"\\(rest) = \\(value)\\n\"))",
"}",
".None => set top += \"\\(key) = \\(value)\\n\"",
"}",
"}",
"var out = top",
"for name in keys(sections) {",
"if out != \"\" {",
"set out += \"\\n\"",
"}",
"set out += \"[\\(name)]\\n\\(value_or(get(sections, name), \"\"))\"",
"}",
"out",
"}",
"",
"fn encode_value(value: Text) -> Text {",
"let plain = trim(value) == value and not starts_with(value, \"\\\"\") and not contains(value, \"\\n\") and not contains(value, from_code_point(13)) and not contains(value, \"\\\\\")",
"if plain {",
"return value",
"}",
"\"\\\"\\(replace(replace(replace(replace(value, \"\\\\\", \"\\\\\\\\\"), \"\\\"\", \"\\\\\\\"\"), \"\\n\", \"\\\\n\"), from_code_point(13), \"\\\\r\"))\\\"\"",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/crypto.tes; do not edit by hand."
pub fn std_crypto() -> Text {
let lines = [
"// std/crypto: authenticated encryption and key derivation.",
"//",
"// The primitives are built-ins, written once in the runtime (runtime/crypto.rs):",
"// `aead_seal`/`aead_open` (ChaCha20-Poly1305), `hkdf_sha256`, `sha512`,",
"// `hmac_sha512`, next to `sha256`, `hmac_sha256` and `random_bytes`. This module",
"// only fixes the safe way to combine them, so that programs never choose nonces",
"// or wire formats themselves.",
"//",
"//     import std/crypto",
"//     let key = crypto.derive_key(master_secret, \"session cookies\")",
"//     let token = crypto.encrypt_text(key, user_id, \"session\")",
"//     let back = crypto.decrypt_text(key, token, \"session\")   // .Some(user_id), or .None when changed",
"",
"note \"A new random 32-byte key for `encrypt` and `decrypt`.\"",
"pub fn new_key() -> Bytes uses random = random_bytes(32)",
"",
"note \"A 32-byte key for one purpose, derived from a longer secret with HKDF-SHA-256. Different purposes give independent keys, so one master secret can serve cookies, files and tokens without one use weakening another.\"",
"pub fn derive_key(secret: Bytes, purpose: Text) -> Bytes = hkdf_sha256(secret, to_bytes(\"tessera std/crypto\"), to_bytes(purpose), 32)",
"",
"note \"Encrypts and authenticates `plaintext` with ChaCha20-Poly1305 under `key` (32 bytes, R004 otherwise) and a random nonce. The result is the nonce (12 bytes), the ciphertext and the tag (16 bytes). `context` is authenticated but not stored: `decrypt` must be given the same one, so a value encrypted for one use is refused in another.\"",
"pub fn encrypt(key: Bytes, plaintext: Bytes, context: Text) -> Bytes uses random {",
"let nonce = random_bytes(12)",
"nonce + aead_seal(key, nonce, plaintext, to_bytes(context))",
"}",
"",
"note \"The plaintext of an `encrypt` result, or `.None` when the data was changed, is too short, or the key or context differ.\"",
"pub fn decrypt(key: Bytes, sealed: Bytes, context: Text) -> Option[Bytes] {",
"if length(sealed) < 28 {",
"return .None",
"}",
"aead_open(key, slice(sealed, 0, 12), slice(sealed, 12, length(sealed)), to_bytes(context))",
"}",
"",
"note \"`encrypt` for text, as URL-safe base64 without padding, so the result fits in a cookie or a URL unchanged.\"",
"pub fn encrypt_text(key: Bytes, text: Text, context: Text) -> Text uses random {",
"let encoded = base64_encode(encrypt(key, to_bytes(text), context))",
"replace(replace(replace(encoded, \"+\", \"-\"), \"/\", \"_\"), \"=\", \"\")",
"}",
"",
"note \"The text of an `encrypt_text` result, or `.None` when it was changed or is not one.\"",
"pub fn decrypt_text(key: Bytes, token: Text, context: Text) -> Option[Text] {",
"if contains(token, \"+\") or contains(token, \"/\") or contains(token, \"=\") {",
"return .None",
"}",
"let data = try base64_decode(replace(replace(token, \"-\", \"+\"), \"_\", \"/\"))",
"let plain = try decrypt(key, data, context)",
"from_bytes(plain)",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/fixed.tes; do not edit by hand."
pub fn std_fixed() -> Text {
let lines = [
"// std/fixed: 16.16 fixed-point numbers, as DOOM uses them (language-design.md section 7.6).",
"// A number v is stored as the Int v * 65536. Integer arithmetic only, so results are the same on",
"// every platform; `mul` and `div` cannot overflow for values in -2^31 to 2^31 - 1.",
"// Effects: none.",
"",
"note \"1.0 as a fixed-point number.\"",
"pub fn one() -> Int = 65536",
"",
"pub fn from_int(value: Int) -> Int = shift_left(value, 16)",
"",
"note \"The integer part, rounded toward negative infinity: 1.5 gives 1, -1.5 gives -2.\"",
"pub fn floor_int(value: Int) -> Int = shift_right(value, 16)",
"",
"note \"The product, rounded toward negative infinity like DOOM's FixedMul.\"",
"pub fn mul(a: Int, b: Int) -> Int = shift_right(a * b, 16)",
"",
"note \"The quotient, rounded toward zero. R003 when `b` is 0.\"",
"pub fn div(a: Int, b: Int) -> Int = shift_left(a, 16) / b",
"",
"pub fn abs(value: Int) -> Int = if value < 0 { -value } else { value }",
"",
"note \"sin(2π · index / count) as a fixed-point number, rounded to the nearest unit. `count` must be positive (R010).\"",
"pub fn sine(index: Int, count: Int) -> Int = turn_sine(4 * index, 4 * count)",
"",
"note \"cos(2π · index / count) as a fixed-point number, rounded to the nearest unit. `count` must be positive (R010).\"",
"pub fn cosine(index: Int, count: Int) -> Int = turn_sine(4 * index + count, 4 * count)",
"",
"note \"`sine(index, count)` for every index from 0 to `count - 1`.\"",
"pub fn sine_table(count: Int) -> List[Int] {",
"var table: List[Int] = []",
"for index in range(0, count) {",
"set table += [sine(index, count)]",
"}",
"table",
"}",
"",
"note \"`cosine(index, count)` for every index from 0 to `count - 1`.\"",
"pub fn cosine_table(count: Int) -> List[Int] {",
"var table: List[Int] = []",
"for index in range(0, count) {",
"set table += [cosine(index, count)]",
"}",
"table",
"}",
"",
"note \"π · 2^28, rounded.\"",
"fn pi_28() -> Int = 843314857",
"",
"note \"sin(2π · numerator / denominator). The angle is reduced to a quadrant, where a Taylor series with 28 fraction bits is far more precise than the 16 bits of the result. Every product stays below 2^59: the angle is below 2^28.7 and its square below 2^29.3.\"",
"fn turn_sine(numerator: Int, denominator: Int) -> Int {",
"if denominator <= 0 {",
"fail(\"sine and cosine need a positive count, found \\(denominator / 4)\")",
"}",
"let turn = (numerator % denominator + denominator) % denominator",
"let quadrant = 4 * turn / denominator",
"let rest = 4 * turn - quadrant * denominator",
"// The angle inside the quadrant, from 0 up to π/2, with 28 fraction bits.",
"let x = pi_28() * rest / (2 * denominator)",
"let value = match quadrant {",
"0 => series_sine(x)",
"1 => series_cosine(x)",
"2 => -series_sine(x)",
"_ => -series_cosine(x)",
"}",
"let magnitude = shift_right(abs(value) + 2048, 12)",
"if value < 0 { -magnitude } else { magnitude }",
"}",
"",
"fn series_sine(x: Int) -> Int {",
"let square = shift_right(x * x, 28)",
"var term = x",
"var sum = x",
"var k = 1",
"while term != 0 {",
"set term = -(term * square / shift_left(2 * k * (2 * k + 1), 28))",
"set sum += term",
"set k += 1",
"}",
"sum",
"}",
"",
"fn series_cosine(x: Int) -> Int {",
"let square = shift_right(x * x, 28)",
"var term = shift_left(1, 28)",
"var sum = term",
"var k = 1",
"while term != 0 {",
"set term = -(term * square / shift_left((2 * k - 1) * (2 * k), 28))",
"set sum += term",
"set k += 1",
"}",
"sum",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/html.tes; do not edit by hand."
pub fn std_html() -> Text {
let lines = [
"// std/html: escaping text for HTML, so user input cannot become markup (cross-site scripting).",
"",
"note \"Escapes `&`, `<`, `>`, `\\\"` and `'`; safe in element content and in quoted attribute values.\"",
"pub fn escape(text: Text) -> Text {",
"var out = \"\"",
"for piece in split(text, \"\") {",
"set out += match piece {",
"\"&\" => \"&amp;\"",
"\"<\" => \"&lt;\"",
"\">\" => \"&gt;\"",
"\"\\\"\" => \"&quot;\"",
"\"'\" => \"&#39;\"",
"_ => piece",
"}",
"}",
"out",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/http.tes; do not edit by hand."
pub fn std_http() -> Text {
let lines = [
"// std/http: requests, responses and helpers for web applications (draft 0.13).",
"//",
"// A web application is a program whose entry file has, instead of `main`:",
"//     fn handle(request: http.Request) -> http.Response uses ...",
"// The same program runs as CGI, as an HTTP server, as a FastCGI server, or inside nginx,",
"// Apache and IIS; see hosts/README.md.",
"",
"import std/url",
"",
"pub type Header {",
"name: Text",
"value: Text",
"}",
"",
"pub type Request {",
"method: Text",
"path: Text",
"raw_path: Text",
"query: Map[Text, Text]",
"raw_query: Text",
"headers: Map[Text, Text]",
"body: Bytes",
"remote_address: Text",
"}",
"",
"pub type Response {",
"status: Int",
"headers: List[Header]",
"body: Bytes",
"}",
"",
"// ---------- reading requests ----------",
"",
"note \"A request header by name (case-insensitive).\"",
"pub fn header(request: Request, name: Text) -> Option[Text] = get(request.headers, to_lower(name))",
"",
"note \"The body as text; empty when it is not valid UTF-8.\"",
"pub fn text_body(request: Request) -> Text = value_or(from_bytes(request.body), \"\")",
"",
"note \"Fields of an `application/x-www-form-urlencoded` body (an HTML form).\"",
"pub fn form(request: Request) -> Map[Text, Text] = url.parse_query(text_body(request))",
"",
"pub fn cookies(request: Request) -> Map[Text, Text] {",
"var result: Map[Text, Text] = [:]",
"let line = header(request, \"cookie\") else return result",
"for part in split(line, \";\") {",
"let pair = trim(part)",
"let position = index_of(pair, \"=\") else continue",
"let name = slice_text(pair, 0, position)",
"if not contains(result, name) {",
"set result = put(result, name, slice_text(pair, position + 1, length(pair)))",
"}",
"}",
"result",
"}",
"",
"pub fn cookie(request: Request, name: Text) -> Option[Text] = get(cookies(request), name)",
"",
"note \"Matches a path against a pattern such as `/items/:id`; the result maps parameter names to decoded segments.\"",
"pub fn match_path(pattern: Text, path: Text) -> Option[Map[Text, Text]] {",
"let wanted = split(pattern, \"/\")",
"let actual = split(path, \"/\")",
"if length(wanted) != length(actual) {",
"return .None",
"}",
"var parameters: Map[Text, Text] = [:]",
"for index in range(0, length(wanted)) {",
"if starts_with(wanted[index], \":\") {",
"let value = url.percent_decode(actual[index]) else return .None",
"set parameters = put(parameters, slice_text(wanted[index], 1, length(wanted[index])), value)",
"} else if wanted[index] != actual[index] {",
"return .None",
"}",
"}",
".Some(parameters)",
"}",
"",
"// ---------- building responses ----------",
"",
"fn security_headers() -> List[Header] = [Header { name: \"x-content-type-options\", value: \"nosniff\" }, Header { name: \"referrer-policy\", value: \"same-origin\" }]",
"",
"pub fn response(status: Int, content_type: Text, body: Text) -> Response {",
"Response { status: status, headers: security_headers() + [Header { name: \"content-type\", value: content_type }], body: to_bytes(body) }",
"}",
"",
"pub fn text(status: Int, body: Text) -> Response = response(status, \"text/plain; charset=utf-8\", body)",
"",
"note \"HTML with a restrictive Content-Security-Policy and framing forbidden; escape user input with `html.escape`.\"",
"pub fn html(status: Int, body: Text) -> Response {",
"let base = response(status, \"text/html; charset=utf-8\", body)",
"base with { headers: base.headers + [Header { name: \"content-security-policy\", value: \"default-src 'self'; frame-ancestors 'none'\" }, Header { name: \"x-frame-options\", value: \"DENY\" }] }",
"}",
"",
"pub fn json(status: Int, body: Text) -> Response = response(status, \"application/json\", body)",
"",
"pub fn bytes_response(status: Int, content_type: Text, body: Bytes) -> Response {",
"Response { status: status, headers: security_headers() + [Header { name: \"content-type\", value: content_type }], body: body }",
"}",
"",
"note \"303 See Other: after a form post, the browser follows with a GET.\"",
"pub fn redirect(location: Text) -> Response = text(303, \"\") with { headers: security_headers() + [Header { name: \"location\", value: location }] }",
"",
"pub fn not_found() -> Response = text(404, \"not found\\n\")",
"",
"pub fn with_header(r: Response, name: Text, value: Text) -> Response {",
"let lower = to_lower(name)",
"var kept: List[Header] = []",
"for h in r.headers {",
"if h.name != lower {",
"set kept += [h]",
"}",
"}",
"r with { headers: kept + [Header { name: lower, value: value }] }",
"}",
"",
"note \"Adds a cookie with safe defaults: HttpOnly, Secure, SameSite=Lax, path `/`. `max_age` in seconds; 0 deletes the cookie.\"",
"pub fn with_cookie(r: Response, name: Text, value: Text, max_age: Int) -> Response {",
"r with { headers: r.headers + [Header { name: \"set-cookie\", value: \"\\(name)=\\(value); Max-Age=\\(max_age); Path=/; HttpOnly; Secure; SameSite=Lax\" }] }",
"}",
"",
"// ---------- signed values, sessions and CSRF tokens ----------",
"",
"fn signature(secret: Text, value: Text) -> Text {",
"replace(replace(replace(base64_encode(hmac_sha256(to_bytes(secret), to_bytes(value))), \"+\", \"-\"), \"/\", \"_\"), \"=\", \"\")",
"}",
"",
"note \"`value.signature`: tamper-proof (not secret) text for cookies, with an HMAC-SHA-256 under `secret`.\"",
"pub fn sign(secret: Text, value: Text) -> Text = \"\\(value).\\(signature(secret, value))\"",
"",
"pub fn verify(secret: Text, signed: Text) -> Option[Text] {",
"let parts = split(signed, \".\")",
"if length(parts) < 2 {",
"return .None",
"}",
"let value = join(slice(parts, 0, length(parts) - 1), \".\")",
"let given = parts[length(parts) - 1]",
"if equal_constant_time(to_bytes(signature(secret, value)), to_bytes(given)) { .Some(value) } else { .None }",
"}",
"",
"note \"A CSRF token bound to the session; put it in forms and check it with `check_csrf` on every state-changing request.\"",
"pub fn csrf_token(secret: Text, session_id: Text) -> Text = signature(secret, \"csrf:\\(session_id)\")",
"",
"pub fn check_csrf(secret: Text, session_id: Text, token: Text) -> Bool = equal_constant_time(to_bytes(csrf_token(secret, session_id)), to_bytes(token))",
"",
"// ---------- HTTP client (plain HTTP; effect `net`) ----------",
"",
"pub type ClientResponse {",
"status: Int",
"headers: Map[Text, Text]",
"body: Bytes",
"}",
"",
"fn find_header_end(data: Bytes) -> Option[Int] {",
"if length(data) < 4 {",
"return .None",
"}",
"for index in range(0, length(data) - 3) {",
"if data[index] == 13 and data[index + 1] == 10 and data[index + 2] == 13 and data[index + 3] == 10 {",
"return .Some(index)",
"}",
"}",
".None",
"}",
"",
"pub fn fetch(method: Text, address: Text, headers: List[Header], body: Bytes) -> Result[ClientResponse, Text] uses net {",
"var lines: List[Text] = []",
"for h in headers {",
"set lines += [\"\\(h.name): \\(h.value)\"]",
"}",
"let raw = try net_request(method, address, lines, body)",
"let end = find_header_end(raw) else return .Error(\"malformed response\")",
"let head = value_or(from_bytes(slice(raw, 0, end)), \"\")",
"let head_lines = split(head, \"\\u{d}\\n\")",
"let status_parts = split(head_lines[0], \" \")",
"let status = if length(status_parts) > 1 { value_or(parse_int(status_parts[1]), 0) } else { 0 }",
"var found: Map[Text, Text] = [:]",
"for line in slice(head_lines, 1, length(head_lines)) {",
"let position = index_of(line, \":\") else continue",
"set found = put(found, to_lower(trim(slice_text(line, 0, position))), trim(slice_text(line, position + 1, length(line))))",
"}",
".Ok(ClientResponse { status: status, headers: found, body: slice(raw, end + 4, length(raw)) })",
"}",
"",
"pub fn get_text(address: Text) -> Result[Text, Text] uses net {",
"let r = try fetch(\"GET\", address, [], to_bytes(\"\"))",
".Ok(value_or(from_bytes(r.body), \"\"))",
"}",
"",
"// ---------- used by the compiler's host glue; not needed in applications ----------",
"",
"pub fn from_raw(method: Text, raw_path: Text, raw_query: Text, remote: Text, names: List[Text], values: List[Text], body: Bytes) -> Request {",
"var headers: Map[Text, Text] = [:]",
"for index in range(0, length(names)) {",
"let name = to_lower(names[index])",
"let joined = match get(headers, name) {",
".Some(earlier) => if name == \"cookie\" { \"\\(earlier); \\(values[index])\" } else { \"\\(earlier), \\(values[index])\" }",
".None => values[index]",
"}",
"set headers = put(headers, name, joined)",
"}",
"Request { method: to_upper(method), path: value_or(url.percent_decode(raw_path), raw_path), raw_path: raw_path, query: url.parse_query(raw_query), raw_query: raw_query, headers: headers, body: body, remote_address: remote }",
"}",
"",
"pub fn status_of(r: Response) -> Int = r.status",
"",
"pub fn header_names_of(r: Response) -> List[Text] {",
"var out: List[Text] = []",
"for h in r.headers {",
"set out += [h.name]",
"}",
"out",
"}",
"",
"pub fn header_values_of(r: Response) -> List[Text] {",
"var out: List[Text] = []",
"for h in r.headers {",
"set out += [h.value]",
"}",
"out",
"}",
"",
"pub fn body_of(r: Response) -> Bytes = r.body",
"",
"note \"Builds a request for tests of `handle`: `http.request(\\\"GET\\\", \\\"/items?id=4\\\", \\\"\\\")`.\"",
"pub fn request(method: Text, target: Text, body: Text) -> Request {",
"let position = index_of(target, \"?\")",
"let raw_path = match position {",
".Some(p) => slice_text(target, 0, p)",
".None => target",
"}",
"let raw_query = match position {",
".Some(p) => slice_text(target, p + 1, length(target))",
".None => \"\"",
"}",
"from_raw(method, raw_path, raw_query, \"127.0.0.1\", [], [], to_bytes(body))",
"}",
"",
"pub fn response_text(r: Response) -> Text = value_or(from_bytes(r.body), \"\")",
"",
]
join(lines, "\n")
}

note "Generated from std/json.tes; do not edit by hand."
pub fn std_json() -> Text {
let lines = [
"// std/json: JSON values, parsing and encoding (RFC 8259).",
"// Numbers are `Decimal` (9 decimal places); more precise numbers are rounded half away from zero.",
"",
"pub enum Json {",
"Null",
"Bool(value: Bool)",
"Number(value: Decimal)",
"String(value: Text)",
"Array(items: List[Json])",
"Object(fields: Map[Text, Json])",
"}",
"",
"// ---------- reading values ----------",
"",
"pub fn field(json: Json, name: Text) -> Option[Json] {",
"match json {",
".Object(fields) => get(fields, name)",
"_ => .None",
"}",
"}",
"",
"pub fn as_text(json: Json) -> Option[Text] {",
"match json {",
".String(value) => .Some(value)",
"_ => .None",
"}",
"}",
"",
"pub fn as_bool(json: Json) -> Option[Bool] {",
"match json {",
".Bool(value) => .Some(value)",
"_ => .None",
"}",
"}",
"",
"pub fn as_decimal(json: Json) -> Option[Decimal] {",
"match json {",
".Number(value) => .Some(value)",
"_ => .None",
"}",
"}",
"",
"note \"Only whole numbers; `1.5` gives `.None`.\"",
"pub fn as_int(json: Json) -> Option[Int] {",
"match json {",
".Number(value) => if decimal(to_int(value)) == value { .Some(to_int(value)) } else { .None }",
"_ => .None",
"}",
"}",
"",
"note \"The items of an array; an empty list for anything else.\"",
"pub fn as_list(json: Json) -> List[Json] {",
"match json {",
".Array(items) => items",
"_ => []",
"}",
"}",
"",
"pub fn text_field(json: Json, name: Text) -> Option[Text] {",
"let value = field(json, name) else return .None",
"as_text(value)",
"}",
"",
"pub fn int_field(json: Json, name: Text) -> Option[Int] {",
"let value = field(json, name) else return .None",
"as_int(value)",
"}",
"",
"pub fn from_int(value: Int) -> Json = .Number(decimal(value))",
"",
"// ---------- encoding ----------",
"",
"fn hex4(code: Int) -> Text {",
"let digits = split(\"0123456789abcdef\", \"\")",
"\"\\(digits[code / 4096 % 16])\\(digits[code / 256 % 16])\\(digits[code / 16 % 16])\\(digits[code % 16])\"",
"}",
"",
"pub fn quote(text: Text) -> Text {",
"var out = \"\\\"\"",
"for code in code_points(text) {",
"set out += if code == 34 { \"\\\\\\\"\" } else if code == 92 { \"\\\\\\\\\" } else if code == 10 { \"\\\\n\" } else if code == 13 { \"\\\\r\" } else if code == 9 { \"\\\\t\" } else if code < 32 { \"\\\\u\\(hex4(code))\" } else { from_code_point(code) }",
"}",
"out + \"\\\"\"",
"}",
"",
"note \"Compact JSON; object keys in sorted order, so the output is deterministic.\"",
"pub fn encode(json: Json) -> Text {",
"match json {",
".Null => \"null\"",
".Bool(value) => if value { \"true\" } else { \"false\" }",
".Number(value) => to_text(value)",
".String(value) => quote(value)",
".Array(items) => {",
"var parts: List[Text] = []",
"for item in items {",
"set parts += [encode(item)]",
"}",
"\"[\\(join(parts, \",\"))]\"",
"}",
".Object(fields) => {",
"var parts: List[Text] = []",
"for key in keys(fields) {",
"let value = get(fields, key) else continue",
"set parts += [\"\\(quote(key)):\\(encode(value))\"]",
"}",
"\"{\\(join(parts, \",\"))}\"",
"}",
"}",
"}",
"",
"// ---------- parsing ----------",
"",
"type Parsed {",
"value: Json",
"next: Int",
"}",
"",
"type Reader {",
"codes: List[Int]",
"}",
"",
"fn skip_space(r: Reader, start: Int) -> Int {",
"var index = start",
"while index < length(r.codes) and (r.codes[index] == 32 or r.codes[index] == 9 or r.codes[index] == 10 or r.codes[index] == 13) {",
"set index += 1",
"}",
"index",
"}",
"",
"fn at(r: Reader, index: Int) -> Int = if index < length(r.codes) { r.codes[index] } else { -1 }",
"",
"fn expect_word(r: Reader, index: Int, word: Text, value: Json) -> Result[Parsed, Text] {",
"let wanted = code_points(word)",
"for offset in range(0, length(wanted)) {",
"if at(r, index + offset) != wanted[offset] {",
"return .Error(\"invalid value at position \\(index)\")",
"}",
"}",
".Ok(Parsed { value: value, next: index + length(wanted) })",
"}",
"",
"fn hex_digit(code: Int) -> Int {",
"if code >= 48 and code <= 57 {",
"return code - 48",
"}",
"if code >= 65 and code <= 70 {",
"return code - 55",
"}",
"if code >= 97 and code <= 102 {",
"return code - 87",
"}",
"-1",
"}",
"",
"fn read_hex4(r: Reader, index: Int) -> Int {",
"var value = 0",
"for offset in range(0, 4) {",
"let digit = hex_digit(at(r, index + offset))",
"if digit < 0 {",
"return -1",
"}",
"set value = value * 16 + digit",
"}",
"value",
"}",
"",
"type ParsedText {",
"text: Text",
"next: Int",
"}",
"",
"fn parse_string(r: Reader, start: Int) -> Result[ParsedText, Text] {",
"var index = start + 1",
"var out: List[Int] = []",
"while true {",
"let code = at(r, index)",
"if code == -1 {",
"return .Error(\"unterminated string starting at position \\(start)\")",
"}",
"if code == 34 {",
"return .Ok(ParsedText { text: from_code_points(out), next: index + 1 })",
"}",
"if code < 32 {",
"return .Error(\"control character in string at position \\(index)\")",
"}",
"if code != 92 {",
"set out += [code]",
"set index += 1",
"continue",
"}",
"let escaped = at(r, index + 1)",
"if escaped == 117 {",
"var value = read_hex4(r, index + 2)",
"if value < 0 {",
"return .Error(\"invalid \\\\u escape at position \\(index)\")",
"}",
"set index += 6",
"if value >= 55296 and value <= 56319 {",
"let low = if at(r, index) == 92 and at(r, index + 1) == 117 { read_hex4(r, index + 2) } else { -1 }",
"if low < 56320 or low > 57343 {",
"return .Error(\"unpaired surrogate at position \\(index)\")",
"}",
"set value = 65536 + (value - 55296) * 1024 + (low - 56320)",
"set index += 6",
"} else if value >= 56320 and value <= 57343 {",
"return .Error(\"unpaired surrogate at position \\(index)\")",
"}",
"set out += [value]",
"continue",
"}",
"let replacement = match escaped {",
"34 => 34",
"92 => 92",
"47 => 47",
"98 => 8",
"102 => 12",
"110 => 10",
"114 => 13",
"116 => 9",
"_ => -1",
"}",
"if replacement < 0 {",
"return .Error(\"invalid escape at position \\(index)\")",
"}",
"set out += [replacement]",
"set index += 2",
"}",
".Error(\"unreachable\")",
"}",
"",
"fn is_digit(code: Int) -> Bool = code >= 48 and code <= 57",
"",
"note \"Builds the `Decimal` from the digits and exponent, rounding beyond 9 decimal places.\"",
"fn number_value(negative: Bool, digits: List[Int], point: Int, exponent: Int) -> Option[Decimal] {",
"// `digits` with the decimal point after `point` digits, times 10^exponent.",
"let shift = point + exponent",
"var whole: List[Int] = []",
"var fraction: List[Int] = []",
"for index in range(0, length(digits)) {",
"if index < shift {",
"set whole += [digits[index]]",
"} else {",
"set fraction += [digits[index]]",
"}",
"}",
"if shift < 0 {",
"set fraction = concat(split_zeros(0 - shift), fraction)",
"}",
"var whole_text = from_code_points(whole)",
"if whole_text == \"\" {",
"set whole_text = \"0\"",
"}",
"var missing = shift - length(digits)",
"while missing > 0 {",
"set whole_text += \"0\"",
"set missing -= 1",
"}",
"let kept = if length(fraction) > 9 { slice(fraction, 0, 9) } else { fraction }",
"let text = if length(kept) == 0 { whole_text } else { \"\\(whole_text).\\(from_code_points(kept))\" }",
"var value = parse_decimal(text) else return .None",
"if length(fraction) > 9 and fraction[9] >= 53 {",
"let smallest = parse_decimal(\"0.000000001\") else return .None",
"set value += smallest",
"}",
".Some(if negative { -value } else { value })",
"}",
"",
"fn split_zeros(count: Int) -> List[Int] {",
"var out: List[Int] = []",
"for _ in range(0, count) {",
"set out += [48]",
"}",
"out",
"}",
"",
"fn parse_number(r: Reader, start: Int) -> Result[Parsed, Text] {",
"var index = start",
"let negative = at(r, index) == 45",
"if negative {",
"set index += 1",
"}",
"var digits: List[Int] = []",
"if not is_digit(at(r, index)) {",
"return .Error(\"invalid number at position \\(start)\")",
"}",
"if at(r, index) == 48 and is_digit(at(r, index + 1)) {",
"return .Error(\"leading zero in number at position \\(start)\")",
"}",
"while is_digit(at(r, index)) {",
"set digits += [at(r, index)]",
"set index += 1",
"}",
"let point = length(digits)",
"if at(r, index) == 46 {",
"set index += 1",
"if not is_digit(at(r, index)) {",
"return .Error(\"invalid number at position \\(start)\")",
"}",
"while is_digit(at(r, index)) {",
"set digits += [at(r, index)]",
"set index += 1",
"}",
"}",
"var exponent = 0",
"if at(r, index) == 101 or at(r, index) == 69 {",
"set index += 1",
"var exponent_negative = false",
"if at(r, index) == 43 or at(r, index) == 45 {",
"set exponent_negative = at(r, index) == 45",
"set index += 1",
"}",
"if not is_digit(at(r, index)) {",
"return .Error(\"invalid exponent at position \\(start)\")",
"}",
"while is_digit(at(r, index)) {",
"if exponent > 1000 {",
"return .Error(\"number out of range at position \\(start)\")",
"}",
"set exponent = exponent * 10 + (at(r, index) - 48)",
"set index += 1",
"}",
"if exponent_negative {",
"set exponent = 0 - exponent",
"}",
"}",
"let value = number_value(negative, digits, point, exponent) else return .Error(\"number out of range at position \\(start)\")",
".Ok(Parsed { value: .Number(value), next: index })",
"}",
"",
"fn parse_value(r: Reader, start: Int, depth: Int) -> Result[Parsed, Text] {",
"if depth > 500 {",
"return .Error(\"nesting too deep at position \\(start)\")",
"}",
"let index = skip_space(r, start)",
"let code = at(r, index)",
"if code == 123 {",
"return parse_object(r, index, depth)",
"}",
"if code == 91 {",
"return parse_array(r, index, depth)",
"}",
"if code == 34 {",
"let s = try parse_string(r, index)",
"return .Ok(Parsed { value: .String(s.text), next: s.next })",
"}",
"if code == 116 {",
"return expect_word(r, index, \"true\", .Bool(true))",
"}",
"if code == 102 {",
"return expect_word(r, index, \"false\", .Bool(false))",
"}",
"if code == 110 {",
"return expect_word(r, index, \"null\", .Null)",
"}",
"if code == 45 or is_digit(code) {",
"return parse_number(r, index)",
"}",
"if code == -1 {",
"return .Error(\"unexpected end of input\")",
"}",
".Error(\"unexpected character at position \\(index)\")",
"}",
"",
"fn parse_array(r: Reader, start: Int, depth: Int) -> Result[Parsed, Text] {",
"var items: List[Json] = []",
"var index = skip_space(r, start + 1)",
"if at(r, index) == 93 {",
"return .Ok(Parsed { value: .Array(items), next: index + 1 })",
"}",
"while true {",
"let item = try parse_value(r, index, depth + 1)",
"set items += [item.value]",
"set index = skip_space(r, item.next)",
"if at(r, index) == 44 {",
"set index += 1",
"} else if at(r, index) == 93 {",
"return .Ok(Parsed { value: .Array(items), next: index + 1 })",
"} else {",
"return .Error(\"expected `,` or `]` at position \\(index)\")",
"}",
"}",
".Error(\"unreachable\")",
"}",
"",
"fn parse_object(r: Reader, start: Int, depth: Int) -> Result[Parsed, Text] {",
"var fields: Map[Text, Json] = [:]",
"var index = skip_space(r, start + 1)",
"if at(r, index) == 125 {",
"return .Ok(Parsed { value: .Object(fields), next: index + 1 })",
"}",
"while true {",
"if at(r, index) != 34 {",
"return .Error(\"expected a string key at position \\(index)\")",
"}",
"let key = try parse_string(r, index)",
"set index = skip_space(r, key.next)",
"if at(r, index) != 58 {",
"return .Error(\"expected `:` at position \\(index)\")",
"}",
"let value = try parse_value(r, index + 1, depth + 1)",
"set fields = put(fields, key.text, value.value)",
"set index = skip_space(r, value.next)",
"if at(r, index) == 44 {",
"set index = skip_space(r, index + 1)",
"} else if at(r, index) == 125 {",
"return .Ok(Parsed { value: .Object(fields), next: index + 1 })",
"} else {",
"return .Error(\"expected `,` or `}` at position \\(index)\")",
"}",
"}",
".Error(\"unreachable\")",
"}",
"",
"note \"Parses one JSON value; positions in error messages count characters from 0.\"",
"pub fn parse(text: Text) -> Result[Json, Text] {",
"let r = Reader { codes: code_points(text) }",
"let parsed = try parse_value(r, 0, 0)",
"let rest = skip_space(r, parsed.next)",
"if rest != length(r.codes) {",
"return .Error(\"unexpected text after the value at position \\(rest)\")",
"}",
".Ok(parsed.value)",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/keys.tes; do not edit by hand."
pub fn std_keys() -> Text {
let lines = [
"// std/keys: which keys are held down, from the `Key` and `KeyUp` window events, and what was",
"// typed recently (for shortcuts and codes). Key names are compared in lower case, so Shift does",
"// not matter. Effects: none.",
"",
"pub type Keys {",
"held: List[Text]",
"typed: Text",
"}",
"",
"pub fn none() -> Keys = Keys { held: [], typed: \"\" }",
"",
"note \"The keys after a window event: `Key` holds a key down and adds a one-character key to the typed text (the last 32 characters are kept), `KeyUp` lets go. Other events change nothing.\"",
"pub fn update(keys: Keys, event: WindowEvent) -> Keys {",
"match event {",
".Key(name) => {",
"let lower = to_lower(name)",
"let held = if contains(keys.held, lower) { keys.held } else { keys.held + [lower] }",
"var typed = keys.typed",
"if length(name) == 1 {",
"set typed += lower",
"if length(typed) > 32 {",
"set typed = slice_text(typed, length(typed) - 32, length(typed))",
"}",
"}",
"keys with { held: held, typed: typed }",
"}",
".KeyUp(name) => keys with { held: filter_out(keys.held, to_lower(name)) }",
"_ => keys",
"}",
"}",
"",
"fn filter_out(names: List[Text], name: Text) -> List[Text] {",
"var out: List[Text] = []",
"for n in names {",
"if n != name {",
"set out += [n]",
"}",
"}",
"out",
"}",
"",
"pub fn held(keys: Keys, name: Text) -> Bool = contains(keys.held, to_lower(name))",
"",
"note \"Whether any of the named keys is held.\"",
"pub fn any_held(keys: Keys, names: List[Text]) -> Bool {",
"for name in names {",
"if held(keys, name) {",
"return true",
"}",
"}",
"false",
"}",
"",
"note \"Whether the typed text ends with `word` (lower case); use `forget_typed` after acting on it.\"",
"pub fn typed(keys: Keys, word: Text) -> Bool = ends_with(keys.typed, to_lower(word))",
"",
"pub fn forget_typed(keys: Keys) -> Keys = keys with { typed: \"\" }",
"",
"note \"Lets go of every key, for example when a menu opens.\"",
"pub fn release_all(keys: Keys) -> Keys = keys with { held: [] }",
"",
]
join(lines, "\n")
}

note "Generated from std/logging.tes; do not edit by hand."
pub fn std_logging() -> Text {
let lines = [
"// std/logging: levels, context fields and structured log lines (draft 0.23).",
"//",
"// There are no global variables, so a `Logger` is a value: make one at the start",
"// (usually from the configuration), add context fields such as a request id, and",
"// pass it to the functions that log. Lines go to the `log` built-in, which writes",
"// standard error and, in a web host, the server's error log.",
"//",
"//     import std/logging",
"//     let logger = logging.with_field(logging.new(.Info), \"request\", request_id)",
"//     logging.info(logger, \"user logged in\", [\"user\": name])",
"//     // [info] user logged in request=7f3a user=alice",
"//",
"// Every value is escaped, so a newline in user input can never start a forged line.",
"",
"import std/json",
"",
"pub enum Level {",
"Debug",
"Info",
"Warning",
"Error",
"}",
"",
"pub enum Format {",
"Text",
"Json",
"}",
"",
"pub type Field {",
"key: Text",
"value: Text",
"}",
"",
"pub type Logger {",
"level: Level",
"format: Format",
"fields: List[Field]",
"}",
"",
"note \"A logger that writes lines of `level` and above in the text format, without context fields. Change the format with `logger with { format: .Json }`.\"",
"pub fn new(level: Level) -> Logger = Logger { level: level, format: .Text, fields: [] }",
"",
"note \"A copy of `logger` that adds `key=value` to every line, after the message and before the fields of the call. Context fields keep the order in which they were added.\"",
"pub fn with_field(logger: Logger, key: Text, value: Text) -> Logger = logger with { fields: logger.fields + [Field { key: key, value: value }] }",
"",
"note \"A copy of `logger` that writes lines of `level` and above.\"",
"pub fn with_level(logger: Logger, level: Level) -> Logger = logger with { level: level }",
"",
"note \"The level for a name such as `\\\"info\\\"` from a configuration file or environment variable: `debug`, `info`, `warning` (also `warn`) or `error`, in any case.\"",
"pub fn parse_level(text: Text) -> Option[Level] {",
"match to_lower(trim(text)) {",
"\"debug\" => .Some(.Debug)",
"\"info\" => .Some(.Info)",
"\"warning\" => .Some(.Warning)",
"\"warn\" => .Some(.Warning)",
"\"error\" => .Some(.Error)",
"_ => .None",
"}",
"}",
"",
"note \"The lowercase name of a level, as passed to the `log` built-in.\"",
"pub fn level_name(level: Level) -> Text {",
"match level {",
".Debug => \"debug\"",
".Info => \"info\"",
".Warning => \"warning\"",
".Error => \"error\"",
"}",
"}",
"",
"fn rank(level: Level) -> Int {",
"match level {",
".Debug => 0",
".Info => 1",
".Warning => 2",
".Error => 3",
"}",
"}",
"",
"note \"Whether `logger` writes lines of `level`. Check it before building an expensive message.\"",
"pub fn enabled(logger: Logger, level: Level) -> Bool = rank(level) >= rank(logger.level)",
"",
"note \"The line `logger` writes for a message, without the level prefix the `log` built-in adds, whether or not the level is enabled. Use it to write log lines somewhere else, such as a file.\"",
"pub fn render(logger: Logger, level: Level, message: Text, fields: Map[Text, Text]) -> Text {",
"var all = logger.fields",
"for key in keys(fields) {",
"set all += [Field { key: key, value: value_or(get(fields, key), \"\") }]",
"}",
"match logger.format {",
".Text => render_text(message, all)",
".Json => render_json(level, message, all)",
"}",
"}",
"",
"fn render_text(message: Text, fields: List[Field]) -> Text {",
"var out = escape_controls(message)",
"for field in fields {",
"set out += \" \\(field_key(field.key))=\\(field_value(field.value))\"",
"}",
"out",
"}",
"",
"fn render_json(level: Level, message: Text, fields: List[Field]) -> Text {",
"var out = \"{\\\"level\\\":\\\"\\(level_name(level))\\\",\\\"message\\\":\\(json.quote(message))\"",
"for field in fields {",
"set out += \",\\(json.quote(field.key)):\\(json.quote(field.value))\"",
"}",
"out + \"}\"",
"}",
"",
"note \"A key is written as it is when it consists of letters, digits, `_`, `-` and `.`; anything else becomes `_`, so a key can never break the line apart.\"",
"fn field_key(key: Text) -> Text {",
"if key == \"\" {",
"return \"_\"",
"}",
"var out = \"\"",
"for code in code_points(key) {",
"set out += if is_key_code(code) { from_code_point(code) } else { \"_\" }",
"}",
"out",
"}",
"",
"fn is_key_code(code: Int) -> Bool {",
"if code >= 97 and code <= 122 {",
"return true",
"}",
"if code >= 65 and code <= 90 {",
"return true",
"}",
"if code >= 48 and code <= 57 {",
"return true",
"}",
"code == 95 or code == 45 or code == 46",
"}",
"",
"note \"A value is quoted, as a JSON string, when it is empty or contains a space, `=`, `\\\"` or a control character; otherwise it is written as it is.\"",
"fn field_value(value: Text) -> Text {",
"if value == \"\" {",
"return \"\\\"\\\"\"",
"}",
"for code in code_points(value) {",
"if code <= 32 or code == 61 or code == 34 or code == 127 {",
"return json.quote(value)",
"}",
"}",
"value",
"}",
"",
"fn escape_controls(text: Text) -> Text {",
"var out = \"\"",
"for code in code_points(text) {",
"set out += if code == 10 { \"\\\\n\" } else if code == 13 { \"\\\\r\" } else if code == 9 { \"\\\\t\" } else if code < 32 or code == 127 { \"\\\\u\\(pad_left(hex_digits(code), 4, \"0\"))\" } else { from_code_point(code) }",
"}",
"out",
"}",
"",
"fn hex_digits(value: Int) -> Text {",
"let digits = split(\"0123456789abcdef\", \"\")",
"if value < 16 {",
"return digits[value]",
"}",
"hex_digits(value / 16) + digits[value % 16]",
"}",
"",
"note \"Writes `message` with the logger's context fields and `fields` (in key order) at `level`, if the logger writes that level.\"",
"pub fn write(logger: Logger, level: Level, message: Text, fields: Map[Text, Text]) -> Unit uses log {",
"if enabled(logger, level) {",
"log(level_name(level), render(logger, level, message, fields))",
"}",
"}",
"",
"note \"`write` at level `.Debug`.\"",
"pub fn debug(logger: Logger, message: Text, fields: Map[Text, Text]) -> Unit uses log = write(logger, .Debug, message, fields)",
"",
"note \"`write` at level `.Info`.\"",
"pub fn info(logger: Logger, message: Text, fields: Map[Text, Text]) -> Unit uses log = write(logger, .Info, message, fields)",
"",
"note \"`write` at level `.Warning`.\"",
"pub fn warning(logger: Logger, message: Text, fields: Map[Text, Text]) -> Unit uses log = write(logger, .Warning, message, fields)",
"",
"note \"`write` at level `.Error`.\"",
"pub fn error(logger: Logger, message: Text, fields: Map[Text, Text]) -> Unit uses log = write(logger, .Error, message, fields)",
"",
]
join(lines, "\n")
}

note "Generated from std/math.tes; do not edit by hand."
pub fn std_math() -> Text {
let lines = [
"// std/math: small integer helpers. Effects: none.",
"",
"pub fn min(a: Int, b: Int) -> Int = if a < b { a } else { b }",
"",
"pub fn max(a: Int, b: Int) -> Int = if a > b { a } else { b }",
"",
"note \"`value` limited to `low` to `high`. Stops with R010 if `low > high`.\"",
"pub fn clamp(value: Int, low: Int, high: Int) -> Int {",
"if low > high {",
"fail(\"clamp: low \\(low) is greater than high \\(high)\")",
"}",
"min(max(value, low), high)",
"}",
"",
"note \"The absolute value. The smallest `Int` has no positive counterpart: R002.\"",
"pub fn abs(value: Int) -> Int = if value < 0 { -value } else { value }",
"",
"note \"The integer square root: the largest `r` with `r * r <= value`, exact for every `Int` (digit by digit, no overflow). Stops with R010 for a negative value.\"",
"pub fn isqrt(value: Int) -> Int {",
"if value < 0 {",
"fail(\"isqrt of the negative number \\(value)\")",
"}",
"var rest = value",
"var root = 0",
"var bit = shift_left(1, 62)",
"while bit > rest {",
"set bit = shift_right(bit, 2)",
"}",
"while bit != 0 {",
"if rest >= root + bit {",
"set rest -= root + bit",
"set root = shift_right(root, 1) + bit",
"} else {",
"set root = shift_right(root, 1)",
"}",
"set bit = shift_right(bit, 2)",
"}",
"root",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/palette.tes; do not edit by hand."
pub fn std_palette() -> Text {
let lines = [
"// std/palette: 256-color RGB palettes stored as 768 bytes, three per color (red, green, blue),",
"// as in DOOM's PLAYPAL lump, PCX files and GIF color tables. Colors are packed like the built-in",
"// `rgb(red, green, blue)`, so they can be drawn with the `ui` functions too.",
"// Effects: none.",
"",
"note \"The 256 colors of the palette that starts at `at`. R001 if fewer than 768 bytes follow.\"",
"pub fn read(data: Bytes, at: Int) -> List[Int] {",
"var colors: List[Int] = []",
"for index in range(0, 256) {",
"let base = at + index * 3",
"set colors += [rgb(data[base], data[base + 1], data[base + 2])]",
"}",
"colors",
"}",
"",
"pub fn red(color: Int) -> Int = bit_and(shift_right(color, 16), 255)",
"",
"pub fn green(color: Int) -> Int = bit_and(shift_right(color, 8), 255)",
"",
"pub fn blue(color: Int) -> Int = bit_and(color, 255)",
"",
]
join(lines, "\n")
}

note "Generated from std/plane.tes; do not edit by hand."
pub fn std_plane() -> Text {
let lines = [
"// std/plane: 2D geometry in 16.16 fixed point (std/fixed) for games and simulations: where a ray",
"// meets a segment, whether segments cross, whether a circle touches a segment, and the nearest",
"// of a set of directions. Points are fixed values; segment end points are whole units (so the",
"// products stay below 2^51). Effects: none.",
"",
"import std/fixed",
"import std/math",
"",
"note \"Where a ray meets a segment: `distance` is the ray parameter (fixed; with a ray direction of length 1.0 it is the distance), `along` the position on the segment from 0 to 65536 (0.0 to 1.0). `hit` is false when they do not meet in front of the ray.\"",
"pub type Hit {",
"hit: Bool",
"distance: Int",
"along: Int",
"}",
"",
"note \"Exact quotient of a by b as a fixed value, without overflowing a * 65536: magnitudes up to 2^50 for `a` and 2^47 for `b` are safe.\"",
"pub fn ratio(a: Int, b: Int) -> Int {",
"let whole = a / b",
"let rest = a - whole * b",
"whole * fixed.one() + rest * fixed.one() / b",
"}",
"",
"note \"The ray from (px, py) along (dx, dy), all fixed, against the segment (ax, ay)-(bx, by) in whole units. Hits farther than 65536 times the ray direction are ignored.\"",
"pub fn intersect(px: Int, py: Int, dx: Int, dy: Int, ax: Int, ay: Int, bx: Int, by: Int) -> Hit {",
"let none = Hit { hit: false, distance: 0, along: 0 }",
"let lx = bx - ax",
"let ly = by - ay",
"let den = dx * ly - dy * lx",
"if den == 0 {",
"return none",
"}",
"let ex = fixed.from_int(ax) - px",
"let ey = fixed.from_int(ay) - py",
"let t_num = ex * ly - ey * lx",
"let u_num = fixed.mul(ex, dy) - fixed.mul(ey, dx)",
"if den > 0 {",
"if t_num <= 0 or u_num < 0 or u_num > den {",
"return none",
"}",
"} else if t_num >= 0 or u_num > 0 or u_num < den {",
"return none",
"}",
"if t_num / den > 65536 {",
"return none",
"}",
"Hit { hit: true, distance: ratio(t_num, den), along: ratio(u_num, den) }",
"}",
"",
"note \"Which side of the line a-b the point p is on (all fixed): 1 left, -1 right, 0 on it. Computed with 8 fraction bits so it cannot overflow.\"",
"pub fn orient(ax: Int, ay: Int, bx: Int, by: Int, px: Int, py: Int) -> Int {",
"let cross = shift_right(bx - ax, 8) * shift_right(py - ay, 8) - shift_right(by - ay, 8) * shift_right(px - ax, 8)",
"if cross > 0 { 1 } else if cross < 0 { -1 } else { 0 }",
"}",
"",
"note \"Whether segment p-q properly crosses segment a-b (all fixed).\"",
"pub fn crosses(px: Int, py: Int, qx: Int, qy: Int, ax: Int, ay: Int, bx: Int, by: Int) -> Bool {",
"orient(px, py, qx, qy, ax, ay) * orient(px, py, qx, qy, bx, by) < 0 and orient(ax, ay, bx, by, px, py) * orient(ax, ay, bx, by, qx, qy) < 0",
"}",
"",
"note \"Whether a circle of `radius` units at (x, y) (fixed) touches the segment (ax, ay)-(bx, by) in whole units. Distances are compared with 8 fraction bits, so squares stay below 2^52.\"",
"pub fn circle_touches(x: Int, y: Int, radius: Int, ax: Int, ay: Int, bx: Int, by: Int) -> Bool {",
"let r = fixed.from_int(radius)",
"if x + r <= fixed.from_int(math.min(ax, bx)) or x - r >= fixed.from_int(math.max(ax, bx)) or y + r <= fixed.from_int(math.min(ay, by)) or y - r >= fixed.from_int(math.max(ay, by)) {",
"return false",
"}",
"let lx = bx - ax",
"let ly = by - ay",
"let ex = x - fixed.from_int(ax)",
"let ey = y - fixed.from_int(ay)",
"let length_squared = lx * lx + ly * ly",
"let t = if length_squared == 0 { 0 } else { math.clamp((ex * lx + ey * ly) / length_squared, 0, fixed.one()) }",
"let nx = shift_right(ex - lx * t, 8)",
"let ny = shift_right(ey - ly * t, 8)",
"let limit = shift_right(r, 8)",
"nx * nx + ny * ny < limit * limit",
"}",
"",
"note \"The index of the direction, among `count` evenly spaced ones from tables of cosines and sines (as made by std/fixed `cosine_table` and `sine_table`), that points most nearly along (dx, dy) (fixed). The result is an index into the tables.\"",
"pub fn direction(dx: Int, dy: Int, cosines: List[Int], sines: List[Int], count: Int) -> Int {",
"let x = shift_right(dx, 8)",
"let y = shift_right(dy, 8)",
"let step = length(cosines) / count",
"var best = 0",
"var best_dot = 0",
"for k in range(0, count) {",
"let a = k * step",
"let dot = x * shift_right(cosines[a], 8) + y * shift_right(sines[a], 8)",
"if k == 0 or dot > best_dot {",
"set best = a",
"set best_dot = dot",
"}",
"}",
"best",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/ppm.tes; do not edit by hand."
pub fn std_ppm() -> Text {
let lines = [
"// std/ppm: binary PPM (P6) images, the simplest format every image viewer opens.",
"// Effects: none; write the result with `write_bytes`.",
"",
"note \"An image of `width` x `height` palette indexes, row by row from the top left; `palette` holds colors packed like `rgb(...)`. R010 for a side that is not positive or a pixel count other than `width * height`; R001 for an index outside the palette.\"",
"pub fn encode(width: Int, height: Int, pixels: List[Int], palette: List[Int]) -> Bytes {",
"if width <= 0 or height <= 0 {",
"fail(\"ppm.encode: the image is \\(width) x \\(height); both sides must be positive\")",
"}",
"if length(pixels) != width * height {",
"fail(\"ppm.encode: \\(length(pixels)) pixels for a \\(width) x \\(height) image, expected \\(width * height)\")",
"}",
"var body = bytes(repeat([0], width * height * 3))",
"var at = 0",
"for index in pixels {",
"let color = palette[index]",
"set body[at] = bit_and(shift_right(color, 16), 255)",
"set body[at + 1] = bit_and(shift_right(color, 8), 255)",
"set body[at + 2] = bit_and(color, 255)",
"set at += 3",
"}",
"to_bytes(\"P6\\n\\(width) \\(height)\\n255\\n\") + body",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/raster.tes; do not edit by hand."
pub fn std_raster() -> Text {
let lines = [
"// std/raster: images drawn in software. An image is a grid of Int values, row by row from the",
"// top left: colors made with `rgb` (draw it with `draw_pixels`), or palette indexes (turn them",
"// into colors with `remap`). Every function returns the changed image and changes it in place",
"// when called as `set image = raster.f(image, ...)`. Drawing is clipped to the image.",
"// Effects: none.",
"",
"import std/math",
"",
"pub type Image {",
"width: Int",
"height: Int",
"pixels: List[Int]",
"}",
"",
"note \"A bitmap font: one image per character code, drawn with `transparent` pixels left out. `space` is the width of a character the font does not have.\"",
"pub type Font {",
"glyphs: Map[Int, Image]",
"space: Int",
"transparent: Int",
"}",
"",
"note \"A `width` x `height` image filled with `value`. R010 for a side that is not positive.\"",
"pub fn blank(width: Int, height: Int, value: Int) -> Image {",
"if width <= 0 or height <= 0 {",
"fail(\"raster.blank: the image is \\(width) x \\(height); both sides must be positive\")",
"}",
"Image { width: width, height: height, pixels: repeat([value], width * height) }",
"}",
"",
"note \"An image from a list of values, `width` per row. R010 if the length is not a multiple of `width`.\"",
"pub fn from_pixels(width: Int, pixels: List[Int]) -> Image {",
"if width <= 0 or length(pixels) % width != 0 {",
"fail(\"raster.from_pixels: \\(length(pixels)) values do not make rows of \\(width)\")",
"}",
"Image { width: width, height: length(pixels) / width, pixels: pixels }",
"}",
"",
"note \"The value at (x, y), or `outside` when that is not in the image.\"",
"pub fn pixel(image: Image, x: Int, y: Int, outside: Int) -> Int = if x < 0 or y < 0 or x >= image.width or y >= image.height { outside } else { image.pixels[y * image.width + x] }",
"",
"note \"Fills the rectangle with its top-left corner at (x, y).\"",
"pub fn fill(image: Image, x: Int, y: Int, width: Int, height: Int, value: Int) -> Image {",
"var out = image",
"let left = math.max(x, 0)",
"let right = math.min(x + width, out.width)",
"let top = math.max(y, 0)",
"let bottom = math.min(y + height, out.height)",
"if left >= right or top >= bottom {",
"return out",
"}",
"for row in range(top, bottom) {",
"for column in range(left, right) {",
"set out.pixels[row * out.width + column] = value",
"}",
"}",
"out",
"}",
"",
"note \"A straight line from (x0, y0) to (x1, y1), both ends included, with integer (Bresenham) steps.\"",
"pub fn line(image: Image, x0: Int, y0: Int, x1: Int, y1: Int, value: Int) -> Image {",
"var out = image",
"let dx = math.abs(x1 - x0)",
"let dy = -math.abs(y1 - y0)",
"let step_x = if x0 < x1 { 1 } else { -1 }",
"let step_y = if y0 < y1 { 1 } else { -1 }",
"var error = dx + dy",
"var x = x0",
"var y = y0",
"while true {",
"if x >= 0 and y >= 0 and x < out.width and y < out.height {",
"set out.pixels[y * out.width + x] = value",
"}",
"if x == x1 and y == y1 {",
"break",
"}",
"let twice = 2 * error",
"if twice >= dy {",
"set error += dy",
"set x += step_x",
"}",
"if twice <= dx {",
"set error += dx",
"set y += step_y",
"}",
"}",
"out",
"}",
"",
"note \"Copies `source` with its top-left corner at (x, y), leaving out pixels equal to `transparent`.\"",
"pub fn blit(image: Image, source: Image, x: Int, y: Int, transparent: Int) -> Image {",
"var out = image",
"let left = math.max(x, 0)",
"let right = math.min(x + source.width, out.width)",
"let top = math.max(y, 0)",
"let bottom = math.min(y + source.height, out.height)",
"if left >= right or top >= bottom {",
"return out",
"}",
"for row in range(top, bottom) {",
"let from = (row - y) * source.width - x",
"for column in range(left, right) {",
"let value = source.pixels[from + column]",
"if value != transparent {",
"set out.pixels[row * out.width + column] = value",
"}",
"}",
"}",
"out",
"}",
"",
"note \"Copies `source` scaled to `width` x `height` pixels with its top-left corner at (x, y), each target pixel taking the nearest source pixel; pixels equal to `transparent` are left out. Enlarges (an interface drawn at low resolution over a large view) as well as shrinks.\"",
"pub fn stretch(image: Image, source: Image, x: Int, y: Int, width: Int, height: Int, transparent: Int) -> Image {",
"var out = image",
"if width <= 0 or height <= 0 {",
"return out",
"}",
"let left = math.max(x, 0)",
"let right = math.min(x + width, out.width)",
"let top = math.max(y, 0)",
"let bottom = math.min(y + height, out.height)",
"if left >= right or top >= bottom {",
"return out",
"}",
"for row in range(top, bottom) {",
"let from = (row - y) * source.height / height * source.width",
"for column in range(left, right) {",
"let value = source.pixels[from + (column - x) * source.width / width]",
"if value != transparent {",
"set out.pixels[row * out.width + column] = value",
"}",
"}",
"}",
"out",
"}",
"",
"note \"Replaces every value v by `table[v]`: palette indexes to colors, or a light table that darkens. R001 for a value outside the table.\"",
"pub fn remap(image: Image, table: List[Int]) -> Image {",
"var out = image",
"for i in range(0, length(out.pixels)) {",
"set out.pixels[i] = table[out.pixels[i]]",
"}",
"out",
"}",
"",
"note \"Width in pixels of a text in a font.\"",
"pub fn measure(font: Font, message: Text) -> Int {",
"var total = 0",
"for code in code_points(message) {",
"set total += match get(font.glyphs, code) {",
".Some(g) => g.width",
".None => font.space",
"}",
"}",
"total",
"}",
"",
"note \"Draws a text with its top-left corner at (x, y).\"",
"pub fn text(image: Image, font: Font, x: Int, y: Int, message: Text) -> Image {",
"var out = image",
"var at = x",
"for code in code_points(message) {",
"match get(font.glyphs, code) {",
".Some(g) => {",
"set out = blit(out, g, at, y, font.transparent)",
"set at += g.width",
"}",
".None => set at += font.space",
"}",
"}",
"out",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/rng.tes; do not edit by hand."
pub fn std_rng() -> Text {
let lines = [
"// std/rng: a seeded, repeatable random number generator for games, simulations and tests: the",
"// same seed always gives the same numbers, on every platform. Not for secrets; use the built-in",
"// `random_int` (effect `random`) for those. A linear congruential generator modulo 2^31 whose",
"// products stay below 2^62. Effects: none.",
"",
"note \"The next seed after `seed` (0 to 2^31 - 1).\"",
"pub fn next(seed: Int) -> Int = (seed * 1103515245 + 12345) % 2147483648",
"",
"note \"A number from 0 to 255 and the next seed: [value, seed].\"",
"pub fn byte(seed: Int) -> List[Int] {",
"let n = next(seed)",
"[shift_right(n, 16) % 256, n]",
"}",
"",
"note \"A number from `low` to `high` (inclusive, at most 256 apart for an even spread) and the next seed: [value, seed].\"",
"pub fn roll(seed: Int, low: Int, high: Int) -> List[Int] {",
"let r = byte(seed)",
"[low + r[0] * (high - low + 1) / 256, r[1]]",
"}",
"",
]
join(lines, "\n")
}

note "Generated from std/sound.tes; do not edit by hand."
pub fn std_sound() -> Text {
let lines = [
"// std/sound: sounds for the built-in `play_sound` (effect `audio`): reading WAV files,",
"// making tones, and the volume and stereo position of a sound heard from somewhere in a 2D world.",
"",
"import std/fixed",
"import std/math",
"",
"note \"A sound ready for `play_sound`: 8-bit unsigned mono samples (128 is silence) and their rate.\"",
"pub type Sound {",
"samples: Bytes",
"rate: Int",
"}",
"",
"fn u16(b: Bytes, at: Int) -> Int = bit_or(b[at], shift_left(b[at + 1], 8))",
"",
"fn u32(b: Bytes, at: Int) -> Int = bit_or(u16(b, at), shift_left(u16(b, at + 2), 16))",
"",
"note \"Reads a WAV file (RIFF, uncompressed PCM, 8 or 16 bits, mono or stereo) as a mono 8-bit sound. Stereo is mixed down; 16-bit samples keep their top 8 bits.\"",
"pub fn from_wav(data: Bytes) -> Result[Sound, Text] {",
"if length(data) < 12 or from_bytes(slice(data, 0, 4)) != .Some(\"RIFF\") or from_bytes(slice(data, 8, 12)) != .Some(\"WAVE\") {",
"return .Error(\"not a WAV file\")",
"}",
"var at = 12",
"var channels = 0",
"var rate = 0",
"var bits = 0",
"while at + 8 <= length(data) {",
"let id = value_or(from_bytes(slice(data, at, at + 4)), \"\")",
"let size = u32(data, at + 4)",
"let body = at + 8",
"if body + size > length(data) {",
"return .Error(\"the WAV file is cut off\")",
"}",
"if id == \"fmt \" {",
"if size < 16 or u16(data, body) != 1 {",
"return .Error(\"only uncompressed (PCM) WAV files are supported\")",
"}",
"set channels = u16(data, body + 2)",
"set rate = u32(data, body + 4)",
"set bits = u16(data, body + 14)",
"}",
"if id == \"data\" {",
"if channels < 1 or channels > 2 or (bits != 8 and bits != 16) {",
"return .Error(\"unsupported WAV format: \\(channels) channels, \\(bits) bits\")",
"}",
"let frame = channels * bits / 8",
"let count = size / frame",
"var out = repeat([128], count)",
"for i in range(0, count) {",
"var total = 0",
"for c in range(0, channels) {",
"let p = body + i * frame + c * bits / 8",
"// 16-bit samples are signed; their high byte plus 128 is the unsigned 8-bit value.",
"set total += if bits == 8 { data[p] } else { (data[p + 1] + 128) % 256 }",
"}",
"set out[i] = total / channels",
"}",
"return .Ok(Sound { samples: bytes(out), rate: math.clamp(rate, 1000, 96000) })",
"}",
"set at = body + size + size % 2",
"}",
".Error(\"the WAV file has no data\")",
"}",
"",
"note \"A sine tone of `frequency` hertz lasting `milliseconds`, at 22,050 samples per second, made with integer arithmetic (std/fixed).\"",
"pub fn tone(frequency: Int, milliseconds: Int, loudness: Int) -> Sound {",
"let rate = 22050",
"let count = math.max(rate * milliseconds / 1000, 1)",
"let amplitude = math.clamp(loudness, 0, 100) * 127 / 100",
"var out = repeat([128], count)",
"for i in range(0, count) {",
"set out[i] = 128 + shift_right(fixed.sine(i * frequency, rate) * amplitude, 16)",
"}",
"Sound { samples: bytes(out), rate: rate }",
"}",
"",
"note \"How loud a sound is and where it sits left to right, for a listener facing some direction: `dx`, `dy` is the offset from listener to sound in whole units, (`right_x`, `right_y`) the listener's right-hand direction as fixed values (65536 is 1.0). Volume falls from 100 to 0 at distance `range`; pan is -100 (left) to 100 (right), at most 75 so both ears still hear it. Returns [volume, pan].\"",
"pub fn position(dx: Int, dy: Int, right_x: Int, right_y: Int, range: Int) -> List[Int] {",
"let distance = math.isqrt(dx * dx + dy * dy)",
"if distance >= range {",
"return [0, 0]",
"}",
"let side = fixed.floor_int(dx * right_x + dy * right_y)",
"let pan = if distance < 32 { 0 } else { side * 75 / distance }",
"[100 - distance * 100 / range, math.clamp(pan, -75, 75)]",
"}",
"",
"note \"Plays a sound at a volume (0 to 100) and pan (-100 to 100).\"",
"pub fn play(s: Sound, volume: Int, pan: Int) -> Unit uses audio = play_sound(s.samples, s.rate, math.clamp(volume, 0, 100), math.clamp(pan, -100, 100))",
"",
]
join(lines, "\n")
}

note "Generated from std/url.tes; do not edit by hand."
pub fn std_url() -> Text {
let lines = [
"// std/url: percent-encoding and query strings (RFC 3986, application/x-www-form-urlencoded).",
"",
"note \"Characters that never need encoding (RFC 3986 unreserved).\"",
"fn is_unreserved(code: Int) -> Bool {",
"(code >= 65 and code <= 90) or (code >= 97 and code <= 122) or (code >= 48 and code <= 57) or code == 45 or code == 46 or code == 95 or code == 126",
"}",
"",
"fn hex_value(code: Int) -> Int {",
"if code >= 48 and code <= 57 {",
"return code - 48",
"}",
"if code >= 65 and code <= 70 {",
"return code - 55",
"}",
"if code >= 97 and code <= 102 {",
"return code - 87",
"}",
"-1",
"}",
"",
"note \"Encodes everything except unreserved characters, so the result is safe in a path segment, a query key or a query value.\"",
"pub fn percent_encode(text: Text) -> Text {",
"let digits = split(\"0123456789ABCDEF\", \"\")",
"var out = \"\"",
"for byte in byte_values(to_bytes(text)) {",
"if is_unreserved(byte) {",
"set out += from_code_point(byte)",
"} else {",
"set out += \"%\\(digits[byte / 16])\\(digits[byte % 16])\"",
"}",
"}",
"out",
"}",
"",
"note \"Decodes `%XX` escapes; `.None` for a broken escape or bytes that are not UTF-8. With `plus_is_space`, `+` means a space (form encoding).\"",
"fn decode(text: Text, plus_is_space: Bool) -> Option[Text] {",
"let input = byte_values(to_bytes(text))",
"var out: List[Int] = []",
"var index = 0",
"while index < length(input) {",
"let byte = input[index]",
"if byte == 37 {",
"if index + 2 >= length(input) {",
"return .None",
"}",
"let high = hex_value(input[index + 1])",
"let low = hex_value(input[index + 2])",
"if high < 0 or low < 0 {",
"return .None",
"}",
"set out += [high * 16 + low]",
"set index += 3",
"} else {",
"set out += [if plus_is_space and byte == 43 { 32 } else { byte }]",
"set index += 1",
"}",
"}",
"from_bytes(bytes(out))",
"}",
"",
"pub fn percent_decode(text: Text) -> Option[Text] = decode(text, false)",
"",
"note \"Every value of every key, in order. Broken escapes keep the raw text.\"",
"pub fn parse_query_all(query: Text) -> Map[Text, List[Text]] {",
"var result: Map[Text, List[Text]] = [:]",
"if query == \"\" {",
"return result",
"}",
"for pair in split(query, \"&\") {",
"if pair == \"\" {",
"continue",
"}",
"let position = index_of(pair, \"=\")",
"let raw_key = match position {",
".Some(p) => slice_text(pair, 0, p)",
".None => pair",
"}",
"let raw_value = match position {",
".Some(p) => slice_text(pair, p + 1, length(pair))",
".None => \"\"",
"}",
"let key = value_or(decode(raw_key, true), raw_key)",
"let value = value_or(decode(raw_value, true), raw_value)",
"set result = put(result, key, value_or(get(result, key), []) + [value])",
"}",
"result",
"}",
"",
"note \"The first value of each key: `a=1&b=2&a=3` gives `a` = `1`, `b` = `2`.\"",
"pub fn parse_query(query: Text) -> Map[Text, Text] {",
"var result: Map[Text, Text] = [:]",
"let all = parse_query_all(query)",
"for key in keys(all) {",
"let found = value_or(get(all, key), [])",
"if length(found) > 0 {",
"set result = put(result, key, found[0])",
"}",
"}",
"result",
"}",
"",
"pub fn encode_query(values: Map[Text, Text]) -> Text {",
"var parts: List[Text] = []",
"for key in keys(values) {",
"set parts += [\"\\(percent_encode(key))=\\(percent_encode(value_or(get(values, key), \"\")))\"]",
"}",
"join(parts, \"&\")",
"}",
"",
"note \"The decoded segments of a path: `/a/b%20c/` gives `a` and `b c`.\"",
"pub fn path_segments(path: Text) -> List[Text] {",
"var out: List[Text] = []",
"for part in split(path, \"/\") {",
"if part != \"\" {",
"set out += [value_or(percent_decode(part), part)]",
"}",
"}",
"out",
"}",
"",
]
join(lines, "\n")
}
