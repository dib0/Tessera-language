// Lexer: source text to tokens, including significant newlines (spec section 4).

import source uses nothing

pub enum TokenKind {
    Int
    Text
    Ident
    Fn
    Let
    Var
    Set
    If
    Else
    For
    In
    While
    Note
    Uses
    And
    Or
    Not
    True
    False
    Type
    Enum
    Match
    Return
    Break
    Continue
    Import
    Pub
    With
    Try
    Underscore
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    Arrow
    FatArrow
    Assign
    EqEq
    NotEq
    Lt
    LtEq
    Gt
    GtEq
    Plus
    Minus
    Star
    Slash
    Percent
    Newline
    Eof
}

note "`text` holds the name, the decoded text literal, or the decimal digits of a number."
pub type Token {
    kind: TokenKind
    text: Text
    span: source.Span
}

pub type LexResult {
    tokens: List[Token]
    diagnostics: List[source.Diagnostic]
}

note "`expansion` replaces `token` when not empty (text literals with `\\(...)` interpolation)."
type Scan {
    token: Token
    end: Int
    diagnostics: List[source.Diagnostic]
    emit: Bool
    expansion: List[Token]
}

pub fn symbol_text(kind: TokenKind) -> Text {
    match kind {
        .Fn => "fn"
        .Let => "let"
        .Var => "var"
        .Set => "set"
        .If => "if"
        .Else => "else"
        .For => "for"
        .In => "in"
        .While => "while"
        .Note => "note"
        .Uses => "uses"
        .And => "and"
        .Or => "or"
        .Not => "not"
        .True => "true"
        .False => "false"
        .Type => "type"
        .Enum => "enum"
        .Match => "match"
        .Return => "return"
        .Break => "break"
        .Continue => "continue"
        .Import => "import"
        .Pub => "pub"
        .With => "with"
        .Try => "try"
        .Underscore => "_"
        .LParen => "("
        .RParen => ")"
        .LBracket => "["
        .RBracket => "]"
        .LBrace => "{"
        .RBrace => "}"
        .Comma => ","
        .Colon => ":"
        .Dot => "."
        .Arrow => "->"
        .FatArrow => "=>"
        .Assign => "="
        .EqEq => "=="
        .NotEq => "!="
        .Lt => "<"
        .LtEq => "<="
        .Gt => ">"
        .GtEq => ">="
        .Plus => "+"
        .Minus => "-"
        .Star => "*"
        .Slash => "/"
        .Percent => "%"
        _ => "?"
    }
}

pub fn describe_token(token: Token) -> Text {
    match token.kind {
        .Int => "number `" + token.text + "`"
        .Text => "text literal"
        .Ident => "name `" + token.text + "`"
        .Newline => "end of line"
        .Eof => "end of file"
        _ => "`" + symbol_text(token.kind) + "`"
    }
}

note "A line ending in one of these tokens continues on the next line (spec 4.6)."
fn continues_line(kind: TokenKind) -> Bool {
    match kind {
        .Comma => true
        .Assign => true
        .Arrow => true
        .FatArrow => true
        .EqEq => true
        .NotEq => true
        .Lt => true
        .LtEq => true
        .Gt => true
        .GtEq => true
        .Plus => true
        .Minus => true
        .Star => true
        .Slash => true
        .Percent => true
        .And => true
        .Or => true
        .Not => true
        .Dot => true
        .LParen => true
        .LBracket => true
        .LBrace => true
        _ => false
    }
}

fn keyword_kind(word: Text) -> TokenKind {
    match word {
        "fn" => .Fn
        "let" => .Let
        "var" => .Var
        "set" => .Set
        "if" => .If
        "else" => .Else
        "for" => .For
        "in" => .In
        "while" => .While
        "note" => .Note
        "uses" => .Uses
        "and" => .And
        "or" => .Or
        "not" => .Not
        "true" => .True
        "false" => .False
        "type" => .Type
        "enum" => .Enum
        "match" => .Match
        "return" => .Return
        "break" => .Break
        "continue" => .Continue
        "import" => .Import
        "pub" => .Pub
        "with" => .With
        "try" => .Try
        _ => .Ident
    }
}

fn reserved_words() -> List[Text] = ["module", "unsafe", "loop", "const", "trait", "impl"]

fn token(kind: TokenKind, text: Text, span: source.Span) -> Token = Token { kind: kind, text: text, span: span }

fn newline_allowed(tokens: List[Token], open_kinds: List[Int]) -> Bool {
    let open_count = length(open_kinds)
    if open_count > 0 {
        let top = open_kinds[open_count - 1]
        if top == 40 or top == 91 {
            return false
        }
    }
    let count = length(tokens)
    if count == 0 {
        return false
    }
    let last = tokens[count - 1].kind
    not (last == .Newline or continues_line(last))
}

fn non_ascii_letter(code: Int, span: source.Span) -> source.Diagnostic {
    source.error_help("E0103", span, "non-ASCII letter `\(from_code_point(code))` in a name", "names use ASCII letters, digits and `_` only; this prevents look-alike characters (homoglyphs)")
}

fn scan_word(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    var index = start
    var name: List[Int] = []
    var diagnostics: List[source.Diagnostic] = []
    while index < length(codes) and (source.is_alphanumeric(codes[index]) or codes[index] == 95 or codes[index] >= 128) {
        let code = codes[index]
        if code >= 128 {
            let here = col + index - start
            set diagnostics = append(diagnostics, non_ascii_letter(code, source.span_of(file, line, here, here + 1)))
        } else {
            set name = append(name, code)
        }
        set index = index + 1
    }
    let word = from_code_points(name)
    let span = source.span_of(file, line, col, col + index - start)
    let kind = keyword_kind(word)
    if kind == .Ident and source.contains_text(reserved_words(), word) {
        set diagnostics = append(diagnostics, source.error_help("E0108", span, "`\(word)` is a reserved word", "choose a different name"))
    }
    Scan { token: token(kind, word, span), end: index, diagnostics: diagnostics, emit: true, expansion: [] }
}

note "Digits compared as text: `a` is larger than `b` when both have the same length."
fn digits_greater(a: List[Int], b: List[Int]) -> Bool {
    if length(a) != length(b) {
        return length(a) > length(b)
    }
    for index in range(0, length(a)) {
        if a[index] != b[index] {
            return a[index] > b[index]
        }
    }
    false
}

fn scan_number(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    var index = start
    var digits: List[Int] = []
    while index < length(codes) and (source.is_digit(codes[index]) or codes[index] == 95) {
        if codes[index] != 95 {
            set digits = append(digits, codes[index])
        }
        set index = index + 1
    }
    var bad_suffix = false
    while index < length(codes) and (source.is_alphanumeric(codes[index]) or codes[index] >= 128) {
        set bad_suffix = true
        set index = index + 1
    }
    let raw_codes = slice(codes, start, index)
    let raw = from_code_points(raw_codes)
    let span = source.span_of(file, line, col, col + index - start)
    if bad_suffix {
        let d = source.error_help("E0106", span, "invalid number `\(raw)`", "numbers are decimal digits only, optionally separated by `_`")
        return Scan { token: token(.Int, "0", span), end: index, diagnostics: [d], emit: true, expansion: [] }
    }
    var diagnostics: List[source.Diagnostic] = []
    let raw_count = length(raw_codes)
    var double_underscore = false
    for position in range(1, raw_count) {
        if raw_codes[position] == 95 and raw_codes[position - 1] == 95 {
            set double_underscore = true
        }
    }
    if raw_codes[raw_count - 1] == 95 or double_underscore {
        set diagnostics = append(diagnostics, source.error_help("E0106", span, "invalid number `\(raw)`", "`_` may only appear between digits, e.g. `1_000_000`"))
    }
    if length(digits) > 1 and digits[0] == 48 {
        set diagnostics = append(diagnostics, source.error_help("E0106", span, "number `\(raw)` has a leading zero", "leading zeros are not allowed; write the number without them"))
    }
    var text = from_code_points(digits)
    if digits_greater(digits, code_points("9223372036854775808")) {
        set diagnostics = append(diagnostics, source.error_help("E0106", span, "number `\(raw)` does not fit in `Int`", "`Int` is a signed 64-bit integer: -9223372036854775808 to 9223372036854775807"))
        set text = "0"
    }
    Scan { token: token(.Int, text, span), end: index, diagnostics: diagnostics, emit: true, expansion: [] }
}

note "Index of the `)` that closes an interpolation whose code starts at `start`, or -1 if the line ends first."
fn interpolation_end(codes: List[Int], start: Int) -> Int {
    var depth = 1
    var index = start
    while index < length(codes) {
        let code = codes[index]
        if code == 10 {
            return -1
        }
        if code == 34 {
            set index = text_end(codes, index)
            if index < 0 {
                return -1
            }
            continue
        }
        if code == 40 {
            set depth = depth + 1
        } else if code == 41 {
            set depth = depth - 1
            if depth == 0 {
                return index
            }
        }
        set index = index + 1
    }
    -1
}

note "Index just after the closing quote of the text literal that starts at `start`, or -1."
fn text_end(codes: List[Int], start: Int) -> Int {
    var index = start + 1
    while index < length(codes) {
        let code = codes[index]
        if code == 10 {
            return -1
        }
        if code == 34 {
            return index + 1
        }
        if code == 92 and index + 1 < length(codes) and codes[index + 1] == 40 {
            let close = interpolation_end(codes, index + 2)
            if close < 0 {
                return -1
            }
            set index = close + 1
        } else if code == 92 {
            set index = index + 2
        } else {
            set index = index + 1
        }
    }
    -1
}

note "`\\(expr)` in a text literal becomes `(\"before\" + to_text(expr) + \"after\")`."
fn scan_text(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    var index = start + 1
    var value: List[Int] = []
    var diagnostics: List[source.Diagnostic] = []
    var closed = false
    var pieces: List[Token] = []
    var interpolated = false
    var segment_col = col
    while not closed {
        if index >= length(codes) or codes[index] == 10 {
            let open_span = source.span_of(file, line, col, col + index - start)
            set diagnostics = append(diagnostics, source.error_help("E0109", open_span, "text literal is not closed", "add a closing `\"` on the same line; use `\\n` for line breaks"))
            break
        }
        let code = codes[index]
        let here = col + index - start
        if code == 34 {
            set index = index + 1
            set closed = true
        } else if code == 92 and index + 1 < length(codes) and codes[index + 1] == 40 {
            let here_span = source.span_of(file, line, here, here + 2)
            let close = interpolation_end(codes, index + 2)
            if close < 0 {
                set diagnostics = append(diagnostics, source.error_help("E0109", here_span, "`\\(` is not closed on this line", "write `\\(expression)`; the expression ends at the matching `)`"))
                set index = length(codes)
                break
            }
            if close == index + 2 {
                set diagnostics = append(diagnostics, source.error_help("E0109", here_span, "empty interpolation `\\()`", "put an expression between the parentheses, e.g. `\\(count)`"))
            } else {
                let inner = tokenize_range(codes, index + 2, close, file, line, here + 2, true)
                set diagnostics = concat(diagnostics, inner.diagnostics)
                if length(pieces) > 0 or length(value) > 0 {
                    set pieces = add_piece(pieces, token(.Text, from_code_points(value), source.span_of(file, line, segment_col, here)))
                }
                set pieces = add_plus(pieces, here_span)
                set pieces = concat(pieces, [token(.Ident, "to_text", here_span), token(.LParen, "", here_span)])
                set pieces = append(concat(pieces, inner.tokens), token(.RParen, "", here_span))
            }
            set interpolated = true
            set value = []
            set index = close + 1
            set segment_col = col + index - start
        } else if code == 92 {
            let escape_span = source.span_of(file, line, here, here + 1)
            let next = if index + 1 < length(codes) { codes[index + 1] } else { -1 }
            set index = index + 2
            if next == 110 {
                set value = append(value, 10)
            } else if next == 116 {
                set value = append(value, 9)
            } else if next == 92 {
                set value = append(value, 92)
            } else if next == 34 {
                set value = append(value, 34)
            } else if next == 117 {
                if index >= length(codes) or codes[index] != 123 {
                    set diagnostics = append(diagnostics, source.error_help("E0109", escape_span, "invalid unicode escape", "write unicode escapes as `\\u{1F600}`"))
                    continue
                }
                set index = index + 1
                var hex: List[Int] = []
                while index < length(codes) and codes[index] != 125 and codes[index] != 34 and codes[index] != 10 {
                    set hex = append(hex, codes[index])
                    set index = index + 1
                }
                if index < length(codes) and codes[index] == 125 {
                    set index = index + 1
                }
                var valid = length(hex) >= 1 and length(hex) <= 6
                var scalar = 0
                for digit in hex {
                    if not source.is_hex_digit(digit) {
                        set valid = false
                    } else {
                        set scalar = scalar * 16 + source.hex_value(digit)
                    }
                }
                if valid and (scalar > 1114111 or (scalar >= 55296 and scalar <= 57343)) {
                    set valid = false
                }
                if valid {
                    set value = append(value, scalar)
                } else {
                    set diagnostics = append(diagnostics, source.error("E0109", escape_span, "`\\u{\(from_code_points(hex))}` is not a valid unicode scalar value"))
                }
            } else {
                let shown = if next < 0 or next == 10 { "" } else { from_code_point(next) }
                if next == 10 {
                    set index = index - 1
                }
                set diagnostics = append(diagnostics, source.error_help("E0109", escape_span, "unknown escape `\\\(shown)`", "valid escapes are `\\n`, `\\t`, `\\\\`, `\\\"` and `\\u{...}`"))
            }
        } else if source.is_control(code) {
            set diagnostics = append(diagnostics, source.error_help("E0109", source.span_of(file, line, here, here + 1), "control character inside a text literal", "use an escape such as `\\t` or `\\u{...}`"))
            set index = index + 1
        } else {
            set value = append(value, code)
            set index = index + 1
        }
    }
    let span = source.span_of(file, line, col, col + index - start)
    if not interpolated {
        return Scan { token: token(.Text, from_code_points(value), span), end: index, diagnostics: diagnostics, emit: true, expansion: [] }
    }
    if length(value) > 0 {
        set pieces = add_piece(pieces, token(.Text, from_code_points(value), source.span_of(file, line, segment_col, col + index - start)))
    }
    if length(pieces) == 0 {
        set pieces = [token(.Text, "", span)]
    }
    let expansion = append(concat([token(.LParen, "", span)], pieces), token(.RParen, "", span))
    Scan { token: token(.Text, "", span), end: index, diagnostics: diagnostics, emit: true, expansion: expansion }
}

fn add_plus(pieces: List[Token], span: source.Span) -> List[Token] {
    if length(pieces) == 0 { pieces } else { append(pieces, token(.Plus, "", span)) }
}

fn add_piece(pieces: List[Token], piece: Token) -> List[Token] = append(add_plus(pieces, piece.span), piece)

fn two_char_kind(first: Int, second: Int) -> TokenKind {
    if first == 45 and second == 62 {
        .Arrow
    } else if first == 61 and second == 62 {
        .FatArrow
    } else if first == 61 and second == 61 {
        .EqEq
    } else if first == 33 and second == 61 {
        .NotEq
    } else if first == 60 and second == 61 {
        .LtEq
    } else if first == 62 and second == 61 {
        .GtEq
    } else {
        .Eof
    }
}

fn one_char_kind(code: Int) -> TokenKind {
    match code {
        40 => .LParen
        41 => .RParen
        91 => .LBracket
        93 => .RBracket
        123 => .LBrace
        125 => .RBrace
        44 => .Comma
        58 => .Colon
        46 => .Dot
        61 => .Assign
        60 => .Lt
        62 => .Gt
        43 => .Plus
        45 => .Minus
        42 => .Star
        47 => .Slash
        37 => .Percent
        _ => .Eof
    }
}

fn unexpected_character_help(code: Int) -> Text {
    match code {
        33 => "use `not` for negation and `!=` for inequality"
        38 => "use `and` instead of `&&`"
        124 => "use `or` instead of `||`"
        59 => "statements end at the end of a line; remove the `;`"
        39 => "text literals use double quotes"
        _ => "remove this character"
    }
}

fn scan_symbol(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    let code = codes[start]
    let next = if start + 1 < length(codes) { codes[start + 1] } else { -1 }
    let pair = two_char_kind(code, next)
    if pair != .Eof {
        return Scan { token: token(pair, "", source.span_of(file, line, col, col + 2)), end: start + 2, diagnostics: [], emit: true, expansion: [] }
    }
    let span = source.span_of(file, line, col, col + 1)
    let single = one_char_kind(code)
    if single == .Eof {
        let d = source.error_help("E0103", span, "unexpected character `\(from_code_point(code))`", unexpected_character_help(code))
        return Scan { token: token(.Eof, "", span), end: start + 1, diagnostics: [d], emit: false, expansion: [] }
    }
    Scan { token: token(single, "", span), end: start + 1, diagnostics: [], emit: true, expansion: [] }
}

fn bracket_code(kind: TokenKind) -> Int {
    match kind {
        .LParen => 40
        .RParen => 40
        .LBracket => 91
        .RBracket => 91
        .LBrace => 123
        .RBrace => 123
        _ => 0
    }
}

fn is_opening(kind: TokenKind) -> Bool = kind == .LParen or kind == .LBracket or kind == .LBrace

fn is_closing(kind: TokenKind) -> Bool = kind == .RParen or kind == .RBracket or kind == .RBrace

pub fn tokenize(text: Text, file: Int) -> LexResult {
    let codes = code_points(text)
    tokenize_range(codes, 0, length(codes), file, 1, 1, false)
}

note "Tokenizes `codes[start..end]`. `nested` is true for the code inside a text interpolation: no end-of-file tokens then."
fn tokenize_range(codes: List[Int], start: Int, end: Int, file: Int, first_line: Int, first_col: Int, nested: Bool) -> LexResult {
    let count = end
    var tokens: List[Token] = []
    var diagnostics: List[source.Diagnostic] = []
    var open_kinds: List[Int] = []
    var open_spans: List[source.Span] = []
    var index = start
    var line = first_line
    var col = first_col
    if not nested and count > 0 and codes[0] == 65279 {
        set diagnostics = append(diagnostics, source.error_help("E0101", source.span_of(file, 1, 1, 2), "file starts with a byte order mark", "save the file as UTF-8 without BOM"))
        set index = 1
        set col = 2
    }
    while index < count {
        let code = codes[index]
        let here = source.span_of(file, line, col, col + 1)
        if code == 10 {
            if newline_allowed(tokens, open_kinds) {
                set tokens = append(tokens, token(.Newline, "", here))
            }
            set index = index + 1
            set line = line + 1
            set col = 1
            continue
        }
        if code == 32 {
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 9 {
            set diagnostics = append(diagnostics, source.error_help("E0101", here, "tab characters are not allowed", "indent with 4 spaces; write `\\t` inside text literals"))
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 13 {
            set diagnostics = append(diagnostics, source.error_help("E0101", here, "carriage return characters are not allowed", "use Unix line endings (LF)"))
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 47 and index + 1 < count and codes[index + 1] == 47 {
            while index < count and codes[index] != 10 {
                if codes[index] == 13 or codes[index] == 9 {
                    set diagnostics = append(diagnostics, source.error("E0101", source.span_of(file, line, col, col + 1), "tab or carriage return characters are not allowed"))
                }
                set index = index + 1
                set col = col + 1
            }
            continue
        }
        if code == 95 and not (index + 1 < count and (source.is_alphanumeric(codes[index + 1]) or codes[index + 1] == 95)) {
            set tokens = append(tokens, token(.Underscore, "", here))
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 95 {
            set diagnostics = append(diagnostics, source.error_help("E0103", here, "names must start with a letter", "for an unused binding write `_` alone, e.g. `for _ in range(0, n)`"))
            set index = index + 1
            set col = col + 1
            while index < count and (source.is_alphanumeric(codes[index]) or codes[index] == 95) {
                set index = index + 1
                set col = col + 1
            }
            continue
        }
        if code >= 128 {
            set diagnostics = append(diagnostics, source.error_help("E0103", here, "unexpected character `\(from_code_point(code))`", "names use ASCII letters, digits and `_` only; text belongs inside double quotes"))
            set index = index + 1
            set col = col + 1
            continue
        }
        let scan = if code == 34 {
            scan_text(codes, index, file, line, col)
        } else if source.is_digit(code) {
            scan_number(codes, index, file, line, col)
        } else if source.is_letter(code) {
            scan_word(codes, index, file, line, col)
        } else {
            scan_symbol(codes, index, file, line, col)
        }
        set diagnostics = concat(diagnostics, scan.diagnostics)
        set col = col + scan.end - index
        set index = scan.end
        if not scan.emit {
            continue
        }
        if length(scan.expansion) > 0 {
            set tokens = concat(tokens, scan.expansion)
            continue
        }
        let kind = scan.token.kind
        let span = scan.token.span
        if is_opening(kind) {
            set open_kinds = append(open_kinds, bracket_code(kind))
            set open_spans = append(open_spans, span)
        } else if is_closing(kind) {
            let expected = bracket_code(kind)
            let depth = length(open_kinds)
            let shown = symbol_text(kind)
            if depth == 0 {
                set diagnostics = append(diagnostics, source.error("E0102", span, "`\(shown)` has no matching opening bracket"))
            } else {
                let top = open_kinds[depth - 1]
                if top != expected {
                    let open_text = from_code_point(top)
                    set diagnostics = append(diagnostics, source.error_help("E0102", span, "`\(shown)` does not match the open `\(open_text)`", "the `\(open_text)` was opened on line \(open_spans[depth - 1].line)"))
                }
                set open_kinds = slice(open_kinds, 0, depth - 1)
                set open_spans = slice(open_spans, 0, depth - 1)
            }
        }
        set tokens = append(tokens, scan.token)
    }
    let end_span = source.span_of(file, line, col, col + 1)
    if nested {
        return LexResult { tokens: tokens, diagnostics: diagnostics }
    }
    var remaining = length(open_kinds) - 1
    while remaining >= 0 {
        let d = source.error("E0102", open_spans[remaining], "`\(from_code_point(open_kinds[remaining]))` is never closed")
        set diagnostics = append(diagnostics, d with { label: "opened here" })
        set remaining = remaining - 1
    }
    if newline_allowed(tokens, []) {
        set tokens = append(tokens, token(.Newline, "", end_span))
    }
    let token_count = length(tokens)
    if token_count > 0 and tokens[token_count - 1].kind != .Newline {
        set tokens = append(tokens, token(.Newline, "", end_span))
    }
    set tokens = append(tokens, token(.Eof, "", end_span))
    LexResult { tokens: tokens, diagnostics: diagnostics }
}
