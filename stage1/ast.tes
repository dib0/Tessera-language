// Syntax tree. The parser fills every `ty` with `Type.Unknown`; the checker
// returns a copy of the tree with the real types filled in.

enum Type {
    Int
    Bool
    Text
    Unit
    Never
    Unknown
    List(element: Type)
    Named(name: Text)
}

type Note {
    text: Text
    span: Span
}

type TypeExpr {
    name: Text
    args: List[TypeExpr]
    span: Span
}

enum OptionalType {
    Absent
    Present(type_expr: TypeExpr)
}

enum OptionalExpr {
    Absent
    Present(expr: Expr)
}

enum UnaryOp {
    Negate
    Not
}

enum BinaryOp {
    Add
    Subtract
    Multiply
    Divide
    Remainder
    Equal
    NotEqual
    Less
    LessEqual
    Greater
    GreaterEqual
    And
    Or
}

type Expr {
    kind: ExprKind
    span: Span
    ty: Type
}

enum ExprKind {
    IntLiteral(value: Int)
    BoolLiteral(value: Bool)
    TextLiteral(value: Text)
    UnitLiteral
    Name(name: Text)
    ListLiteral(items: List[Expr])
    Call(name: Text, name_span: Span, args: List[Expr])
    Index(target: Expr, index: Expr)
    FieldAccess(target: Expr, name: Text, name_span: Span)
    Unary(op: UnaryOp, operand: Expr)
    Binary(op: BinaryOp, op_span: Span, left: Expr, right: Expr)
    If(condition: Expr, then_block: Block, else_branch: OptionalExpr)
    BlockExpr(block: Block)
    Match(scrutinee: Expr, arms: List[Arm])
    RecordLiteral(type_name: Text, type_span: Span, fields: List[FieldInit])
    VariantLiteral(type_name: Text, variant: Text, variant_span: Span, args: List[Expr])
    Return(value: OptionalExpr)
    Break
    Continue
}

type FieldInit {
    name: Text
    span: Span
    value: Expr
}

type Block {
    statements: List[Statement]
    tail: OptionalExpr
    span: Span
}

note "A `Let` named `_` discards its value."
enum Statement {
    Let(name: Text, name_span: Span, declared: OptionalType, value: Expr, mutable: Bool)
    Set(name: Text, name_span: Span, value: Expr)
    For(variable: Text, variable_span: Span, iterable: Expr, body: Block)
    While(condition: Expr, body: Block)
    ExprStatement(expr: Expr)
}

type Arm {
    pattern: Pattern
    body: Expr
}

type Pattern {
    kind: PatternKind
    span: Span
}

type Binding {
    name: Text
    span: Span
}

note "A binding named `_` ignores its field."
enum PatternKind {
    Wildcard
    IntPattern(value: Int)
    TextPattern(value: Text)
    BoolPattern(value: Bool)
    VariantPattern(type_name: Text, variant: Text, bindings: List[Binding])
}

type Param {
    name: Text
    span: Span
    type_expr: TypeExpr
}

type Field {
    name: Text
    span: Span
    type_expr: TypeExpr
}

type EffectName {
    name: Text
    span: Span
}

type Function {
    notes: List[Note]
    name: Text
    name_span: Span
    params: List[Param]
    return_type: TypeExpr
    effects: List[EffectName]
    body: Expr
}

type RecordDecl {
    notes: List[Note]
    name: Text
    name_span: Span
    fields: List[Field]
}

type VariantDecl {
    name: Text
    span: Span
    fields: List[Field]
}

type EnumDecl {
    notes: List[Note]
    name: Text
    name_span: Span
    variants: List[VariantDecl]
}

enum Item {
    FunctionItem(function: Function)
    RecordItem(record: RecordDecl)
    EnumItem(decl: EnumDecl)
}

fn make_expr(kind: ExprKind, span: Span) -> Expr = Expr { kind: kind, span: span, ty: Type.Unknown }

fn with_type(expr: Expr, ty: Type) -> Expr = Expr { kind: expr.kind, span: expr.span, ty: ty }

fn with_kind(expr: Expr, kind: ExprKind) -> Expr = Expr { kind: kind, span: expr.span, ty: expr.ty }

fn type_text(ty: Type) -> Text {
    match ty {
        Type.Int => "Int"
        Type.Bool => "Bool"
        Type.Text => "Text"
        Type.Unit => "Unit"
        Type.Never => "Never"
        Type.Unknown => "?"
        Type.List(element) => "List[" + type_text(element) + "]"
        Type.Named(name) => name
    }
}

fn binary_symbol(op: BinaryOp) -> Text {
    match op {
        BinaryOp.Add => "+"
        BinaryOp.Subtract => "-"
        BinaryOp.Multiply => "*"
        BinaryOp.Divide => "/"
        BinaryOp.Remainder => "%"
        BinaryOp.Equal => "=="
        BinaryOp.NotEqual => "!="
        BinaryOp.Less => "<"
        BinaryOp.LessEqual => "<="
        BinaryOp.Greater => ">"
        BinaryOp.GreaterEqual => ">="
        BinaryOp.And => "and"
        BinaryOp.Or => "or"
    }
}
