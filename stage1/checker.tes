// Name resolution, type checking and effect checking (spec sections 5 to 10).
// Produces a copy of the program in which every expression carries its type.

type FieldType {
    name: Text
    ty: Type
}

type VariantType {
    name: Text
    fields: List[FieldType]
}

type TypeDef {
    name: Text
    is_enum: Bool
    fields: List[FieldType]
    variants: List[VariantType]
    span: Span
}

type Signature {
    name: Text
    params: List[Type]
    return_type: Type
    effects: List[Text]
    span: Span
}

note "Built-in functions with a fixed signature; the generic ones are handled in `check_call`."
type Builtin {
    name: Text
    params: List[Type]
    return_type: Type
    effect: Text
}

type Local {
    name: Text
    ty: Type
    mutable: Bool
    was_set: Bool
    span: Span
}

type Checker {
    type_defs: List[TypeDef]
    functions: List[Signature]
    builtins: List[Builtin]
    locals: List[Local]
    diagnostics: List[Diagnostic]
    function_name: Text
    return_type: Type
    declared_effects: List[Text]
    used_effects: List[Text]
    loop_depth: Int
    uses_window_event: Bool
}

type Checked {
    checker: Checker
    expr: Expr
}

type CheckedBlock {
    checker: Checker
    block: Block
    ty: Type
}

type CheckedArgs {
    checker: Checker
    args: List[Expr]
}

type ResolvedType {
    checker: Checker
    ty: Type
}

type ResolvedFields {
    checker: Checker
    fields: List[FieldType]
}

type CheckedProgram {
    items: List[Item]
    type_defs: List[TypeDef]
    diagnostics: List[Diagnostic]
    uses_ui: Bool
}

fn effect_names() -> List[Text] = ["io", "fs", "env", "process", "ui"]

fn generic_builtin_names() -> List[Text] = ["to_text", "length", "append", "concat", "slice", "replace_at"]

fn list_of(element: Type) -> Type = Type.List(element)

fn builtin(name: Text, params: List[Type], return_type: Type, effect: Text) -> Builtin {
    Builtin { name: name, params: params, return_type: return_type, effect: effect }
}

fn builtin_table() -> List[Builtin] {
    [
        builtin("print", [Type.Text], Type.Unit, "io"),
        builtin("print_error", [Type.Text], Type.Unit, "io"),
        builtin("range", [Type.Int, Type.Int], list_of(Type.Int), ""),
        builtin("code_points", [Type.Text], list_of(Type.Int), ""),
        builtin("from_code_point", [Type.Int], Type.Text, ""),
        builtin("from_code_points", [list_of(Type.Int)], Type.Text, ""),
        builtin("join", [list_of(Type.Text), Type.Text], Type.Text, ""),
        builtin("read_file", [Type.Text], Type.Text, "fs"),
        builtin("write_file", [Type.Text, Type.Text], Type.Unit, "fs"),
        builtin("args", [], list_of(Type.Text), "env"),
        builtin("exit", [Type.Int], Type.Never, "env"),
        builtin("fail", [Type.Text], Type.Never, ""),
        builtin("environment_variable", [Type.Text], Type.Text, "env"),
        builtin("run_process", [Type.Text, list_of(Type.Text)], Type.Int, "process"),
        builtin("rgb", [Type.Int, Type.Int, Type.Int], Type.Int, ""),
        builtin("open_window", [Type.Text, Type.Int, Type.Int], Type.Unit, "ui"),
        builtin("fill_rectangle", [Type.Int, Type.Int, Type.Int, Type.Int, Type.Int], Type.Unit, "ui"),
        builtin("draw_line", [Type.Int, Type.Int, Type.Int, Type.Int, Type.Int, Type.Int], Type.Unit, "ui"),
        builtin("draw_circle", [Type.Int, Type.Int, Type.Int, Type.Int, Type.Int], Type.Unit, "ui"),
        builtin("fill_circle", [Type.Int, Type.Int, Type.Int, Type.Int], Type.Unit, "ui"),
        builtin("draw_text", [Type.Int, Type.Int, Type.Text, Type.Int], Type.Unit, "ui"),
        builtin("text_width", [Type.Text], Type.Int, "ui"),
        builtin("present", [], Type.Unit, "ui"),
        builtin("next_event", [], Type.Named("WindowEvent"), "ui"),
    ]
}

fn is_builtin_name(c: Checker, name: Text) -> Bool {
    if contains_text(generic_builtin_names(), name) {
        return true
    }
    for b in c.builtins {
        if b.name == name {
            return true
        }
    }
    false
}

note "The event type of the `ui` effect; the runtime in runtime/ui.rs builds these values."
fn window_event_type(span: Span) -> TypeDef {
    let click = VariantType { name: "Click", fields: [FieldType { name: "x", ty: Type.Int }, FieldType { name: "y", ty: Type.Int }, FieldType { name: "button", ty: Type.Int }] }
    let key = VariantType { name: "Key", fields: [FieldType { name: "name", ty: Type.Text }] }
    let close = VariantType { name: "Close", fields: [] }
    TypeDef { name: "WindowEvent", is_enum: true, fields: [], variants: [click, key, close], span: span }
}

// ---------- type relations ----------

fn is_unit_like(ty: Type) -> Bool = ty == Type.Unit or ty == Type.Never or ty == Type.Unknown

note "Can a value of type `actual` be used where `expected` is required?"
fn fits(actual: Type, expected: Type) -> Bool {
    if actual == Type.Never or actual == Type.Unknown or expected == Type.Unknown {
        return true
    }
    match actual {
        Type.List(actual_element) => match expected {
            Type.List(expected_element) => fits(actual_element, expected_element)
            _ => false
        }
        _ => actual == expected
    }
}

note "The common type of two branches: a one-element list, or empty when there is none."
fn join_types(a: Type, b: Type) -> List[Type] {
    if a == Type.Never {
        return [b]
    }
    if b == Type.Never {
        return [a]
    }
    if a == Type.Unknown or b == Type.Unknown {
        return [Type.Unknown]
    }
    match a {
        Type.List(a_element) => match b {
            Type.List(b_element) => {
                let inner = join_types(a_element, b_element)
                if length(inner) == 0 { [] } else { [Type.List(inner[0])] }
            }
            _ => []
        }
        _ => if a == b { [a] } else { [] }
    }
}

// ---------- checker state ----------

fn report(c: Checker, d: Diagnostic) -> Checker {
    Checker { type_defs: c.type_defs, functions: c.functions, builtins: c.builtins, locals: c.locals, diagnostics: append(c.diagnostics, d), function_name: c.function_name, return_type: c.return_type, declared_effects: c.declared_effects, used_effects: c.used_effects, loop_depth: c.loop_depth, uses_window_event: c.uses_window_event }
}

fn with_locals(c: Checker, locals: List[Local]) -> Checker {
    Checker { type_defs: c.type_defs, functions: c.functions, builtins: c.builtins, locals: locals, diagnostics: c.diagnostics, function_name: c.function_name, return_type: c.return_type, declared_effects: c.declared_effects, used_effects: c.used_effects, loop_depth: c.loop_depth, uses_window_event: c.uses_window_event }
}

fn with_type_defs(c: Checker, defs: List[TypeDef]) -> Checker {
    Checker { type_defs: defs, functions: c.functions, builtins: c.builtins, locals: c.locals, diagnostics: c.diagnostics, function_name: c.function_name, return_type: c.return_type, declared_effects: c.declared_effects, used_effects: c.used_effects, loop_depth: c.loop_depth, uses_window_event: c.uses_window_event }
}

fn with_functions(c: Checker, functions: List[Signature]) -> Checker {
    Checker { type_defs: c.type_defs, functions: functions, builtins: c.builtins, locals: c.locals, diagnostics: c.diagnostics, function_name: c.function_name, return_type: c.return_type, declared_effects: c.declared_effects, used_effects: c.used_effects, loop_depth: c.loop_depth, uses_window_event: c.uses_window_event }
}

fn with_used_effects(c: Checker, used: List[Text]) -> Checker {
    Checker { type_defs: c.type_defs, functions: c.functions, builtins: c.builtins, locals: c.locals, diagnostics: c.diagnostics, function_name: c.function_name, return_type: c.return_type, declared_effects: c.declared_effects, used_effects: used, loop_depth: c.loop_depth, uses_window_event: c.uses_window_event }
}

fn with_loop_depth(c: Checker, depth: Int) -> Checker {
    Checker { type_defs: c.type_defs, functions: c.functions, builtins: c.builtins, locals: c.locals, diagnostics: c.diagnostics, function_name: c.function_name, return_type: c.return_type, declared_effects: c.declared_effects, used_effects: c.used_effects, loop_depth: depth, uses_window_event: c.uses_window_event }
}

fn mark_window_event(c: Checker, type_name: Text) -> Checker {
    if type_name != "WindowEvent" or c.uses_window_event {
        return c
    }
    Checker { type_defs: c.type_defs, functions: c.functions, builtins: c.builtins, locals: c.locals, diagnostics: c.diagnostics, function_name: c.function_name, return_type: c.return_type, declared_effects: c.declared_effects, used_effects: c.used_effects, loop_depth: c.loop_depth, uses_window_event: true }
}

fn enter_function(c: Checker, name: Text, return_type: Type, effects: List[Text]) -> Checker {
    Checker { type_defs: c.type_defs, functions: c.functions, builtins: c.builtins, locals: [], diagnostics: c.diagnostics, function_name: name, return_type: return_type, declared_effects: effects, used_effects: [], loop_depth: 0, uses_window_event: c.uses_window_event }
}

fn checked(c: Checker, expr: Expr, ty: Type) -> Checked = Checked { checker: c, expr: with_type(expr, ty) }

fn type_index(c: Checker, name: Text) -> Int {
    for index in range(0, length(c.type_defs)) {
        if c.type_defs[index].name == name {
            return index
        }
    }
    -1
}

fn find_signature(c: Checker, name: Text) -> List[Signature] {
    for s in c.functions {
        if s.name == name {
            return [s]
        }
    }
    []
}

fn find_local(c: Checker, name: Text) -> List[Local] {
    var index = length(c.locals) - 1
    while index >= 0 {
        if c.locals[index].name == name {
            return [c.locals[index]]
        }
        set index = index - 1
    }
    []
}

fn quoted_names(names: List[Text]) -> Text {
    var parts: List[Text] = []
    for n in names {
        set parts = append(parts, "`" + n + "`")
    }
    join(parts, ", ")
}

fn field_names(fields: List[FieldType]) -> List[Text] {
    var names: List[Text] = []
    for f in fields {
        set names = append(names, f.name)
    }
    names
}

fn variant_names(variants: List[VariantType]) -> List[Text] {
    var names: List[Text] = []
    for v in variants {
        set names = append(names, v.name)
    }
    names
}

// ---------- naming ----------

fn is_snake_case(name: Text) -> Bool {
    let codes = code_points(name)
    if length(codes) == 0 or not is_lower(codes[0]) {
        return false
    }
    for code in codes {
        if not (is_lower(code) or is_digit(code) or code == 95) {
            return false
        }
    }
    if codes[length(codes) - 1] == 95 {
        return false
    }
    for index in range(1, length(codes)) {
        if codes[index] == 95 and codes[index - 1] == 95 {
            return false
        }
    }
    true
}

fn is_pascal_case(name: Text) -> Bool {
    let codes = code_points(name)
    if length(codes) == 0 or not is_upper(codes[0]) {
        return false
    }
    for code in codes {
        if not is_alphanumeric(code) {
            return false
        }
    }
    true
}

fn to_snake_case(name: Text) -> Text {
    var out: List[Int] = []
    var index = 0
    for code in code_points(name) {
        let count = length(out)
        if is_upper(code) {
            if index > 0 and not (count > 0 and out[count - 1] == 95) {
                set out = append(out, 95)
            }
            set out = append(out, code + 32)
        } else if code == 95 and (count == 0 or out[count - 1] == 95) {
            set index = index
        } else {
            set out = append(out, code)
        }
        set index = index + 1
    }
    while length(out) > 0 and out[length(out) - 1] == 95 {
        set out = slice(out, 0, length(out) - 1)
    }
    from_code_points(out)
}

fn to_pascal_case(name: Text) -> Text {
    var out: List[Int] = []
    for part in split_on(name, 95) {
        let codes = code_points(part)
        if length(codes) > 0 {
            let first = if is_lower(codes[0]) { codes[0] - 32 } else { codes[0] }
            set out = concat(append(out, first), slice(codes, 1, length(codes)))
        }
    }
    from_code_points(out)
}

fn check_snake(c: Checker, name: Text, span: Span, what: Text) -> Checker {
    if is_snake_case(name) {
        return c
    }
    let suggestion = to_snake_case(name)
    let shown = if suggestion == "" { "a_name" } else { suggestion }
    report(c, error_help("E0207", span, what + " `" + name + "` must be written in snake_case", "rename it to `" + shown + "`"))
}

fn check_pascal(c: Checker, name: Text, span: Span, what: Text) -> Checker {
    if is_pascal_case(name) {
        return c
    }
    report(c, error_help("E0207", span, what + " `" + name + "` must be written in PascalCase", "rename it to `" + to_pascal_case(name) + "`"))
}

// ---------- scopes ----------

fn declare(start: Checker, name: Text, span: Span, ty: Type, mutable: Bool, what: Text) -> Checker {
    let c = check_snake(start, name, span, what)
    let existing = find_local(c, name)
    if length(existing) > 0 {
        let d = error_help("E0204", span, "`" + name + "` is already defined on line " + to_text(existing[0].span.line), "Tessera does not allow shadowing; choose a different name")
        return report(c, d)
    }
    with_locals(c, append(c.locals, Local { name: name, ty: ty, mutable: mutable, was_set: false, span: span }))
}

fn pop_scope(start: Checker, mark: Int) -> Checker {
    var c = start
    for local in slice(c.locals, mark, length(c.locals)) {
        if local.mutable and not local.was_set {
            set c = report(c, error_help("E0206", local.span, "`" + local.name + "` is declared with `var` but never changed", "use `let` for values that do not change"))
        }
    }
    with_locals(c, slice(c.locals, 0, mark))
}

fn mark_set(c: Checker, name: Text) -> Checker {
    var index = length(c.locals) - 1
    while index >= 0 {
        let local = c.locals[index]
        if local.name == name {
            let updated = Local { name: local.name, ty: local.ty, mutable: local.mutable, was_set: true, span: local.span }
            return with_locals(c, replace_at(c.locals, index, updated))
        }
        set index = index - 1
    }
    c
}

// ---------- declarations ----------

fn builtin_type_names() -> List[Text] = ["Int", "Bool", "Text", "Unit", "List", "Never", "WindowEvent"]

fn resolve(start: Checker, te: TypeExpr) -> ResolvedType {
    let name = te.name
    if name == "List" {
        if length(te.args) != 1 {
            let d = error_help("E0208", te.span, "`List` needs exactly one element type", "write e.g. `List[Int]`")
            return ResolvedType { checker: report(start, d), ty: Type.Unknown }
        }
        let inner = resolve(start, te.args[0])
        return ResolvedType { checker: inner.checker, ty: Type.List(inner.ty) }
    }
    var c = start
    var ty = Type.Unknown
    if name == "Int" {
        set ty = Type.Int
    } else if name == "Bool" {
        set ty = Type.Bool
    } else if name == "Text" {
        set ty = Type.Text
    } else if name == "Unit" {
        set ty = Type.Unit
    } else if type_index(c, name) >= 0 {
        set ty = Type.Named(name)
        set c = mark_window_event(c, name)
    } else {
        let hint = match name {
            "i64" => "Int"
            "int" => "Int"
            "integer" => "Int"
            "bool" => "Bool"
            "boolean" => "Bool"
            "str" => "Text"
            "string" => "Text"
            "String" => "Text"
            "text" => "Text"
            "unit" => "Unit"
            "void" => "Unit"
            "list" => "List[...]"
            "Vec" => "List[...]"
            "vec" => "List[...]"
            "Array" => "List[...]"
            _ => ""
        }
        var d = error("E0208", te.span, "unknown type `" + name + "`")
        if hint != "" {
            set d = with_help(d, "did you mean `" + hint + "`?")
        }
        return ResolvedType { checker: report(c, d), ty: Type.Unknown }
    }
    if length(te.args) > 0 {
        set c = report(c, error("E0208", te.span, "type `" + name + "` takes no type arguments"))
    }
    ResolvedType { checker: c, ty: ty }
}

fn resolve_fields(start: Checker, fields: List[Field]) -> ResolvedFields {
    var c = start
    var out: List[FieldType] = []
    for f in fields {
        set c = check_snake(c, f.name, f.span, "field")
        if contains_text(field_names(out), f.name) {
            set c = report(c, error("E0201", f.span, "field `" + f.name + "` is defined twice"))
            continue
        }
        let resolved = resolve(c, f.type_expr)
        set c = resolved.checker
        set out = append(out, FieldType { name: f.name, ty: resolved.ty })
    }
    ResolvedFields { checker: c, fields: out }
}

fn declaration_name(item: Item) -> Text {
    match item {
        Item.FunctionItem(f) => f.name
        Item.RecordItem(r) => r.name
        Item.EnumItem(e) => e.name
    }
}

fn check_program(items: List[Item]) -> CheckedProgram {
    let nowhere = span_of(0, 1, 1, 2)
    var c = Checker { type_defs: [window_event_type(nowhere)], functions: [], builtins: builtin_table(), locals: [], diagnostics: [], function_name: "", return_type: Type.Unit, declared_effects: [], used_effects: [], loop_depth: 0, uses_window_event: false }

    // 1. Type names, so that field types can refer to any declared type.
    for item in items {
        let decl_span = match item {
            Item.RecordItem(r) => [r.name_span]
            Item.EnumItem(e) => [e.name_span]
            Item.FunctionItem(_) => []
        }
        if length(decl_span) == 0 {
            continue
        }
        let name = declaration_name(item)
        set c = check_pascal(c, name, decl_span[0], "type")
        if contains_text(builtin_type_names(), name) {
            set c = report(c, error("E0201", decl_span[0], "`" + name + "` is a built-in type and cannot be redefined"))
            continue
        }
        let existing = type_index(c, name)
        if existing >= 0 {
            set c = report(c, error("E0201", decl_span[0], "type `" + name + "` is already defined on line " + to_text(c.type_defs[existing].span.line)))
            continue
        }
        let is_enum = match item {
            Item.EnumItem(_) => true
            _ => false
        }
        set c = with_type_defs(c, append(c.type_defs, TypeDef { name: name, is_enum: is_enum, fields: [], variants: [], span: decl_span[0] }))
    }

    // 2. Type bodies.
    for item in items {
        match item {
            Item.RecordItem(r) => {
                let index = type_index(c, r.name)
                if index >= 0 and c.type_defs[index].span == r.name_span {
                    let resolved = resolve_fields(c, r.fields)
                    set c = resolved.checker
                    let def = TypeDef { name: r.name, is_enum: false, fields: resolved.fields, variants: [], span: r.name_span }
                    set c = with_type_defs(c, replace_at(c.type_defs, index, def))
                }
            }
            Item.EnumItem(e) => {
                let index = type_index(c, e.name)
                if index >= 0 and c.type_defs[index].span == e.name_span {
                    var variants: List[VariantType] = []
                    for v in e.variants {
                        set c = check_pascal(c, v.name, v.span, "variant")
                        if contains_text(variant_names(variants), v.name) {
                            set c = report(c, error("E0201", v.span, "variant `" + v.name + "` is defined twice"))
                            continue
                        }
                        let resolved = resolve_fields(c, v.fields)
                        set c = resolved.checker
                        set variants = append(variants, VariantType { name: v.name, fields: resolved.fields })
                    }
                    if length(variants) == 0 {
                        set c = report(c, error("E0201", e.name_span, "enum `" + e.name + "` has no variants"))
                    }
                    let def = TypeDef { name: e.name, is_enum: true, fields: [], variants: variants, span: e.name_span }
                    set c = with_type_defs(c, replace_at(c.type_defs, index, def))
                }
            }
            Item.FunctionItem(_) => {}
        }
    }

    // 3. Function signatures.
    for item in items {
        match item {
            Item.FunctionItem(f) => {
                set c = check_snake(c, f.name, f.name_span, "function name")
                if is_builtin_name(c, f.name) {
                    set c = report(c, error_help("E0211", f.name_span, "`" + f.name + "` is a built-in function and cannot be redefined", "choose a different name"))
                    continue
                }
                let previous = find_signature(c, f.name)
                if length(previous) > 0 {
                    set c = report(c, error_help("E0201", f.name_span, "function `" + f.name + "` is already defined on line " + to_text(previous[0].span.line), "Tessera has no overloading; give the function a different name"))
                    continue
                }
                var params: List[Type] = []
                for p in f.params {
                    let resolved = resolve(c, p.type_expr)
                    set c = resolved.checker
                    set params = append(params, resolved.ty)
                }
                let ret = resolve(c, f.return_type)
                set c = ret.checker
                var effects: List[Text] = []
                for effect in f.effects {
                    if not contains_text(effect_names(), effect.name) {
                        set c = report(c, error_help("E0303", effect.span, "unknown effect `" + effect.name + "`", "known effects are: " + join(effect_names(), ", ")))
                    } else if contains_text(effects, effect.name) {
                        set c = report(c, error("E0304", effect.span, "effect `" + effect.name + "` is listed twice"))
                    } else {
                        set effects = append(effects, effect.name)
                    }
                }
                set c = with_functions(c, append(c.functions, Signature { name: f.name, params: params, return_type: ret.ty, effects: effects, span: f.name_span }))
            }
            _ => {}
        }
    }

    // 4. main.
    var main_found = false
    for item in items {
        match item {
            Item.FunctionItem(f) => {
                if f.name == "main" and not main_found {
                    set main_found = true
                    if length(f.params) > 0 or f.return_type.name != "Unit" {
                        set c = report(c, error_help("E0212", f.name_span, "`main` must take no parameters and return `Unit`", "use the `args()` built-in (effect `env`) to read command-line arguments"))
                    }
                }
            }
            _ => {}
        }
    }
    if not main_found {
        set c = report(c, error_help("E0212", nowhere, "the program has no `main` function", "add `fn main() -> Unit uses io { ... }`"))
    }

    // 5. Bodies.
    var typed: List[Item] = []
    var uses_ui = false
    for item in items {
        match item {
            Item.FunctionItem(f) => {
                let signature = find_signature(c, f.name)
                if length(signature) > 0 and signature[0].span == f.name_span {
                    if contains_text(signature[0].effects, "ui") {
                        set uses_ui = true
                    }
                    let result = check_function(c, f, signature[0])
                    set c = result.checker
                    let typed_function = Function { notes: f.notes, name: f.name, name_span: f.name_span, params: f.params, return_type: f.return_type, effects: f.effects, body: result.expr }
                    set typed = append(typed, Item.FunctionItem(typed_function))
                } else {
                    set typed = append(typed, item)
                }
            }
            _ => {
                set typed = append(typed, item)
            }
        }
    }
    CheckedProgram { items: typed, type_defs: c.type_defs, diagnostics: c.diagnostics, uses_ui: uses_ui or c.uses_window_event }
}

fn check_function(start: Checker, f: Function, signature: Signature) -> Checked {
    var c = enter_function(start, f.name, signature.return_type, signature.effects)
    for index in range(0, length(f.params)) {
        let p = f.params[index]
        set c = declare(c, p.name, p.span, signature.params[index], false, "parameter")
    }
    let body = check_expr(c, f.body, signature.return_type)
    set c = body.checker
    let body_type = body.expr.ty
    if not fits(body_type, signature.return_type) {
        let span = match f.body.kind {
            ExprKind.BlockExpr(block) => match block.tail {
                OptionalExpr.Present(tail) => tail.span
                OptionalExpr.Absent => block.span
            }
            _ => f.body.span
        }
        let d = error("E0501", span, "function `" + f.name + "` must return `" + type_text(signature.return_type) + "`, but its body produces `" + type_text(body_type) + "`")
        set c = report(c, with_label(d, "this is `" + type_text(body_type) + "`"))
    }
    set c = pop_scope(c, 0)
    if f.name != "main" {
        for effect in f.effects {
            if contains_text(signature.effects, effect.name) and not contains_text(c.used_effects, effect.name) {
                let d = error_help("E0302", effect.span, "function `" + f.name + "` declares effect `" + effect.name + "` but never uses it", "remove `" + effect.name + "` from the `uses` list so the signature does not overstate what the function can do")
                set c = report(c, d)
            }
        }
    }
    Checked { checker: c, expr: body.expr }
}

// ---------- expressions ----------

fn expect_expr(c: Checker, e: Expr, expected: Type) -> Checked {
    let result = check_expr(c, e, expected)
    let actual = result.expr.ty
    if fits(actual, expected) {
        return result
    }
    let d = error("E0501", e.span, "expected `" + type_text(expected) + "`, found `" + type_text(actual) + "`")
    Checked { checker: report(result.checker, with_label(d, "this is `" + type_text(actual) + "`")), expr: result.expr }
}

fn check_all(start: Checker, exprs: List[Expr]) -> CheckedArgs {
    var c = start
    var out: List[Expr] = []
    for e in exprs {
        let result = check_expr(c, e, Type.Unknown)
        set c = result.checker
        set out = append(out, result.expr)
    }
    CheckedArgs { checker: c, args: out }
}

note "`expected` is `Type.Unknown` when the context does not require a type."
fn check_expr(c: Checker, e: Expr, expected: Type) -> Checked {
    match e.kind {
        ExprKind.IntLiteral(_) => checked(c, e, Type.Int)
        ExprKind.BoolLiteral(_) => checked(c, e, Type.Bool)
        ExprKind.TextLiteral(_) => checked(c, e, Type.Text)
        ExprKind.UnitLiteral => checked(c, e, Type.Unit)
        ExprKind.Name(name) => {
            let local = find_local(c, name)
            if length(local) > 0 {
                return checked(c, e, local[0].ty)
            }
            var d = error("E0202", e.span, "unknown name `" + name + "`")
            if length(find_signature(c, name)) > 0 or is_builtin_name(c, name) {
                set d = with_help(d, "`" + name + "` is a function; call it with `" + name + "(...)`")
            }
            checked(report(c, d), e, Type.Unknown)
        }
        ExprKind.ListLiteral(items) => check_list(c, e, items, expected)
        ExprKind.Call(name, name_span, args) => check_call(c, e, name, name_span, args, expected)
        ExprKind.Index(target, index) => {
            let target_result = check_expr(c, target, Type.Unknown)
            let index_result = expect_expr(target_result.checker, index, Type.Int)
            let typed = with_kind(e, ExprKind.Index(target_result.expr, index_result.expr))
            let after = index_result.checker
            match target_result.expr.ty {
                Type.List(element) => checked(after, typed, element)
                Type.Unknown => checked(after, typed, Type.Unknown)
                Type.Text => {
                    let d = error_help("E0507", target.span, "`Text` cannot be indexed", "use `code_points(text)` to get a `List[Int]` of characters")
                    checked(report(after, d), typed, Type.Unknown)
                }
                _ => {
                    let d = error("E0507", target.span, "only lists can be indexed, found `" + type_text(target_result.expr.ty) + "`")
                    checked(report(after, d), typed, Type.Unknown)
                }
            }
        }
        ExprKind.FieldAccess(target, name, name_span) => check_field(c, e, target, name, name_span)
        ExprKind.Unary(op, operand) => {
            let want = if op == UnaryOp.Negate { Type.Int } else { Type.Bool }
            let result = check_expr(c, operand, want)
            let typed = with_kind(e, ExprKind.Unary(op, result.expr))
            if fits(result.expr.ty, want) {
                return checked(result.checker, typed, want)
            }
            let symbol = if op == UnaryOp.Negate { "-" } else { "not" }
            let d = error("E0503", operand.span, "`" + symbol + "` needs `" + type_text(want) + "`, found `" + type_text(result.expr.ty) + "`")
            checked(report(result.checker, d), typed, want)
        }
        ExprKind.Binary(op, op_span, left, right) => check_binary(c, e, op, op_span, left, right)
        ExprKind.If(condition, then_block, else_branch) => check_if(c, e, condition, then_block, else_branch, expected)
        ExprKind.BlockExpr(block) => {
            let result = check_block(c, block, expected)
            checked(result.checker, with_kind(e, ExprKind.BlockExpr(result.block)), result.ty)
        }
        ExprKind.Match(scrutinee, arms) => check_match(c, e, scrutinee, arms, expected)
        ExprKind.RecordLiteral(type_name, type_span, fields) => check_record_literal(c, e, type_name, type_span, fields)
        ExprKind.VariantLiteral(type_name, variant, variant_span, args) => check_variant(c, e, type_name, variant, variant_span, args)
        ExprKind.Return(value) => {
            let ret = c.return_type
            match value {
                OptionalExpr.Present(v) => {
                    let result = check_expr(c, v, ret)
                    let typed = with_kind(e, ExprKind.Return(OptionalExpr.Present(result.expr)))
                    if fits(result.expr.ty, ret) {
                        return checked(result.checker, typed, Type.Never)
                    }
                    let d = error("E0501", v.span, "function `" + c.function_name + "` returns `" + type_text(ret) + "`, but this is `" + type_text(result.expr.ty) + "`")
                    checked(report(result.checker, d), typed, Type.Never)
                }
                OptionalExpr.Absent => {
                    if fits(Type.Unit, ret) {
                        return checked(c, e, Type.Never)
                    }
                    let d = error("E0501", e.span, "function `" + c.function_name + "` returns `" + type_text(ret) + "`; `return` needs a value")
                    checked(report(c, d), e, Type.Never)
                }
            }
        }
        ExprKind.Break => check_jump(c, e, "break")
        ExprKind.Continue => check_jump(c, e, "continue")
    }
}

fn check_jump(c: Checker, e: Expr, word: Text) -> Checked {
    if c.loop_depth == 0 {
        return checked(report(c, error("E0210", e.span, "`" + word + "` can only be used inside a loop")), e, Type.Never)
    }
    checked(c, e, Type.Never)
}

fn check_list(start: Checker, e: Expr, items: List[Expr], expected: Type) -> Checked {
    let element_expected: List[Type] = match expected {
        Type.List(element) => [element]
        _ => []
    }
    if length(items) == 0 {
        if length(element_expected) > 0 {
            return checked(start, e, Type.List(element_expected[0]))
        }
        let d = error_help("E0505", e.span, "the element type of this empty list is unknown", "add a type annotation, e.g. `let names: List[Text] = []`")
        return checked(report(start, d), e, Type.Unknown)
    }
    let first_hint = if length(element_expected) > 0 { element_expected[0] } else { Type.Unknown }
    let first = check_expr(start, items[0], first_hint)
    var c = first.checker
    var element = first.expr.ty
    if length(element_expected) > 0 and fits(element, element_expected[0]) {
        set element = element_expected[0]
    }
    var typed: List[Expr] = [first.expr]
    for item in slice(items, 1, length(items)) {
        let result = check_expr(c, item, element)
        set c = result.checker
        set typed = append(typed, result.expr)
        let joined = join_types(element, result.expr.ty)
        if length(joined) > 0 {
            set element = joined[0]
        } else {
            let found = type_text(result.expr.ty)
            let d = error("E0501", item.span, "list elements must all have the same type: expected `" + type_text(element) + "`, found `" + found + "`")
            set c = report(c, with_label(d, "this is `" + found + "`"))
        }
    }
    checked(c, with_kind(e, ExprKind.ListLiteral(typed)), Type.List(element))
}

fn check_field(c: Checker, e: Expr, target: Expr, name: Text, name_span: Span) -> Checked {
    let target_result = check_expr(c, target, Type.Unknown)
    let after = target_result.checker
    let typed = with_kind(e, ExprKind.FieldAccess(target_result.expr, name, name_span))
    match target_result.expr.ty {
        Type.Unknown => checked(after, typed, Type.Unknown)
        Type.Named(type_name) => {
            let index = type_index(after, type_name)
            if index >= 0 and not after.type_defs[index].is_enum {
                let fields = after.type_defs[index].fields
                for f in fields {
                    if f.name == name {
                        return checked(after, typed, f.ty)
                    }
                }
                let d = error_help("E0209", name_span, "type `" + type_name + "` has no field `" + name + "`", "available fields: " + quoted_names(field_names(fields)))
                return checked(report(after, d), typed, Type.Unknown)
            }
            let d = error_help("E0512", name_span, "`" + type_name + "` is an enum; it has no fields", "use `match` to read the values inside an enum")
            checked(report(after, d), typed, Type.Unknown)
        }
        _ => {
            let d = error("E0512", name_span, "`" + type_text(target_result.expr.ty) + "` has no fields")
            checked(report(after, d), typed, Type.Unknown)
        }
    }
}

fn check_condition(c: Checker, condition: Expr, what: Text) -> Checked {
    let result = check_expr(c, condition, Type.Bool)
    if fits(result.expr.ty, Type.Bool) {
        return result
    }
    let d = error_help("E0504", condition.span, "the condition of `" + what + "` must be `Bool`, found `" + type_text(result.expr.ty) + "`", "Tessera has no truthiness; write a comparison such as `count != 0`")
    Checked { checker: report(result.checker, d), expr: result.expr }
}

fn tail_or_block_span(block: Block) -> Span {
    match block.tail {
        OptionalExpr.Present(tail) => tail.span
        OptionalExpr.Absent => block.span
    }
}

fn check_if(c: Checker, e: Expr, condition: Expr, then_block: Block, else_branch: OptionalExpr, expected: Type) -> Checked {
    let cond = check_condition(c, condition, "if")
    match else_branch {
        OptionalExpr.Absent => {
            let then_result = check_block(cond.checker, then_block, Type.Unit)
            let typed = with_kind(e, ExprKind.If(cond.expr, then_result.block, OptionalExpr.Absent))
            if is_unit_like(then_result.ty) {
                return checked(then_result.checker, typed, Type.Unit)
            }
            let d = error_help("E0506", tail_or_block_span(then_block), "this `if` has no `else`, so its block cannot produce a value (found `" + type_text(then_result.ty) + "`)", "add an `else` branch, or use `let _ = ...` to discard the value")
            checked(report(then_result.checker, d), typed, Type.Unit)
        }
        OptionalExpr.Present(else_expr) => {
            let then_result = check_block(cond.checker, then_block, expected)
            let hint = if expected != Type.Unknown { expected } else if then_result.ty != Type.Never { then_result.ty } else { Type.Unknown }
            let else_result = check_expr(then_result.checker, else_expr, hint)
            let typed = with_kind(e, ExprKind.If(cond.expr, then_result.block, OptionalExpr.Present(else_result.expr)))
            let joined = join_types(then_result.ty, else_result.expr.ty)
            if length(joined) > 0 {
                return checked(else_result.checker, typed, joined[0])
            }
            let else_text = type_text(else_result.expr.ty)
            let d = error("E0506", else_expr.span, "`if` and `else` have different types: `" + type_text(then_result.ty) + "` and `" + else_text + "`")
            checked(report(else_result.checker, with_label(d, "this is `" + else_text + "`")), typed, Type.Unknown)
        }
    }
}

fn check_block(start: Checker, block: Block, expected: Type) -> CheckedBlock {
    let mark = length(start.locals)
    var c = start
    var statements: List[Statement] = []
    for statement in block.statements {
        let result = check_statement(c, statement)
        set c = result.checker
        set statements = append(statements, result.statement)
    }
    var ty = Type.Unit
    var tail = OptionalExpr.Absent
    match block.tail {
        OptionalExpr.Present(tail_expr) => {
            let result = check_expr(c, tail_expr, expected)
            set c = result.checker
            set ty = result.expr.ty
            set tail = OptionalExpr.Present(result.expr)
        }
        OptionalExpr.Absent => {}
    }
    CheckedBlock { checker: pop_scope(c, mark), block: Block { statements: statements, tail: tail, span: block.span }, ty: ty }
}

type CheckedStatement {
    checker: Checker
    statement: Statement
}

fn check_statement(c: Checker, statement: Statement) -> CheckedStatement {
    match statement {
        Statement.Let(name, name_span, declared, value, mutable) => {
            var after = c
            var ty = Type.Unknown
            var typed_value = value
            match declared {
                OptionalType.Present(type_expr) => {
                    let resolved = resolve(c, type_expr)
                    let result = expect_expr(resolved.checker, value, resolved.ty)
                    set after = result.checker
                    set ty = resolved.ty
                    set typed_value = result.expr
                }
                OptionalType.Absent => {
                    let result = check_expr(c, value, Type.Unknown)
                    set after = result.checker
                    set ty = result.expr.ty
                    set typed_value = result.expr
                    if ty == Type.Unit {
                        set after = report(after, error_help("E0508", value.span, "this expression produces no value (`Unit`)", "call it as a statement instead of binding it"))
                    }
                }
            }
            if name == "_" {
                if mutable {
                    set after = report(after, error_help("E0110", name_span, "`var _` is not allowed", "use `let _ = ...` to discard a value"))
                }
            } else {
                set after = declare(after, name, name_span, ty, mutable, "variable")
            }
            CheckedStatement { checker: after, statement: Statement.Let(name, name_span, declared, typed_value, mutable) }
        }
        Statement.Set(name, name_span, value) => {
            let target = find_local(c, name)
            if length(target) == 0 {
                let result = check_expr(report(c, error("E0202", name_span, "unknown name `" + name + "`")), value, Type.Unknown)
                return CheckedStatement { checker: result.checker, statement: Statement.Set(name, name_span, result.expr) }
            }
            var after = c
            if not target[0].mutable {
                set after = report(after, error_help("E0205", name_span, "`" + name + "` cannot be changed", "declare it with `var` instead of `let` (line " + to_text(target[0].span.line) + "); parameters can never be changed"))
            } else {
                set after = mark_set(after, name)
            }
            let result = expect_expr(after, value, target[0].ty)
            CheckedStatement { checker: result.checker, statement: Statement.Set(name, name_span, result.expr) }
        }
        Statement.For(variable, variable_span, iterable, body) => {
            let iterable_result = check_expr(c, iterable, Type.Unknown)
            var after = iterable_result.checker
            var element = Type.Unknown
            match iterable_result.expr.ty {
                Type.List(item_type) => {
                    set element = item_type
                }
                Type.Unknown => {}
                _ => {
                    let found = iterable_result.expr.ty
                    var d = error("E0507", iterable.span, "`for` needs a list, found `" + type_text(found) + "`")
                    if found == Type.Text {
                        set d = with_help(d, "use `for code in code_points(text)` to loop over characters")
                    } else if found == Type.Int {
                        set d = with_help(d, "use `range(0, n)` to loop over numbers")
                    }
                    set after = report(after, d)
                }
            }
            let mark = length(after.locals)
            set after = declare(after, variable, variable_span, element, false, "loop variable")
            set after = with_loop_depth(after, after.loop_depth + 1)
            let body_result = check_loop_body(after, body, "for")
            set after = with_loop_depth(body_result.checker, body_result.checker.loop_depth - 1)
            set after = pop_scope(after, mark)
            CheckedStatement { checker: after, statement: Statement.For(variable, variable_span, iterable_result.expr, body_result.block) }
        }
        Statement.While(condition, body) => {
            let cond = check_condition(c, condition, "while")
            let inside = with_loop_depth(cond.checker, cond.checker.loop_depth + 1)
            let body_result = check_loop_body(inside, body, "while")
            let after = with_loop_depth(body_result.checker, body_result.checker.loop_depth - 1)
            CheckedStatement { checker: after, statement: Statement.While(cond.expr, body_result.block) }
        }
        Statement.ExprStatement(expr) => {
            let result = check_expr(c, expr, Type.Unknown)
            if is_unit_like(result.expr.ty) {
                return CheckedStatement { checker: result.checker, statement: Statement.ExprStatement(result.expr) }
            }
            let d = error_help("E0508", expr.span, "the value of this expression (`" + type_text(result.expr.ty) + "`) is not used", "use the value, or write `let _ = ...` to discard it explicitly")
            CheckedStatement { checker: report(result.checker, d), statement: Statement.ExprStatement(result.expr) }
        }
    }
}

fn check_loop_body(c: Checker, body: Block, what: Text) -> CheckedBlock {
    let result = check_block(c, body, Type.Unit)
    if is_unit_like(result.ty) {
        return result
    }
    let d = error_help("E0508", tail_or_block_span(body), "the body of `" + what + "` must not produce a value (found `" + type_text(result.ty) + "`)", "write `let _ = ...` to discard the value")
    CheckedBlock { checker: report(result.checker, d), block: result.block, ty: result.ty }
}

fn check_binary(c: Checker, e: Expr, op: BinaryOp, op_span: Span, left: Expr, right: Expr) -> Checked {
    let symbol = binary_symbol(op)
    if op == BinaryOp.Add {
        let left_result = check_expr(c, left, Type.Unknown)
        let left_type = left_result.expr.ty
        let right_result = check_expr(left_result.checker, right, left_type)
        let right_type = right_result.expr.ty
        let typed = with_kind(e, ExprKind.Binary(op, op_span, left_result.expr, right_result.expr))
        let after = right_result.checker
        if left_type == Type.Int and right_type == Type.Int {
            return checked(after, typed, Type.Int)
        }
        if left_type == Type.Text and right_type == Type.Text {
            return checked(after, typed, Type.Text)
        }
        let simple_left = left_type == Type.Int or left_type == Type.Text or left_type == Type.Unknown
        let simple_right = right_type == Type.Int or right_type == Type.Text or right_type == Type.Unknown
        if left_type == Type.Unknown and simple_right {
            return checked(after, typed, right_type)
        }
        if right_type == Type.Unknown and simple_left {
            return checked(after, typed, left_type)
        }
        var d = error("E0503", e.span, "`+` cannot combine `" + type_text(left_type) + "` and `" + type_text(right_type) + "`")
        let mixed = (left_type == Type.Text and right_type == Type.Int) or (left_type == Type.Int and right_type == Type.Text)
        let left_is_list = match left_type {
            Type.List(_) => true
            _ => false
        }
        if mixed {
            set d = with_help(d, "convert the number with `to_text(...)`; Tessera has no implicit conversions")
        } else if left_is_list {
            set d = with_help(d, "use `concat(a, b)` to join lists or `append(list, item)` to add one item")
        }
        return checked(report(after, d), typed, Type.Unknown)
    }
    if op == BinaryOp.Equal or op == BinaryOp.NotEqual {
        let left_result = check_expr(c, left, Type.Unknown)
        let right_result = check_expr(left_result.checker, right, left_result.expr.ty)
        let typed = with_kind(e, ExprKind.Binary(op, op_span, left_result.expr, right_result.expr))
        if length(join_types(left_result.expr.ty, right_result.expr.ty)) > 0 {
            return checked(right_result.checker, typed, Type.Bool)
        }
        let d = error("E0514", e.span, "cannot compare `" + type_text(left_result.expr.ty) + "` with `" + type_text(right_result.expr.ty) + "`")
        return checked(report(right_result.checker, d), typed, Type.Bool)
    }
    let is_logic = op == BinaryOp.And or op == BinaryOp.Or
    let is_order = op == BinaryOp.Less or op == BinaryOp.LessEqual or op == BinaryOp.Greater or op == BinaryOp.GreaterEqual
    let operand_type = if is_logic { Type.Bool } else { Type.Int }
    let result_type = if is_logic or is_order { Type.Bool } else { Type.Int }
    let left_result = check_expr(c, left, operand_type)
    var after = left_result.checker
    if not fits(left_result.expr.ty, operand_type) {
        set after = report(after, operand_error(op, is_order, left.span, left_result.expr.ty, operand_type))
    }
    let right_result = check_expr(after, right, operand_type)
    set after = right_result.checker
    if not fits(right_result.expr.ty, operand_type) {
        set after = report(after, operand_error(op, is_order, right.span, right_result.expr.ty, operand_type))
    }
    checked(after, with_kind(e, ExprKind.Binary(op, op_span, left_result.expr, right_result.expr)), result_type)
}

fn operand_error(op: BinaryOp, is_order: Bool, span: Span, found: Type, wanted: Type) -> Diagnostic {
    let symbol = binary_symbol(op)
    if is_order {
        return error("E0514", span, "`" + symbol + "` compares numbers only, found `" + type_text(found) + "`")
    }
    error("E0503", span, "`" + symbol + "` needs `" + type_text(wanted) + "`, found `" + type_text(found) + "`")
}

fn check_record_literal(start: Checker, e: Expr, type_name: Text, type_span: Span, inits: List[FieldInit]) -> Checked {
    let index = type_index(start, type_name)
    if index < 0 or start.type_defs[index].is_enum {
        let d = if index < 0 {
            error("E0208", type_span, "unknown type `" + type_name + "`")
        } else {
            error_help("E0511", type_span, "`" + type_name + "` is an enum, not a record", "build an enum value with `" + type_name + ".Variant(...)`")
        }
        var after = report(start, d)
        var typed_inits: List[FieldInit] = []
        for init in inits {
            let result = check_expr(after, init.value, Type.Unknown)
            set after = result.checker
            set typed_inits = append(typed_inits, FieldInit { name: init.name, span: init.span, value: result.expr })
        }
        return checked(after, with_kind(e, ExprKind.RecordLiteral(type_name, type_span, typed_inits)), Type.Unknown)
    }
    let fields = start.type_defs[index].fields
    var c = start
    var seen: List[Text] = []
    var typed: List[FieldInit] = []
    for init in inits {
        var field_type: List[Type] = []
        for f in fields {
            if f.name == init.name {
                set field_type = [f.ty]
            }
        }
        if length(field_type) > 0 {
            if contains_text(seen, init.name) {
                set c = report(c, error("E0511", init.span, "field `" + init.name + "` is given twice"))
            }
            set seen = append(seen, init.name)
            let result = expect_expr(c, init.value, field_type[0])
            set c = result.checker
            set typed = append(typed, FieldInit { name: init.name, span: init.span, value: result.expr })
        } else {
            set c = report(c, error("E0209", init.span, "type `" + type_name + "` has no field `" + init.name + "`"))
            let result = check_expr(c, init.value, Type.Unknown)
            set c = result.checker
            set typed = append(typed, FieldInit { name: init.name, span: init.span, value: result.expr })
        }
    }
    var missing: List[Text] = []
    for f in fields {
        if not contains_text(seen, f.name) {
            set missing = append(missing, f.name)
        }
    }
    if length(missing) > 0 {
        set c = report(c, error_help("E0511", e.span, "missing field(s) " + quoted_names(missing) + " in `" + type_name + "`", "every field must be given a value"))
    }
    checked(c, with_kind(e, ExprKind.RecordLiteral(type_name, type_span, typed)), Type.Named(type_name))
}

fn check_variant(start: Checker, e: Expr, type_name: Text, variant: Text, variant_span: Span, args: List[Expr]) -> Checked {
    let c = mark_window_event(start, type_name)
    let index = type_index(c, type_name)
    if index < 0 {
        let all = check_all(report(c, error("E0208", e.span, "unknown type `" + type_name + "`")), args)
        return checked(all.checker, with_kind(e, ExprKind.VariantLiteral(type_name, variant, variant_span, all.args)), Type.Unknown)
    }
    let def = c.type_defs[index]
    if not def.is_enum {
        let d = error_help("E0209", e.span, "`" + type_name + "` is a record, not an enum", "build it with `" + type_name + " { field: value }`")
        return checked(report(c, d), e, Type.Unknown)
    }
    var fields: List[FieldType] = []
    var found = false
    for v in def.variants {
        if v.name == variant {
            set fields = v.fields
            set found = true
        }
    }
    if not found {
        let d = error_help("E0209", variant_span, "enum `" + type_name + "` has no variant `" + variant + "`", "available variants: " + quoted_names(variant_names(def.variants)))
        let all = check_all(report(c, d), args)
        return checked(all.checker, with_kind(e, ExprKind.VariantLiteral(type_name, variant, variant_span, all.args)), Type.Unknown)
    }
    if length(args) != length(fields) {
        let d = error("E0502", e.span, "`" + type_name + "." + variant + "` takes " + to_text(length(fields)) + " value(s), but " + to_text(length(args)) + " were given")
        let all = check_all(report(c, d), args)
        return checked(all.checker, with_kind(e, ExprKind.VariantLiteral(type_name, variant, variant_span, all.args)), Type.Named(type_name))
    }
    var after = c
    var typed: List[Expr] = []
    for position in range(0, length(args)) {
        let result = expect_expr(after, args[position], fields[position].ty)
        set after = result.checker
        set typed = append(typed, result.expr)
    }
    checked(after, with_kind(e, ExprKind.VariantLiteral(type_name, variant, variant_span, typed)), Type.Named(type_name))
}

// ---------- match ----------

fn check_match(start: Checker, e: Expr, scrutinee: Expr, arms: List[Arm], expected: Type) -> Checked {
    let scrutinee_result = check_expr(start, scrutinee, Type.Unknown)
    var c = scrutinee_result.checker
    let st = scrutinee_result.expr.ty
    var enum_variants: List[VariantType] = []
    var is_enum_match = false
    var is_valid = st == Type.Int or st == Type.Text or st == Type.Bool or st == Type.Unknown
    match st {
        Type.Named(name) => {
            let index = type_index(c, name)
            if index >= 0 and c.type_defs[index].is_enum {
                set enum_variants = c.type_defs[index].variants
                set is_enum_match = true
                set is_valid = true
            }
        }
        _ => {}
    }
    if not is_valid {
        set c = report(c, error_help("E0513", scrutinee.span, "cannot `match` on `" + type_text(st) + "`", "`match` works on enums, `Int`, `Text` and `Bool`"))
    }
    var result: List[Type] = []
    var covered: List[Text] = []
    var seen_true = false
    var seen_false = false
    var has_wildcard = false
    var seen_literals: List[Text] = []
    var typed_arms: List[Arm] = []
    for arm in arms {
        let pattern_span = arm.pattern.span
        if has_wildcard {
            set c = report(c, error_help("E0510", pattern_span, "this arm can never match: an earlier `_` arm matches everything", "remove this arm or move it above the `_` arm"))
        }
        let mark = length(c.locals)
        match arm.pattern.kind {
            PatternKind.Wildcard => {
                set has_wildcard = true
            }
            PatternKind.IntPattern(value) => {
                set c = pattern_type(c, st, Type.Int, pattern_span)
                let key = "i" + to_text(value)
                if contains_text(seen_literals, key) {
                    set c = report(c, error("E0510", pattern_span, "this value is already matched by an earlier arm"))
                }
                set seen_literals = append(seen_literals, key)
            }
            PatternKind.TextPattern(value) => {
                set c = pattern_type(c, st, Type.Text, pattern_span)
                let key = "t" + value
                if contains_text(seen_literals, key) {
                    set c = report(c, error("E0510", pattern_span, "this value is already matched by an earlier arm"))
                }
                set seen_literals = append(seen_literals, key)
            }
            PatternKind.BoolPattern(value) => {
                set c = pattern_type(c, st, Type.Bool, pattern_span)
                if (value and seen_true) or (not value and seen_false) {
                    set c = report(c, error("E0510", pattern_span, "this value is already matched by an earlier arm"))
                }
                if value {
                    set seen_true = true
                } else {
                    set seen_false = true
                }
            }
            PatternKind.VariantPattern(type_name, variant, bindings) => {
                set c = mark_window_event(c, type_name)
                var fields: List[FieldType] = []
                var resolved = false
                if is_enum_match and st == Type.Named(type_name) {
                    for v in enum_variants {
                        if v.name == variant {
                            set fields = v.fields
                            set resolved = true
                        }
                    }
                    if not resolved {
                        set c = report(c, error_help("E0209", pattern_span, "enum `" + type_name + "` has no variant `" + variant + "`", "available variants: " + quoted_names(variant_names(enum_variants))))
                    }
                } else if st != Type.Unknown {
                    set c = report(c, error("E0513", pattern_span, "pattern of type `" + type_name + "` cannot match a value of type `" + type_text(st) + "`"))
                }
                if resolved {
                    if contains_text(covered, variant) {
                        set c = report(c, error("E0510", pattern_span, "`" + type_name + "." + variant + "` is already matched by an earlier arm"))
                    }
                    set covered = append(covered, variant)
                    if length(bindings) != length(fields) {
                        let d = error_help("E0513", pattern_span, "`" + type_name + "." + variant + "` has " + to_text(length(fields)) + " field(s), but the pattern binds " + to_text(length(bindings)), "write `" + type_name + "." + variant + "(" + join(field_names(fields), ", ") + ")`")
                        set c = report(c, d)
                    }
                    var position = 0
                    while position < length(bindings) and position < length(fields) {
                        let b = bindings[position]
                        if b.name != "_" {
                            set c = declare(c, b.name, b.span, fields[position].ty, false, "binding")
                        }
                        set position = position + 1
                    }
                } else {
                    for b in bindings {
                        if b.name != "_" {
                            set c = declare(c, b.name, b.span, Type.Unknown, false, "binding")
                        }
                    }
                }
            }
        }
        var hint = expected
        if hint == Type.Unknown and length(result) > 0 and result[0] != Type.Never {
            set hint = result[0]
        }
        let body = check_expr(c, arm.body, hint)
        set c = pop_scope(body.checker, mark)
        set typed_arms = append(typed_arms, Arm { pattern: arm.pattern, body: body.expr })
        let body_type = body.expr.ty
        if length(result) == 0 {
            set result = [body_type]
        } else {
            let joined = join_types(result[0], body_type)
            if length(joined) > 0 {
                set result = joined
            } else {
                let d = error("E0506", arm.body.span, "match arms have different types: `" + type_text(result[0]) + "` and `" + type_text(body_type) + "`")
                set c = report(c, with_label(d, "this is `" + type_text(body_type) + "`"))
                set result = [Type.Unknown]
            }
        }
    }
    if not has_wildcard {
        if st == Type.Bool {
            if not (seen_true and seen_false) {
                set c = report(c, error_help("E0509", e.span, "`match` does not cover all values", "add the missing `true`/`false` arm or a `_` arm"))
            }
        } else if is_enum_match {
            var missing: List[Text] = []
            for v in enum_variants {
                if not contains_text(covered, v.name) {
                    set missing = append(missing, type_text(st) + "." + v.name)
                }
            }
            if length(missing) > 0 {
                set c = report(c, error_help("E0509", e.span, "`match` does not cover " + quoted_names(missing), "add an arm for each missing variant (preferred) or a `_` arm"))
            }
        } else if st != Type.Unknown and is_valid {
            set c = report(c, error_help("E0509", e.span, "`match` on `" + type_text(st) + "` needs a `_` arm", "add `_ => ...` as the last arm"))
        } else if not is_valid {
            let is_named = match st {
                Type.Named(_) => true
                _ => false
            }
            if not is_named {
                set c = report(c, error_help("E0509", e.span, "`match` on `" + type_text(st) + "` needs a `_` arm", "add `_ => ...` as the last arm"))
            }
        }
    }
    let typed = with_kind(e, ExprKind.Match(scrutinee_result.expr, typed_arms))
    if length(arms) == 0 {
        return checked(c, typed, Type.Never)
    }
    checked(c, typed, if length(result) > 0 { result[0] } else { Type.Unknown })
}

fn pattern_type(c: Checker, scrutinee: Type, pattern: Type, span: Span) -> Checker {
    if fits(pattern, scrutinee) {
        return c
    }
    report(c, error("E0513", span, "pattern of type `" + type_text(pattern) + "` cannot match a value of type `" + type_text(scrutinee) + "`"))
}

// ---------- calls ----------

fn use_effect(c: Checker, effect: Text, callee: Text, span: Span) -> Checker {
    if contains_text(c.declared_effects, effect) {
        if contains_text(c.used_effects, effect) {
            return c
        }
        return with_used_effects(c, append(c.used_effects, effect))
    }
    let d = error_help("E0301", span, "`" + callee + "` uses effect `" + effect + "`, but `" + c.function_name + "` does not declare it", "add `uses " + effect + "` to the signature of `" + c.function_name + "`, or move the call to a function that already uses `" + effect + "`")
    report(c, with_label(d, "this call needs `" + effect + "`"))
}

fn arity_error(c: Checker, name: Text, args: List[Expr], count: Int, span: Span) -> CheckedArgs {
    let d = error("E0502", span, "`" + name + "` takes " + to_text(count) + " argument(s), but " + to_text(length(args)) + " were given")
    check_all(report(c, d), args)
}

fn expect_args(start: Checker, args: List[Expr], params: List[Type]) -> CheckedArgs {
    var c = start
    var typed: List[Expr] = []
    for index in range(0, length(args)) {
        let result = expect_expr(c, args[index], params[index])
        set c = result.checker
        set typed = append(typed, result.expr)
    }
    CheckedArgs { checker: c, args: typed }
}

type ListArg {
    checker: Checker
    expr: Expr
    element: Type
}

fn list_arg(c: Checker, arg: Expr, expected: Type, name: Text) -> ListArg {
    let list_expected = match expected {
        Type.List(_) => expected
        _ => Type.Unknown
    }
    let result = check_expr(c, arg, list_expected)
    match result.expr.ty {
        Type.List(element) => ListArg { checker: result.checker, expr: result.expr, element: element }
        Type.Unknown => ListArg { checker: result.checker, expr: result.expr, element: Type.Unknown }
        Type.Never => ListArg { checker: result.checker, expr: result.expr, element: Type.Unknown }
        _ => {
            let d = error("E0501", arg.span, "`" + name + "` needs a list, found `" + type_text(result.expr.ty) + "`")
            ListArg { checker: report(result.checker, d), expr: result.expr, element: Type.Unknown }
        }
    }
}

fn call_result(c: Checker, e: Expr, name: Text, name_span: Span, args: List[Expr], ty: Type) -> Checked {
    checked(c, with_kind(e, ExprKind.Call(name, name_span, args)), ty)
}

fn check_generic_call(c: Checker, e: Expr, name: Text, name_span: Span, args: List[Expr], expected: Type) -> Checked {
    let span = e.span
    if name == "to_text" or name == "length" {
        if length(args) != 1 {
            let all = arity_error(c, name, args, 1, span)
            return call_result(all.checker, e, name, name_span, all.args, if name == "to_text" { Type.Text } else { Type.Int })
        }
        let result = check_expr(c, args[0], Type.Unknown)
        let t = result.expr.ty
        var after = result.checker
        let base_ok = t == Type.Unknown or t == Type.Never
        if name == "to_text" {
            if not (base_ok or t == Type.Int or t == Type.Bool) {
                set after = report(after, error("E0501", args[0].span, "`to_text` accepts `Int` or `Bool`, found `" + type_text(t) + "`"))
            }
            return call_result(after, e, name, name_span, [result.expr], Type.Text)
        }
        let is_list = match t {
            Type.List(_) => true
            _ => false
        }
        if not (base_ok or is_list or t == Type.Text) {
            set after = report(after, error("E0501", args[0].span, "`length` accepts a list or `Text`, found `" + type_text(t) + "`"))
        }
        return call_result(after, e, name, name_span, [result.expr], Type.Int)
    }
    let count = if name == "append" or name == "concat" { 2 } else { 3 }
    if length(args) != count {
        let all = arity_error(c, name, args, count, span)
        return call_result(all.checker, e, name, name_span, all.args, Type.Unknown)
    }
    let list = list_arg(c, args[0], expected, name)
    let element = list.element
    let rest_types = match name {
        "append" => [element]
        "concat" => [Type.List(element)]
        "slice" => [Type.Int, Type.Int]
        _ => [Type.Int, element]
    }
    let rest = expect_args(list.checker, slice(args, 1, count), rest_types)
    call_result(rest.checker, e, name, name_span, concat([list.expr], rest.args), Type.List(element))
}

fn check_call(start: Checker, e: Expr, name: Text, name_span: Span, args: List[Expr], expected: Type) -> Checked {
    if contains_text(generic_builtin_names(), name) {
        return check_generic_call(start, e, name, name_span, args, expected)
    }
    for b in start.builtins {
        if b.name == name {
            var c = start
            if b.effect != "" {
                set c = use_effect(c, b.effect, name, e.span)
            }
            if name == "next_event" {
                set c = mark_window_event(c, "WindowEvent")
            }
            if length(args) != length(b.params) {
                let all = arity_error(c, name, args, length(b.params), e.span)
                return call_result(all.checker, e, name, name_span, all.args, b.return_type)
            }
            let typed = expect_args(c, args, b.params)
            return call_result(typed.checker, e, name, name_span, typed.args, b.return_type)
        }
    }
    let signature = find_signature(start, name)
    if length(signature) == 0 {
        var d = error("E0203", name_span, "unknown function `" + name + "`")
        if length(find_local(start, name)) > 0 {
            set d = with_help(d, "`" + name + "` is a value, not a function")
        }
        let all = check_all(report(start, d), args)
        return call_result(all.checker, e, name, name_span, all.args, Type.Unknown)
    }
    let sig = signature[0]
    var c = start
    for effect in sig.effects {
        set c = use_effect(c, effect, name, e.span)
    }
    if length(args) != length(sig.params) {
        let all = arity_error(c, name, args, length(sig.params), e.span)
        return call_result(all.checker, e, name, name_span, all.args, sig.return_type)
    }
    let typed = expect_args(c, args, sig.params)
    call_result(typed.checker, e, name, name_span, typed.args, sig.return_type)
}
