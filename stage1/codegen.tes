// Rust code generation from the typed program. Output must match the stage 0
// compiler byte for byte for programs without the `ui` effect.
//
// Value model: Int -> i64, Bool -> bool, Text -> Rc<String>, List[T] -> Rc<Vec<T>>,
// user types -> Rc<T_Name>. Reading a variable clones it (cheap); `set x = f(x, ...)`
// moves `x` instead when nothing can observe the difference (spec 6.2).

import source uses nothing
import ast uses nothing
import parser uses nothing
import checker uses nothing

type Gen {
paths: List[Text]
type_defs: List[checker.TypeDef]
function_name: Text
tmp: Int
take_var: Text
}

type Code {
gen: Gen
text: Text
}

type CodeList {
gen: Gen
texts: List[Text]
}

type Usage {
count: Int
has_jump_or_loop: Bool
}

fn code(g: Gen, text: Text) -> Code = Code { gen: g, text: text }

fn rust_type(ty: ast.Type) -> Text {
match ty {
.Int => "i64"
.Bool => "bool"
.Text => "Rc<String>"
.Unit => "()"
.Never => "()"
.Unknown => "()"
.List(element) => "Rc<Vec<" + rust_type(element) + ">>"
.Option(element) => "Option<" + rust_type(element) + ">"
.Result(value, error) => "Result<" + rust_type(value) + ", " + rust_type(error) + ">"
.Named(name) => "Rc<T_" + name + ">"
.Map(key, value) => "Rc<std::collections::BTreeMap<" + rust_type(key) + ", " + rust_type(value) + ">>"
.Bytes => "Rc<Vec<u8>>"
.Decimal => "TDecimal"
.Database => "TDatabase"
.Function(params, result, _) => {
var names: List[Text] = []
for p in params {
set names = append(names, rust_type(p))
}
"fn(" + join(names, ", ") + ") -> " + rust_type(result)
}
}
}

fn pad(indent: Int) -> Text = source.repeat_text("    ", indent)

fn find_type_def(defs: List[checker.TypeDef], name: Text) -> Option[checker.TypeDef] {
for def in defs {
if def.name == name {
return .Some(def)
}
}
.None
}

fn definition_of(defs: List[checker.TypeDef], name: Text) -> Text {
match find_type_def(defs, name) {
.Some(def) => type_definition(def)
.None => fail("no type definition for `\(name)`")
}
}

note "Resolve a type expression the checker already validated."
fn resolve_simple(te: ast.TypeExpr, defs: List[checker.TypeDef]) -> ast.Type {
match te.name {
"Int" => .Int
"Bool" => .Bool
"Text" => .Text
"Unit" => .Unit
"List" => if length(te.args) > 0 { .List(resolve_simple(te.args[0], defs)) } else { .List(.Unknown) }
"Option" => if length(te.args) > 0 { .Option(resolve_simple(te.args[0], defs)) } else { .Option(.Unknown) }
"Result" => if length(te.args) > 1 { .Result(resolve_simple(te.args[0], defs), resolve_simple(te.args[1], defs)) } else { .Result(.Unknown, .Unknown) }
"Map" => if length(te.args) > 1 { .Map(resolve_simple(te.args[0], defs), resolve_simple(te.args[1], defs)) } else { .Map(.Unknown, .Unknown) }
"Bytes" => .Bytes
"Decimal" => .Decimal
"Database" => .Database
"fn" => function_type_simple(te, defs)
_ => if find_type_def(defs, te.name) != .None { .Named(te.name) } else { .Unknown }
}
}

note "A function type is stored as `fn` with the parameter types, the result type and a last `uses` entry listing the effects."
fn function_type_simple(te: ast.TypeExpr, defs: List[checker.TypeDef]) -> ast.Type {
let count = length(te.args)
var params: List[ast.Type] = []
for index in range(0, count - 2) {
set params = append(params, resolve_simple(te.args[index], defs))
}
var effects: List[Text] = []
for e in te.args[count - 1].args {
set effects = append(effects, e.name)
}
.Function(params, resolve_simple(te.args[count - 2], defs), effects)
}

fn replace_newlines(text: Text) -> Text {
var out: List[Int] = []
for c in code_points(text) {
set out = append(out, if c == 10 { 32 } else { c })
}
from_code_points(out)
}

// ---------- program ----------

fn type_definition(def: checker.TypeDef) -> Text {
if def.is_enum {
var out = "#[derive(Clone, PartialEq)]\nenum T_\(def.name) {\n"
for v in def.variants {
if length(v.fields) == 0 {
set out = "\(out)    V_\(v.name),\n"
} else {
var types: List[Text] = []
for f in v.fields {
set types = append(types, rust_type(f.ty))
}
set out = "\(out)    V_\(v.name)(\(join(types, ", "))),\n"
}
}
return "\(out)}\n\n"
}
var out = "#[derive(Clone, PartialEq)]\nstruct T_\(def.name) {\n"
for f in def.fields {
set out = "\(out)    f_\(f.name): \(rust_type(f.ty)),\n"
}
"\(out)}\n\n"
}

pub type Runtime {
core: Text
ui: Text
extra: Text
web: Text
}

note "`mode` is `program` (an executable: `main`, or a web application with `handle`), `library` (a web application as a shared library) or `tests`."
pub fn generate(program: checker.CheckedProgram, paths: List[Text], runtime: Runtime, mode: Text) -> Text {
var out = ""
if program.uses_ui {
set out = out + definition_of(program.type_defs, "WindowEvent")
}
set out = out + definition_of(program.type_defs, "FileError")
for item in program.items {
match item {
.RecordItem(r) => {
set out = out + definition_of(program.type_defs, r.name)
}
.EnumItem(e) => {
set out = out + definition_of(program.type_defs, e.name)
}
.FunctionItem(_) => {}
.ImportItem(_) => {}
.TestItem(_, _, _) => {}
}
}
var g = Gen { paths: paths, type_defs: program.type_defs, function_name: "", tmp: 0, take_var: "" }
for item in program.items {
match item {
.FunctionItem(f) => {
let result = gen_function(g, f)
set g = result.gen
set out = "\(out)\(result.text)\n"
}
_ => {}
}
}
var tests: List[Text] = []
var test_number = 0
for item in program.items {
match item {
.TestItem(name, span, body) => {
if mode == "tests" {
let tg = g with { function_name: "test \"\(name)\"", tmp: 0, take_var: "" }
let block = match body.kind {
.BlockExpr(b) => gen_block(tg, b, 0)
_ => code(tg, "{}")
}
set g = block.gen
set out = "\(out)fn t_test_\(test_number)() \(with_first_line(block.text, "t_enter(\(location(tg, span)));", 1))\n\n"
set tests = append(tests, "(\(source.rust_string(name)), t_test_\(test_number) as fn())")
set test_number = test_number + 1
}
}
_ => {}
}
}
let entry_code = if mode == "tests" {
"fn main() {\n    t_run_tests(&[\(join(tests, ", "))]);\n}\n"
} else if program.entry == "handle" {
handler_glue() + (if mode == "library" { "" } else { "fn main() {\n    tw_web_main(tessera_app);\n}\n" })
} else {
"fn main() {\n    t_run(f_main);\n}\n"
}
let body = out + entry_code
var head = "// Generated by the Tessera compiler. Do not edit.\n\(runtime.core)\(runtime.extra)"
if program.uses_ui {
set head = head + runtime.ui
}
if contains_part(body, "tw_") or contains_part(body, "TDecimal") or contains_part(body, "TDatabase") {
set head = head + runtime.web
}
"\(head)\n\(body)"
}

note "Connects the host's raw request and response (runtime/web.rs) with `handle` through std/http."
fn handler_glue() -> Text {
join([
"// The web application entry point used by every host (CGI, servers, server modules).",
"pub fn tessera_app(raw: RawRequest) -> RawResponse {",
"    let mut names: Vec<Rc<String>> = Vec::new();",
"    let mut values: Vec<Rc<String>> = Vec::new();",
"    for (name, value) in raw.headers.into_iter() { names.push(Rc::new(name)); values.push(Rc::new(value)); }",
"    let request = f_std__http__from_raw(Rc::new(raw.method), Rc::new(raw.path), Rc::new(raw.query), Rc::new(raw.remote_addr), Rc::new(names), Rc::new(values), Rc::new(raw.body));",
"    let response = f_handle(request);",
"    let status = f_std__http__status_of(response.clone());",
"    let header_names = f_std__http__header_names_of(response.clone());",
"    let header_values = f_std__http__header_values_of(response.clone());",
"    let body = f_std__http__body_of(response);",
"    RawResponse {",
"        status: if (100..=999).contains(&status) { status as u16 } else { 500 },",
"        headers: header_names.iter().zip(header_values.iter()).map(|(n, v)| (n.to_string(), v.to_string())).collect(),",
"        body: body.to_vec(),",
"    }",
"}",
""
], "\n")
}

note "Whether `part` occurs in `text`; decides which runtime parts a program needs."
fn contains_part(text: Text, part: Text) -> Bool {
let codes = code_points(text)
let wanted = code_points(part)
let last = length(codes) - length(wanted)
var index = 0
while index <= last {
if codes[index] == wanted[0] {
var same = true
var offset = 1
while same and offset < length(wanted) {
if codes[index + offset] != wanted[offset] {
set same = false
}
set offset = offset + 1
}
if same {
return true
}
}
set index = index + 1
}
false
}

fn gen_function(start: Gen, f: ast.Function) -> Code {
let g = start with { function_name: f.name, tmp: 0, take_var: "" }
var out = ""
for n in f.notes {
set out = "\(out)// note: \(replace_newlines(n.text))\n"
}
var params: List[Text] = []
for p in f.params {
set params = append(params, "v_\(p.name): \(rust_type(resolve_simple(p.type_expr, g.type_defs)))")
}
let ret = rust_type(resolve_simple(f.return_type, g.type_defs))
let body = match f.body.kind {
.BlockExpr(block) => gen_block(g, block, 0)
_ => {
let inner = gen_expr(g, f.body, 1)
code(inner.gen, "{\n    \(inner.text)\n}")
}
}
let entered = with_first_line(body.text, "t_enter(\(location(g, f.name_span)));", 1)
code(body.gen, "\(out)fn f_\(f.name)(\(join(params, ", "))) -> \(ret) \(entered)\n")
}

note "Inserts `line` as the first statement of a generated block (text starting with `{` and a newline): the stack and time checks of draft 0.13."
fn with_first_line(block: Text, line: Text, indent: Int) -> Text {
let codes = code_points(block)
"{\n\(pad(indent))\(line)\n\(from_code_points(slice(codes, 2, length(codes))))"
}

fn gen_block(start: Gen, block: ast.Block, indent: Int) -> Code {
var g = start
var out = "{\n"
for statement in block.statements {
let line = gen_statement(g, statement, indent + 1)
set g = line.gen
set out = "\(out)\(pad(indent + 1))\(line.text)\n"
}
match block.tail {
.Some(tail) => {
let result = gen_expr(g, tail, indent + 1)
set g = result.gen
set out = "\(out)\(pad(indent + 1))\(result.text)\n"
}
.None => {}
}
code(g, "\(out)\(pad(indent))}")
}

fn gen_statement(g: Gen, statement: ast.Statement, indent: Int) -> Code {
match statement {
.Let(name, _, _, value, mutable) => {
let v = gen_expr(g, value, indent)
if name == "_" {
return code(v.gen, "let _ = \(v.text);")
}
let m = if mutable { "mut " } else { "" }
if value.ty == .Never {
return code(v.gen, "let \(m)v_\(name) = \(v.text);")
}
code(v.gen, "let \(m)v_\(name): \(rust_type(value.ty)) = \(v.text);")
}
.Set(name, _, value) => {
let usage = scan_expr(value, name)
let movable = match value.ty {
.Text => true
.List(_) => true
.Map(_, _) => true
.Bytes => true
_ => false
}
let prepared = if movable and usage.count == 1 and not usage.has_jump_or_loop { g with { take_var: name } } else { g }
let v = gen_expr(prepared, value, indent)
code(v.gen with { take_var: "" }, "v_\(name) = \(v.text);")
}
.SetPlace(target, value) => gen_set_place(g, target, value, indent)
.For(variable, _, iterable, body) => {
let it = gen_expr(g, iterable, indent)
let b = gen_block(it.gen, body, indent)
let binding = if variable == "_" { "_" } else { "v_\(variable)" }
code(b.gen, "for \(binding) in t_iter(\(it.text)) \(with_first_line(b.text, "t_tick(\(location(g, body.span)));", indent + 1))")
}
.While(condition, body) => {
let c = gen_expr(g, condition, indent)
let b = gen_block(c.gen, body, indent)
code(b.gen, "while \(c.text) \(with_first_line(b.text, "t_tick(\(location(g, body.span)));", indent + 1))")
}
.ExprStatement(expr) => {
let e = gen_expr(g, expr, indent)
code(e.gen, "\(e.text);")
}
}
}

// ---------- setting a place (spec 6.2) ----------

fn place_root_name(target: ast.Expr) -> Text {
match target.kind {
.Name(name) => name
.FieldAccess(inner, _, _) => place_root_name(inner)
.Index(inner, _) => place_root_name(inner)
_ => ""
}
}

note "The index expressions of a place, outermost (leftmost) first."
fn place_indexes(target: ast.Expr) -> List[ast.Expr] {
match target.kind {
.FieldAccess(inner, _, _) => place_indexes(inner)
.Index(inner, index) => place_indexes(inner) + [index]
_ => []
}
}

note "A Rust expression of type `&mut T` for the place; index `n` (from the left) is in `t_place<n>`. Records and lists are copied on write by `Rc::make_mut` when shared."
fn place_reference(g: Gen, target: ast.Expr) -> Text {
match target.kind {
.Name(name) => "&mut v_\(name)"
.FieldAccess(inner, field, _) => "&mut Rc::make_mut(\(place_reference(g, inner))).f_\(field)"
.Index(inner, _) => "t_slot(\(place_reference(g, inner)), t_place\(length(place_indexes(inner))), \(location(g, target.span)))"
_ => fail("internal compiler error: invalid place reached code generation")
}
}

note "`set place = value`: indexes left to right, then the value, then the checked write."
fn gen_set_place(g: Gen, target: ast.Expr, value: ast.Expr, indent: Int) -> Code {
var current = g
var out = "{ "
var number = 0
for index in place_indexes(target) {
let i = gen_expr(current, index, indent)
set current = i.gen
set out = "\(out)let t_place\(number): i64 = \(i.text); "
set number += 1
}
let v = gen_expr(current, value, indent)
set out = "\(out)let t_value = \(v.text); "
match target.kind {
.Index(inner, _) => {
if inner.ty == .Bytes {
return code(v.gen, "\(out)t_set_byte(\(place_reference(g, inner)), t_place\(number - 1), t_value, \(location(g, target.span))); }")
}
}
_ => {}
}
code(v.gen, "\(out)*\(place_reference(g, target)) = t_value; }")
}

// ---------- move analysis ----------

fn no_usage() -> Usage = Usage { count: 0, has_jump_or_loop: false }

fn add_usage(a: Usage, b: Usage) -> Usage {
Usage { count: a.count + b.count, has_jump_or_loop: a.has_jump_or_loop or b.has_jump_or_loop }
}

fn with_jump(u: Usage) -> Usage = u with { has_jump_or_loop: true }

fn scan_list(exprs: List[ast.Expr], name: Text) -> Usage {
var total = no_usage()
for e in exprs {
set total = add_usage(total, scan_expr(e, name))
}
total
}

fn scan_block(block: ast.Block, name: Text) -> Usage {
var total = no_usage()
for statement in block.statements {
let part = match statement {
.Let(_, _, _, value, _) => scan_expr(value, name)
.Set(target, _, value) => {
let inner = scan_expr(value, name)
if target == name { inner with { count: inner.count + 2 } } else { inner }
}
.SetPlace(target, value) => {
// Like `Set`: a changed variable is never moved out of (count + 2).
let inner = add_usage(scan_expr(target, name), scan_expr(value, name))
if place_root_name(target) == name { inner with { count: inner.count + 2 } } else { inner }
}
.ExprStatement(expr) => scan_expr(expr, name)
.For(_, _, iterable, body) => with_jump(add_usage(scan_expr(iterable, name), scan_block(body, name)))
.While(condition, body) => with_jump(add_usage(scan_expr(condition, name), scan_block(body, name)))
}
set total = add_usage(total, part)
}
match block.tail {
.Some(tail) => add_usage(total, scan_expr(tail, name))
.None => total
}
}

fn scan_expr(e: ast.Expr, name: Text) -> Usage {
match e.kind {
.Name(n) => if n == name { Usage { count: 1, has_jump_or_loop: false } } else { no_usage() }
.ListLiteral(items) => scan_list(items, name)
.Call(_, _, args) => scan_list(args, name)
.VariantLiteral(_, _, _, args) => scan_list(args, name)
.Index(target, index) => add_usage(scan_expr(target, name), scan_expr(index, name))
.FieldAccess(target, _, _) => scan_expr(target, name)
.Unary(_, operand) => scan_expr(operand, name)
.Binary(_, _, left, right) => add_usage(scan_expr(left, name), scan_expr(right, name))
.If(condition, then_block, else_branch) => {
let both = add_usage(scan_expr(condition, name), scan_block(then_block, name))
match else_branch {
.Some(else_expr) => add_usage(both, scan_expr(else_expr, name))
.None => both
}
}
.BlockExpr(block) => scan_block(block, name)
.Match(scrutinee, arms) => {
var total = scan_expr(scrutinee, name)
for arm in arms {
set total = add_usage(total, scan_expr(arm.body, name))
}
total
}
.RecordUpdate(target, fields) => {
var total = scan_expr(target, name)
for f in fields {
set total = add_usage(total, scan_expr(f.value, name))
}
total
}
.RecordLiteral(_, _, fields) => {
var total = no_usage()
for f in fields {
set total = add_usage(total, scan_expr(f.value, name))
}
total
}
.Return(value) => match value {
.Some(v) => with_jump(scan_expr(v, name))
.None => with_jump(no_usage())
}
.Try(operand) => with_jump(scan_expr(operand, name))
.Break => with_jump(no_usage())
.Continue => with_jump(no_usage())
.DecimalLiteral(_) => no_usage()
.MapLiteral(keys, values) => add_usage(scan_list(keys, name), scan_list(values, name))
.FunctionRef(_) => no_usage()
.CallValue(callee, args) => add_usage(scan_expr(callee, name), scan_list(args, name))
.OrElse(value, otherwise) => with_jump(add_usage(scan_expr(value, name), scan_expr(otherwise, name)))
_ => no_usage()
}
}

// ---------- expressions ----------

fn location(g: Gen, span: source.Span) -> Text {
source.rust_string("\(g.paths[span.file]):\(span.line):\(span.col) in function `\(g.function_name)`")
}

fn gen_list(start: Gen, exprs: List[ast.Expr], indent: Int) -> CodeList {
var g = start
var texts: List[Text] = []
for e in exprs {
let result = gen_expr(g, e, indent)
set g = result.gen
set texts = append(texts, result.text)
}
CodeList { gen: g, texts: texts }
}

fn int_literal(value: Int) -> Text {
if value == parser.min_int() {
return "i64::MIN"
}
if value < 0 {
return "(\(value)i64)"
}
"\(value)i64"
}

fn gen_expr(g: Gen, e: ast.Expr, indent: Int) -> Code {
match e.kind {
.IntLiteral(value) => code(g, int_literal(value))
.BoolLiteral(value) => code(g, to_text(value))
.TextLiteral(value) => code(g, "t_text(\(source.rust_string(value)))")
.UnitLiteral => code(g, "()")
.Name(name) => {
if g.take_var == name {
return code(g with { take_var: "" }, "std::mem::take(&mut v_\(name))")
}
code(g, "v_\(name).clone()")
}
.ListLiteral(items) => {
if length(items) == 0 {
let element = match e.ty {
.List(t) => rust_type(t)
_ => "()"
}
return code(g, "Rc::new(Vec::<\(element)>::new())")
}
let parts = gen_list(g, items, indent)
code(parts.gen, "Rc::new(vec![\(join(parts.texts, ", "))])")
}
.Call(name, _, args) => gen_call(g, name, args, e.span, indent)
.Index(target, index) => {
let t = gen_expr(g, target, indent)
let i = gen_expr(t.gen, index, indent)
let function = if target.ty == .Bytes { "t_bytes_index" } else { "t_index" }
code(i.gen, "\(function)(&\(t.text), \(i.text), \(location(g, e.span)))")
}
.FieldAccess(target, name, _) => {
let t = gen_expr(g, target, indent)
code(t.gen, "(\(t.text)).f_\(name).clone()")
}
.Unary(op, operand) => {
let o = gen_expr(g, operand, indent)
match op {
.Negate => code(o.gen, if e.ty == .Decimal { "tw_dec_neg(\(o.text), \(location(g, e.span)))" } else { "t_neg(\(o.text), \(location(g, e.span)))" })
.Not => code(o.gen, "(!\(o.text))")
}
}
.Binary(op, op_span, left, right) => {
let l = gen_expr(g, left, indent)
let r = gen_expr(l.gen, right, indent)
let loc = location(g, op_span)
let a = l.text
let b = r.text
let text = match op {
.Add => match e.ty {
.Text => "t_concat(\(a), \(b))"
.List(_) => "t_concat_lists(\(a), \(b))"
.Bytes => "t_concat_lists(\(a), \(b))"
.Decimal => "tw_dec_add(\(a), \(b), \(loc))"
_ => "t_add(\(a), \(b), \(loc))"
}
.Subtract => if e.ty == .Decimal { "tw_dec_sub(\(a), \(b), \(loc))" } else { "t_sub(" + a + ", " + b + ", " + loc + ")" }
.Multiply => if e.ty == .Decimal { "tw_dec_mul(\(a), \(b), \(loc))" } else { "t_mul(" + a + ", " + b + ", " + loc + ")" }
.Divide => if e.ty == .Decimal { "tw_dec_div(\(a), \(b), \(loc))" } else { "t_div(" + a + ", " + b + ", " + loc + ")" }
.Remainder => "t_rem(" + a + ", " + b + ", " + loc + ")"
.Equal => "(" + a + " == " + b + ")"
.NotEqual => "(" + a + " != " + b + ")"
.Less => "(" + a + " < " + b + ")"
.LessEqual => "(" + a + " <= " + b + ")"
.Greater => "(" + a + " > " + b + ")"
.GreaterEqual => "(" + a + " >= " + b + ")"
.And => "(" + a + " && " + b + ")"
.Or => "(" + a + " || " + b + ")"
}
code(r.gen, text)
}
.If(condition, then_block, else_branch) => {
let c = gen_expr(g, condition, indent)
let t = gen_block(c.gen, then_block, indent)
match else_branch {
.None => code(t.gen, "if \(c.text) \(t.text)")
.Some(else_expr) => {
let el = gen_expr(t.gen, else_expr, indent)
code(el.gen, "if \(c.text) \(t.text) else \(el.text)")
}
}
}
.BlockExpr(block) => gen_block(g, block, indent)
.Match(scrutinee, arms) => gen_match(g, scrutinee, arms, indent)
.RecordLiteral(type_name, _, fields) => {
var current = g
var parts: List[Text] = []
for f in fields {
let v = gen_expr(current, f.value, indent)
set current = v.gen
set parts = append(parts, "f_\(f.name): \(v.text)")
}
code(current, "Rc::new(T_\(type_name) { \(join(parts, ", ")) })")
}
.RecordUpdate(target, fields) => {
let t = gen_expr(g, target, indent)
var current = t.gen with { tmp: t.gen.tmp + 1 }
let tmp = "t\(current.tmp)"
var out = "{ let mut \(tmp) = Rc::unwrap_or_clone(\(t.text)); "
for f in fields {
let v = gen_expr(current, f.value, indent)
set current = v.gen
set out = "\(out)\(tmp).f_\(f.name) = \(v.text); "
}
code(current, "\(out)Rc::new(\(tmp)) }")
}
.VariantLiteral(type_name, variant, _, args) => match type_name {
"Option" => gen_option(g, e, variant, args, indent)
"Result" => {
let value = gen_expr(g, args[0], indent)
let constructor = if variant == "Ok" { "Ok" } else { "Err" }
let turbofish = match e.ty {
.Result(ok_type, error_type) => "Result::<" + rust_type(ok_type) + ", " + rust_type(error_type) + ">"
_ => "Result::<(), ()>"
}
code(value.gen, "\(turbofish)::\(constructor)(\(value.text))")
}
_ => gen_variant(g, type_name, variant, args, indent)
}
.Try(operand) => {
let value = gen_expr(g, operand, indent)
match operand.ty {
.Option(_) => code(value.gen, "match \(value.text) { Some(ok_value) => ok_value, None => return None }")
_ => code(value.gen, "match \(value.text) { Ok(ok_value) => ok_value, Err(error_value) => return Err(error_value) }")
}
}
.Return(value) => match value {
.Some(v) => {
let result = gen_expr(g, v, indent)
code(result.gen, "return \(result.text)")
}
.None => code(g, "return ()")
}
.Break => code(g, "break")
.Continue => code(g, "continue")
.DecimalLiteral(digits) => code(g, decimal_literal(digits))
.MapLiteral(keys, values) => {
let k = gen_list(g, keys, indent)
let v = gen_list(k.gen, values, indent)
var pairs: List[Text] = []
for index in range(0, length(k.texts)) {
set pairs = append(pairs, "(\(k.texts[index]), \(v.texts[index]))")
}
let types = match e.ty {
.Map(key, value) => "\(rust_type(key)), \(rust_type(value))"
_ => "(), ()"
}
code(v.gen, "t_map_new::<\(types)>(vec![\(join(pairs, ", "))])")
}
.FunctionRef(name) => code(g, function_value(g, name, e.ty, indent))
.CallValue(callee, args) => {
let f = gen_expr(g, callee, indent)
let a = gen_list(f.gen, args, indent)
code(a.gen, "(\(f.text))(\(join(a.texts, ", ")))")
}
.OrElse(value, otherwise) => {
let v = gen_expr(g, value, indent)
let o = gen_expr(v.gen, otherwise, indent + 1)
let arms = match value.ty {
.Result(_, _) => "Ok(t_value) => t_value, Err(_) => "
_ => "Some(t_value) => t_value, None => "
}
code(o.gen, "match \(v.text) { \(arms){ \(o.text) } }")
}
}
}

note "Rust names of the variants of the built-in `Option` and `Result`."
fn rust_variant(variant: Text) -> Text = if variant == "Error" { "Err" } else { variant }

fn gen_option(g: Gen, e: ast.Expr, variant: Text, args: List[ast.Expr], indent: Int) -> Code {
if variant == "None" {
let element = match e.ty {
.Option(t) => rust_type(t)
_ => "()"
}
return code(g, "Option::<\(element)>::None")
}
let value = gen_expr(g, args[0], indent)
code(value.gen, "Some(\(value.text))")
}

fn gen_variant(g: Gen, type_name: Text, variant: Text, args: List[ast.Expr], indent: Int) -> Code {
if type_name == "" {
return fail("internal compiler error: unresolved `.\(variant)` shorthand reached code generation")
}
if length(args) == 0 {
return code(g, "Rc::new(T_\(type_name)::V_\(variant))")
}
let parts = gen_list(g, args, indent)
code(parts.gen, "Rc::new(T_\(type_name)::V_\(variant)(\(join(parts.texts, ", "))))")
}

fn variant_has_fields(defs: List[checker.TypeDef], type_name: Text, variant: Text) -> Bool {
match find_type_def(defs, type_name) {
.Some(def) => {
for v in def.variants {
if v.name == variant {
return length(v.fields) > 0
}
}
false
}
.None => false
}
}

fn gen_match(start: Gen, scrutinee: ast.Expr, arms: List[ast.Arm], indent: Int) -> Code {
let s = gen_expr(start, scrutinee, indent)
var g = s.gen
let head = match scrutinee.ty {
.Named(_) => "match &*(" + s.text + ")"
.Option(_) => "match &(" + s.text + ")"
.Result(_, _) => "match &(" + s.text + ")"
.Text => "match (" + s.text + ").as_str()"
_ => "match " + s.text
}
var out = "\(head) {\n"
for arm in arms {
var prefix = ""
var pattern = "_"
match arm.pattern.kind {
.Wildcard => {}
.IntPattern(value) => {
set pattern = if value == parser.min_int() { "i64::MIN" } else { to_text(value) }
}
.TextPattern(value) => {
set pattern = source.rust_string(value)
}
.BoolPattern(value) => {
set pattern = to_text(value)
}
.VariantPattern(type_name, variant, bindings) => {
let is_option = type_name == "Option" or type_name == "Result"
if (is_option and variant != "None") or variant_has_fields(g.type_defs, type_name, variant) {
var parts: List[Text] = []
for b in bindings {
if b.name == "_" {
set parts = append(parts, "_")
} else {
set g = g with { tmp: g.tmp + 1 }
let tmp = "t\(g.tmp)"
set prefix = "\(prefix)let v_\(b.name) = \(tmp).clone(); "
set parts = append(parts, tmp)
}
}
let constructor = if is_option { rust_variant(variant) } else { "T_\(type_name)::V_\(variant)" }
set pattern = "\(constructor)(\(join(parts, ", ")))"
} else {
set pattern = if is_option { variant } else { "T_\(type_name)::V_\(variant)" }
}
}
}
let body = gen_expr(g, arm.body, indent + 1)
set g = body.gen
set out = "\(out)\(pad(indent + 1))\(pattern) => { \(prefix)\(body.text) }\n"
}
code(g, "\(out)\(pad(indent))}")
}

fn call_with_location(name: Text, args: List[Text], loc: Text) -> Text = "\(name)(\(join(append(args, loc), ", ")))"

fn call_plain(name: Text, args: List[Text]) -> Text = "\(name)(\(join(args, ", ")))"

fn references(args: List[Text]) -> List[Text] {
var out: List[Text] = []
for a in args {
set out = append(out, "&" + a)
}
out
}

fn call_ref(name: Text, args: List[Text]) -> Text = call_plain(name, references(args))

fn call_ref_location(name: Text, args: List[Text], loc: Text) -> Text = call_with_location(name, references(args), loc)

note "`Decimal` literals become fixed-point units of 10^-9: `1.25` is `TDecimal(1250000000)`."
fn decimal_literal(digits: Text) -> Text {
var whole: List[Int] = []
var fraction: List[Int] = []
var after_point = false
for code in code_points(digits) {
if code == 46 {
set after_point = true
} else if after_point {
set fraction = append(fraction, code)
} else {
set whole = append(whole, code)
}
}
while length(fraction) < 9 {
set fraction = append(fraction, 48)
}
var units = concat(whole, fraction)
while length(units) > 1 and units[0] == 48 {
set units = slice(units, 1, length(units))
}
"TDecimal(\(from_code_points(units))i128)"
}

note "A function used as a value: a cast of the generated function, or for a built-in a closure without captures."
fn function_value(g: Gen, name: Text, ty: ast.Type, indent: Int) -> Text {
let codes = code_points(name)
if length(codes) == 0 or codes[0] != 35 {
return "(f_\(name) as \(rust_type(ty)))"
}
let builtin = from_code_points(slice(codes, 1, length(codes)))
var params: List[Text] = []
var args: List[ast.Expr] = []
match ty {
.Function(types, _, _) => {
for index in range(0, length(types)) {
set params = append(params, "v_t_arg\(index): \(rust_type(types[index]))")
set args = append(args, ast.Expr { kind: .Name("t_arg\(index)"), span: source.span_of(0, 0, 0, 0), ty: types[index] })
}
}
_ => {}
}
let call = gen_call(g, builtin, args, source.span_of(0, 0, 0, 0), indent)
"((|\(join(params, ", "))| \(call.text)) as \(rust_type(ty)))"
}

fn gen_call(g: Gen, name: Text, args: List[ast.Expr], span: source.Span, indent: Int) -> Code {
let generated = gen_list(g, args, indent)
let a = generated.texts
let loc = location(g, span)
let text = match name {
"print" => call_plain("t_print", a)
"print_error" => call_plain("t_print_error", a)
"to_text" => match args[0].ty {
.Bool => call_plain("t_bool_to_text", a)
.Text => "(" + a[0] + ")"
.Decimal => call_plain("tw_dec_to_text", a)
_ => call_plain("t_int_to_text", a)
}
"length" => match args[0].ty {
.Text => "t_text_length(&\(a[0]))"
.Map(_, _) => "t_map_length(&\(a[0]))"
_ => "t_list_length(&\(a[0]))"
}
"append" => call_plain("t_append", a)
"concat" => call_plain("t_concat_lists", a)
"slice" => call_with_location("t_slice", a, loc)
"replace_at" => call_with_location("t_replace_at", a, loc)
"value_or" => call_plain("t_value_or", a)
"range" => call_with_location("t_range", a, loc)
"code_points" => "t_code_points(&" + a[0] + ")"
"from_code_point" => call_with_location("t_from_code_point", a, loc)
"from_code_points" => "t_from_code_points(&" + a[0] + ", " + loc + ")"
"join" => "t_join(&" + a[0] + ", &" + a[1] + ")"
"split" => "t_split(&" + a[0] + ", &" + a[1] + ")"
"parse_int" => "t_parse_int(&" + a[0] + ")"
"sort" => call_plain("t_sort", a)
"index_of" => if args[0].ty == .Text { "t_text_index_of(&\(a[0]), &\(a[1]))" } else { "t_index_of(&\(a[0]), &\(a[1]))" }
"contains" => match args[0].ty {
.Text => "t_text_contains(&\(a[0]), &\(a[1]))"
.Map(_, _) => "t_map_contains(&\(a[0]), &\(a[1]))"
_ => "t_contains(&\(a[0]), &\(a[1]))"
}
"get" => "t_map_get(&\(a[0]), &\(a[1]))"
"put" => call_plain("t_map_put", a)
"remove" => "t_map_remove(\(a[0]), &\(a[1]))"
"keys" => "t_map_keys(&\(a[0]))"
"values" => "t_map_values(&\(a[0]))"
"map" => call_plain("t_map_list", a)
"filter" => call_plain("t_filter", a)
"sort_by" => call_plain("t_sort_by", a)
"trim" => call_ref("t_trim", a)
"starts_with" => call_ref("t_starts_with", a)
"ends_with" => call_ref("t_ends_with", a)
"replace" => call_ref("t_replace", a)
"slice_text" => call_with_location("t_slice_text", a, loc)
"repeat" => match args[0].ty {
.List(_) => call_with_location("t_repeat_list", a, loc)
_ => call_with_location("t_repeat", a, loc)
}
"bit_and" => "(\(a[0]) & \(a[1]))"
"bit_or" => "(\(a[0]) | \(a[1]))"
"bit_xor" => "(\(a[0]) ^ \(a[1]))"
"shift_left" => call_with_location("t_shift_left", a, loc)
"shift_right" => call_with_location("t_shift_right", a, loc)
"pad_left" => call_with_location("t_pad_left", a, loc)
"pad_right" => call_with_location("t_pad_right", a, loc)
"lines" => call_ref("t_lines", a)
"read_line" => call_with_location("t_read_line", a, loc)
"read_input" => call_with_location("t_read_input", a, loc)
"read_text" => call_with_location("t_read_text", a, loc)
"write_text" => call_with_location("t_write_text", a, loc)
"read_bytes" => call_with_location("t_read_bytes", a, loc)
"write_bytes" => call_with_location("t_write_bytes", a, loc)
"list_directory" => call_with_location("t_list_directory", a, loc)
"create_directory" => call_with_location("t_create_directory", a, loc)
"remove_file" => call_with_location("t_remove_file", a, loc)
"log" => call_plain("t_log", a)
"to_bytes" => call_ref("t_to_bytes", a)
"from_bytes" => call_ref("t_from_bytes", a)
"bytes" => call_with_location("t_bytes", a, loc)
"byte_values" => call_ref("t_byte_values", a)
"decimal" => call_plain("tw_dec_from_int", a)
"parse_decimal" => call_plain("tw_dec_parse", a)
"round" => call_with_location("tw_dec_round", a, loc)
"to_int" => call_with_location("tw_dec_to_int", a, loc)
"now" => call_plain("tw_now_ms", a)
"monotonic" => call_plain("tw_monotonic_ms", a)
"sleep" => call_with_location("tw_sleep_ms", a, loc)
"format_time" => call_plain("tw_format_time", a)
"parse_time" => call_plain("tw_parse_time", a)
"http_date" => call_plain("tw_http_date", a)
"random_int" => call_with_location("tw_random_int", a, loc)
"random_bytes" => call_with_location("tw_random_bytes", a, loc)
"sha256" => call_plain("tw_sha256", a)
"hmac_sha256" => call_plain("tw_hmac_sha256", a)
"base64_encode" => call_plain("tw_base64_encode", a)
"base64_decode" => call_plain("tw_base64_decode", a)
"hex_encode" => call_plain("tw_hex_encode", a)
"hex_decode" => call_plain("tw_hex_decode", a)
"equal_constant_time" => call_plain("tw_equal_constant_time", a)
"password_hash" => call_with_location("tw_password_hash", a, loc)
"password_verify" => call_plain("tw_password_verify", a)
"db_open" => call_with_location("tw_db_open", a, loc)
"db_query" => call_with_location("tw_db_query", a, loc)
"db_execute" => call_with_location("tw_db_execute", a, loc)
"net_request" => call_with_location("tw_net_request", a, loc)
"assert" => call_with_location("t_assert", a, loc)
"read_file" => call_with_location("t_read_file", a, loc)
"write_file" => call_with_location("t_write_file", a, loc)
"args" => call_with_location("t_args", a, loc)
"exit" => call_with_location("t_exit", a, loc)
"exit_with" => call_with_location("t_exit_with", a, loc)
"to_lower" => "t_to_lower(&" + a[0] + ")"
"to_upper" => "t_to_upper(&" + a[0] + ")"
"fail" => call_with_location("t_user_fail", a, loc)
"file_exists" => call_plain("t_file_exists", a)
"environment_variable" => call_plain("t_environment_variable", a)
"run_process" => call_plain("t_run_process", a)
"rgb" => call_with_location("t_rgb", a, loc)
"open_window" => call_with_location("t_open_window", a, loc)
"fill_rectangle" => call_with_location("t_fill_rectangle", a, loc)
"draw_line" => call_with_location("t_draw_line", a, loc)
"draw_circle" => call_with_location("t_draw_circle", a, loc)
"fill_circle" => call_with_location("t_fill_circle", a, loc)
"draw_text" => call_with_location("t_draw_text", a, loc)
"text_width" => call_with_location("t_text_width", a, loc)
"present" => call_with_location("t_present", a, loc)
"next_event" => call_with_location("t_next_event", a, loc)
_ => call_plain("f_\(name)", a)
}
code(generated.gen, text)
}
