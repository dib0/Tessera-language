<?xml version="1.0" encoding="utf-8"?>
<!--
  Recommended IIS hosting: HttpPlatformHandler (install "HttpPlatformHandler
  v1.2" from Microsoft). IIS starts app.exe (the Tessera program built for
  Windows) with no arguments and sets HTTP_PLATFORM_PORT; the Tessera runtime
  then serves HTTP/1.1 on 127.0.0.1:%HTTP_PLATFORM_PORT% and IIS proxies all
  requests of this site/application to it. IIS restarts the process when it
  exits and on app pool recycle.

  Put this file and app.exe in the site's physical folder. Create the "logs"
  folder and give the app pool identity write access to it if you enable
  stdout logging.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\inetpub\tessera\app.exe"
                  arguments=""
                  startupTimeLimit="20"
                  startupRetryCount="3"
                  rapidFailsPerMinute="10"
                  requestTimeout="00:02:00"
                  processesPerApplication="1"
                  forwardWindowsAuthToken="false"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\tessera-stdout">
      <!--
        processPath: absolute path of the Tessera executable. (On Azure App
        Service use "%HOME%\site\wwwroot\app.exe".) It is started without
        arguments; the runtime sees HTTP_PLATFORM_PORT and serves HTTP.
        processesPerApplication: >1 starts several independent processes and
        load-balances between them (each gets its own HTTP_PLATFORM_PORT).
      -->
      <environmentVariables>
        <environmentVariable name="TESSERA_TIME_LIMIT_MS" value="5000" />
        <environmentVariable name="TESSERA_MEMORY_LIMIT_MB" value="256" />
        <environmentVariable name="TESSERA_MAX_BODY_MB" value="10" />
        <environmentVariable name="TESSERA_FS_ROOT" value="C:\inetpub\tessera\data" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <!-- bytes; keep in line with TESSERA_MAX_BODY_MB -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
