<?xml version="1.0" encoding="utf-8"?>
<!--
  Alternative: run the Tessera program as a CGI executable with the IIS CGI
  module (Windows feature "CGI" under Application Development). One process is
  started per request, so this is simple but slow; prefer web.config
  (HttpPlatformHandler).

  Rename this file to web.config in the site folder that contains app.exe.

  The CGI executable must also be allowed at server level, in
  applicationHost.config (this section cannot be set in web.config):

    <system.webServer>
      <security>
        <isapiCgiRestriction>
          <add path="C:\inetpub\tessera\app.exe" allowed="true" description="Tessera app" />
        </isapiCgiRestriction>
      </security>
    </system.webServer>

  or with appcmd (elevated prompt):
    %windir%\system32\inetsrv\appcmd set config /section:isapiCgiRestriction /+"[path='C:\inetpub\tessera\app.exe',allowed='true',description='Tessera app']"

  The handlers section must be unlocked for web.config to override it:
    %windir%\system32\inetsrv\appcmd unlock config /section:handlers

  Limits (TESSERA_*) can be set as environment variables of the application
  pool (IIS 10: applicationPools/add/environmentVariables), since CGI passes
  the worker process environment on to the program.
-->
<configuration>
  <system.webServer>
    <handlers accessPolicy="Read, Script, Execute">
      <!-- every request under this folder goes to app.exe; no "%s" arguments:
           the program is started without arguments and detects CGI from the
           CGI environment variables (GATEWAY_INTERFACE, REQUEST_METHOD, ...) -->
      <add name="TesseraCgi" path="*" verb="*" modules="CgiModule"
           scriptProcessor="C:\inetpub\tessera\app.exe"
           resourceType="Unspecified" requireAccess="Execute" />
    </handlers>
    <cgi createProcessAsUser="false" timeout="00:01:00" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
