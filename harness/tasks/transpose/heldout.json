{
  "tests": [
    {
      "args": [
        "a,b,c"
      ],
      "stdout": "a\nb\nc\n",
      "exit": 0
    },
    {
      "args": [
        "1,2",
        "3,4",
        "5,6"
      ],
      "stdout": "1,3,5\n2,4,6\n",
      "exit": 0
    },
    {
      "args": [
        "a,,b",
        ",x,"
      ],
      "stdout": "a,\n,x\nb,\n",
      "exit": 0
    },
    {
      "args": [
        "1,2",
        "3,4,5"
      ],
      "stdout": "",
      "stderr": "error: ragged matrix\n",
      "exit": 1
    },
    {
      "args": [
        "1,2,3",
        "4,5,6",
        "7,8"
      ],
      "stdout": "",
      "stderr": "error: ragged matrix\n",
      "exit": 1
    }
  ]
}
