note "Pricing stays pure: a quote depends only on its inputs, so finance can reproduce and audit every quote from the arguments alone. Amounts are whole cents."
pub enum Step {
Base(quantity: Int, unit: Int, amount: Int)
MemberDiscount(amount: Int)
BulkDiscount(amount: Int)
}

pub type Quote {
sku: Text
quantity: Int
customer: Text
total: Int
steps: List[Step]
}

fn unit_price(sku: Text) -> Option[Int] {
match sku {
"pen" => .Some(250)
"pad" => .Some(480)
"ink" => .Some(1299)
"clip" => .Some(5)
_ => .None
}
}

pub fn known_product(sku: Text) -> Bool = unit_price(sku) != .None

note "Percentages of an amount in cents are truncated toward zero."
fn percent_of(amount: Int, percent: Int) -> Int = amount * percent / 100

note "Members get 10% off the base price; from 10 units on, a further 5% comes off the amount after the member discount. The steps record every rule that applied, in order."
pub fn quote(sku: Text, quantity: Int, customer: Text) -> Option[Quote] {
let unit = unit_price(sku) else return .None
var total = unit * quantity
var steps: List[Step] = [.Base(quantity, unit, total)]
if customer == "member" {
let member = percent_of(total, 10)
set total -= member
set steps += [.MemberDiscount(member)]
}
if quantity >= 10 {
let bulk = percent_of(total, 5)
set total -= bulk
set steps += [.BulkDiscount(bulk)]
}
.Some(Quote { sku: sku, quantity: quantity, customer: customer, total: total, steps: steps })
}
