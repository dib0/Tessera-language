// std/math: small integer helpers. Effects: none.

pub fn min(a: Int, b: Int) -> Int = if a < b { a } else { b }

pub fn max(a: Int, b: Int) -> Int = if a > b { a } else { b }

note "`value` limited to `low` to `high`. Stops with R010 if `low > high`."
pub fn clamp(value: Int, low: Int, high: Int) -> Int {
if low > high {
fail("clamp: low \(low) is greater than high \(high)")
}
min(max(value, low), high)
}

note "The absolute value. The smallest `Int` has no positive counterpart: R002."
pub fn abs(value: Int) -> Int = if value < 0 { -value } else { value }

note "The integer square root: the largest `r` with `r * r <= value`, exact for every `Int` (digit by digit, no overflow). Stops with R010 for a negative value."
pub fn isqrt(value: Int) -> Int {
if value < 0 {
fail("isqrt of the negative number \(value)")
}
var rest = value
var root = 0
var bit = shift_left(1, 62)
while bit > rest {
set bit = shift_right(bit, 2)
}
while bit != 0 {
if rest >= root + bit {
set rest -= root + bit
set root = shift_right(root, 1) + bit
} else {
set root = shift_right(root, 1)
}
set bit = shift_right(bit, 2)
}
root
}
