note "Whether a THINGS entry appears at a skill level (0 to 4) in single player: flag 1 for the two easiest, 2 for the middle and 4 for the two hardest; not flag 16 (multiplayer only), and not a player start."
pub fn spawns_at(kind: Int, flags: Int, skill: Int) -> Bool {
let wanted = if skill <= 1 { 1 } else if skill == 2 { 2 } else { 4 }
bit_and(flags, wanted) != 0 and bit_and(flags, 16) == 0 and kind != 1 and kind != 2 and kind != 3 and kind != 4 and kind != 11
}
