note "Whether a THINGS entry appears at a skill level (0 to 4) in single player: flag 1 for the two easiest, 2 for the middle and 4 for the two hardest; not flag 16 (multiplayer only), and not a player start."
note "The weapon slot names, in slot order."
pub fn weapon_name(slot: Int) -> Text = ["fist", "pistol", "shotgun", "chaingun", "rocket launcher", "plasma gun", "BFG 9000", "chainsaw"][slot]

note "Weapon sprites (on screen) and their flashes, by slot."
pub fn weapon_sprite(slot: Int) -> Text = ["PUNG", "PISG", "SHTG", "CHGG", "MISG", "PLSG", "BFGG", "SAWG"][slot]

pub fn weapon_flash(slot: Int) -> Text = ["", "PISF", "SHTF", "CHGF", "MISF", "PLSF", "BFGF", ""][slot]

note "The sprite frames a weapon shows while firing, over its whole cooldown."
pub fn weapon_frames(slot: Int) -> Text = ["BCDCB", "ABCB", "ABCDCB", "AB", "AB", "AB", "ABC", "AB"][slot]

note "Ammunition kind used by a weapon slot, or -1 (fist, chainsaw)."
pub fn ammo_kind(slot: Int) -> Int = [-1, 0, 1, 0, 2, 3, 3, -1][slot]

pub fn ammo_name(kind: Int) -> Text = ["bullets", "shells", "rockets", "cells"][kind]

pub fn spawns_at(kind: Int, flags: Int, skill: Int) -> Bool {
let wanted = if skill <= 1 { 1 } else if skill == 2 { 2 } else { 4 }
bit_and(flags, wanted) != 0 and bit_and(flags, 16) == 0 and kind != 1 and kind != 2 and kind != 3 and kind != 4 and kind != 11
}
