// What each THINGS type is: its sprite, size, and how the game treats it. Values from the public
// thing-type tables of the WAD format (sprite names, radius, height, health, speed); behaviour such
// as damage is this engine's own. Effects: none.

pub enum Role {
Decoration
Obstacle
Item(effect: Pickup)
Monster(species: Species)
Hidden
}

pub enum Pickup {
Health(amount: Int, limit: Int)
Armor(amount: Int, limit: Int)
SetArmor(amount: Int)
Ammo(amount: Int)
Key(color: Text)
Weapon(name: Text, ammo: Int)
Other(name: Text)
}

note "How a monster looks and fights: animation frames per state, and its attack."
pub type Species {
name: Text
walk: Text
attack: Text
pain: Text
death: Text
melee: Bool
damage_min: Int
damage_max: Int
}

pub type Info {
sprite: Text
frames: Text
radius: Int
height: Int
health: Int
speed: Int
role: Role
}

fn decoration(sprite: Text, frames: Text) -> Info = Info { sprite: sprite, frames: frames, radius: 16, height: 16, health: 0, speed: 0, role: .Decoration }

fn obstacle(sprite: Text, frames: Text, radius: Int, height: Int) -> Info = Info { sprite: sprite, frames: frames, radius: radius, height: height, health: 0, speed: 0, role: .Obstacle }

fn item(sprite: Text, frames: Text, effect: Pickup) -> Info = Info { sprite: sprite, frames: frames, radius: 20, height: 16, health: 0, speed: 0, role: .Item(effect) }

fn monster(sprite: Text, radius: Int, height: Int, health: Int, speed: Int, species: Species) -> Info = Info { sprite: sprite, frames: species.walk, radius: radius, height: height, health: health, speed: speed, role: .Monster(species) }

fn species(name: Text, attack: Text, pain: Text, death: Text, melee: Bool, low: Int, high: Int) -> Species = Species { name: name, walk: "ABCD", attack: attack, pain: pain, death: death, melee: melee, damage_min: low, damage_max: high }

pub fn hidden() -> Info = Info { sprite: "", frames: "A", radius: 0, height: 0, health: 0, speed: 0, role: .Hidden }

