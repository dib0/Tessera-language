// The game world, advanced one tic (1/35 second) at a time: the player (movement with momentum,
// using lines, picking up items), then sectors, lights, projectiles, monsters and effects. The
// data lives in state.tes; specials in sectors.tes, weapons and monsters in combat.tes.
// Effects: none.

import std/fixed
import std/math
import std/plane
import combat
import geometry
import level
import movement
import render
import sectors
import state
import things

// ---------- creating the world ----------

pub fn create(l: level.Level) -> state.World = create_at_skill(l, 2)

note "The world of a level at a skill level from 0 to 4 (2 is the middle one), with a fresh player."
pub fn create_at_skill(l: level.Level, skill: Int) -> state.World = enter(l, skill, state.start_stats())

note "The world of a level for a player who keeps health, armor, weapons and ammunition from the previous level (keys and power-ups do not carry over)."
pub fn enter(l: level.Level, skill: Int, carried: state.Stats) -> state.World {
var mobjs: List[state.Mobj] = []
for t in l.things {
let info = things.info(t.kind)
if things.spawns_at(t.kind, t.flags, skill) and info.sprite != "" {
let x = fixed.from_int(t.x)
let y = fixed.from_int(t.y)
set mobjs += [state.Mobj { kind: t.kind, info: info, x: x, y: y, angle: geometry.degrees_to_fine(t.angle), sector: geometry.sector_at(l, x, y), health: info.health, present: true, state: .Idle }]
}
}
let stats = carried with { keys: [], kills: 0, items: 0, secrets: 0, berserk: false, invulnerable: 0, radiation_suit: 0 }
var w = state.World { level: l, skill: skill, neighbors: sectors.find_neighbors(l), centers: sectors.find_centers(l), player: movement.start(l), stats: stats, mobjs: mobjs, movers: [], lights: [], missiles: [], effects: [], switched: repeat([0], length(l.sidedefs)), sounds: [], tic: 0, seed: 1, message: "", message_time: 0, cooldown: 0, firing: -1, fire_held: false, use_held: false, exited: 0, momentum_x: 0, momentum_y: 0, damage_flash: 0, bonus_flash: 0 }
set w.lights = sectors.find_lights(w)
w
}

note "The world without monsters, like the original game's -nomonsters option."
pub fn without_monsters(world: state.World) -> state.World {
var w = world
for i in range(0, length(w.mobjs)) {
if state.is_monster(w.mobjs[i]) {
set w.mobjs[i].present = false
}
}
w
}

pub fn no_input() -> state.Input = state.no_input()

// ---------- one tic ----------

pub fn tic(world: state.World, input: state.Input, trig: geometry.Trig) -> state.World {
var w = world
set w.sounds = []
set w.tic += 1
if w.stats.health > 0 and w.exited == 0 {
if input.weapon >= 0 {
set w = combat.select_weapon(w, input.weapon)
}
set w = move_player(w, input, trig)
if input.use and not w.use_held {
set w = use_line(w, trig)
}
if input.fire and w.cooldown == 0 {
set w = combat.fire(w, trig)
}
set w = pick_up(w)
set w = sectors.floor_effects(w)
}
set w.use_held = input.use
set w.fire_held = input.fire
if w.cooldown > 0 {
set w.cooldown -= 1
}
if w.firing >= 0 {
set w.firing = if w.firing + 1 >= combat.weapon_cooldown(w.stats.weapon) { -1 } else { w.firing + 1 }
}
set w.stats.invulnerable = math.max(w.stats.invulnerable - 1, 0)
set w.stats.radiation_suit = math.max(w.stats.radiation_suit - 1, 0)
set w.damage_flash = math.max(w.damage_flash - 1, 0)
set w.bonus_flash = math.max(w.bonus_flash - 1, 0)
set w = sectors.run_switches(w)
set w = sectors.run_movers(w)
set w = sectors.run_lights(w)
set w = combat.run_missiles(w)
set w = combat.run_monsters(w, trig)
set w = run_effects(w)
if w.message_time > 0 {
set w.message_time -= 1
}
w
}

fn run_effects(world: state.World) -> state.World {
var w = world
var kept: List[state.Effect] = []
for e in w.effects {
let next = e with { time: e.time + 1 }
if next.time / next.speed < length(next.frames) {
set kept += [next]
}
}
set w.effects = kept
w
}

note "Turns the player, moves it directly by `forward`/`sideways` units if given, then by its momentum: input pushes (thrust `move * 2048` per tic along the view), the speed is at most 30 units per tic in each direction, and friction keeps 0xE800/0x10000 of it every tic; below 0x1000 without input it stops. These are the original game's published movement constants."
fn move_player(world: state.World, input: state.Input, trig: geometry.Trig) -> state.World {
var w = world
set w.player = movement.turn(w.player, input.turn)
if input.forward != 0 or input.sideways != 0 {
set w = displace(w, input.forward, input.sideways, trig)
}
let c = trig.cosine[w.player.angle]
let s = trig.sine[w.player.angle]
let push = input.forward_move * 2048
let side = input.side_move * 2048
let limit = fixed.from_int(30)
var mx = math.clamp(w.momentum_x + fixed.mul(push, c) + fixed.mul(side, s), -limit, limit)
var my = math.clamp(w.momentum_y + fixed.mul(push, s) - fixed.mul(side, c), -limit, limit)
if mx != 0 or my != 0 {
let before_x = w.player.x
let before_y = w.player.y
set w = slide(w, mx, my)
// A wall that stopped the move also stops that part of the momentum.
if w.player.x == before_x {
set mx = 0
}
if w.player.y == before_y {
set my = 0
}
}
set mx = shift_right(mx * 59392, 16)
set my = shift_right(my * 59392, 16)
if input.forward_move == 0 and input.side_move == 0 and math.abs(mx) < 4096 and math.abs(my) < 4096 {
set mx = 0
set my = 0
}
set w.momentum_x = mx
set w.momentum_y = my
w
}

note "Moves the player by (dx, dy) fixed in steps of at most 8 units."
fn slide(world: state.World, dx: Int, dy: Int) -> state.World {
var w = world
let steps = math.max(1, (math.max(math.abs(dx), math.abs(dy)) + fixed.from_int(8) - 1) / fixed.from_int(8))
for i in range(0, steps) {
let step_x = dx * (i + 1) / steps - dx * i / steps
let step_y = dy * (i + 1) / steps - dy * i / steps
set w = player_step(w, step_x, step_y)
}
w
}

fn displace(world: state.World, forward_units: Int, sideways_units: Int, trig: geometry.Trig) -> state.World {
var w = world
let p = w.player
let c = trig.cosine[p.angle]
let s = trig.sine[p.angle]
let forward = fixed.from_int(forward_units)
let sideways = fixed.from_int(sideways_units)
let dx = fixed.mul(forward, c) + fixed.mul(sideways, s)
let dy = fixed.mul(forward, s) - fixed.mul(sideways, c)
set w = slide(w, dx, dy)
w
}

fn player_step(world: state.World, dx: Int, dy: Int) -> state.World {
var w = world
let p = w.player
let floor = state.sector_floor(w, p.sector)
for attempt in [[dx, dy], [dx, 0], [0, dy]] {
let x = p.x + attempt[0]
let y = p.y + attempt[1]
if (attempt[0] != 0 or attempt[1] != 0) and movement.fits(w.level, x, y, floor) and not state.hits_thing(w, x, y, movement.radius(), -1) {
set w.player = p with { x: x, y: y, sector: geometry.sector_at(w.level, x, y) }
set w = walk_over(w, p.x, p.y, x, y)
return w
}
}
w
}

note "Triggers the walk-over specials of lines the player's centre crossed going from (x0, y0) to (x1, y1). Teleporters work only when crossed from their front (right) side."
fn walk_over(world: state.World, x0: Int, y0: Int, x1: Int, y1: Int) -> state.World {
var w = world
for index in range(0, length(w.level.linedefs)) {
let line = w.level.linedefs[index]
if line.special != 0 and sectors.is_walk_special(line.special) {
let a = w.level.vertexes[line.start]
let b = w.level.vertexes[line.end]
let ax = fixed.from_int(a.x)
let ay = fixed.from_int(a.y)
let bx = fixed.from_int(b.x)
let by = fixed.from_int(b.y)
if plane.crosses(x0, y0, x1, y1, ax, ay, bx, by) {
if sectors.is_teleport(line.special) {
if plane.orient(ax, ay, bx, by, x0, y0) < 0 {
return sectors.teleport(w, index)
}
} else {
set w = sectors.trigger(w, index, false)
}
}
}
}
w
}

note "The player pressed `use`: the nearest line within 64 units straight ahead is used, if it has a special; otherwise the player grunts. Two-sided lines without a special are looked through."
fn use_line(w: state.World, trig: geometry.Trig) -> state.World {
let p = w.player
let dx = trig.cosine[p.angle]
let dy = trig.sine[p.angle]
var best = -1
var best_distance = fixed.from_int(65)
for index in range(0, length(w.level.linedefs)) {
let line = w.level.linedefs[index]
if line.back < 0 or line.special != 0 {
let a = w.level.vertexes[line.start]
let b = w.level.vertexes[line.end]
let hit = plane.intersect(p.x, p.y, dx, dy, a.x, a.y, b.x, b.y)
if hit.hit and hit.distance < best_distance {
set best = index
set best_distance = hit.distance
}
}
}
if best < 0 {
return w
}
let special = w.level.linedefs[best].special
if special != 0 and not sectors.is_walk_special(special) {
return sectors.trigger(w, best, true)
}
state.sound_here(w, "DSNOWAY")
}

// ---------- items ----------

fn pickup_name(effect: things.Pickup) -> Text {
match effect {
.Health(amount, _) => if amount == 1 { "a health bonus" } else if amount == 100 { "a soul sphere" } else if amount == 200 { "a mega sphere" } else if amount == 10 { "a stimpack" } else { "a medikit" }
.Armor(_, _) => "an armor bonus"
.SetArmor(amount) => if amount == 100 { "the armor" } else { "the mega armor" }
.Ammo(kind, amount) => "\(amount) \(things.ammo_name(kind))"
.Backpack => "a backpack full of ammo"
.Key(color) => "a \(color) key"
.Weapon(slot, _, _) => "the \(things.weapon_name(slot))"
.Power(name, _) => name
}
}

fn pick_up(world: state.World) -> state.World {
var w = world
let p = w.player
for i in range(0, length(w.mobjs)) {
let m = w.mobjs[i]
if m.present {
match m.info.role {
.Item(effect) => {
let reach = fixed.from_int(movement.radius() + m.info.radius)
if math.abs(m.x - p.x) < reach and math.abs(m.y - p.y) < reach {
let before = w.stats
set w.stats = apply_pickup(w.stats, effect)
if w.stats != before or is_power(effect) {
set w.mobjs[i].present = false
set w.stats.items += 1
set w.bonus_flash = 6
set w = state.say(w, "Picked up \(pickup_name(effect))")
set w = state.sound_here(w, match effect {
.Weapon(_, _, _) => "DSWPNUP"
.Power(_, _) => "DSGETPOW"
_ => "DSITEMUP"
})
match effect {
.Weapon(slot, _, _) => if not before.weapons[slot] {
set w.stats.weapon = slot
}
_ => {}
}
}
}
}
_ => {}
}
}
}
w
}

fn is_power(effect: things.Pickup) -> Bool {
match effect {
.Power(_, _) => true
_ => false
}
}

fn add_ammo(stats: state.Stats, kind: Int, amount: Int) -> state.Stats {
var s = stats
set s.ammo[kind] = math.min(s.ammo[kind] + amount, s.max_ammo[kind])
s
}

note "The stats after taking an item; unchanged when the item is of no use (full health, full armor, full ammunition)."
fn apply_pickup(stats: state.Stats, effect: things.Pickup) -> state.Stats {
match effect {
.Health(amount, limit) => if stats.health >= limit { stats } else { stats with { health: math.min(stats.health + amount, limit) } }
.Armor(amount, limit) => if stats.armor >= limit { stats } else { stats with { armor: math.min(stats.armor + amount, limit), armor_class: math.max(stats.armor_class, 1) } }
.SetArmor(amount) => if stats.armor >= amount { stats } else { stats with { armor: amount, armor_class: if amount >= 200 { 2 } else { 1 } } }
.Ammo(kind, amount) => if stats.ammo[kind] >= stats.max_ammo[kind] { stats } else { add_ammo(stats, kind, amount) }
.Backpack => {
var s = stats with { max_ammo: [400, 100, 100, 600] }
for kind in range(0, 4) {
set s = add_ammo(s, kind, [10, 4, 1, 20][kind])
}
s
}
.Key(color) => if contains(stats.keys, color) { stats } else { stats with { keys: stats.keys + [color] } }
.Weapon(slot, kind, amount) => {
var s = stats
set s.weapons[slot] = true
if amount > 0 {
set s = add_ammo(s, kind, amount)
}
s
}
.Power(name, tics) => match name {
"berserk" => stats with { berserk: true, health: math.max(stats.health, 100) }
"invulnerability" => stats with { invulnerable: tics }
"radiation suit" => stats with { radiation_suit: tics }
_ => stats
}
}
}

// ---------- drawing ----------

note "The sprite frame letter of a thing for the current tic."
fn frame_of(m: state.Mobj, tic: Int) -> Text {
let frames = match m.info.role {
.Monster(s) => match m.state {
.Idle => slice_text(s.walk, 0, 2)
.Chase(_) => s.walk
.Attack(time) => slice_text(s.attack, math.min(time * length(s.attack) / 17, length(s.attack) - 1), math.min(time * length(s.attack) / 17, length(s.attack) - 1) + 1)
.Pain(_) => s.pain
.Dead(time) => slice_text(s.death, math.min(time / 6, length(s.death) - 1), math.min(time / 6, length(s.death) - 1) + 1)
}
_ => m.info.frames
}
let speed = match m.state {
.Chase(_) => 4
_ => 8
}
let count = length(frames)
slice_text(frames, (tic / speed) % count, (tic / speed) % count + 1)
}

note "Everything in the world to draw as sprites: things, projectiles (seen from the direction they fly) and effects."
pub fn sprites(w: state.World) -> List[render.SpriteDraw] {
var out: List[render.SpriteDraw] = []
for m in w.mobjs {
if m.present and m.info.sprite != "" {
let sector = w.level.sectors[m.sector]
set out += [render.SpriteDraw { x: m.x, y: m.y, z: fixed.from_int(sector.floor), sprite: m.info.sprite, frame: frame_of(m, w.tic), angle: m.angle, light: sector.light }]
}
}
for m in w.missiles {
let frame = if (w.tic / 4) % 2 == 0 { "A" } else { "B" }
let angle = if math.abs(m.dx) >= math.abs(m.dy) { if m.dx > 0 { 0 } else { 4096 } } else if m.dy > 0 { 2048 } else { 6144 }
set out += [render.SpriteDraw { x: m.x, y: m.y, z: m.z - fixed.from_int(8), sprite: m.sprite, frame: frame, angle: angle, light: 255 }]
}
for e in w.effects {
let index = math.min(e.time / e.speed, length(e.frames) - 1)
set out += [render.SpriteDraw { x: e.x, y: e.y, z: e.z, sprite: e.sprite, frame: slice_text(e.frames, index, index + 1), angle: 0, light: 255 }]
}
out
}

note "The weapon on screen: its sprite and frame, and the muzzle flash (empty when none), e.g. [\"PISGA0\", \"PISFA0\"]."
pub fn weapon_view(w: state.World) -> List[Text] {
let slot = w.stats.weapon
let sprite = things.weapon_sprite(slot)
let frames = things.weapon_frames(slot)
var frame = if slot == 7 { if (w.tic / 4) % 2 == 0 { "C" } else { "D" } } else { "A" }
var flash = ""
if w.firing >= 0 {
let index = math.min(w.firing * length(frames) / combat.weapon_cooldown(slot), length(frames) - 1)
set frame = slice_text(frames, index, index + 1)
if w.firing < 4 and things.weapon_flash(slot) != "" {
set flash = "\(things.weapon_flash(slot))A0"
}
}
["\(sprite)\(frame)0", flash]
}

note "Which of PLAYPAL's 14 palettes to show: red after damage (1 to 8), yellow after a pickup (9 to 12), green with the radiation suit (13), else 0."
pub fn palette_index(w: state.World) -> Int {
if w.damage_flash > 0 {
return math.min((w.damage_flash + 7) / 8, 8)
}
if w.bonus_flash > 0 {
return 9 + math.min((w.bonus_flash + 7) / 8, 3) - 1
}
if w.stats.radiation_suit > 0 and (w.stats.radiation_suit > 128 or w.stats.radiation_suit % 16 < 8) {
return 13
}
0
}

pub fn camera(w: state.World) -> geometry.Camera = movement.camera(w.level, w.player)

note "The map after this one: the next on a normal exit, the secret map (9) on a secret exit, and back from the secret map to where the episode continues. Empty after the last map of an episode."
pub fn next_map(name: Text, secret: Bool) -> Text {
let codes = code_points(name)
if length(codes) != 4 {
return ""
}
let episode = codes[1] - 48
let map = codes[3] - 48
if secret {
return "E\(episode)M9"
}
if map == 9 {
return "E\(episode)M\([4, 6, 7, 3][math.clamp(episode - 1, 0, 3)])"
}
if map >= 8 {
return ""
}
"E\(episode)M\(map + 1)"
}
