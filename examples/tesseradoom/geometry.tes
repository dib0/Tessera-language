// Shared geometry in 16.16 fixed point (decision D2): the camera, per-column ray directions,
// ray/segment intersection and the BSP point location. Map coordinates are whole units; a fixed
// value is units * 65536. Angles are fine angles: 8192 per full turn, counter-clockwise from east.
// Effects: none.

import std/fixed
import level

pub fn fine_angles() -> Int = 8192

pub fn screen_width() -> Int = 320

pub fn screen_height() -> Int = 200

note "Focal length in pixels: 160 gives a 90 degree horizontal field of view at 320 columns."
pub fn focal() -> Int = 160

note "The eye is 41 units above the floor, as in the original game."
pub fn eye_height() -> Int = 41

pub type Camera {
x: Int
y: Int
z: Int
angle: Int
}

note "Sine and cosine tables for the fine angles, built once and passed around."
pub type Trig {
sine: List[Int]
cosine: List[Int]
}

pub fn make_trig() -> Trig = Trig { sine: fixed.sine_table(fine_angles()), cosine: fixed.cosine_table(fine_angles()) }

pub fn wrap_angle(angle: Int) -> Int = ((angle % fine_angles()) + fine_angles()) % fine_angles()

note "Converts a THINGS angle in degrees to a fine angle."
pub fn degrees_to_fine(degrees: Int) -> Int = wrap_angle(degrees * fine_angles() / 360)

note "Ray directions for every screen column, (forward + right * k) with k from -1 to 1 across the screen: the forward part is exactly 1.0, so the intersection parameter along a ray is the perpendicular distance and walls show no fisheye distortion."
pub type Rays {
dx: List[Int]
dy: List[Int]
}

pub fn column_rays(trig: Trig, angle: Int) -> Rays {
let c = trig.cosine[angle]
let s = trig.sine[angle]
var dx: List[Int] = []
var dy: List[Int] = []
for x in range(0, screen_width()) {
// k = (x + 0.5 - width / 2) / focal, as a fixed value.
let k = (2 * x + 1 - screen_width()) * fixed.one() / (2 * focal())
// right = (sin, -cos)
set dx += [c + fixed.mul(s, k)]
set dy += [s - fixed.mul(c, k)]
}
Rays { dx: dx, dy: dy }
}

note "Where a ray from (px, py) along (dx, dy) crosses the segment from (ax, ay) to (bx, by): `distance` is the ray parameter (fixed; with the column rays this is the perpendicular distance), `along` the position on the segment from 0 to 65536 (fixed 0.0 to 1.0). `hit` is false when they do not cross in front of the camera."
pub type Hit {
hit: Bool
distance: Int
along: Int
}

fn no_hit() -> Hit = Hit { hit: false, distance: 0, along: 0 }

note "Exact quotient of a by b as a fixed value, without overflowing a * 65536: magnitudes up to 2^50 for `a` and 2^47 for `b` are safe."
pub fn ratio(a: Int, b: Int) -> Int {
let whole = a / b
let rest = a - whole * b
whole * fixed.one() + rest * fixed.one() / b
}

note "Ray (px, py fixed) + t * (dx, dy fixed) against the segment (ax, ay)-(bx, by) in whole map units. Products stay below 2^51: positions differ by at most 2^32 (fixed), segment lengths are below 2^16 and directions below 2^18."
pub fn intersect(px: Int, py: Int, dx: Int, dy: Int, ax: Int, ay: Int, bx: Int, by: Int) -> Hit {
let lx = bx - ax
let ly = by - ay
let den = dx * ly - dy * lx
if den == 0 {
return no_hit()
}
let ex = fixed.from_int(ax) - px
let ey = fixed.from_int(ay) - py
let t_num = ex * ly - ey * lx
// u = cross(E, D) / den, already in fixed units because E and D are both fixed.
let u_num = fixed.mul(ex, dy) - fixed.mul(ey, dx)
if den > 0 {
if t_num <= 0 or u_num < 0 or u_num > den {
return no_hit()
}
} else if t_num >= 0 or u_num > 0 or u_num < den {
return no_hit()
}
// Farther than 65536 units only happens for rays almost parallel to the segment; ignoring them keeps `ratio` from overflowing.
if t_num / den > 65536 {
return no_hit()
}
Hit { hit: true, distance: ratio(t_num, den), along: ratio(u_num, den) }
}

note "Which side of a BSP partition line a fixed point is on: 0 for the right (front) side, 1 for the left."
pub fn node_side(node: level.Node, x: Int, y: Int) -> Int {
let dx = x - fixed.from_int(node.x)
let dy = y - fixed.from_int(node.y)
// Cross product of the partition direction and the point offset; the right side is negative.
let cross = node.dx * dy - node.dy * dx
if cross > 0 { 1 } else { 0 }
}

note "The subsector containing a fixed point, found by walking the BSP tree from the root (the last node)."
pub fn subsector_at(l: level.Level, x: Int, y: Int) -> Int {
if length(l.nodes) == 0 {
return 0
}
var child = length(l.nodes) - 1
while true {
let node = l.nodes[child]
let next = if node_side(node, x, y) == 0 { node.right } else { node.left }
if bit_and(next, 32768) != 0 {
return bit_and(next, 32767)
}
set child = next
}
0
}

note "The sector containing a fixed point."
pub fn sector_at(l: level.Level, x: Int, y: Int) -> Int {
let sub = l.subsectors[subsector_at(l, x, y)]
let seg = l.segs[sub.first]
let line = l.linedefs[seg.linedef]
let side = if seg.side == 0 { line.front } else { line.back }
l.sidedefs[side].sector
}

note "The camera at the player 1 start, eyes 41 units above the floor."
pub fn start_camera(l: level.Level) -> Camera {
let start = level.find_thing(l, 1) else return Camera { x: 0, y: 0, z: fixed.from_int(eye_height()), angle: 0 }
let x = fixed.from_int(start.x)
let y = fixed.from_int(start.y)
let floor = l.sectors[sector_at(l, x, y)].floor
Camera { x: x, y: y, z: fixed.from_int(floor + eye_height()), angle: degrees_to_fine(start.angle) }
}
