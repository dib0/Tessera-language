// Tic-tac-toe in a window: you play X, the computer plays O.
// Click a square to play. R or a click after the game starts a new game; Escape or Q quits.
//
// Build with the stage 1 compiler:
//   tessera1 build examples/tictactoe/tictactoe.tes -o tictactoe

enum Mark {
    Empty
    Cross
    Circle
}

enum Outcome {
    Playing
    Won(winner: Mark, line: Int)
    Draw
}

type Game {
    board: List[Mark]
    outcome: Outcome
}

// ---------- layout and colors ----------

fn window_width() -> Int = 360

fn window_height() -> Int = 470

fn board_left() -> Int = 30

fn board_top() -> Int = 80

fn cell_size() -> Int = 100

fn background() -> Int = rgb(250, 247, 238)

fn ink() -> Int = rgb(52, 58, 76)

fn cross_color() -> Int = rgb(214, 69, 65)

fn circle_color() -> Int = rgb(41, 109, 214)

fn highlight() -> Int = rgb(46, 168, 98)

// ---------- rules (pure) ----------

note "The eight ways to get three in a row, as board indexes (row by row, 0 to 8)."
fn lines() -> List[List[Int]] {
    [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]]
}

fn new_game() -> Game {
    let board = [Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty, Mark.Empty]
    Game { board: board, outcome: Outcome.Playing }
}

fn outcome_of(board: List[Mark]) -> Outcome {
    let all_lines = lines()
    for index in range(0, length(all_lines)) {
        let line = all_lines[index]
        let first = board[line[0]]
        if first != Mark.Empty and board[line[1]] == first and board[line[2]] == first {
            return Outcome.Won(first, index)
        }
    }
    for cell in board {
        if cell == Mark.Empty {
            return Outcome.Playing
        }
    }
    Outcome.Draw
}

fn opponent(mark: Mark) -> Mark = if mark == Mark.Cross { Mark.Circle } else { Mark.Cross }

note "Minimax score from the computer's (Circle's) point of view; quicker wins score higher."
fn score(board: List[Mark], to_move: Mark, depth: Int) -> Int {
    match outcome_of(board) {
        Outcome.Won(winner, _) => if winner == Mark.Circle { 10 - depth } else { depth - 10 }
        Outcome.Draw => 0
        Outcome.Playing => {
            var best = if to_move == Mark.Circle { -100 } else { 100 }
            for cell in range(0, 9) {
                if board[cell] == Mark.Empty {
                    let value = score(replace_at(board, cell, to_move), opponent(to_move), depth + 1)
                    let better = if to_move == Mark.Circle { value > best } else { value < best }
                    if better {
                        set best = value
                    }
                }
            }
            best
        }
    }
}

note "The computer never loses: it picks the square with the best minimax score (first one on ties)."
fn computer_move(board: List[Mark]) -> Int {
    var best_cell = -1
    var best_score = -100
    for cell in range(0, 9) {
        if board[cell] == Mark.Empty {
            let value = score(replace_at(board, cell, Mark.Circle), Mark.Cross, 1)
            if value > best_score {
                set best_score = value
                set best_cell = cell
            }
        }
    }
    best_cell
}

fn place(game: Game, cell: Int, mark: Mark) -> Game {
    let board = replace_at(game.board, cell, mark)
    Game { board: board, outcome: outcome_of(board) }
}

note "A human move is followed directly by the computer's answer, unless the game is over."
fn play(game: Game, cell: Int) -> Game {
    if game.outcome != Outcome.Playing or game.board[cell] != Mark.Empty {
        return game
    }
    let after_human = place(game, cell, Mark.Cross)
    if after_human.outcome != Outcome.Playing {
        return after_human
    }
    place(after_human, computer_move(after_human.board), Mark.Circle)
}

note "The square under a click, or -1 when the click is outside the board."
fn cell_at(x: Int, y: Int) -> Int {
    let column = (x - board_left()) / cell_size()
    let row = (y - board_top()) / cell_size()
    let inside = x >= board_left() and y >= board_top() and column < 3 and row < 3
    if inside { row * 3 + column } else { -1 }
}

fn status_text(outcome: Outcome) -> Text {
    match outcome {
        Outcome.Playing => "Your move: you are X"
        Outcome.Won(winner, _) => if winner == Mark.Cross { "You win!" } else { "The computer wins" }
        Outcome.Draw => "Draw"
    }
}

// ---------- drawing ----------

fn cell_center_x(cell: Int) -> Int = board_left() + (cell % 3) * cell_size() + cell_size() / 2

fn cell_center_y(cell: Int) -> Int = board_top() + (cell / 3) * cell_size() + cell_size() / 2

fn draw_centered_text(y: Int, text: Text, color: Int) -> Unit uses ui {
    draw_text((window_width() - text_width(text)) / 2, y, text, color)
}

fn draw_mark(cell: Int, mark: Mark) -> Unit uses ui {
    let x = cell_center_x(cell)
    let y = cell_center_y(cell)
    let reach = 28
    match mark {
        Mark.Cross => {
            draw_line(x - reach, y - reach, x + reach, y + reach, 10, cross_color())
            draw_line(x - reach, y + reach, x + reach, y - reach, 10, cross_color())
        }
        Mark.Circle => draw_circle(x, y, reach + 2, 9, circle_color())
        Mark.Empty => {}
    }
}

fn draw_game(game: Game) -> Unit uses ui {
    fill_rectangle(0, 0, window_width(), window_height(), background())
    draw_centered_text(28, "Tessera Tic-Tac-Toe", ink())
    let board_size = 3 * cell_size()
    for i in range(1, 3) {
        let offset = i * cell_size()
        draw_line(board_left() + offset, board_top() + 8, board_left() + offset, board_top() + board_size - 8, 5, ink())
        draw_line(board_left() + 8, board_top() + offset, board_left() + board_size - 8, board_top() + offset, 5, ink())
    }
    for cell in range(0, 9) {
        draw_mark(cell, game.board[cell])
    }
    match game.outcome {
        Outcome.Won(_, line_index) => {
            let line = lines()[line_index]
            draw_line(cell_center_x(line[0]), cell_center_y(line[0]), cell_center_x(line[2]), cell_center_y(line[2]), 8, highlight())
        }
        _ => {}
    }
    let status_color = match game.outcome {
        Outcome.Won(winner, _) => if winner == Mark.Cross { highlight() } else { cross_color() }
        _ => ink()
    }
    draw_centered_text(board_top() + board_size + 22, status_text(game.outcome), status_color)
    let hint = if game.outcome == Outcome.Playing { "Click a square. R restarts, Q quits." } else { "Click or press R to play again." }
    draw_centered_text(board_top() + board_size + 52, hint, ink())
    present()
}

fn main() -> Unit uses ui {
    open_window("Tessera Tic-Tac-Toe", window_width(), window_height())
    var game = new_game()
    while true {
        draw_game(game)
        match next_event() {
            WindowEvent.Click(x, y, button) => {
                if button == 1 {
                    if game.outcome != Outcome.Playing {
                        set game = new_game()
                    } else {
                        let cell = cell_at(x, y)
                        if cell >= 0 {
                            set game = play(game, cell)
                        }
                    }
                }
            }
            WindowEvent.Key(name) => {
                if name == "r" or name == "R" {
                    set game = new_game()
                } else if name == "q" or name == "Q" or name == "Escape" {
                    return
                }
            }
            WindowEvent.Close => return
        }
    }
}
