// Prints a small receipt. Exercises lists, for, var/set, notes, and io.

note "Prices are in cents to avoid rounding; never introduce fractional money here."
fn line_total(price: Int, quantity: Int) -> Int = price * quantity

fn format_cents(cents: Int) -> Text {
    let euros = cents / 100
    let rest = cents % 100
    let padding = if rest < 10 { "0" } else { "" }
    to_text(euros) + "." + padding + to_text(rest)
}

fn main() -> Unit uses io {
    let items = ["coffee", "bagel", "juice"]
    let prices = [320, 275, 410]
    let quantities = [2, 1, 3]

    var total = 0
    for index in range(0, length(items)) {
        let subtotal = line_total(prices[index], quantities[index])
        set total = total + subtotal
        print(items[index] + ": " + format_cents(subtotal))
    }
    print("total: " + format_cents(total))
}
