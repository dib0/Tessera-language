// Lexer: source text to tokens, including significant newlines (spec section 4).

enum TokenKind {
    Int
    Text
    Ident
    Fn
    Let
    Var
    Set
    If
    Else
    For
    In
    While
    Note
    Uses
    And
    Or
    Not
    True
    False
    Type
    Enum
    Match
    Return
    Break
    Continue
    Import
    Pub
    With
    Underscore
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    Arrow
    FatArrow
    Assign
    EqEq
    NotEq
    Lt
    LtEq
    Gt
    GtEq
    Plus
    Minus
    Star
    Slash
    Percent
    Newline
    Eof
}

note "`text` holds the name, the decoded text literal, or the decimal digits of a number."
type Token {
    kind: TokenKind
    text: Text
    span: Span
}

type LexResult {
    tokens: List[Token]
    diagnostics: List[Diagnostic]
}

type Scan {
    token: Token
    end: Int
    diagnostics: List[Diagnostic]
    emit: Bool
}

fn symbol_text(kind: TokenKind) -> Text {
    match kind {
        TokenKind.Fn => "fn"
        TokenKind.Let => "let"
        TokenKind.Var => "var"
        TokenKind.Set => "set"
        TokenKind.If => "if"
        TokenKind.Else => "else"
        TokenKind.For => "for"
        TokenKind.In => "in"
        TokenKind.While => "while"
        TokenKind.Note => "note"
        TokenKind.Uses => "uses"
        TokenKind.And => "and"
        TokenKind.Or => "or"
        TokenKind.Not => "not"
        TokenKind.True => "true"
        TokenKind.False => "false"
        TokenKind.Type => "type"
        TokenKind.Enum => "enum"
        TokenKind.Match => "match"
        TokenKind.Return => "return"
        TokenKind.Break => "break"
        TokenKind.Continue => "continue"
        TokenKind.Import => "import"
        TokenKind.Pub => "pub"
        TokenKind.With => "with"
        TokenKind.Underscore => "_"
        TokenKind.LParen => "("
        TokenKind.RParen => ")"
        TokenKind.LBracket => "["
        TokenKind.RBracket => "]"
        TokenKind.LBrace => "{"
        TokenKind.RBrace => "}"
        TokenKind.Comma => ","
        TokenKind.Colon => ":"
        TokenKind.Dot => "."
        TokenKind.Arrow => "->"
        TokenKind.FatArrow => "=>"
        TokenKind.Assign => "="
        TokenKind.EqEq => "=="
        TokenKind.NotEq => "!="
        TokenKind.Lt => "<"
        TokenKind.LtEq => "<="
        TokenKind.Gt => ">"
        TokenKind.GtEq => ">="
        TokenKind.Plus => "+"
        TokenKind.Minus => "-"
        TokenKind.Star => "*"
        TokenKind.Slash => "/"
        TokenKind.Percent => "%"
        _ => "?"
    }
}

fn describe_token(token: Token) -> Text {
    match token.kind {
        TokenKind.Int => "number `" + token.text + "`"
        TokenKind.Text => "text literal"
        TokenKind.Ident => "name `" + token.text + "`"
        TokenKind.Newline => "end of line"
        TokenKind.Eof => "end of file"
        _ => "`" + symbol_text(token.kind) + "`"
    }
}

note "A line ending in one of these tokens continues on the next line (spec 4.6)."
fn continues_line(kind: TokenKind) -> Bool {
    match kind {
        TokenKind.Comma => true
        TokenKind.Assign => true
        TokenKind.Arrow => true
        TokenKind.FatArrow => true
        TokenKind.EqEq => true
        TokenKind.NotEq => true
        TokenKind.Lt => true
        TokenKind.LtEq => true
        TokenKind.Gt => true
        TokenKind.GtEq => true
        TokenKind.Plus => true
        TokenKind.Minus => true
        TokenKind.Star => true
        TokenKind.Slash => true
        TokenKind.Percent => true
        TokenKind.And => true
        TokenKind.Or => true
        TokenKind.Not => true
        TokenKind.Dot => true
        TokenKind.LParen => true
        TokenKind.LBracket => true
        TokenKind.LBrace => true
        _ => false
    }
}

fn keyword_kind(word: Text) -> TokenKind {
    match word {
        "fn" => TokenKind.Fn
        "let" => TokenKind.Let
        "var" => TokenKind.Var
        "set" => TokenKind.Set
        "if" => TokenKind.If
        "else" => TokenKind.Else
        "for" => TokenKind.For
        "in" => TokenKind.In
        "while" => TokenKind.While
        "note" => TokenKind.Note
        "uses" => TokenKind.Uses
        "and" => TokenKind.And
        "or" => TokenKind.Or
        "not" => TokenKind.Not
        "true" => TokenKind.True
        "false" => TokenKind.False
        "type" => TokenKind.Type
        "enum" => TokenKind.Enum
        "match" => TokenKind.Match
        "return" => TokenKind.Return
        "break" => TokenKind.Break
        "continue" => TokenKind.Continue
        "import" => TokenKind.Import
        "pub" => TokenKind.Pub
        "with" => TokenKind.With
        _ => TokenKind.Ident
    }
}

fn reserved_words() -> List[Text] = ["module", "try", "unsafe", "loop", "const", "trait", "impl"]

fn token(kind: TokenKind, text: Text, span: Span) -> Token = Token { kind: kind, text: text, span: span }

fn newline_allowed(tokens: List[Token], open_kinds: List[Int]) -> Bool {
    let open_count = length(open_kinds)
    if open_count > 0 {
        let top = open_kinds[open_count - 1]
        if top == 40 or top == 91 {
            return false
        }
    }
    let count = length(tokens)
    if count == 0 {
        return false
    }
    let last = tokens[count - 1].kind
    not (last == TokenKind.Newline or continues_line(last))
}

fn non_ascii_letter(code: Int, span: Span) -> Diagnostic {
    error_help("E0103", span, "non-ASCII letter `" + from_code_point(code) + "` in a name", "names use ASCII letters, digits and `_` only; this prevents look-alike characters (homoglyphs)")
}

fn scan_word(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    var index = start
    var name: List[Int] = []
    var diagnostics: List[Diagnostic] = []
    while index < length(codes) and (is_alphanumeric(codes[index]) or codes[index] == 95 or codes[index] >= 128) {
        let code = codes[index]
        if code >= 128 {
            let here = col + index - start
            set diagnostics = append(diagnostics, non_ascii_letter(code, span_of(file, line, here, here + 1)))
        } else {
            set name = append(name, code)
        }
        set index = index + 1
    }
    let word = from_code_points(name)
    let span = span_of(file, line, col, col + index - start)
    let kind = keyword_kind(word)
    if kind == TokenKind.Ident and contains_text(reserved_words(), word) {
        set diagnostics = append(diagnostics, error_help("E0108", span, "`" + word + "` is a reserved word", "choose a different name"))
    }
    Scan { token: token(kind, word, span), end: index, diagnostics: diagnostics, emit: true }
}

note "Digits compared as text: `a` is larger than `b` when both have the same length."
fn digits_greater(a: List[Int], b: List[Int]) -> Bool {
    if length(a) != length(b) {
        return length(a) > length(b)
    }
    for index in range(0, length(a)) {
        if a[index] != b[index] {
            return a[index] > b[index]
        }
    }
    false
}

fn scan_number(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    var index = start
    var digits: List[Int] = []
    while index < length(codes) and (is_digit(codes[index]) or codes[index] == 95) {
        if codes[index] != 95 {
            set digits = append(digits, codes[index])
        }
        set index = index + 1
    }
    var bad_suffix = false
    while index < length(codes) and (is_alphanumeric(codes[index]) or codes[index] >= 128) {
        set bad_suffix = true
        set index = index + 1
    }
    let raw_codes = slice(codes, start, index)
    let raw = from_code_points(raw_codes)
    let span = span_of(file, line, col, col + index - start)
    if bad_suffix {
        let d = error_help("E0106", span, "invalid number `" + raw + "`", "numbers are decimal digits only, optionally separated by `_`")
        return Scan { token: token(TokenKind.Int, "0", span), end: index, diagnostics: [d], emit: true }
    }
    var diagnostics: List[Diagnostic] = []
    let raw_count = length(raw_codes)
    var double_underscore = false
    for position in range(1, raw_count) {
        if raw_codes[position] == 95 and raw_codes[position - 1] == 95 {
            set double_underscore = true
        }
    }
    if raw_codes[raw_count - 1] == 95 or double_underscore {
        set diagnostics = append(diagnostics, error_help("E0106", span, "invalid number `" + raw + "`", "`_` may only appear between digits, e.g. `1_000_000`"))
    }
    if length(digits) > 1 and digits[0] == 48 {
        set diagnostics = append(diagnostics, error_help("E0106", span, "number `" + raw + "` has a leading zero", "leading zeros are not allowed; write the number without them"))
    }
    var text = from_code_points(digits)
    if digits_greater(digits, code_points("9223372036854775808")) {
        set diagnostics = append(diagnostics, error_help("E0106", span, "number `" + raw + "` does not fit in `Int`", "`Int` is a signed 64-bit integer: -9223372036854775808 to 9223372036854775807"))
        set text = "0"
    }
    Scan { token: token(TokenKind.Int, text, span), end: index, diagnostics: diagnostics, emit: true }
}

fn scan_text(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    var index = start + 1
    var value: List[Int] = []
    var diagnostics: List[Diagnostic] = []
    var closed = false
    while not closed {
        if index >= length(codes) or codes[index] == 10 {
            let open_span = span_of(file, line, col, col + index - start)
            set diagnostics = append(diagnostics, error_help("E0109", open_span, "text literal is not closed", "add a closing `\"` on the same line; use `\\n` for line breaks"))
            break
        }
        let code = codes[index]
        let here = col + index - start
        if code == 34 {
            set index = index + 1
            set closed = true
        } else if code == 92 {
            let escape_span = span_of(file, line, here, here + 1)
            let next = if index + 1 < length(codes) { codes[index + 1] } else { -1 }
            set index = index + 2
            if next == 110 {
                set value = append(value, 10)
            } else if next == 116 {
                set value = append(value, 9)
            } else if next == 92 {
                set value = append(value, 92)
            } else if next == 34 {
                set value = append(value, 34)
            } else if next == 117 {
                if index >= length(codes) or codes[index] != 123 {
                    set diagnostics = append(diagnostics, error_help("E0109", escape_span, "invalid unicode escape", "write unicode escapes as `\\u{1F600}`"))
                    continue
                }
                set index = index + 1
                var hex: List[Int] = []
                while index < length(codes) and codes[index] != 125 and codes[index] != 34 and codes[index] != 10 {
                    set hex = append(hex, codes[index])
                    set index = index + 1
                }
                if index < length(codes) and codes[index] == 125 {
                    set index = index + 1
                }
                var valid = length(hex) >= 1 and length(hex) <= 6
                var scalar = 0
                for digit in hex {
                    if not is_hex_digit(digit) {
                        set valid = false
                    } else {
                        set scalar = scalar * 16 + hex_value(digit)
                    }
                }
                if valid and (scalar > 1114111 or (scalar >= 55296 and scalar <= 57343)) {
                    set valid = false
                }
                if valid {
                    set value = append(value, scalar)
                } else {
                    set diagnostics = append(diagnostics, error("E0109", escape_span, "`\\u{" + from_code_points(hex) + "}` is not a valid unicode scalar value"))
                }
            } else {
                let shown = if next < 0 or next == 10 { "" } else { from_code_point(next) }
                if next == 10 {
                    set index = index - 1
                }
                set diagnostics = append(diagnostics, error_help("E0109", escape_span, "unknown escape `\\" + shown + "`", "valid escapes are `\\n`, `\\t`, `\\\\`, `\\\"` and `\\u{...}`"))
            }
        } else if is_control(code) {
            set diagnostics = append(diagnostics, error_help("E0109", span_of(file, line, here, here + 1), "control character inside a text literal", "use an escape such as `\\t` or `\\u{...}`"))
            set index = index + 1
        } else {
            set value = append(value, code)
            set index = index + 1
        }
    }
    let span = span_of(file, line, col, col + index - start)
    Scan { token: token(TokenKind.Text, from_code_points(value), span), end: index, diagnostics: diagnostics, emit: true }
}

fn two_char_kind(first: Int, second: Int) -> TokenKind {
    if first == 45 and second == 62 {
        TokenKind.Arrow
    } else if first == 61 and second == 62 {
        TokenKind.FatArrow
    } else if first == 61 and second == 61 {
        TokenKind.EqEq
    } else if first == 33 and second == 61 {
        TokenKind.NotEq
    } else if first == 60 and second == 61 {
        TokenKind.LtEq
    } else if first == 62 and second == 61 {
        TokenKind.GtEq
    } else {
        TokenKind.Eof
    }
}

fn one_char_kind(code: Int) -> TokenKind {
    match code {
        40 => TokenKind.LParen
        41 => TokenKind.RParen
        91 => TokenKind.LBracket
        93 => TokenKind.RBracket
        123 => TokenKind.LBrace
        125 => TokenKind.RBrace
        44 => TokenKind.Comma
        58 => TokenKind.Colon
        46 => TokenKind.Dot
        61 => TokenKind.Assign
        60 => TokenKind.Lt
        62 => TokenKind.Gt
        43 => TokenKind.Plus
        45 => TokenKind.Minus
        42 => TokenKind.Star
        47 => TokenKind.Slash
        37 => TokenKind.Percent
        _ => TokenKind.Eof
    }
}

fn unexpected_character_help(code: Int) -> Text {
    match code {
        33 => "use `not` for negation and `!=` for inequality"
        38 => "use `and` instead of `&&`"
        124 => "use `or` instead of `||`"
        59 => "statements end at the end of a line; remove the `;`"
        39 => "text literals use double quotes"
        _ => "remove this character"
    }
}

fn scan_symbol(codes: List[Int], start: Int, file: Int, line: Int, col: Int) -> Scan {
    let code = codes[start]
    let next = if start + 1 < length(codes) { codes[start + 1] } else { -1 }
    let pair = two_char_kind(code, next)
    if pair != TokenKind.Eof {
        return Scan { token: token(pair, "", span_of(file, line, col, col + 2)), end: start + 2, diagnostics: [], emit: true }
    }
    let span = span_of(file, line, col, col + 1)
    let single = one_char_kind(code)
    if single == TokenKind.Eof {
        let d = error_help("E0103", span, "unexpected character `" + from_code_point(code) + "`", unexpected_character_help(code))
        return Scan { token: token(TokenKind.Eof, "", span), end: start + 1, diagnostics: [d], emit: false }
    }
    Scan { token: token(single, "", span), end: start + 1, diagnostics: [], emit: true }
}

fn bracket_code(kind: TokenKind) -> Int {
    match kind {
        TokenKind.LParen => 40
        TokenKind.RParen => 40
        TokenKind.LBracket => 91
        TokenKind.RBracket => 91
        TokenKind.LBrace => 123
        TokenKind.RBrace => 123
        _ => 0
    }
}

fn is_opening(kind: TokenKind) -> Bool = kind == TokenKind.LParen or kind == TokenKind.LBracket or kind == TokenKind.LBrace

fn is_closing(kind: TokenKind) -> Bool = kind == TokenKind.RParen or kind == TokenKind.RBracket or kind == TokenKind.RBrace

fn tokenize(text: Text, file: Int) -> LexResult {
    let codes = code_points(text)
    let count = length(codes)
    var tokens: List[Token] = []
    var diagnostics: List[Diagnostic] = []
    var open_kinds: List[Int] = []
    var open_spans: List[Span] = []
    var index = 0
    var line = 1
    var col = 1
    if count > 0 and codes[0] == 65279 {
        set diagnostics = append(diagnostics, error_help("E0101", span_of(file, 1, 1, 2), "file starts with a byte order mark", "save the file as UTF-8 without BOM"))
        set index = 1
        set col = 2
    }
    while index < count {
        let code = codes[index]
        let here = span_of(file, line, col, col + 1)
        if code == 10 {
            if newline_allowed(tokens, open_kinds) {
                set tokens = append(tokens, token(TokenKind.Newline, "", here))
            }
            set index = index + 1
            set line = line + 1
            set col = 1
            continue
        }
        if code == 32 {
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 9 {
            set diagnostics = append(diagnostics, error_help("E0101", here, "tab characters are not allowed", "indent with 4 spaces; write `\\t` inside text literals"))
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 13 {
            set diagnostics = append(diagnostics, error_help("E0101", here, "carriage return characters are not allowed", "use Unix line endings (LF)"))
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 47 and index + 1 < count and codes[index + 1] == 47 {
            while index < count and codes[index] != 10 {
                if codes[index] == 13 or codes[index] == 9 {
                    set diagnostics = append(diagnostics, error("E0101", span_of(file, line, col, col + 1), "tab or carriage return characters are not allowed"))
                }
                set index = index + 1
                set col = col + 1
            }
            continue
        }
        if code == 95 and not (index + 1 < count and (is_alphanumeric(codes[index + 1]) or codes[index + 1] == 95)) {
            set tokens = append(tokens, token(TokenKind.Underscore, "", here))
            set index = index + 1
            set col = col + 1
            continue
        }
        if code == 95 {
            set diagnostics = append(diagnostics, error("E0103", here, "names must start with a letter"))
            set index = index + 1
            set col = col + 1
            while index < count and (is_alphanumeric(codes[index]) or codes[index] == 95) {
                set index = index + 1
                set col = col + 1
            }
            continue
        }
        if code >= 128 {
            set diagnostics = append(diagnostics, error_help("E0103", here, "unexpected character `" + from_code_point(code) + "`", "names use ASCII letters, digits and `_` only; text belongs inside double quotes"))
            set index = index + 1
            set col = col + 1
            continue
        }
        let scan = if code == 34 {
            scan_text(codes, index, file, line, col)
        } else if is_digit(code) {
            scan_number(codes, index, file, line, col)
        } else if is_letter(code) {
            scan_word(codes, index, file, line, col)
        } else {
            scan_symbol(codes, index, file, line, col)
        }
        set diagnostics = concat(diagnostics, scan.diagnostics)
        set col = col + scan.end - index
        set index = scan.end
        if not scan.emit {
            continue
        }
        let kind = scan.token.kind
        let span = scan.token.span
        if is_opening(kind) {
            set open_kinds = append(open_kinds, bracket_code(kind))
            set open_spans = append(open_spans, span)
        } else if is_closing(kind) {
            let expected = bracket_code(kind)
            let depth = length(open_kinds)
            let shown = symbol_text(kind)
            if depth == 0 {
                set diagnostics = append(diagnostics, error("E0102", span, "`" + shown + "` has no matching opening bracket"))
            } else {
                let top = open_kinds[depth - 1]
                if top != expected {
                    let open_text = from_code_point(top)
                    set diagnostics = append(diagnostics, error_help("E0102", span, "`" + shown + "` does not match the open `" + open_text + "`", "the `" + open_text + "` was opened on line " + to_text(open_spans[depth - 1].line)))
                }
                set open_kinds = slice(open_kinds, 0, depth - 1)
                set open_spans = slice(open_spans, 0, depth - 1)
            }
        }
        set tokens = append(tokens, scan.token)
    }
    let end_span = span_of(file, line, col, col + 1)
    var remaining = length(open_kinds) - 1
    while remaining >= 0 {
        let d = error("E0102", open_spans[remaining], "`" + from_code_point(open_kinds[remaining]) + "` is never closed")
        set diagnostics = append(diagnostics, with_label(d, "opened here"))
        set remaining = remaining - 1
    }
    if newline_allowed(tokens, []) {
        set tokens = append(tokens, token(TokenKind.Newline, "", end_span))
    }
    let token_count = length(tokens)
    if token_count > 0 and tokens[token_count - 1].kind != TokenKind.Newline {
        set tokens = append(tokens, token(TokenKind.Newline, "", end_span))
    }
    set tokens = append(tokens, token(TokenKind.Eof, "", end_span))
    LexResult { tokens: tokens, diagnostics: diagnostics }
}
