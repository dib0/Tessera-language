// Command-line driver of the stage 1 compiler (the Tessera compiler written in Tessera).

fn usage() -> Text {
    join([
        "Tessera stage 1 compiler (written in Tessera)",
        "",
        "Usage:",
        "  tessera1 check <files...> [--json]           Check for errors without generating code",
        "  tessera1 build <files...> -o <output>        Compile to a native executable",
        "        [--opt 0|1|2|3]                         (the generated Rust is kept as <output>.rs)",
        "  tessera1 emit-rust <files...> [-o <file.rs>] Write the generated Rust code",
        "  tessera1 notes <files...>                    Export notes as JSON",
        "",
        "The first file is the entry module (with `main`); imported modules are found",
        "relative to its directory. Further files given on the command line are part of",
        "the entry module.",
        "Exit codes: 0 ok, 1 compile errors, 2 usage error, 3 Rust backend failure.",
        "Set TESSERA_RUSTC to choose the rustc binary.",
    ], "\n")
}

type Options {
    command: Text
    files: List[Text]
    output: Text
    json: Bool
    opt: Text
    error: Text
}

fn parse_options(arguments: List[Text]) -> Options {
    if length(arguments) == 0 {
        return Options { command: "", files: [], output: "", json: false, opt: "2", error: "missing command" }
    }
    var files: List[Text] = []
    var output = ""
    var json = false
    var opt = "2"
    var problem = ""
    var index = 1
    while index < length(arguments) and problem == "" {
        let argument = arguments[index]
        if argument == "-o" or argument == "--opt" {
            if index + 1 >= length(arguments) {
                set problem = "`" + argument + "` needs a value"
            } else if argument == "-o" {
                set output = arguments[index + 1]
            } else if contains_text(["0", "1", "2", "3"], arguments[index + 1]) {
                set opt = arguments[index + 1]
            } else {
                set problem = "invalid optimization level `" + arguments[index + 1] + "`"
            }
            set index = index + 2
        } else if argument == "--json" {
            set json = true
            set index = index + 1
        } else if starts_with_text(argument, "-") {
            set problem = "unknown option `" + argument + "`"
        } else {
            set files = append(files, argument)
            set index = index + 1
        }
    }
    let command = arguments[0]
    if problem == "" and length(files) == 0 and command != "help" and command != "--help" {
        set problem = "no source files given"
    }
    Options { command: command, files: files, output: output, json: json, opt: opt, error: problem }
}

type Frontend {
    files: List[SourceFile]
    program: CheckedProgram
    diagnostics: List[Diagnostic]
}

type Loaded {
    files: List[SourceFile]
    modules: List[Module]
    diagnostics: List[Diagnostic]
}

type ParsedSource {
    items: List[Item]
    diagnostics: List[Diagnostic]
}

fn parse_source(text: Text, file: Int) -> ParsedSource {
    let lexed = tokenize(text, file)
    if length(lexed.diagnostics) > 0 {
        return ParsedSource { items: [], diagnostics: lexed.diagnostics }
    }
    let parsed = parse_file(lexed.tokens)
    ParsedSource { items: parsed.items, diagnostics: parsed.diagnostics }
}

fn directory_of(path: Text) -> Text {
    let codes = code_points(path)
    var index = length(codes) - 1
    while index >= 0 {
        if codes[index] == 47 {
            return from_code_points(slice(codes, 0, index))
        }
        set index = index - 1
    }
    "."
}

fn base_name(path: Text) -> Text {
    let directory = directory_of(path)
    if directory == "." and not starts_with_text(path, "./") {
        return path
    }
    from_code_points(slice(code_points(path), length(code_points(directory)) + 1, length(code_points(path))))
}

fn join_path(directory: Text, relative: Text) -> Text = if directory == "." { relative } else { directory + "/" + relative }

fn valid_module_path(path: Text) -> Bool {
    for segment in split_on(path, 47) {
        if not is_snake_case(segment) {
            return false
        }
    }
    true
}

note "Loads the entry files and, following `import`s, every module they need. Module files are found relative to the directory of the first entry file."
fn load_program(entry_paths: List[Text]) -> Loaded uses fs {
    let root = directory_of(entry_paths[0])
    var files: List[SourceFile] = []
    var diagnostics: List[Diagnostic] = []
    var entry_items: List[Item] = []
    var entry_files: List[Text] = []
    for path in entry_paths {
        let file = length(files)
        let text = read_file(path)
        set files = append(files, SourceFile { path: path, text: text })
        set entry_files = append(entry_files, join_path(directory_of(path), base_name(path)))
        let parsed = parse_source(text, file)
        set diagnostics = concat(diagnostics, parsed.diagnostics)
        set entry_items = concat(entry_items, parsed.items)
    }
    var modules: List[Module] = [Module { path: "", prefix: "", items: entry_items, is_entry: true }]
    var loaded: List[Text] = [""]
    var next = 0
    while next < length(modules) {
        for i in imports_of(modules[next]) {
            if contains_text(loaded, i.path) or not valid_module_path(i.path) {
                continue
            }
            set loaded = append(loaded, i.path)
            let file_path = join_path(root, i.path + ".tes")
            if contains_text(entry_files, file_path) {
                set diagnostics = append(diagnostics, error_help("E0603", i.span, "`" + i.path + "` is the entry module and cannot be imported", "move the shared code into its own module"))
                continue
            }
            if not file_exists(file_path) {
                set diagnostics = append(diagnostics, error_help("E0601", i.span, "cannot find module `" + i.path + "`", "expected the file `" + file_path + "`"))
                continue
            }
            let file = length(files)
            let text = read_file(file_path)
            set files = append(files, SourceFile { path: file_path, text: text })
            let parsed = parse_source(text, file)
            set diagnostics = concat(diagnostics, parsed.diagnostics)
            set modules = append(modules, Module { path: i.path, prefix: module_prefix(i.path), items: parsed.items, is_entry: false })
        }
        set next = next + 1
    }
    Loaded { files: files, modules: modules, diagnostics: concat(diagnostics, find_cycles(modules)) }
}

type Visit {
    states: List[Int]
    diagnostics: List[Diagnostic]
}

fn module_index(modules: List[Module], path: Text) -> Int {
    for index in range(0, length(modules)) {
        if modules[index].path == path {
            return index
        }
    }
    -1
}

fn module_label(m: Module) -> Text = if m.is_entry { "(entry)" } else { m.path }

note "Depth-first search; `states` holds 0 (not seen), 1 (on the current path) or 2 (done)."
fn visit_module(node: Int, modules: List[Module], start: Visit, path_stack: List[Int]) -> Visit {
    var states = replace_at(start.states, node, 1)
    var diagnostics = start.diagnostics
    let stack = append(path_stack, node)
    for i in imports_of(modules[node]) {
        let target = module_index(modules, i.path)
        if target < 0 {
            continue
        }
        if states[target] == 1 {
            var names: List[Text] = []
            var on_cycle = false
            for member in stack {
                if member == target {
                    set on_cycle = true
                }
                if on_cycle {
                    set names = append(names, module_label(modules[member]))
                }
            }
            set names = append(names, module_label(modules[target]))
            set diagnostics = append(diagnostics, error_help("E0603", i.span, "import cycle: " + join(names, " -> "), "modules must form layers; move the shared part into a module that both can import"))
        } else if states[target] == 0 {
            let result = visit_module(target, modules, Visit { states: states, diagnostics: diagnostics }, stack)
            set states = result.states
            set diagnostics = result.diagnostics
        }
    }
    Visit { states: replace_at(states, node, 2), diagnostics: diagnostics }
}

fn find_cycles(modules: List[Module]) -> List[Diagnostic] {
    var states: List[Int] = []
    for m in modules {
        set states = append(states, 0)
    }
    visit_module(0, modules, Visit { states: states, diagnostics: [] }, []).diagnostics
}

fn run_frontend(entry_paths: List[Text]) -> Frontend uses fs {
    let loaded = load_program(entry_paths)
    var diagnostics = loaded.diagnostics
    var program = CheckedProgram { items: [], type_defs: [], diagnostics: [], uses_ui: false }
    if length(diagnostics) == 0 {
        set program = check_program(loaded.modules)
        set diagnostics = program.diagnostics
    }
    Frontend { files: loaded.files, program: program, diagnostics: dedup_diagnostics(sort_diagnostics(diagnostics)) }
}

fn report_diagnostics(diagnostics: List[Diagnostic], files: List[SourceFile], json: Bool, summary: Text) -> Unit uses io {
    if json {
        print(render_json(diagnostics, files))
        return
    }
    for d in diagnostics {
        print_error(render(d, files))
    }
    if length(diagnostics) == 0 {
        print_error("ok: no errors")
    } else {
        print_error(to_text(length(diagnostics)) + " error(s)" + summary)
    }
}

fn paths_of(files: List[SourceFile]) -> List[Text] {
    var paths: List[Text] = []
    for f in files {
        set paths = append(paths, f.path)
    }
    paths
}

note "`print` adds a newline; generated code already ends with one."
fn without_final_newline(text: Text) -> Text {
    let codes = code_points(text)
    let count = length(codes)
    if count > 0 and codes[count - 1] == 10 { from_code_points(slice(codes, 0, count - 1)) } else { text }
}

fn notes_json(items: List[Item], files: List[SourceFile]) -> Text {
    var entries: List[Text] = []
    for item in items {
        let entry = match item {
            Item.FunctionItem(f) => note_entry("function", display_name(f.name), f.name_span, f.notes, files)
            Item.RecordItem(r) => note_entry("type", display_name(r.name), r.name_span, r.notes, files)
            Item.EnumItem(e) => note_entry("enum", display_name(e.name), e.name_span, e.notes, files)
            Item.ImportItem(_) => ""
        }
        if entry != "" {
            set entries = append(entries, entry)
        }
    }
    if length(entries) == 0 {
        return "{\n  \"notes\": []\n}\n"
    }
    "{\n  \"notes\": [\n" + join(entries, ",\n") + "\n  ]\n}\n"
}

fn note_entry(kind: Text, name: Text, span: Span, notes: List[Note], files: List[SourceFile]) -> Text {
    if length(notes) == 0 {
        return ""
    }
    var texts: List[Text] = []
    for n in notes {
        set texts = append(texts, json_string(n.text))
    }
    "    {\"file\": " + json_string(files[span.file].path) + ", \"item\": " + json_string(name) + ", \"kind\": " + json_string(kind) + ", \"line\": " + to_text(span.line) + ", \"text\": [" + join(texts, ", ") + "]}"
}

fn run_rustc(options: Options, rust_path: Text) -> Int uses process, env {
    let arguments = ["--edition", "2021", "-C", "opt-level=" + options.opt, "--crate-name", "tessera_program", "-o", options.output, rust_path]
    let configured = environment_variable("TESSERA_RUSTC")
    if configured != "" {
        return run_process(configured, arguments)
    }
    let status = run_process("rustc", arguments)
    if status != -1 {
        return status
    }
    run_process(environment_variable("HOME") + "/.cargo/bin/rustc", arguments)
}

fn main() -> Unit uses io, fs, env, process {
    let options = parse_options(args())
    if options.command == "help" or options.command == "--help" {
        print(usage())
        exit(0)
    }
    if options.error != "" {
        print_error("error: " + options.error + "\n\n" + usage())
        exit(2)
    }
    for path in options.files {
        if not ends_with_text(path, ".tes") {
            print_error("error: `" + path + "` is not a Tessera source file (expected the `.tes` extension)")
            exit(2)
        }
        if not file_exists(path) {
            print_error("error: cannot read `" + path + "`")
            exit(2)
        }
    }
    let command = options.command
    if not contains_text(["check", "build", "emit-rust", "notes"], command) {
        print_error("error: unknown command `" + command + "`")
        exit(2)
    }
    let frontend = run_frontend(options.files)
    let files = frontend.files
    if command == "check" {
        report_diagnostics(frontend.diagnostics, files, options.json, "")
        exit(if length(frontend.diagnostics) == 0 { 0 } else { 1 })
    }
    if length(frontend.diagnostics) > 0 {
        report_diagnostics(frontend.diagnostics, files, options.json, "; no code was generated")
        exit(1)
    }
    if command == "notes" {
        print(without_final_newline(notes_json(frontend.program.items, files)))
        exit(0)
    }
    let rust = generate(frontend.program, paths_of(files), core_runtime(), ui_runtime())
    if command == "emit-rust" {
        if options.output == "" {
            print(without_final_newline(rust))
        } else {
            write_file(options.output, rust)
        }
        exit(0)
    }
    if options.output == "" {
        print_error("error: `build` needs `-o <output>`")
        exit(2)
    }
    let rust_path = options.output + ".rs"
    write_file(rust_path, rust)
    let status = run_rustc(options, rust_path)
    if status == -1 {
        print_error("error: cannot run rustc (install Rust from https://rustup.rs or set TESSERA_RUSTC)")
        exit(3)
    }
    if status != 0 {
        print_error("error: internal compiler error: the generated Rust code did not compile. This is a bug in the Tessera compiler.")
        exit(3)
    }
}
