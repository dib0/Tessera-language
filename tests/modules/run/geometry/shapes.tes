// Pure geometry; private helpers stay inside the module.

pub type Point {
    x: Int
    y: Int
}

pub enum Shape {
    Circle(radius: Int)
    Square(side: Int)
}

fn square(value: Int) -> Int = value * value

pub fn area(shape: Shape) -> Int {
    match shape {
        Shape.Circle(radius) => 3 * square(radius)
        Shape.Square(side) => square(side)
    }
}

pub fn unit_square() -> Shape = Shape.Square(1)

pub fn distance_squared(a: Point, b: Point) -> Int = square(b.x - a.x) + square(b.y - a.y)
