// Spec section 21: the interpreter checks every runtime error itself. Values right at the limits
// must not stop the program; each program in fail/ crosses one limit by the smallest step.

type Key {
name: Text
weight: Float
}

fn weight_of(k: Key) -> Float = k.weight

fn name_of(k: Key) -> Text = k.name

fn is_long(t: Text) -> Bool = length(t) > 2

fn floats() -> List[Float] = [0.0, -0.0, -1.5]

fn main() -> Unit uses io {
let max = 9223372036854775807
let min = -9223372036854775807 - 1
print("int \(max - 1 + 1) \(min + 1 - 1) \(max / -1) \(min / 1) \(min % 7) \(-max) \(min - -1)")
print("int \(3037000499 * 3037000499) \(-3037000499 * 3037000499) \(4611686018427387904 * -2) \(min / -2 * -1)")
print("shift \(shift_left(-4611686018427387904, 1)) \(shift_left(4611686018427387903, 1)) \(shift_left(1, 62)) \(shift_right(min, 63))")
let large: Float = 1e300
let huge = large * 1e7
print("float \(huge) \(huge + huge * 0.79) \(huge * 17.9) \(1e-300 * 1e-300) \(huge / 0.1) \(1e-300 / 5e-324) \(-huge - huge)")
print("float \(exp(709.78) > 1e307) \(pow(10.0, 307.9) > 1e307) \(pow(-2.0, 3.0)) \(to_int(9.2233720368547748e18)) \(to_int(-9.223372036854775808e18))")
let dmax = value_or(parse_decimal("170141183460469231731687303715.884105727"), 0.0)
let dmin = -dmax - 0.000000001
print("decimal \(dmax - 1.0 + 1.0) \(dmin + 1.0 - 1.0) \(dmax * 1.0) \(dmax / 1.0) \(dmax * 0.5) \(-dmax)")
print("decimal \(to_int(9223372036854775807.999)) \(to_int(-9223372036854775808.999)) \(round(dmax, 2)) \(round(dmin, 2)) \(round(-2.5, 0)) \(round(dmax - 0.6, 0))")
let keys = [Key { name: "b", weight: 0.0 }, Key { name: "a", weight: -0.0 }, Key { name: "c", weight: -1.5 }, Key { name: "d", weight: 0.0 }]
print("sort_by \(join(map(sort_by(keys, weight_of), name_of), " ")) \(join(map(sort(floats()), to_text), " "))")
print("functions \(join(map([1, 22, 333], to_text), ",")) \(join(filter(["a", "bbb", "cc", "dddd"], is_long), ","))")
print("text \(pad_left("é", 3, "·")) \(slice_text("añb", 1, 3)) \(from_code_points([1114111, 55295, 57344]) == "􏿿퟿")")
print("bytes \(byte_values(bytes([0, 255]))[1]) \(slice(bytes([1, 2, 3]), 3, 3) == bytes([]))")
}
