// parse_int, split, sort, index_of, contains, to_lower, to_upper, exit_with, `+` on lists,
// `set x += e` / `set x -= e`, and an `if` whose `then` branch takes its type from `else` (drafts 0.10 to 0.12, stage 1 only).

fn show(value: Option[Int]) -> Text {
match value {
.Some(n) => "\(n)"
.None => "none"
}
}

fn main() -> Unit uses io, env {
print(show(parse_int("42")))
print(show(parse_int("-17")))
print(show(parse_int("+5")))
print(show(parse_int("")))
print(show(parse_int(" 1")))
print(show(parse_int("1.5")))
print(show(parse_int("9223372036854775807")))
print(show(parse_int("9223372036854775808")))
print(join(split("a,b,,c", ","), "|"))
print(join(split("one => two", " => "), "|"))
print(join(split("héllo", ""), "|"))
print("\(length(split("", ",")))")
print(join(sort(["pear", "apple", "Zebra", "fig"]), " "))
let numbers = sort([3, -1, 20, 3, 0])
var total = 0
var parts: List[Text] = []
for n in numbers {
set total += n
set parts += ["\(n)"]
}
print(join(parts, " "))
set total -= 1
print("total \(total)")
var text = "a"
set text += "b" + "c"
print(text)
print(show(index_of([10, 20, 30], 20)))
print(show(index_of(["x", "y"], "z")))
print(show(index_of("héllo world", "world")))
print(show(index_of("abc", "")))
print("\(contains([1, 2, 3], 2)) \(contains([1, 2, 3], 9)) \(contains("key: value", ": ")) \(contains("abc", "d"))")
let joined = [1, 2] + [3]
let empty: List[Int] = []
print("\(length(joined + empty)) \(length(empty + joined)) \(joined[2])")
print("\(to_lower("Hello WÖRLD 42")) \(to_upper("straße"))")
let arg = "+7"
let parsed = if contains(arg, "+") { .None } else { parse_int(arg) }
let fallback = if length(arg) > 5 { [] } else { [1, 2] }
print("\(show(parsed)) \(length(fallback))")
exit_with(0, "done (on standard error)")
}
