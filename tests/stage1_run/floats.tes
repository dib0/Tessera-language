// Float (draft 0.17): literals from context, arithmetic, conversions, library functions, text.

type Body {
name: Text
mass: Float
velocity: Float
}

fn kinetic(b: Body) -> Float = 0.5 * b.mass * b.velocity * b.velocity

fn mass_of(b: Body) -> Float = b.mass

fn hypot(x: Float, y: Float) -> Float = sqrt(x * x + y * y)

fn mean(values: List[Float]) -> Float {
var total: Float = 0.0
for v in values {
set total += v
}
total / float(length(values))
}

fn main() -> Unit uses io {
// Literals: Float where expected, Decimal elsewhere, exponents always Float.
let half: Float = 0.5
let price = 19.99
let epsilon = 1e-9
let big = 6.02214076e23
let precise: Float = 3.14159265358979
print("\(half) \(price) \(epsilon) \(big) \(precise)")
let tenth: Float = 0.1
print("decimal \(0.1 + 0.2 == 0.3) \(price + 0.01), float \(tenth + 0.2 == 0.3) \(tenth + 0.2)")
var x: Float = 2.0
set x = x * 1.5 - 0.25
set x -= 1.0
print("x \(x) \(-x) \(x / 4.0) \(2.0 * x) \(x > 1.0) \(1.0 <= x) \(-0.5 < x)")

// Records and functions.
let bodies = [Body { name: "ball", mass: 0.45, velocity: 12.5 }, Body { name: "car", mass: 1200.0, velocity: 27.8 }, Body { name: "fly", mass: 1.2e-5, velocity: 2.0 }]
for b in sort_by(bodies, mass_of) {
print("\(b.name) \(kinetic(b))")
}
print("mean \(mean([1.0, 2.0, 4.0])) hypot \(hypot(3.0, 4.0))")

// Conversions.
print("float \(float(7)) \(float(-9007199254740993))")
print("to_int \(to_int(2.9)) \(to_int(-2.9)) \(to_int(floor(-2.5))) \(to_int(ceil(2.1)))")
let values: List[Float] = [2.345, -2.5, 1234.5678, 0.1, 2.675, 0.125, 99.995]
print("round \(round(values[0], 2)) \(round(values[1], 0)) \(round(values[2], 1)) \(round(values[3], 15)) \(round(values[4], 2)) \(round(values[5], 2)) \(round(values[6], 2))")

// Library functions.
print("sqrt \(sqrt(2.0)) exp \(exp(1.0)) ln \(ln(10.0)) pow \(pow(2.0, 0.5)) \(pow(-2.0, 3.0))")
print("trig \(sin(pi() / 2.0)) \(cos(0.0)) \(atan2(1.0, 1.0) * 4.0) \(tan(0.0))")

// Text.
let samples: List[Float] = [1.0, 100.0, 1e21, 1e-7, -0.0, 123456.789, 0.1 * 3.0]
print("text \(join(map(samples, to_text), " "))")
for t in ["1.5", "-0.25", "2e3", "1E-2", "7", "", "+1", ".5", "1.", "inf", "nan", "1e999", "1.5x"] {
let shown = match parse_float(t) {
.Some(v) => to_text(v)
.None => "none"
}
print("parse \"\(t)\" \(shown)")
}

// Sorting and equality.
print("sort \(join(map(sort([3.5, -1.0, 2.25, 0e0]), to_text), " "))")
print("equal \(-0.0 == 0.0) \([1.0, 2.0] == [1.0, 2.0]) \(Body { name: "a", mass: 1.0, velocity: 0.0 } == Body { name: "a", mass: 1.0, velocity: 0.0 })")
}
